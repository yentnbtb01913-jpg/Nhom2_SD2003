@startuml WisdomITNews_ClassDiagram

' ==================== DOMAIN MODELS ====================

class Article {
    - Id: int
    - Title: string
    - Slug: string
    - Summary: string
    - Content: string
    - Thumbnail: string?
    - ThumbnailAlt: string?
    - CategoryId: int?
    - AuthorId: int?
    - AuthorUserId: int?
    - Views: int
    - Status: string
    - IsFeatured: bool
    - IsBreaking: bool
    - PublishedAt: DateTime?
    - AiSummary: string?
    - SourceName: string?
    - SourceUrl: string?
    - IsExternal: bool
    - MetaTitle: string?
    - MetaDesc: string?
    - Region: string?
    - Latitude: double?
    - Longitude: double?
    - CreatedAt: DateTime
    - UpdatedAt: DateTime
    + Category: Category?
    + Author: Admin?
    + AuthorUser: User?
    + Comments: ICollection<Comment>
    + ArticleTags: ICollection<ArticleTag>
    + AILogs: ICollection<AILog>
    + ViewHistories: ICollection<ViewHistory>
}

class Category {
    - Id: int
    - Name: string
    - Slug: string
    - Description: string?
    - Icon: string?
    - Color: string
    - SortOrder: int
    - IsVisible: bool
    - ParentCategoryId: int?
    - CreatedAt: DateTime
    - UpdatedAt: DateTime
    - ArticleCount: int [NotMapped]
    + ParentCategory: Category?
    + Children: ICollection<Category>
    + Articles: ICollection<Article>
}

class Tag {
    - Id: int
    - Name: string
    - Slug: string
    - CreatedAt: DateTime
    + ArticleTags: ICollection<ArticleTag>
}

class ArticleTag {
    - ArticleId: int [PK]
    - TagId: int [PK]
    - Article: Article?
    - Tag: Tag?
}

class Comment {
    - Id: int
    - ArticleId: int
    - AuthorName: string
    - AuthorEmail: string?
    - Content: string
    - ParentId: int?
    - Likes: int
    - Status: string
    - CreatedAt: DateTime
    - ParentCommentId: int?
    - LikeCount: int
    - DislikeCount: int
    - UserId: int?
    - Article: Article?
    - ParentComment: Comment?
    + Replies: ICollection<Comment>
    - User: User?
    + Votes: ICollection<CommentVote>
}

class CommentVote {
    - Id: int
    - CommentId: int
    - SessionId: string
    - VoteType: string
    - CreatedAt: DateTime
    - Comment: Comment?
}

class AILog {
    - Id: long
    - ArticleId: int?
    - Action: string
    - PromptText: string?
    - ResultText: string?
    - ModelUsed: string?
    - TokensUsed: int
    - IsSuccess: bool
    - ErrorMsg: string?
    - CreatedAt: DateTime
    - Article: Article?
}

class ViewHistory {
    - Id: int
    - ArticleId: int
    - SessionId: string
    - ViewedAt: DateTime
    - Article: Article?
}

class Admin {
    - Id: int
    - Username: string
    - PasswordHash: string
    - FullName: string
    - Email: string
    - Gender: string?
    - Address: string?
    - Role: string
    - IsActive: bool
    - LastLogin: DateTime?
    - CreatedAt: DateTime
    + Articles: ICollection<Article>
}

class User {
    - Id: int
    - Username: string
    - Email: string
    - PasswordHash: string
    - FullName: string
    - AvatarUrl: string?
    - CoverUrl: string?
    - Bio: string?
    - Role: string
    - IsActive: bool
    - IsEmailConfirmed: bool
    - CreatedAt: DateTime
    + Articles: ICollection<Article>
    + Comments: ICollection<Comment>
}

class ChatGroup {
    - Id: int
    - Name: string
    - Avatar: string?
    - CreatorType: string
    - CreatorId: int
    - IsDirectMessage: bool
    - CreatedAt: DateTime
    + Members: ICollection<ChatMember>
    + Messages: ICollection<ChatMessage>
}

class ChatMember {
    - Id: int
    - GroupId: int
    - MemberType: string
    - MemberId: int
    - Role: string
    - JoinedAt: DateTime
    - Group: ChatGroup?
}

class ChatMessage {
    - Id: int
    - GroupId: int
    - SenderType: string
    - SenderId: int
    - SenderName: string
    - SenderAvatar: string?
    - Content: string
    - MessageType: string
    - FileUrl: string?
    - FileName: string?
    - ReplyToId: int?
    - IsPinned: bool
    - SentAt: DateTime
    - Group: ChatGroup?
    - ReplyTo: ChatMessage?
}

class Friendship {
    - Id: int
    - RequesterId: int
    - ReceiverId: int
    - Status: string
    - CreatedAt: DateTime
    - AcceptedAt: DateTime?
    - Requester: User?
    - Receiver: User?
}

class UserFollow {
    - Id: int
    - FollowerId: int
    - FollowingId: int
    - CreatedAt: DateTime
    - Follower: User?
    - Following: User?
}

class SavedArticle {
    - Id: int
    - UserId: int
    - ArticleId: int
    - SavedAt: DateTime
}

class UserCategoryFollow {
    - Id: int
    - UserId: int
    - CategoryId: int
    - CreatedAt: DateTime
}

class Video {
    - Id: int
    - Title: string
    - YouTubeId: string
    - Source: string?
    - Description: string?
    - Status: string
    - Views: int
    - CreatedByAdminId: int?
    - CreatedByUserId: int?
    - VideoUrl: string?
    - VideoType: string
    - FileSize: long?
    - CreatedAt: DateTime
    - PublishedAt: DateTime
    + IsUpload: bool [computed]
    + Thumbnail: string [computed]
    + EmbedUrl: string [computed]
}

class RssSource {
    - Id: int
    - Name: string
    - FeedUrl: string
    - Description: string?
    - WebsiteUrl: string?
    - Country: string?
    - IsActive: bool
    - DefaultCategoryId: int?
    - MaxImport: int
    - LastImportAt: DateTime?
    - TotalImported: int
    - CreatedAt: DateTime
}

class NewsletterSubscriber {
    - Id: int
    - Email: string
    - FullName: string?
    - Phone: string?
    - Source: string?
    - Status: string
    - SubscribedAt: DateTime
}

class FeedbackReport {
    - Id: int
    - PageUrl: string?
    - Type: string
    - Description: string
    - CreatedAt: DateTime
    - IsResolved: bool
}

' ==================== CONTROLLERS ====================

class HomeController {
    - _db: AppDbContext
    - _logger: ILogger<HomeController>
    + Index(): Task<IActionResult>
    + Category(string slug): Task<IActionResult>
    + Search(string q): Task<IActionResult>
}

class ArticleController {
    - _db: AppDbContext
    - _ai: AIService
    - _logger: ILogger<ArticleController>
    + Detail(string slug): Task<IActionResult>
    + Chat([FromBody] ChatRequest): Task<IActionResult>
    + LikeComment(int id): Task<IActionResult>
    + DislikeComment(int id): Task<IActionResult>
    + ReplyComment(): Task<IActionResult>
}

class AdminController {
    - _db: AppDbContext
    - _imageUpload: ImageUploadService
    - _ai: AIService
    - _email: EmailService
    - _videoUpload: VideoUploadService
    - _logger: ILogger<AdminController>
    + Login(): IActionResult
    + Logout(): IActionResult
    + Dashboard(): Task<IActionResult>
    + Articles(): Task<IActionResult>
    + CreateArticle(): Task<IActionResult>
    + EditArticle(int id): Task<IActionResult>
    + DeleteArticle(int id): Task<IActionResult>
    + Categories(): Task<IActionResult>
    + Comments(): Task<IActionResult>
    + Subscribers(): Task<IActionResult>
    + Feedback(): Task<IActionResult>
    + Videos(): Task<IActionResult>
    + RssSources(): Task<IActionResult>
}

class NhanVienController {
    - _db: AppDbContext
    - _imageUpload: ImageUploadService
    - _ai: AIService
    - _logger: ILogger<NhanVienController>
    + Login(): IActionResult
    + Logout(): IActionResult
    + Dashboard(): Task<IActionResult>
    + Articles(): Task<IActionResult>
    + CreateArticle(): Task<IActionResult>
    + EditArticle(int id): Task<IActionResult>
    + Comments(): Task<IActionResult>
}

class JournalistController {
    - _db: AppDbContext
    - _imageUpload: ImageUploadService
    - _logger: ILogger<JournalistController>
    + Register(): IActionResult
    + Login(): IActionResult
    + Logout(): IActionResult
    + Dashboard(): Task<IActionResult>
    + CreateArticle(): Task<IActionResult>
    + EditArticle(int id): Task<IActionResult>
}

class AccountController {
    - _db: AppDbContext
    - _logger: ILogger<AccountController>
    + Register(): IActionResult
    + Login(): IActionResult
    + Logout(): IActionResult
    + Profile(string username): Task<IActionResult>
    + EditProfile(): Task<IActionResult>
}

class ChatController {
    - _db: AppDbContext
    - _logger: ILogger<ChatController>
    + Index(): Task<IActionResult>
    + Group(int id): Task<IActionResult>
    + CreateGroup(): Task<IActionResult>
}

class FriendController {
    - _db: AppDbContext
    - _logger: ILogger<FriendController>
    + SendRequest(int userId): Task<IActionResult>
    + AcceptRequest(int id): Task<IActionResult>
    + RejectRequest(int id): Task<IActionResult>
    + Follow(int userId): Task<IActionResult>
    + Unfollow(int userId): Task<IActionResult>
}

class FeedbackController {
    - _db: AppDbContext
    - _logger: ILogger<FeedbackController>
    + Submit(): Task<IActionResult>
}

class VideoController {
    - _db: AppDbContext
    - _logger: ILogger<VideoController>
    + Index(): Task<IActionResult>
    + Detail(int id): Task<IActionResult>
    + Watch(int id): Task<IActionResult>
}

class RegionController {
    - _db: AppDbContext
    - _logger: ILogger<RegionController>
    + Index(string region): Task<IActionResult>
}

class RssController {
    - _db: AppDbContext
    - _importService: NewsImportService
    - _logger: ILogger<RssController>
    + ImportFromSource(int id): Task<IActionResult>
    + ImportAll(): Task<IActionResult>
}

' ==================== SERVICES ====================

class AIService {
    - _httpClient: HttpClient
    - _apiKey: string
    - _logger: ILogger<AIService>
    + SummarizeAsync(string content): Task<SummarizeResponse>
    + SuggestTitleAsync(string content): Task<SuggestTitleResponse>
    + ChatAsync(string message): Task<(string reply, bool success)>
    + ModerateAsync(string content): Task<ModerationResult>
}

class EmailService {
    - _smtpHost: string
    - _smtpPort: int
    - _smtpUser: string
    - _smtpPass: string
    - _logger: ILogger<EmailService>
    + SendEmailAsync(string to, string subject, string body): Task
    + SendNewsletterAsync(List<string> recipients, string subject, string body): Task
}

class ImageUploadService {
    - _webHostEnvironment: IWebHostEnvironment
    - _logger: ILogger<ImageUploadService>
    + UploadAsync(IFormFile file): Task<string>
    + DeleteAsync(string filePath): Task
}

class VideoUploadService {
    - _webHostEnvironment: IWebHostEnvironment
    - _logger: ILogger<VideoUploadService>
    + UploadAsync(IFormFile file): Task<string>
    + DeleteAsync(string filePath): Task
}

class NewsImportService {
    - _httpClient: HttpClient
    - _db: AppDbContext
    - _logger: ILogger<NewsImportService>
    + ImportRssAsync(string feedUrl): Task<int>
    + ImportFromSourceAsync(RssSource source): Task<int>
    - GetThumbnail(XElement item): string?
}

class WeatherService {
    - _httpClient: HttpClient
    - _apiKey: string
    - _logger: ILogger<WeatherService>
    + GetWeatherAsync(string city): Task<WeatherViewModel>
}

class SlugHelper {
    + Generate(string text): string
}

class SimpleXlsx {
    + ExportToExcel<T>(IEnumerable<T> data, string fileName): byte[]
}

' ==================== DATA LAYER ====================

class AppDbContext {
    + Admins: DbSet<Admin>
    + Categories: DbSet<Category>
    + Articles: DbSet<Article>
    + Tags: DbSet<Tag>
    + ArticleTags: DbSet<ArticleTag>
    + Comments: DbSet<Comment>
    + AILogs: DbSet<AILog>
    + NewsletterSubscribers: DbSet<NewsletterSubscriber>
    + CommentVotes: DbSet<CommentVote>
    + ViewHistories: DbSet<ViewHistory>
    + FeedbackReports: DbSet<FeedbackReport>
    + Users: DbSet<User>
    + ChatGroups: DbSet<ChatGroup>
    + ChatMembers: DbSet<ChatMember>
    + ChatMessages: DbSet<ChatMessage>
    + Friendships: DbSet<Friendship>
    + UserFollows: DbSet<UserFollow>
    + SavedArticles: DbSet<SavedArticle>
    + UserCategoryFollows: DbSet<UserCategoryFollow>
    + Videos: DbSet<Video>
    + RssSources: DbSet<RssSource>
    + OnModelCreating(ModelBuilder mb): void
}

class ChatHub {
    - _db: AppDbContext
    + JoinGroup(int groupId): Task
    + SendMessage(int groupId, string content): Task
    + OnConnectedAsync(): Task
    + OnDisconnectedAsync(Exception? exception): Task
}

' ==================== VIEW MODELS ====================

class HomeViewModel {
    + FeaturedArticles: List<Article>
    + LatestArticles: List<Article>
    + AIArticles: List<Article>
    + PopularArticles: List<Article>
    + Categories: List<Category>
    + Tags: List<Tag>
}

class ArticleViewModel {
    + Article: Article
    + Comments: List<Comment>
    + Tags: List<Tag>
    + RelatedArticles: List<Article>
    + PopularArticles: List<Article>
}

class DashboardViewModel {
    + TotalArticles: int
    + PublishedArticles: int
    + TotalViews: int
    + TotalComments: int
    + PendingComments: int
    + Subscribers: int
    + RecentArticles: List<Article>
    + TopArticles: List<Article>
    + TotalChatGroups: int
    + TotalChatMessages: int
    + TotalChatUsers: int
    + RecentChatGroups: List<ChatGroup>
}

class RegisterViewModel {
    + FullName: string
    + Username: string
    + Email: string
    + Password: string
    + ConfirmPassword: string
    + Error: string
}

class LoginViewModel {
    + UsernameOrEmail: string
    + Password: string
    + Error: string
}

' ==================== RELATIONSHIPS ====================

' Article relationships
Article "1" -- "*" Category : belongs to
Article "1" -- "0..1" Admin : written by
Article "1" -- "0..1" User : authored by
Article "1" -- "*" Comment : has
Article "1" -- "*" ArticleTag : has
Article "1" -- "*" AILog : has
Article "1" -- "*" ViewHistory : has

' Category self-reference
Category "1" -- "*" Category : parent-child

' ArticleTag many-to-many
Article "1" -- "*" ArticleTag
Tag "1" -- "*" ArticleTag

' Comment self-reference
Comment "1" -- "*" Comment : replies
Comment "1" -- "*" CommentVote : has

' User relationships
User "1" -- "*" Article : writes
User "1" -- "*" Comment : writes

' Chat relationships
ChatGroup "1" -- "*" ChatMember : has
ChatGroup "1" -- "*" ChatMessage : has
ChatMessage "1" -- "0..1" ChatMessage : replies to

' Social relationships
User "1" -- "*" Friendship : requests
User "1" -- "*" UserFollow : follows
User "1" -- "*" SavedArticle : saves
User "1" -- "*" UserCategoryFollow : follows

' Controller dependencies
HomeController ..> AppDbContext : uses
ArticleController ..> AppDbContext : uses
ArticleController ..> AIService : uses
AdminController ..> AppDbContext : uses
AdminController ..> ImageUploadService : uses
AdminController ..> AIService : uses
AdminController ..> EmailService : uses
AdminController ..> VideoUploadService : uses
VideoController ..> AppDbContext : uses
RssController ..> AppDbContext : uses
RssController ..> NewsImportService : uses

' Service dependencies
AIService ..> HttpClient : uses
EmailService ..> HttpClient : uses
NewsImportService ..> HttpClient : uses
NewsImportService ..> AppDbContext : uses
WeatherService ..> HttpClient : uses

' SignalR
ChatHub ..> AppDbContext : uses

note right of Article
  Core entity for news articles
  Supports AI summaries, external sources
  Regional content support
end note

note right of Category
  Hierarchical category structure
  Self-referencing for parent-child
  Sort order for navigation
end note

note right of Comment
  Nested comments (2 levels)
  Like/Dislike functionality
  User authentication support
end note

note right of ChatGroup
  Real-time messaging via SignalR
  Supports direct messages
  Group chat functionality
end note

@enduml

