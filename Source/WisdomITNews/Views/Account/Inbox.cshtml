@model List<WisdomITNews.Models.Notification>
@{
    ViewData["Title"] = "Hộp thư"; Layout = null;
    string kw = ViewBag.Keyword as string ?? "";
    string st = ViewBag.Status as string ?? "";
    int total = (int)(ViewBag.TotalCount ?? 0);
    int unread = (int)(ViewBag.UnreadCount ?? 0);
    int page = (int)(ViewBag.Page ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    string TabStyle(bool on) => "padding:7px 16px;border-radius:20px;font-size:13px;text-decoration:none;border:1px solid " + (on ? "#0e7d85" : "#e5e7eb") + ";background:" + (on ? "#0e7d85" : "#fff") + ";color:" + (on ? "#fff" : "#374151") + ";";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hộp thư — Wisdom IT News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>body{background:#f6f8fa;font-family:'Segoe UI',system-ui,sans-serif;}</style>
</head>
<body>
    <nav class="py-3 px-4 bg-white border-bottom">
        <div class="mx-auto d-flex align-items-center justify-content-between" style="max-width:1000px;">
            <a href="/" class="text-decoration-none d-flex align-items-center">
                <img src="/Logo%20c%C3%B3%20ch%E1%BB%AF.png" alt="Wisdom IT News" style="height:40px;width:auto;" />
            </a>
            <a href="/" class="btn btn-sm btn-outline-secondary"><i class="fa fa-arrow-left"></i> Trang chủ</a>
        </div>
    </nav>
<div style="max-width:760px;margin:28px auto;padding:0 16px;">

    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:18px;">
        <div>
            <h1 style="font-size:23px;font-weight:800;margin:0;"><i class="fa fa-inbox" style="color:#0e7d85;"></i> Hộp thư</h1>
            <p style="font-size:13px;color:#64748b;margin:4px 0 0;">@total thư · <span style="color:#dc2626;font-weight:600;">@unread chưa đọc</span></p>
        </div>
        <div style="display:flex;gap:8px;">
            <button onclick="markAllReadInbox()" style="background:#f0fdfa;color:#0e7d85;border:1px solid #0e7d85;padding:8px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;"><i class="fa fa-check-double"></i> Đọc tất cả</button>
            <button onclick="deleteAllReadInbox()" style="background:#fee2e2;color:#dc2626;border:1px solid #fca5a5;padding:8px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;"><i class="fa fa-trash"></i> Xóa đã đọc</button>
        </div>
    </div>

    <!-- Tìm kiếm + lọc trạng thái -->
    <form method="get" action="/Account/Inbox" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:16px;">
        <input type="text" name="keyword" value="@kw" placeholder="🔍 Tìm trong hộp thư..." style="flex:1;min-width:200px;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;" />
        <button type="submit" style="background:#0e7d85;color:#fff;border:none;padding:10px 16px;border-radius:8px;font-weight:600;cursor:pointer;">Tìm</button>
    </form>
    <div style="display:flex;gap:8px;margin-bottom:18px;">
        <a href="/Account/Inbox@(string.IsNullOrEmpty(kw) ? "" : "?keyword=" + kw)" style="@TabStyle(string.IsNullOrEmpty(st))">Tất cả</a>
        <a href="/Account/Inbox?status=unread@(string.IsNullOrEmpty(kw) ? "" : "&keyword=" + kw)" style="@TabStyle(st == "unread")">Chưa đọc</a>
        <a href="/Account/Inbox?status=read@(string.IsNullOrEmpty(kw) ? "" : "&keyword=" + kw)" style="@TabStyle(st == "read")">Đã đọc</a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:60px 0;color:#94a3b8;">
            <div style="font-size:48px;margin-bottom:8px;"><i class="fa fa-bell-slash"></i></div>
            <p>Không có thư nào.</p>
        </div>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:10px;">
            @foreach (var n in Model)
            {
                <div id="ntf-@n.Id" style="display:flex;gap:12px;align-items:flex-start;background:@(n.IsRead ? "#fff" : "#f0fdfa");border:1px solid @(n.IsRead ? "#eef2f5" : "#99e1cb");border-radius:12px;padding:14px;">
                    <div style="flex-shrink:0;width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:@(n.IconColor)22;color:@n.IconColor;">
                        <i class="fa fa-@(string.IsNullOrWhiteSpace(n.Icon) ? "bell" : n.Icon)"></i>
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <strong style="font-size:14.5px;color:#1f2937;">@n.Title</strong>
                            @if (!n.IsRead)
                            { <span style="width:8px;height:8px;border-radius:50%;background:#dc2626;display:inline-block;"></span> }
                        </div>
                        <div style="font-size:13px;color:#475569;margin-top:3px;white-space:pre-wrap;">@n.Content</div>
                        <div style="font-size:11.5px;color:#94a3b8;margin-top:6px;">@n.CreatedAt.ToString("HH:mm · dd/MM/yyyy")</div>
                    </div>
                    <div style="display:flex;gap:6px;flex-shrink:0;">
                        @if (!n.IsRead)
                        { <button onclick="markReadInbox(@n.Id)" title="Đánh dấu đã đọc" style="background:none;border:none;color:#0e7d85;cursor:pointer;font-size:15px;"><i class="fa fa-check"></i></button> }
                        <button onclick="deleteInboxItem(@n.Id)" title="Xóa" style="background:none;border:none;color:#dc2626;cursor:pointer;font-size:15px;"><i class="fa fa-trash"></i></button>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div style="display:flex;justify-content:center;gap:6px;margin-top:20px;">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <a href="/Account/Inbox?page=@p@(string.IsNullOrEmpty(st) ? "" : "&status=" + st)@(string.IsNullOrEmpty(kw) ? "" : "&keyword=" + kw)"
                       style="padding:6px 12px;border-radius:6px;text-decoration:none;border:1px solid @(p == page ? "#0e7d85" : "#e5e7eb");background:@(p == page ? "#0e7d85" : "#fff");color:@(p == page ? "#fff" : "#374151");">@p</a>
                }
            </div>
        }
    }
</div>

<script>
    async function post(url){ return fetch(url, { method:'POST' }); }
    async function markReadInbox(id){ await post('/Account/MarkUserNotificationRead/' + id); location.reload(); }
    async function deleteInboxItem(id){ if(!confirm('Xóa thư này?')) return; await post('/Account/DeleteUserNotification/' + id); location.reload(); }
    async function markAllReadInbox(){ await post('/Account/MarkAllUserNotificationsRead'); location.reload(); }
    async function deleteAllReadInbox(){ if(!confirm('Xóa tất cả thư đã đọc?')) return; await post('/Account/DeleteAllReadNotifications'); location.reload(); }
</script>
</body>
</html>
