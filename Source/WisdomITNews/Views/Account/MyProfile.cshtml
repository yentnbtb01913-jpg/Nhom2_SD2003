@using WisdomITNews.Models
@using WisdomITNews.Services
@model ProfileViewModel
@{
    Layout = "_Layout"; ViewData["Title"] = "Tài khoản cá nhân";
}

@section Head {
    <style>
        .mp-page { max-width: 820px; margin: 0 auto; }

        /* Card chính */
        .mp-card-main {
            background: var(--bg-white, #fff);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 6px 24px rgba(0,0,0,.04);
            border: 1px solid var(--border, #e5e7eb);
            margin-top: 20px;
        }

        /* Cover */
        .mp-cover {
            height: 200px;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 40%, #3b82f6 70%, #06b6d4 100%);
            position: relative;
            overflow: hidden;
        }
        .mp-cover img {
            width: 100%; height: 100%; object-fit: cover; display: block;
            position: absolute; inset: 0;
        }
        .mp-cover-btn {
            position: absolute; bottom: 14px; right: 16px; z-index: 5;
            background: rgba(0,0,0,.6); color: #fff;
            border: none; border-radius: 10px;
            padding: 8px 18px; font-size: 12px; font-weight: 600;
            cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
            font-family: inherit; transition: background .2s;
            backdrop-filter: blur(6px);
        }
        .mp-cover-btn:hover { background: rgba(0,0,0,.8); }

        /* Avatar + Info dưới cover */
        .mp-profile-body {
            padding: 0 28px 20px;
        }
        .mp-top-row {
            display: flex; align-items: flex-start; gap: 18px;
            margin-top: -40px;
            position: relative; z-index: 3;
        }

        /* Avatar */
        .mp-av-wrap {
            position: relative; width: 100px; height: 100px;
            flex-shrink: 0; cursor: pointer;
        }
        .mp-av {
            width: 100px; height: 100px; border-radius: 50%;
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            color: #fff; display: flex; align-items: center;
            justify-content: center; font-size: 40px; font-weight: 700;
            overflow: hidden;
            border: 4px solid var(--bg-white, #fff);
            box-shadow: 0 2px 12px rgba(0,0,0,.15);
        }
        .mp-av img { width: 100%; height: 100%; object-fit: cover; }
        .mp-av-overlay {
            position: absolute; inset: 0; border-radius: 50%;
            background: rgba(0,0,0,.5); color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; opacity: 0; transition: opacity .25s;
            cursor: pointer; margin: 0; z-index: 4;
            border: 4px solid transparent;
        }
        .mp-av-wrap:hover .mp-av-overlay { opacity: 1; }

        /* Info */
        .mp-quick-info {
            flex: 1; padding-bottom: 4px; padding-top: 46px; min-width: 0;
        }
        .mp-quick-info h1 {
            font-family: 'Playfair Display', serif;
            font-size: 22px; margin: 0; color: var(--text-dark, #0a2540);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .mp-quick-meta {
            display: flex; align-items: center; gap: 8px;
            margin-top: 4px; flex-wrap: wrap;
        }
        .mp-uname { color: var(--text-muted, #6c757d); font-size: 14px; }
        .mp-role-badge {
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            color: #fff; padding: 2px 12px; border-radius: 20px;
            font-size: 10px; font-weight: 700; text-transform: uppercase;
            letter-spacing: .4px;
        }
        .mp-mini-stats {
            display: flex; gap: 16px; margin-top: 8px;
            color: var(--text-muted, #6c757d); font-size: 13px;
        }
        .mp-mini-stats i { margin-right: 4px; font-size: 12px; }

        /* Form sections */
        .mp-section {
            background: var(--bg-white, #fff);
            border-radius: 16px; padding: 24px 28px;
            border: 1px solid var(--border, #e5e7eb);
            margin-top: 16px;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }
        .mp-sec-title {
            font-family: 'Playfair Display', serif; font-size: 17px;
            margin: 0 0 18px; color: var(--text-dark, #0a2540);
            display: flex; align-items: center; gap: 8px;
            padding-bottom: 12px; border-bottom: 2px solid var(--border, #e5e7eb);
        }
        .mp-sec-title i { color: #3b82f6; font-size: 15px; }

        .mp-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .mp-fg {
            display: flex; flex-direction: column; gap: 5px;
            margin-bottom: 14px;
        }
        .mp-fg label {
            font-size: 13px; font-weight: 600;
            color: var(--text-dark, #0a2540);
        }
        .mp-fg input[type="text"],
        .mp-fg input[type="email"],
        .mp-fg textarea {
            border: 1.5px solid var(--border, #d1d5db);
            border-radius: 10px; padding: 10px 14px;
            font-size: 14px; font-family: inherit; outline: none;
            transition: border-color .2s, box-shadow .2s;
            width: 100%; box-sizing: border-box;
            background: var(--bg-white, #fff);
            color: var(--text-dark, #0a2540);
        }
        .mp-fg textarea { resize: vertical; min-height: 70px; }
        .mp-fg input:focus, .mp-fg textarea:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,.1);
        }
        .mp-fg input:disabled {
            background: var(--bg-gray, #f0f2f5);
            color: var(--text-muted, #6c757d);
            cursor: not-allowed; opacity: .7;
        }
        .mp-hint { font-size: 11px; color: var(--text-muted, #6c757d); }

        .mp-form-foot {
            display: flex; align-items: center; gap: 14px; margin-top: 6px;
        }
        .mp-save {
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            color: #fff; border: none; border-radius: 10px;
            padding: 10px 28px; font-size: 14px; font-weight: 700;
            cursor: pointer; font-family: inherit;
            display: inline-flex; align-items: center; gap: 7px;
            transition: transform .15s, box-shadow .2s;
        }
        .mp-save:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(30,58,138,.25);
        }
        .mp-save:active { transform: scale(.97); }
        #profileMsg { font-size: 13px; }

        .mp-empty {
            text-align: center; padding: 40px 20px;
            color: var(--text-muted, #9ca3af);
        }
        .mp-empty i { font-size: 36px; opacity: .35; display: block; margin-bottom: 10px; }
        .mp-empty p { font-size: 14px; margin: 0; }

        /* Dark mode */
        html[data-mode="dark"] .mp-card-main,
        html[data-mode="dark"] .mp-section { background: var(--bg-white); border-color: var(--border); }
        html[data-mode="dark"] .mp-cover {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 40%, #334155 70%, #475569 100%);
        }
        html[data-mode="dark"] .mp-av { border-color: var(--bg-white); background: linear-gradient(135deg, #334155, #475569); }
        html[data-mode="dark"] .mp-quick-info h1 { color: var(--text-dark); }
        html[data-mode="dark"] .mp-uname { color: var(--text-muted); }
        html[data-mode="dark"] .mp-mini-stats { color: var(--text-muted); }
        html[data-mode="dark"] .mp-sec-title { color: var(--text-dark); border-color: var(--border); }
        html[data-mode="dark"] .mp-fg label { color: var(--text-dark); }
        html[data-mode="dark"] .mp-fg input,
        html[data-mode="dark"] .mp-fg textarea { background: var(--bg-white); color: var(--text-dark); border-color: var(--border); }
        html[data-mode="dark"] .mp-fg input:disabled { background: rgba(255,255,255,.06); color: var(--text-muted); }
        html[data-mode="dark"] .mp-empty { color: var(--text-muted); }
        html[data-mode="dark"] .mp-role-badge { background: linear-gradient(135deg, #1e40af, #2563eb); }

        /* Responsive */
        @@media (max-width: 600px) {
            .mp-top-row { flex-direction: column; align-items: center; text-align: center; margin-top: -40px; }
            .mp-quick-info h1 { white-space: normal; }
            .mp-quick-meta { justify-content: center; }
            .mp-mini-stats { justify-content: center; flex-wrap: wrap; }
            .mp-row { grid-template-columns: 1fr; }
            .mp-section { padding: 20px 16px; }
            .mp-profile-body { padding: 0 16px 16px; }
            .mp-cover { height: 140px; }
        }
    </style>
}

<div class="page-wrapper" style="grid-template-columns:1fr;">
    <main class="mp-page">

        <!-- Card chính -->
        <div class="mp-card-main">
            <!-- Cover -->
            <div class="mp-cover" id="coverSection">
                @if (!string.IsNullOrEmpty(Model.User.CoverUrl))
                {
                    <img id="coverImg" src="@Model.User.CoverUrl" alt="Cover" />
                }
                <label for="coverInput" class="mp-cover-btn">
                    <i class="fa fa-image"></i> Đổi ảnh bìa
                </label>
                <input type="file" id="coverInput" accept="image/jpeg,image/png,image/gif,image/webp" style="display:none;" />
            </div>

            <!-- Avatar + Info -->
            <div class="mp-profile-body">
                <div class="mp-top-row">
                    <div class="mp-av-wrap" id="avatarSection">
                        <div class="mp-av">
                            @if (!string.IsNullOrEmpty(Model.User.AvatarUrl))
                            {
                                <img id="avatarImg" src="@Model.User.AvatarUrl" alt="@Model.User.FullName" />
                            }
                            else
                            {
                                <span id="avatarLetter">@(string.IsNullOrWhiteSpace(Model.User.FullName) ? "?" : Model.User.FullName.Substring(0, 1).ToUpper())</span>
                            }
                        </div>
                        <label for="avatarInput" class="mp-av-overlay">
                            <i class="fa fa-camera"></i>
                        </label>
                        <input type="file" id="avatarInput" accept="image/jpeg,image/png,image/gif,image/webp" style="display:none;" />
                    </div>

                    <div class="mp-quick-info">
                        <h1>@Model.User.FullName</h1>
                        <div class="mp-quick-meta">
                            <span class="mp-uname">@@@Model.User.Username</span>
                            <span class="mp-role-badge">@Model.User.Role</span>
                        </div>
                        <div class="mp-mini-stats">
                            <span><i class="fa fa-newspaper"></i> @Model.Articles.Count bài viết</span>
                            <span><i class="fa fa-comments"></i> @Model.CommentCount bình luận</span>
                            <span><i class="fa fa-calendar"></i> Tham gia @Model.User.CreatedAt.ToString("MM/yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chỉnh sửa thông tin -->
        <section class="mp-section">
            <h2 class="mp-sec-title"><i class="fa fa-pen-to-square"></i> Chỉnh sửa thông tin</h2>
            <form id="editProfileForm">
                @Html.AntiForgeryToken()
                <div class="mp-row">
                    <div class="mp-fg">
                        <label for="editFullName">Họ và tên</label>
                        <input type="text" id="editFullName" value="@Model.User.FullName" maxlength="80" />
                    </div>
                    <div class="mp-fg">
                        <label for="editEmail">Email</label>
                        <input type="email" id="editEmail" value="@Model.User.Email" maxlength="120" />
                    </div>
                </div>
                <div class="mp-row">
                    <div class="mp-fg">
                        <label>Tên đăng nhập</label>
                        <input type="text" value="@Model.User.Username" disabled />
                        <span class="mp-hint">Tên đăng nhập không thể thay đổi.</span>
                    </div>
                    <div class="mp-fg">
                        <label for="editBio">Giới thiệu bản thân</label>
                        <textarea id="editBio" maxlength="300" placeholder="Viết vài dòng về bạn...">@Model.User.Bio</textarea>
                    </div>
                </div>
                <div class="mp-form-foot">
                    <button type="submit" class="mp-save"><i class="fa fa-save"></i> Lưu thay đổi</button>
                    <span id="profileMsg"></span>
                </div>
            </form>
        </section>

        <!-- Bài viết đã đăng -->
        <section class="mp-section">
            <h2 class="mp-sec-title"><i class="fa fa-newspaper"></i> Bài viết đã đăng</h2>
            @if (!Model.Articles.Any())
            {
                <div class="mp-empty">
                    <i class="fa fa-pen-nib"></i>
                    <p>Chưa có bài viết nào.</p>
                </div>
            }
            else
            {
                <div class="article-list">
                    @foreach (var a in Model.Articles)
                    {
                        @await Html.PartialAsync("_ArticleCard", a)
                    }
                </div>
            }
        </section>

    </main>
</div>

@section Scripts {
    <script>
        // Avatar upload
        document.getElementById('avatarInput').addEventListener('change', async function () {
            const file = this.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) { alert('Ảnh quá lớn (tối đa 5MB)'); return; }

            const formData = new FormData();
            formData.append('avatarFile', file);
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('/Account/UploadAvatar', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    const avatar = document.querySelector('.mp-av');
                    avatar.innerHTML = '<img id="avatarImg" src="' + data.avatarUrl + '" alt="Avatar" />';
                    alert(data.message);
                } else {
                    alert(data.message || 'Lỗi upload');
                }
            } catch { alert('Lỗi kết nối'); }
        });

        // Cover upload
        document.getElementById('coverInput').addEventListener('change', async function () {
            const file = this.files[0];
            if (!file) return;
            if (file.size > 10 * 1024 * 1024) { alert('Ảnh quá lớn (tối đa 10MB)'); return; }

            const formData = new FormData();
            formData.append('coverFile', file);
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('/Account/UploadCover', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    const cover = document.getElementById('coverSection');
                    let img = cover.querySelector('#coverImg');
                    if (img) {
                        img.src = data.coverUrl;
                    } else {
                        img = document.createElement('img');
                        img.id = 'coverImg';
                        img.src = data.coverUrl;
                        img.alt = 'Cover';
                        cover.insertBefore(img, cover.firstChild);
                    }
                    alert(data.message);
                } else {
                    alert(data.message || 'Lỗi upload');
                }
            } catch { alert('Lỗi kết nối'); }
        });

        // Edit profile
        document.getElementById('editProfileForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const fullName = document.getElementById('editFullName').value.trim();
            const email = document.getElementById('editEmail').value.trim();
            const bio = document.getElementById('editBio').value.trim();
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const msg = document.getElementById('profileMsg');

            try {
                const formData = new FormData();
                formData.append('fullName', fullName);
                formData.append('email', email);
                formData.append('bio', bio);
                formData.append('__RequestVerificationToken', token);

                const res = await fetch('/Account/UpdateProfile', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    msg.innerHTML = '<span style="color:#16a34a;"><i class="fa fa-check-circle"></i> ' + data.message + '</span>';
                } else {
                    msg.innerHTML = '<span style="color:#dc2626;"><i class="fa fa-circle-xmark"></i> ' + data.message + '</span>';
                }
                setTimeout(() => msg.textContent = '', 3500);
            } catch {
                msg.innerHTML = '<span style="color:#dc2626;">Lỗi kết nối</span>';
            }
        });
    </script>
}
