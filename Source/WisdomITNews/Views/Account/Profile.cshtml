@using WisdomITNews.Models
@using WisdomITNews.Services
@model ProfileViewModel
@{
    Layout = "_Layout"; ViewData["Title"] = "@@" + Model.User.Username;
    var loggedIn = Context.Session.GetInt32("UserId").HasValue;
}

@section Head {
    <meta name="description" content="Trang cá nhân @Model.User.FullName trên Wisdom IT News." />
}

<div class="page-wrapper" style="grid-template-columns:1fr;">
    <main>

        <div class="pf-card">
            <!-- Cover -->
            <div class="pf-cover">
                @if (!string.IsNullOrEmpty(Model.User.CoverUrl))
                {
                    <img src="@Model.User.CoverUrl" alt="Cover" style="width:100%;height:100%;object-fit:cover;display:block;" />
                }
                else
                {
                    <div class="pf-cover-pattern"></div>
                }
            </div>

            <!-- Avatar -->
            <div class="pf-avatar-row">
                <div class="pf-avatar">
                    @if (!string.IsNullOrEmpty(Model.User.AvatarUrl))
                    {
                        <img src="@Model.User.AvatarUrl" alt="@Model.User.FullName" loading="lazy" />
                    }
                    else
                    {
                        <span>@(string.IsNullOrWhiteSpace(Model.User.FullName) ? "?" : Model.User.FullName.Substring(0, 1).ToUpper())</span>
                    }
                    <div class="pf-avatar-ring"></div>
                </div>
            </div>

            <!-- Info -->
            <div class="pf-info">
                <h1 class="pf-name">@Model.User.FullName</h1>
                <div class="pf-meta-line">
                    <span class="pf-username">@@@Model.User.Username</span>
                    <span class="pf-role">@Model.User.Role</span>
                    @if (Model.FollowsMe && !Model.IsOwnProfile)
                    {
                        <span class="pf-follows-you"><i class="fa fa-arrow-left"></i> Đang theo dõi bạn</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.User.Bio))
                {
                    <p class="pf-bio">@Model.User.Bio</p>
                }
                <div class="pf-join"><i class="fa fa-calendar-days"></i> Tham gia từ @Model.User.CreatedAt.ToString("MMMM yyyy")</div>
            </div>

            <!-- Action Buttons -->
            @if (loggedIn && !Model.IsOwnProfile)
            {
                <div class="pf-actions" id="profileActions">
                    @if (Model.FriendStatus == "none")
                    {
                        <button class="pf-btn pf-btn-primary" onclick="profileAction('addFriend')">
                            <i class="fa fa-user-plus"></i> Kết bạn
                        </button>
                    }
                    else if (Model.FriendStatus == "sent")
                    {
                        <button class="pf-btn pf-btn-disabled" disabled>
                            <i class="fa fa-clock"></i> Đã gửi lời mời
                        </button>
                    }
                    else if (Model.FriendStatus == "received")
                    {
                        <button class="pf-btn pf-btn-success" onclick="profileAction('acceptFriend')">
                            <i class="fa fa-check"></i> Chấp nhận
                        </button>
                    }
                    else if (Model.FriendStatus == "friends")
                    {
                        <button class="pf-btn pf-btn-outline pf-btn-friend" onclick="profileAction('unfriend')">
                            <i class="fa fa-user-check"></i> Bạn bè
                        </button>
                    }

                    @if (Model.IFollow)
                    {
                        <button class="pf-btn pf-btn-outline pf-btn-following" onclick="profileAction('unfollow')">
                            <i class="fa fa-rss"></i> Đang theo dõi
                        </button>
                    }
                    else
                    {
                        <button class="pf-btn pf-btn-outline" onclick="profileAction('follow')">
                            <i class="fa fa-rss"></i> Theo dõi
                        </button>
                    }

                    <button class="pf-btn pf-btn-outline" onclick="profileAction('message')">
                        <i class="fa fa-comment-dots"></i> Nhắn tin
                    </button>
                </div>
            }
            @if (!loggedIn && !Model.IsOwnProfile)
            {
                <div class="pf-actions">
                    <a href="/Account/Login" class="pf-btn pf-btn-primary">
                        <i class="fa fa-right-to-bracket"></i> Đăng nhập để tương tác
                    </a>
                </div>
            }

            <!-- Stats -->
            <div class="pf-stats">
                <div class="pf-stat">
                    <span class="pf-stat-num">@Model.Articles.Count</span>
                    <span class="pf-stat-label">Bài viết</span>
                </div>
                <div class="pf-stat">
                    <span class="pf-stat-num">@Model.FriendCount</span>
                    <span class="pf-stat-label">Bạn bè</span>
                </div>
                <a href="/u/@Model.User.Username/followers" class="pf-stat pf-stat-link">
                    <span class="pf-stat-num">@Model.FollowerCount</span>
                    <span class="pf-stat-label">Người theo dõi</span>
                </a>
                <a href="/u/@Model.User.Username/following" class="pf-stat pf-stat-link">
                    <span class="pf-stat-num">@Model.FollowingCount</span>
                    <span class="pf-stat-label">Đang theo dõi</span>
                </a>
                <div class="pf-stat">
                    <span class="pf-stat-num">@Model.CommentCount</span>
                    <span class="pf-stat-label">Bình luận</span>
                </div>
            </div>
        </div>

        <!-- Articles -->
        <div class="pf-articles">
            <div class="pf-section-header">
                <i class="fa fa-newspaper"></i>
                <h2>Bài viết đã đăng</h2>
            </div>
            @if (!Model.Articles.Any())
            {
                <div class="pf-empty">
                    <i class="fa fa-pen-nib"></i>
                    <p>Chưa có bài viết nào.</p>
                </div>
            }
            else
            {
                <div class="article-list">
                    @foreach (var a in Model.Articles)
                    {
                        @await Html.PartialAsync("_ArticleCard", a)
                    }
                </div>
            }
        </div>

    </main>
</div>

@section Scripts {
    <script>
        const TARGET_ID = @Model.User.Id;

        async function profileAction(action) {
            let url, method;
            switch (action) {
                case 'addFriend':
                    url = '/api/friends/request/' + TARGET_ID;
                    method = 'POST';
                    break;
                case 'acceptFriend':
                    url = '/api/friends/accept/' + TARGET_ID;
                    method = 'POST';
                    break;
                case 'unfriend':
                    if (!await confirmSwal('Hủy kết bạn với người này?')) return;
                    url = '/api/friends/by-user/' + TARGET_ID;
                    method = 'DELETE';
                    break;
                case 'follow':
                    url = '/api/friends/follow/' + TARGET_ID;
                    method = 'POST';
                    break;
                case 'unfollow':
                    if (!await confirmSwal('Bỏ theo dõi người này?')) return;
                    url = '/api/friends/follow/' + TARGET_ID;
                    method = 'DELETE';
                    break;
                case 'message':
                    // Chat đã chuyển vào trang Hồ sơ cá nhân (MyProfile) -> tạo/lấy hội thoại
                    // rồi điều hướng sang đó, mở đúng cuộc trò chuyện.
                    const dmRes = await fetch('/api/chat/dm', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ targetType: 'user', targetId: TARGET_ID })
                    });
                    const dmData = await dmRes.json();
                    if (dmData.success) {
                        window.location.href = '/Account/MyProfile?openGroup=' + dmData.groupId;
                    } else {
                        Swal.fire(dmData.message || 'Không thể bắt đầu trò chuyện.');
                    }
                    return;
            }

            try {
                const res = await fetch(url, { method: method });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    Swal.fire(data.message || 'Có lỗi xảy ra');
                }
            } catch (e) {
                Swal.fire('Lỗi kết nối');
            }
        }
    </script>
}