@using WisdomITNews.Models
@{
    Layout = null;
    string email = ViewBag.Email as string ?? "";
    string fullName = ViewBag.FullName as string ?? "";
    bool already = (bool)(ViewBag.AlreadySubscribed ?? false);
    var cats = ViewBag.Categories as List<Category> ?? new List<Category>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng ký nhận tin — Wisdom IT News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>body{background:#f6f8fa;}</style>
</head>
<body>
    <nav class="py-3 px-4 bg-white border-bottom">
        <div class="mx-auto d-flex align-items-center justify-content-between" style="max-width:560px;">
            <a href="/" class="text-decoration-none fw-bold" style="color:#0e7d85;font-size:1.15rem;"><span style="display:inline-flex;width:30px;height:30px;background:linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);align-items:center;justify-content:center;border-radius:7px;color:#fff;font-size:16px;vertical-align:middle;margin-right:7px;">&#9889;</span><span style="vertical-align:middle;color:#0f172a;">Wisdom IT News</span></a>
            <a href="/" class="btn btn-sm btn-outline-secondary"><i class="fa fa-arrow-left"></i> Trang chủ</a>
        </div>
    </nav>

    <div class="container py-5" style="max-width:560px;">
        <div class="text-center mb-4">
            <div style="font-size:44px;color:#0e7d85;"><i class="fa fa-envelope-open-text"></i></div>
            <h3 class="fw-bold mb-1">Đăng ký nhận tin</h3>
            <p class="text-muted">Nhận bản tin công nghệ, lập trình &amp; AI mới nhất qua email.</p>
        </div>

        @if (TempData["NewsletterNotice"] != null)
        { <div class="alert alert-warning"><i class="fa fa-circle-info"></i> @TempData["NewsletterNotice"]</div> }

        @if (already)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div style="font-size:40px;color:#16a34a;"><i class="fa fa-circle-check"></i></div>
                    <h5 class="mt-2">Bạn đã đăng ký nhận tin</h5>
                    <p class="text-muted mb-3">Email <strong>@email</strong> đang nhận bản tin. Bạn có thể cập nhật danh mục quan tâm bên dưới.</p>
                    <a href="/Subscription/Pricing" class="btn text-white" style="background:#0e7d85;"><i class="fa fa-crown"></i> Xem gói Premium</a>
                </div>
            </div>
            <p class="text-center text-muted small mt-3">Cập nhật thông tin?</p>
        }

        <div class="card border-0 shadow-sm @(already ? "" : "")">
            <div class="card-body p-4">
                <form method="post" action="/Account/Newsletter">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small text-muted">Email</label>
                        <input type="email" class="form-control" value="@email" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Họ tên</label>
                        <input type="text" name="fullName" class="form-control" value="@fullName" placeholder="Tên của bạn" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Danh mục quan tâm (tuỳ chọn)</label>
                        <select name="interested" class="form-select">
                            <option value="">— Tất cả chủ đề —</option>
                            @foreach (var c in cats)
                            {
                                <option value="@c.Name">@c.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-lg w-100 text-white" style="background:#0e7d85;">
                        <i class="fa fa-paper-plane"></i> @(already ? "Cập nhật đăng ký" : "Đăng ký nhận tin")
                    </button>
                </form>
            </div>
        </div>

        <p class="text-center text-muted small mt-3">Đăng ký nhận tin là bước cần thiết trước khi đăng ký gói Premium.</p>
    </div>
</body>
</html>
