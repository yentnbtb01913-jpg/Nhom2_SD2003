@model List<WisdomITNews.Models.User>
@{
    var profileUser = ViewBag.ProfileUser as WisdomITNews.Models.User;
    var listType = ViewBag.ListType as string;
    ViewData["Title"] = $"{listType} — @{profileUser?.Username}";
}

<div style="max-width:700px;margin:30px auto;padding:0 15px;">
    <h2 style="margin-bottom:5px;">@listType của <a href="/u/@profileUser?.Username">@profileUser?.FullName</a></h2>
    <p style="color:#666;margin-bottom:20px;">@Model.Count người</p>

    @if (Model.Count == 0)
    {
        <p style="color:#999;">Chưa có ai.</p>
    }
    else
    {
        @foreach (var user in Model)
        {
            <div style="display:flex;align-items:center;gap:12px;padding:12px;border-bottom:1px solid #eee;">
                <img src="@(string.IsNullOrEmpty(user.AvatarUrl) ? "/images/default-avatar.png" : user.AvatarUrl)"
                     alt="" style="width:48px;height:48px;border-radius:50%;object-fit:cover;" />
                <div>
                    <a href="/u/@user.Username" style="font-weight:600;color:#0a2540;text-decoration:none;">
                        @user.FullName
                    </a>
                    <div style="color:#888;font-size:13px;">@("@")@user.Username</div>
                </div>
            </div>
        }
    }
</div>