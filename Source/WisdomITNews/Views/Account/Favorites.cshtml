@using WisdomITNews.Models
@{
    Layout = null;
    ViewData["Title"] = "Danh mục yêu thích";
    var allCats = ViewBag.AllCategories as List<Category> ?? new List<Category>();
    var followed = ViewBag.FollowedCatIds as List<int> ?? new List<int>();
    var saved = ViewBag.SavedArticles as List<Article> ?? new List<Article>();
    var savedCatIds = ViewBag.SavedCatIds as List<int> ?? new List<int>();
    int? filterCat = ViewBag.FilterCat as int?;
    var savedCats = allCats.Where(c => savedCatIds.Contains(c.Id)).ToList();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Danh mục yêu thích — Wisdom IT News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>body{background:#f6f8fa;font-family:'Segoe UI',system-ui,sans-serif;}</style>
</head>
<body>
    <nav class="py-3 px-4 bg-white border-bottom">
        <div class="mx-auto d-flex align-items-center justify-content-between" style="max-width:1000px;">
            <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
                <span style="width:36px;height:36px;background:linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);display:inline-flex;align-items:center;justify-content:center;border-radius:8px;color:#fff;font-size:18px;">&#9889;</span>
                <span style="font-weight:800;color:#0f172a;font-size:1.1rem;">Wisdom IT News</span>
            </a>
            <a href="/" class="btn btn-sm btn-outline-secondary"><i class="fa fa-arrow-left"></i> Trang chủ</a>
        </div>
    </nav>
<div class="container" style="max-width:1000px;padding:24px 16px;">
    <h1 style="font-size:24px;font-weight:800;margin-bottom:6px;"><i class="fa fa-heart" style="color:#e63946;"></i> Danh mục yêu thích</h1>
    <p style="color:#6c757d;margin-bottom:20px;">Chọn chủ đề bạn quan tâm và tìm lại các bài viết đã lưu theo từng danh mục.</p>

    @if (TempData["FavOk"] != null)
    { <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:8px;margin-bottom:16px;">@TempData["FavOk"]</div> }

    <!-- 1) Chọn danh mục yêu thích -->
    <div style="background:#fff;border:1px solid #eef2f5;border-radius:12px;padding:20px;margin-bottom:24px;">
        <h3 style="font-size:16px;font-weight:700;margin-bottom:14px;">Chủ đề yêu thích của bạn</h3>
        <form method="post" action="/Account/SaveFavorites">
            @Html.AntiForgeryToken()
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:16px;">
                @foreach (var c in allCats)
                {
                    var on = followed.Contains(c.Id);
                    <label style="display:flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid @(on ? "#0e7d85" : "#e5e7eb");background:@(on ? "#f0fdfa" : "#fff");border-radius:8px;cursor:pointer;font-size:14px;">
                        <input type="checkbox" name="categoryIds" value="@c.Id" @(on ? "checked" : "") style="width:16px;height:16px;" />
                        <span>@c.Icon @c.Name</span>
                    </label>
                }
            </div>
            @if (!allCats.Any())
            { <p style="color:#94a3b8;">Chưa có danh mục nào.</p> }
            <button type="submit" style="background:#0e7d85;color:#fff;border:none;padding:10px 22px;border-radius:8px;font-weight:700;cursor:pointer;"><i class="fa fa-floppy-disk"></i> Lưu danh mục yêu thích</button>
        </form>
    </div>

    <!-- 2) Bài đã lưu, lọc theo danh mục -->
    <div style="background:#fff;border:1px solid #eef2f5;border-radius:12px;padding:20px;">
        <h3 style="font-size:16px;font-weight:700;margin-bottom:14px;"><i class="fa fa-bookmark" style="color:#0e7d85;"></i> Bài đã lưu (@saved.Count)</h3>

        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;">
            <a href="/Account/Favorites" style="padding:5px 14px;border-radius:20px;font-size:13px;text-decoration:none;border:1px solid @(filterCat == null ? "#0e7d85" : "#e5e7eb");background:@(filterCat == null ? "#0e7d85" : "#fff");color:@(filterCat == null ? "#fff" : "#374151");">Tất cả</a>
            @foreach (var c in savedCats)
            {
                var active = filterCat == c.Id;
                <a href="/Account/Favorites?cat=@c.Id" style="padding:5px 14px;border-radius:20px;font-size:13px;text-decoration:none;border:1px solid @(active ? "#0e7d85" : "#e5e7eb");background:@(active ? "#0e7d85" : "#fff");color:@(active ? "#fff" : "#374151");">@c.Name</a>
            }
        </div>

        @if (!saved.Any())
        {
            <p style="color:#94a3b8;text-align:center;padding:20px 0;">Chưa có bài viết đã lưu@(filterCat != null ? " trong danh mục này" : "").</p>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:12px;">
                @foreach (var a in saved)
                {
                    <div id="fav-@a.Id" style="display:flex;gap:12px;border:1px solid #f0f2f5;border-radius:10px;padding:10px;">
                        <a href="/bai-viet/@a.Slug" style="flex-shrink:0;">
                            <img src="@(string.IsNullOrWhiteSpace(a.Thumbnail) ? "/img/placeholder.png" : a.Thumbnail)" alt="@a.Title" style="width:120px;height:80px;object-fit:cover;border-radius:8px;" />
                        </a>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:11px;color:#0e7d85;font-weight:700;margin-bottom:2px;">@a.Category?.Name</div>
                            <a href="/bai-viet/@a.Slug" style="font-weight:700;color:#1f2937;text-decoration:none;font-size:15px;">@a.Title</a>
                            <div style="font-size:12px;color:#94a3b8;margin-top:4px;"><i class="fa fa-eye"></i> @a.Views</div>
                        </div>
                        <button onclick="unsave(@a.Id)" title="Bỏ lưu" style="background:none;border:none;color:#dc2626;cursor:pointer;font-size:16px;"><i class="fa fa-trash"></i></button>
                    </div>
                }
            </div>
        }
    </div>
</div>

<script>
async function unsave(id){
    try {
        const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        const fd = new FormData();
        if (tokenEl) fd.append('__RequestVerificationToken', tokenEl.value);
        const res = await fetch('/Account/ToggleSave/' + id, { method:'POST', body: fd });
        const d = await res.json();
        if (d.success && !d.saved) {
            const el = document.getElementById('fav-' + id);
            if (el) el.remove();
        }
    } catch(e){ console.error(e); }
}
</script>
</body>
</html>
