@using WisdomITNews.Models
@{
    Layout = null;
    var subs = ViewBag.Subs as List<UserSubscription> ?? new List<UserSubscription>();
    var current = ViewBag.Current as UserSubscription;
    string StatusText(SubscriptionStatus st) => st switch {
        SubscriptionStatus.Trial => "Dùng thử",
        SubscriptionStatus.Active => "Đang hoạt động",
        SubscriptionStatus.Expired => "Hết hạn",
        _ => "Đã hủy" };
    string StatusColor(SubscriptionStatus st) => st switch {
        SubscriptionStatus.Trial => "#0ea5e9",
        SubscriptionStatus.Active => "#16a34a",
        SubscriptionStatus.Expired => "#6b7280",
        _ => "#dc2626" };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gói của tôi — Wisdom IT News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>body{background:#f6f8fa;} .wrap{max-width:760px;}</style>
</head>
<body>
    <nav class="py-3 px-4 bg-white border-bottom">
        <div class="wrap mx-auto d-flex align-items-center justify-content-between">
            <a href="/" class="text-decoration-none fw-bold" style="color:#0e7d85;font-size:1.15rem;"><span style="display:inline-flex;width:30px;height:30px;background:linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);align-items:center;justify-content:center;border-radius:7px;color:#fff;font-size:16px;vertical-align:middle;margin-right:7px;">&#9889;</span><span style="vertical-align:middle;color:#0f172a;">Wisdom IT News</span></a>
            <div class="d-flex gap-2">
                <a href="/Subscription/TransactionHistory" class="btn btn-sm btn-outline-secondary"><i class="fa fa-receipt"></i> Lịch sử GD</a>
                <a href="/" class="btn btn-sm btn-outline-secondary"><i class="fa fa-arrow-left"></i> Trang chủ</a>
            </div>
        </div>
    </nav>
    <div class="container wrap py-5">
        <h3 class="fw-bold mb-4"><i class="fa fa-crown text-warning"></i> Gói của tôi</h3>

        @if (TempData["SubSuccess"] != null)
        { <div class="alert alert-success">@TempData["SubSuccess"]</div> }
        @if (TempData["SubError"] != null)
        { <div class="alert alert-danger">@TempData["SubError"]</div> }

        @if (current != null)
        {
            <div class="card border-0 shadow-sm mb-4" style="border-left:4px solid #16a34a !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="mb-1">@(current.Plan?.Name ?? "Premium")
                                <span class="badge" style="background:@StatusColor(current.Status);">@StatusText(current.Status)</span></h5>
                            <div class="text-muted small">Hiệu lực đến <strong>@current.EndDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/Subscription/Pricing" class="btn btn-sm text-white" style="background:#0e7d85;">Nâng cấp/Gia hạn</a>
                            <form method="post" action="/Subscription/CancelSubscription" id="cancelForm-@current.Id" class="cancel-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@current.Id" />
                                <button type="button" class="btn btn-sm btn-outline-danger btn-cancel" data-id="@current.Id">Hủy gói</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center">
                <span>Bạn chưa có gói Premium nào đang hoạt động.</span>
                <a href="/Subscription/Pricing" class="btn btn-sm text-white" style="background:#0e7d85;">Xem bảng giá</a>
            </div>
        }

        <h6 class="text-muted mt-4 mb-2">Lịch sử đăng ký</h6>
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light"><tr><th>Gói</th><th>Trạng thái</th><th>Bắt đầu</th><th>Kết thúc</th></tr></thead>
                    <tbody>
                        @if (!subs.Any())
                        { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có dữ liệu.</td></tr> }
                        @foreach (var s in subs)
                        {
                            <tr>
                                <td>@(s.Plan?.Name ?? "Premium")</td>
                                <td><span class="badge" style="background:@StatusColor(s.Status);">@StatusText(s.Status)</span></td>
                                <td>@s.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@s.EndDate.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script>
        document.querySelectorAll('.btn-cancel').forEach(function(b){
            b.addEventListener('click',function(){
                var id=this.getAttribute('data-id');
                Swal.fire({title:'Hủy gói?',text:'Bạn sẽ mất quyền truy cập Premium.',icon:'warning',
                    showCancelButton:true,confirmButtonText:'Hủy gói',cancelButtonText:'Không',confirmButtonColor:'#dc2626'})
                .then(function(r){ if(r.isConfirmed) document.getElementById('cancelForm-'+id).submit(); });
            });
        });
    </script>
</body>
</html>
