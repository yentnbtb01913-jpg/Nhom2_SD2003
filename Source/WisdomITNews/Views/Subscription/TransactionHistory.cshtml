@using WisdomITNews.Models
@{
    Layout = null;
    var list = ViewBag.List as List<Transaction> ?? new List<Transaction>();
    string StatusText(TransactionStatus st) => st switch {
        TransactionStatus.Pending => "Chờ xác nhận",
        TransactionStatus.Success => "Thành công",
        TransactionStatus.Failed => "Thất bại",
        _ => "Đã hủy" };
    string StatusColor(TransactionStatus st) => st switch {
        TransactionStatus.Pending => "#ca8a04",
        TransactionStatus.Success => "#16a34a",
        TransactionStatus.Failed => "#dc2626",
        _ => "#6b7280" };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lịch sử giao dịch — Wisdom IT News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>body{background:#f6f8fa;} .wrap{max-width:820px;}</style>
</head>
<body>
    <nav class="py-3 px-4 bg-white border-bottom">
        <div class="wrap mx-auto d-flex align-items-center justify-content-between">
            <a href="/" class="text-decoration-none fw-bold" style="color:#0e7d85;font-size:1.15rem;"><span style="display:inline-flex;width:30px;height:30px;background:linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);align-items:center;justify-content:center;border-radius:7px;color:#fff;font-size:16px;vertical-align:middle;margin-right:7px;">&#9889;</span><span style="vertical-align:middle;color:#0f172a;">Wisdom IT News</span></a>
            <a href="/Subscription/MySubscription" class="btn btn-sm btn-outline-secondary"><i class="fa fa-arrow-left"></i> Gói của tôi</a>
        </div>
    </nav>
    <div class="container wrap py-5">
        <h3 class="fw-bold mb-4"><i class="fa fa-receipt text-success"></i> Lịch sử giao dịch</h3>
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light"><tr><th>#</th><th>Gói</th><th>Số tiền</th><th>Phương thức</th><th>Trạng thái</th><th>Ngày</th></tr></thead>
                    <tbody>
                        @if (!list.Any())
                        { <tr><td colspan="6" class="text-center text-muted py-4">Bạn chưa có giao dịch nào.</td></tr> }
                        @foreach (var t in list)
                        {
                            <tr>
                                <td>@t.Id</td>
                                <td>@(t.Plan?.Name ?? "Premium")</td>
                                <td>@string.Format("{0:#,##0}", t.Amount) đ</td>
                                <td>@t.PaymentMethodLabel</td>
                                <td><span class="badge" style="background:@StatusColor(t.Status);">@StatusText(t.Status)</span></td>
                                <td>@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
