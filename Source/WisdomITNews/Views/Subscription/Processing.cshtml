@{
    Layout = null;
    int txId = (int)(ViewBag.TransactionId ?? 0);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đang xử lý — Wisdom IT News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-light">
    <div class="container" style="max-width:520px;">
        <div class="card shadow-sm my-5 border-0">
            <div class="card-body p-4 p-md-5 text-center">
                <h3 class="mb-4 fw-bold" style="color:#0e7d85;"><span style="display:inline-flex;width:30px;height:30px;background:linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);align-items:center;justify-content:center;border-radius:7px;color:#fff;font-size:16px;vertical-align:middle;margin-right:7px;">&#9889;</span><span style="vertical-align:middle;color:#0f172a;">Wisdom IT News</span></h3>

                @if (TempData["SubSuccess"] != null)
                { <div class="alert alert-success">@TempData["SubSuccess"]</div> }
                @if (TempData["SubError"] != null)
                { <div class="alert alert-danger">@TempData["SubError"]</div> }

                <div id="spin" class="mb-3" style="font-size:46px;color:#0e7d85;"><i class="fa fa-spinner fa-spin"></i></div>
                <h5 class="mb-2">Vui lòng kiểm tra email</h5>
                <p class="text-muted mb-4" id="msg">Chúng tôi đã gửi email xác nhận thanh toán. Mở email và bấm <strong>"Xác nhận thanh toán"</strong> để kích hoạt gói. Trang này sẽ tự cập nhật.</p>

                <form method="post" action="/Subscription/ResendPurchase" class="mb-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="transactionId" value="@txId" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="fa fa-paper-plane"></i> Gửi lại email xác nhận</button>
                </form>
                <a href="/Subscription/Pricing" class="small text-muted">Quay lại bảng giá</a>
            </div>
        </div>
    </div>
    <script>
        var txId=@txId, tries=0, maxTries=12; // ~30s (2.5s * 12)
        function poll(){
            fetch('/Subscription/PaymentStatus?transactionId='+txId)
            .then(r=>r.json()).then(d=>{
                if(d.status==='Success' || d.status==='Failed' || d.status==='Cancelled'){
                    window.location.href='/Subscription/Result?transactionId='+txId; return;
                }
                if(++tries>=maxTries){
                    document.getElementById('spin').innerHTML='<i class="fa fa-clock" style="color:#ca8a04;"></i>';
                    document.getElementById('msg').innerHTML='Đang xử lý lâu hơn dự kiến. Bạn có thể mở email để xác nhận, hoặc quay lại sau — chúng tôi sẽ kích hoạt ngay khi bạn xác nhận.';
                    return;
                }
                setTimeout(poll,2500);
            }).catch(()=>{ if(++tries<maxTries) setTimeout(poll,2500); });
        }
        setTimeout(poll,2500);
    </script>
</body>
</html>
