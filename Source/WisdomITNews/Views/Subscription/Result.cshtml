@using WisdomITNews.Models
@{
    Layout = null;
    var tx = ViewBag.Tx as Transaction;
    var status = tx?.Status ?? TransactionStatus.Pending;
    string priceText = tx != null ? string.Format("{0:#,##0}", tx.Amount) : "0";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kết quả thanh toán — Wisdom IT News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-light">
    <div class="container" style="max-width:520px;">
        <div class="card shadow-sm my-5 border-0">
            <div class="card-body p-4 p-md-5 text-center">
                <h3 class="mb-4 fw-bold" style="color:#0e7d85;"><span style="display:inline-flex;width:30px;height:30px;background:linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);align-items:center;justify-content:center;border-radius:7px;color:#fff;font-size:16px;vertical-align:middle;margin-right:7px;">&#9889;</span><span style="vertical-align:middle;color:#0f172a;">Wisdom IT News</span></h3>
                @if (status == TransactionStatus.Success)
                {
                    <div class="mb-3" style="font-size:52px;color:#16a34a;"><i class="fa fa-circle-check"></i></div>
                    <h5 class="mb-2">Thanh toán thành công!</h5>
                    <p class="text-muted mb-1">Bạn đã kích hoạt gói <strong>@(tx?.Plan?.Name ?? "Premium")</strong>.</p>
                    <p class="text-muted mb-4">Số tiền: @priceText đ • @tx?.PaymentMethodLabel</p>
                    <a href="/Subscription/MySubscription" class="btn text-white" style="background:#0e7d85;"><i class="fa fa-crown"></i> Xem gói của tôi</a>
                    <div class="mt-2"><a href="/" class="small text-muted">Về trang chủ</a></div>
                }
                else if (status == TransactionStatus.Pending)
                {
                    <div class="mb-3" style="font-size:52px;color:#ca8a04;"><i class="fa fa-clock"></i></div>
                    <h5 class="mb-2">Đang chờ xác nhận</h5>
                    <p class="text-muted mb-4">Giao dịch chưa được xác nhận. Vui lòng mở email và bấm "Xác nhận thanh toán".</p>
                    <a href="/Subscription/Processing?transactionId=@tx?.Id" class="btn text-white" style="background:#0e7d85;">Tiếp tục chờ</a>
                }
                else
                {
                    <div class="mb-3" style="font-size:52px;color:#dc2626;"><i class="fa fa-circle-xmark"></i></div>
                    <h5 class="mb-2">Giao dịch không thành công</h5>
                    <p class="text-muted mb-4">Giao dịch đã bị hủy hoặc hết hạn xác nhận. Bạn có thể thử lại.</p>
                    <a href="/Subscription/Checkout?planId=@tx?.PlanId" class="btn text-white" style="background:#0e7d85;"><i class="fa fa-rotate-right"></i> Thử lại</a>
                    <div class="mt-2"><a href="/Subscription/Pricing" class="small text-muted">Về bảng giá</a></div>
                }
            </div>
        </div>
    </div>
</body>
</html>
