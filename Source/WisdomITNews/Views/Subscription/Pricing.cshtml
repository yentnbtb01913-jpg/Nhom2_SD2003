@using WisdomITNews.Models
@{
    Layout = null;
    var plan = ViewBag.Plan as SubscriptionPlan;
    bool loggedIn = (bool)(ViewBag.LoggedIn ?? false);
    bool showTrial = (bool)(ViewBag.ShowTrial ?? false);
    bool hasActive = (bool)(ViewBag.HasActivePremium ?? false);
    string loginUrl = Url.Action("Login", "Account", new { returnUrl = Url.Action("Pricing", "Subscription") }) ?? "/Account/Login";
    string priceText = plan != null ? string.Format("{0:#,##0}", plan.Price) : "0";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bảng giá Premium — Wisdom IT News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { background:#f6f8fa; }
        .pricing-wrap { max-width: 900px; }
        .plan-card { border:1px solid #e5e7eb; border-radius:16px; background:#fff; transition:transform .15s, box-shadow .15s; }
        .plan-card:hover { transform:translateY(-4px); box-shadow:0 12px 30px rgba(0,0,0,.08); }
        .plan-card.premium { border:2px solid #0e7d85; box-shadow:0 10px 28px rgba(14,125,133,.15); }
        .plan-price { font-size:2.2rem; font-weight:800; color:#111827; }
        .feature-li { padding:6px 0; color:#374151; }
        .feature-li i { color:#0e7d85; margin-right:8px; }
        .badge-pop { background:#0e7d85; color:#fff; border-radius:999px; padding:4px 14px; font-size:.8rem; font-weight:700; }
        .btn-premium { background:#0e7d85; border:none; }
        .btn-premium:hover { background:#0b666d; }
    </style>
</head>
<body>
    <nav class="py-3 px-4 bg-white border-bottom">
        <div class="pricing-wrap mx-auto d-flex align-items-center justify-content-between">
            <a href="/" class="text-decoration-none fw-bold" style="color:#0e7d85;font-size:1.2rem;"><span style="display:inline-flex;width:30px;height:30px;background:linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);align-items:center;justify-content:center;border-radius:7px;color:#fff;font-size:16px;vertical-align:middle;margin-right:7px;">&#9889;</span><span style="vertical-align:middle;color:#0f172a;">Wisdom IT News</span></a>
            <a href="/" class="btn btn-sm btn-outline-secondary"><i class="fa fa-arrow-left"></i> Trang chủ</a>
        </div>
    </nav>

    <div class="container pricing-wrap py-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Nâng cấp trải nghiệm đọc báo</h2>
            <p class="text-muted">Chọn gói phù hợp với bạn. Hủy bất cứ lúc nào.</p>
        </div>

        @if (TempData["SubSuccess"] != null)
        { <div class="alert alert-success"><i class="fa fa-circle-check"></i> @TempData["SubSuccess"]</div> }
        @if (TempData["SubError"] != null)
        { <div class="alert alert-danger"><i class="fa fa-circle-exclamation"></i> @TempData["SubError"]</div> }

        <div class="row g-4 justify-content-center">
            <!-- FREE (tĩnh) -->
            <div class="col-md-6">
                <div class="plan-card h-100 p-4 d-flex flex-column">
                    <h4 class="fw-bold mb-1">Free</h4>
                    <p class="text-muted small mb-3">Dành cho độc giả phổ thông</p>
                    <div class="plan-price mb-1">0đ</div>
                    <div class="text-muted small mb-3">Miễn phí trọn đời</div>
                    <ul class="list-unstyled mb-4">
                        <li class="feature-li"><i class="fa fa-check"></i> Đọc tin tức không giới hạn</li>
                        <li class="feature-li"><i class="fa fa-check"></i> Bình luận &amp; lưu bài viết</li>
                        <li class="feature-li"><i class="fa fa-check"></i> Theo dõi chuyên mục yêu thích</li>
                        <li class="feature-li"><i class="fa fa-check"></i> Xem video &amp; podcast công khai</li>
                        <li class="feature-li text-muted"><i class="fa fa-xmark text-muted"></i> Không đọc được bài Premium</li>
                    </ul>
                    <div class="mt-auto">
                        <button class="btn btn-outline-secondary w-100" disabled>Gói hiện tại của bạn</button>
                    </div>
                </div>
            </div>

            <!-- PREMIUM (động) -->
            <div class="col-md-6">
                <div class="plan-card premium h-100 p-4 d-flex flex-column position-relative">
                    <span class="badge-pop position-absolute" style="top:-12px;right:20px;">Phổ biến</span>
                    @if (plan == null)
                    {
                        <h4 class="fw-bold mb-1">Premium</h4>
                        <p class="text-muted">Hiện chưa có gói Premium nào được kích hoạt. Vui lòng quay lại sau.</p>
                    }
                    else
                    {
                        <h4 class="fw-bold mb-1">@plan.Name</h4>
                        <p class="text-muted small mb-3">@(plan.Description ?? "Trải nghiệm đọc báo cao cấp")</p>
                        <div class="plan-price mb-1">@priceText<span style="font-size:1rem;font-weight:600;color:#6b7280;">đ</span></div>
                        <div class="text-muted small mb-3">cho @plan.DurationDays ngày</div>
                        <ul class="list-unstyled mb-4">
                            @if (plan.Features != null && plan.Features.Any())
                            {
                                @foreach (var f in plan.Features.OrderBy(x => x.SortOrder))
                                {
                                    <li class="feature-li"><i class="fa fa-check"></i> @f.FeatureText</li>
                                }
                            }
                            else
                            {
                                <li class="feature-li"><i class="fa fa-check"></i> Đọc toàn bộ bài viết Premium</li>
                            }
                        </ul>

                        <div class="mt-auto d-grid gap-2">
                            @if (hasActive)
                            {
                                <div class="alert alert-success mb-0 text-center py-2"><i class="fa fa-crown"></i> Bạn đang là thành viên Premium</div>
                            }
                            else if (!loggedIn)
                            {
                                <a href="@loginUrl" class="btn btn-premium text-white"><i class="fa fa-arrow-right-to-bracket"></i> Đăng nhập để nâng cấp</a>
                                @if (plan.TrialDays > 0)
                                {
                                    <a href="@loginUrl" class="btn btn-outline-secondary">Dùng thử miễn phí @plan.TrialDays ngày</a>
                                }
                            }
                            else
                            {
                                <a href="/Subscription/Checkout?planId=@plan.Id" class="btn btn-premium text-white"><i class="fa fa-crown"></i> Nâng cấp ngay</a>
                                @if (showTrial)
                                {
                                    <form method="post" action="/Subscription/StartTrial" class="d-grid">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary"><i class="fa fa-gift"></i> Dùng thử miễn phí @plan.TrialDays ngày</button>
                                    </form>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <p class="text-center text-muted small mt-4">Thanh toán mô phỏng phục vụ demo học tập. Bản dùng thử kích hoạt qua email, không cần thẻ.</p>
    </div>
</body>
</html>
