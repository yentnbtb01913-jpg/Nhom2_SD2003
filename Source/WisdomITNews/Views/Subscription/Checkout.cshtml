@using WisdomITNews.Models
@{
    Layout = null;
    var plan = ViewBag.Plan as SubscriptionPlan;
    string priceText = plan != null ? string.Format("{0:#,##0}", plan.Price) : "0";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thanh toán — Wisdom IT News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body{background:#f6f8fa;} .wrap{max-width:640px;}
        .box{border:1px solid #e5e7eb;border-radius:14px;background:#fff;}
        .pm{border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;cursor:pointer;}
        .pm input{margin-right:8px;}
    </style>
</head>
<body>
    <nav class="py-3 px-4 bg-white border-bottom">
        <div class="wrap mx-auto d-flex align-items-center justify-content-between">
            <a href="/" class="text-decoration-none fw-bold" style="color:#0e7d85;font-size:1.15rem;"><span style="display:inline-flex;width:30px;height:30px;background:linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);align-items:center;justify-content:center;border-radius:7px;color:#fff;font-size:16px;vertical-align:middle;margin-right:7px;">&#9889;</span><span style="vertical-align:middle;color:#0f172a;">Wisdom IT News</span></a>
            <a href="/Subscription/Pricing" class="btn btn-sm btn-outline-secondary"><i class="fa fa-arrow-left"></i> Bảng giá</a>
        </div>
    </nav>
    <div class="container wrap py-5">
        <h3 class="fw-bold mb-4"><i class="fa fa-credit-card text-success"></i> Thanh toán</h3>
        @if (plan == null)
        {
            <div class="alert alert-danger">Gói không tồn tại.</div>
        }
        else
        {
            <div class="box p-4 mb-3">
                <div class="d-flex justify-content-between mb-2"><span class="text-muted">Gói</span><strong>@plan.Name</strong></div>
                <div class="d-flex justify-content-between mb-2"><span class="text-muted">Thời hạn</span><span>@plan.DurationDays ngày</span></div>
                <hr/>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Tổng cộng</span>
                    <span class="fw-bold" style="font-size:1.5rem;color:#0e7d85;">@priceText đ</span>
                </div>
            </div>

            <form method="post" action="/Subscription/Checkout" id="payForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="planId" value="@plan.Id" />
                <div class="box p-4 mb-3">
                    <div class="fw-semibold mb-3">Phương thức thanh toán</div>
                    <div class="d-flex gap-2 mb-2">
                        <label class="pm flex-fill"><input type="radio" name="method" value="vnpay" checked> VNPay <span class="text-muted small">(giả lập)</span></label>
                        <label class="pm flex-fill"><input type="radio" name="method" value="momo"> Momo <span class="text-muted small">(giả lập)</span></label>
                    </div>
                    <div class="mt-3">
                        <label class="form-label small text-muted">Mã giảm giá (nếu có)</label>
                        <input type="text" name="coupon" class="form-control" placeholder="Nhập mã giảm giá..." />
                        <div class="form-text">Chức năng mã giảm giá sẽ được bổ sung sau.</div>
                    </div>
                </div>
                <button type="submit" id="payBtn" class="btn btn-lg w-100 text-white" style="background:#0e7d85;">
                    <i class="fa fa-lock"></i> Thanh toán @priceText đ
                </button>
            </form>
            <p class="text-muted small mt-3 text-center">Đây là thanh toán <strong>mô phỏng</strong>. Sau khi bấm, bạn sẽ nhận email để xác nhận và kích hoạt gói.</p>
        }
    </div>
    <script>
        document.getElementById('payForm')?.addEventListener('submit', function(){
            var b=document.getElementById('payBtn');
            b.disabled=true; b.innerHTML='<i class="fa fa-spinner fa-spin"></i> Đang xử lý...';
        });
    </script>
</body>
</html>
