@{
    ViewData["Title"] = "Liên hệ quảng cáo";
}
<div class="container" style="max-width:1000px;margin:0 auto;padding:28px 16px 60px;">
    <h1 style="text-align:center;color:#0e7d85;font-weight:800;font-size:34px;margin-bottom:6px;">Bảng giá Quảng cáo</h1>
    <p style="text-align:center;color:#6b7280;margin-bottom:34px;">Đăng ký quảng cáo trên Báo Online WisdomITNews</p>

    <div style="max-width:460px;margin:0 auto;">
        <div class="wi-adc-card" style="border:1px solid #e5e7eb;border-radius:14px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.06);">
            <div style="background:linear-gradient(135deg,#0e7d85,#14b8a6);height:200px;display:flex;align-items:center;justify-content:center;">
                <i class="fa fa-laptop" style="font-size:76px;color:#fff;opacity:.92;"></i>
            </div>
            <div style="padding:22px 24px;text-align:center;">
                <h2 style="font-weight:800;font-size:22px;margin-bottom:8px;color:#1f2937;">Báo Online</h2>
                <p style="color:#6b7280;font-size:14px;line-height:1.7;margin-bottom:18px;">
                    Đặt banner, hộp quảng cáo tại các vị trí nổi bật: đầu trang, sidebar, trong bài viết.
                    Tiếp cận độc giả công nghệ mỗi ngày.
                </p>
                <a href="/lien-he-quang-cao/bang-gia" style="display:inline-block;background:#0e7d85;color:#fff;font-weight:700;padding:12px 30px;border-radius:8px;text-decoration:none;">
                    <i class="fa fa-tags"></i> Xem bảng giá &amp; đăng ký
                </a>
            </div>
        </div>
        <p style="text-align:center;color:#94a3b8;font-size:12.5px;margin-top:14px;">
            Cần đăng nhập để đăng ký. Sau khi xác nhận thông tin, hệ thống gửi email hướng dẫn thanh toán (demo).
        </p>
    </div>
</div>
