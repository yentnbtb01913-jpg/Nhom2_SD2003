@model WisdomITNews.Models.AdBooking
@{
    ViewData["Title"] = "Đăng ký quảng cáo thành công";
    var emailConfigured = ViewBag.EmailConfigured as bool? ?? false;
}
<div class="container" style="max-width:560px;margin:0 auto;padding:44px 16px 60px;text-align:center;">
    <div style="width:72px;height:72px;border-radius:50%;background:#e6f4f5;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
        <i class="fa fa-check" style="color:#0e7d85;font-size:34px;"></i>
    </div>
    <h1 style="color:#0e7d85;font-weight:800;font-size:24px;margin-bottom:8px;">Đăng ký thành công!</h1>
    <p style="color:#374151;font-size:15px;margin-bottom:6px;">
        Mã số hóa đơn của bạn: <b style="color:#dc2626;">@Model.InvoiceNumber</b>
    </p>
    <p style="color:#6b7280;font-size:14px;margin-bottom:26px;">
        @if (emailConfigured)
        {
            <text>Chúng tôi đã gửi email xác nhận kèm đầy đủ thông tin và hướng dẫn liên hệ thanh toán tới <b>@Model.Email</b> (kiểm tra cả mục Spam), đồng thời gửi một thông báo vào hộp thư của bạn.</text>
        }
        else
        {
            <text>Đơn đã được ghi nhận và một thông báo đã được gửi vào hộp thư của bạn. Chúng tôi sẽ liên hệ để trao đổi về việc thanh toán.</text>
        }
    </p>
    <div style="display:flex;gap:10px;justify-content:center;">
        <a href="/Account/Inbox" style="display:inline-block;background:#0e7d85;color:#fff;font-weight:700;padding:11px 28px;border-radius:8px;text-decoration:none;">Xem hộp thư</a>
        <a href="/" style="display:inline-block;background:#e2e8f0;color:#334155;font-weight:700;padding:11px 28px;border-radius:8px;text-decoration:none;">Về trang chủ</a>
    </div>
</div>
