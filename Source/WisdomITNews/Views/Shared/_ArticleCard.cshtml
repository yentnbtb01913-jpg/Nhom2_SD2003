@using WisdomITNews.Models
@using WisdomITNews.Services
@model Article
@{
    // Lấy 2 dòng tóm tắt đầu (cắt khoảng 160 ký tự để hiển thị popup gọn)
    var previewText = Model.Summary ?? "";
    if (previewText.Length > 180) previewText = previewText.Substring(0, 180).TrimEnd() + "…";

    var thumb = string.IsNullOrWhiteSpace(Model.Thumbnail)
        ? "/images/placeholder.jpg"
        : Model.Thumbnail;
    var altText = string.IsNullOrWhiteSpace(Model.ThumbnailAlt) ? Model.Title : Model.ThumbnailAlt;
}
<article class="article-card js-hover-card"
         data-href="/bai-viet/@Model.Slug"
         data-preview-thumb="@thumb"
         data-preview-title="@Model.Title"
         data-preview-summary="@previewText"
         onclick="location.href='/bai-viet/@Model.Slug'">
    <div class="card-thumb">
        <img src="@thumb" alt="@altText" loading="lazy"/>
    </div>
    <div class="card-body">
        <span class="card-category">@Model.Category?.Icon @Model.Category?.Name</span>
        <h3 class="card-title">@Model.Title</h3>
        <p class="card-excerpt">@Model.Summary</p>
        <div class="card-meta">
            <span><i class="fa fa-clock"></i> @SlugHelper.FormatDate(Model.PublishedAt)</span>
            <span><i class="fa fa-eye"></i> @SlugHelper.FormatViews(Model.Views)</span>
        </div>
    </div>
</article>
