@using WisdomITNews.Models
@{
    // basePath: "/admin" hoặc "/nhan-vien" — được set từ view bọc ngoài (chỉ khác route/layout, logic dùng chung)
    var basePath = ViewBag.BasePath as string ?? "/admin";
    var ranking = ViewBag.Ranking as List<Article> ?? new List<Article>();
    var hidden = ViewBag.Hidden as List<Article> ?? new List<Article>();
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;flex-wrap:wrap;gap:10px;">
    <h1 style="font-size:22px;font-weight:700;">🏆 Tin Nổi Bật Tự Động</h1>
</div>
<p style="color:#64748b;font-size:13px;margin-bottom:20px;max-width:820px;">
    Khu vực lớn trên Trang chủ (1 bài chính + 3 bài phụ) được hệ thống <b>tự động chọn và sắp xếp</b> theo:
    Ghim thủ công &gt; Lượt xem &gt; Ngày xuất bản &gt; Ngày cập nhật — tính lại mỗi lần tải trang, không cần kéo thả.
    Bạn chỉ cần theo dõi và có thể <b>Ghim</b> (giữ 1 bài luôn ở đầu) hoặc <b>Loại</b> (đưa 1 bài ra khỏi khu nổi bật, bài vẫn giữ nguyên) khi cần.
</p>

<form id="featToken">@Html.AntiForgeryToken()</form>

<div style="background:#fff;padding:20px;margin-bottom:24px;box-shadow:0 2px 8px rgba(0,0,0,.07);border-radius:8px;">
    <h2 style="font-size:16px;font-weight:600;margin-bottom:16px;">Bảng xếp hạng hiện tại (Top @ranking.Count)</h2>
    @if (!ranking.Any())
    {
        <div style="padding:30px;text-align:center;color:#6c757d;">Chưa có bài nào đủ điều kiện tham gia khu nổi bật (cần: đã đăng, có ảnh, có danh mục, có lượt xem &gt; 0, có nguồn/tác giả).</div>
    }
    else
    {
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead style="background:#f8fafc;color:#6c757d;text-align:left;">
                <tr>
                    <th style="padding:10px;width:70px;">Hạng</th>
                    <th style="padding:10px;">Tiêu đề</th>
                    <th style="padding:10px;">Danh mục</th>
                    <th style="padding:10px;">Lượt xem</th>
                    <th style="padding:10px;">Ngày đăng</th>
                    <th style="padding:10px;text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < ranking.Count; i++)
                {
                    var a = ranking[i];
                    var rank = i + 1;
                    <tr style="border-bottom:1px solid #e5e7eb;@(rank <= 4 ? "background:#f0fdfa;" : "")">
                        <td style="padding:10px;">
                            @if (rank == 1)
                            {
                                <span style="background:#0e7d85;color:#fff;padding:3px 9px;border-radius:4px;font-size:11px;font-weight:800;">#1 · CHÍNH</span>
                            }
                            else if (rank <= 4)
                            {
                                <span style="background:#99f6e4;color:#0e7d85;padding:3px 9px;border-radius:4px;font-size:11px;font-weight:700;">#@rank · Phụ</span>
                            }
                            else
                            {
                                <span style="color:#94a3b8;font-weight:600;">#@rank</span>
                            }
                            @if (a.FeaturedPinned)
                            {
                                <div style="margin-top:4px;"><i class="fa fa-thumbtack" style="color:#7c3aed;font-size:11px;"></i> <span style="font-size:11px;color:#7c3aed;font-weight:600;">Đã ghim</span></div>
                            }
                        </td>
                        <td style="padding:10px;font-weight:600;max-width:340px;">@a.Title</td>
                        <td style="padding:10px;color:#6c757d;">@(a.Category?.Name ?? "—")</td>
                        <td style="padding:10px;font-weight:600;">@a.Views.ToString("N0")</td>
                        <td style="padding:10px;color:#6c757d;">@(a.PublishedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td style="padding:10px;text-align:right;white-space:nowrap;">
                            @if (a.FeaturedPinned)
                            {
                                <button type="button" onclick="unpinFeatured(@a.Id)" title="Bỏ ghim"
                                        style="padding:6px 12px;background:#7c3aed;color:#fff;border:none;font-size:11px;font-weight:600;cursor:pointer;border-radius:4px;margin-right:4px;">
                                    <i class="fa fa-thumbtack"></i> Bỏ ghim
                                </button>
                            }
                            else
                            {
                                <button type="button" onclick="pinFeatured(@a.Id)" title="Ghim bài này luôn ở đầu khu nổi bật"
                                        style="padding:6px 12px;background:#f5f3ff;color:#7c3aed;border:1px solid #ddd6fe;font-size:11px;font-weight:600;cursor:pointer;border-radius:4px;margin-right:4px;">
                                    <i class="fa fa-thumbtack"></i> Ghim
                                </button>
                            }
                            <button type="button" onclick="hideFeatured(@a.Id)" title="Loại khỏi khu nổi bật (không xóa bài)"
                                    style="padding:6px 12px;background:#fee2e2;color:#991b1b;border:1px solid #fecaca;font-size:11px;font-weight:600;cursor:pointer;border-radius:4px;">
                                <i class="fa fa-eye-slash"></i> Loại
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div style="background:#fff;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);border-radius:8px;">
    <h2 style="font-size:16px;font-weight:600;margin-bottom:16px;"><i class="fa fa-eye-slash" style="color:#991b1b;"></i> Bài đã loại khỏi khu nổi bật</h2>
    @if (!hidden.Any())
    {
        <div style="padding:20px;text-align:center;color:#6c757d;">Chưa có bài nào bị loại.</div>
    }
    else
    {
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead style="background:#f8fafc;color:#6c757d;text-align:left;">
                <tr>
                    <th style="padding:10px;">Tiêu đề</th>
                    <th style="padding:10px;">Danh mục</th>
                    <th style="padding:10px;">Lượt xem</th>
                    <th style="padding:10px;">Ngày đăng</th>
                    <th style="padding:10px;text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in hidden)
                {
                    <tr style="border-bottom:1px solid #e5e7eb;">
                        <td style="padding:10px;font-weight:600;max-width:340px;">@a.Title</td>
                        <td style="padding:10px;color:#6c757d;">@(a.Category?.Name ?? "—")</td>
                        <td style="padding:10px;font-weight:600;">@a.Views.ToString("N0")</td>
                        <td style="padding:10px;color:#6c757d;">@(a.PublishedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td style="padding:10px;text-align:right;">
                            <button type="button" onclick="unhideFeatured(@a.Id)" title="Đưa lại vào khu nổi bật"
                                    style="padding:6px 12px;background:#0e7d85;color:#fff;border:none;font-size:11px;font-weight:600;cursor:pointer;border-radius:4px;">
                                <i class="fa fa-rotate-left"></i> Đưa lại
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<script>
    var FEAT_BASE = '@basePath';
    function featToken() { return document.querySelector('#featToken input[name="__RequestVerificationToken"]').value; }

    async function callFeaturedAction(url, id, okMsg) {
        try {
            var res = await fetch(FEAT_BASE + url + '/' + id, { method: 'POST', headers: { 'RequestVerificationToken': featToken() } });
            var d = await res.json();
            if (d.success) {
                if (window.Swal) Swal.fire({ toast: true, position: 'top-end', timer: 1800, showConfirmButton: false, icon: 'success', title: d.message || okMsg });
                location.reload();
            } else {
                Swal.fire('Lỗi', d.message || 'Không thực hiện được', 'error');
            }
        } catch (e) { Swal.fire('Lỗi', 'Lỗi kết nối', 'error'); }
    }

    function pinFeatured(id) { callFeaturedAction('/PinFeatured', id, 'Đã ghim'); }
    function unpinFeatured(id) { callFeaturedAction('/UnpinFeatured', id, 'Đã bỏ ghim'); }
    function hideFeatured(id) { callFeaturedAction('/HideFeatured', id, 'Đã loại'); }
    function unhideFeatured(id) { callFeaturedAction('/UnhideFeatured', id, 'Đã đưa lại'); }
</script>
