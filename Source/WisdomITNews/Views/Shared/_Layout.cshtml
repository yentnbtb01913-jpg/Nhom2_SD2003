      (s.mutualFriends > 0 ? ' · <i class="fa fa-users" style="font-size:9px;"></i> ' + s.mutualFriends + ' bạn chung' : '') + '</div></div>' +
      '<div style="display:flex;gap:6px;">' +
      '<button onclick="chatUI.sendFriendReq(' + s.id + ')" style="background:#476083;color:#fff;border:none;padding:6px 10px;border-radius:0px;font-size:11px;cursor:pointer;font-weight:600;" title="Kết bạn"><i class="fa fa-user-plus"></i></button>' +
      '<button onclick="chatUI.followUser(' + s.id + ')" style="background:none;border:1px solid #d1d5db;padding:6px 10px;border-radius:0px;font-size:11px;cursor:pointer;color:#6c757d;" title="Theo dõi"><i class="fa fa-rss"></i></button>' +
      '<button onclick="chatUI.startDm(\'user\',' + s.id + ');document.getElementById(\'friendSugModal\').style.display=\'none\'" style="background:none;border:1px solid #d1d5db;padding:6px 10px;border-radius:0px;font-size:11px;cursor:pointer;color:#6c757d;" title="Nhắn tin"><i class="fa fa-comment"></i></button>' +
      '</div></div>'
    ).join('');
  },

  async sendFriendReq(userId) {
    const res = await fetch('/api/friends/request/' + userId, { method: 'POST' });
    const data = await res.json();
    const el = document.getElementById('fsug-' + userId);
    if (el) {
      const btn = el.querySelector('button');
      if (data.success) {
        btn.innerHTML = '<i class="fa fa-check"></i> Đã gửi';
        btn.style.background = '#16a34a';
        btn.disabled = true;
      } else {
        btn.innerHTML = data.message || 'Lỗi';
        btn.style.background = '#e5e7eb';
        btn.style.color = '#6c757d';
      }
    }
  },

  async followUser(userId) {
    const res = await fetch('/api/friends/follow/' + userId, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      const el = document.getElementById('fsug-' + userId);
      if (el) {
        const btns = el.querySelectorAll('button');
        if (btns[1]) { btns[1].innerHTML = '<i class="fa fa-check"></i> Đã theo dõi'; btns[1].style.color = '#16a34a'; btns[1].style.borderColor = '#16a34a'; btns[1].disabled = true; }
      }
    }
  },

  onFriendEvent(data) {
    if (!this.currentUser) return;
    if (data.toId == this.currentUser.id) {
      if (data.type === 'friend_request') {
        this.loadFriendReqCount();
      } else if (data.type === 'friend_accepted') {
        this.loadOnlineBar();
      }
    }
  },

  // Helpers
  escHtml(s) { if(!s)return''; const d=document.createElement('div'); d.textContent=s; return d.innerHTML.replace(/'/g,"&#39;"); },
  formatTime(t) { const d=new Date(t); return d.getHours().toString().padStart(2,'0')+':'+d.getMinutes().toString().padStart(2,'0'); },
  timeAgo(t) {
    const diff = (Date.now() - new Date(t).getTime()) / 1000;
    if (diff < 60) return 'vừa xong';
    if (diff < 3600) return Math.floor(diff/60) + ' phút';
    if (diff < 86400) return Math.floor(diff/3600) + ' giờ';
    return Math.floor(diff/86400) + ' ngày';
  }
};

