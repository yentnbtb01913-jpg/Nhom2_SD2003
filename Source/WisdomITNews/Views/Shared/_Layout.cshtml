        <!-- Feedback Widget -->
        <div id="feedbackWidget" style="position:fixed;bottom:24px;right:24px;z-index:8000;">
            <button id="feedbackToggle" title="Báo lỗi / Góp ý"
                    style="width:48px;height:48px;border-radius:50%;background:#ba1a1a;color:#fff;border:none;font-size:20px;cursor:pointer;box-shadow:0 4px 16px rgba(230,57,70,.4);">
                &#128172;
            </button>
            <div id="feedbackPanel" style="display:none;position:absolute;bottom:60px;right:0;background:#fff;border-radius:0px;padding:20px;width:300px;box-shadow:0 8px 32px rgba(0,0,0,.15);">
                <h4 style="margin:0 0 12px;font-size:15px;">Báo lỗi / Góp ý</h4>
                <select id="fbType" style="width:100%;padding:8px;border:1px solid #e0e4e8;border-radius:0px;font-size:13px;margin-bottom:10px;">
                    <option value="bug">Báo lỗi</option>
                    <option value="content">Nội dung sai</option>
                    <option value="suggestion">Góp ý cải thiện</option>
                    <option value="other">Khác</option>
                </select>
                <textarea id="fbDesc" placeholder="Mô tả vấn đề..." rows="3"
                          style="width:100%;padding:8px;border:1px solid #e0e4e8;border-radius:0px;font-size:13px;resize:vertical;font-family:inherit;margin-bottom:10px;"></textarea>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <button onclick="submitFeedback()"
                            style="background:#ba1a1a;color:#fff;border:none;padding:8px 18px;border-radius:0px;font-size:13px;font-weight:600;cursor:pointer;">
                        Gửi
                    </button>
                    <span id="fbMsg" style="font-size:12px;"></span>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('feedbackToggle').addEventListener('click', function () {
            const panel = document.getElementById('feedbackPanel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
            });

            async function submitFeedback() {
            const type = document.getElementById('fbType').value;
            const desc = document.getElementById('fbDesc').value.trim();
            const msg = document.getElementById('fbMsg');
            if (!desc) { msg.innerHTML = '<span style="color:#ba1a1a">Vui lòng nhập mô tả!</span>'; return; }
            try {
            const res = await fetch('/gop-y', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type, description: desc })
            });
            const data = await res.json();
            if (data.success) {
            msg.innerHTML = '<span style="color:#16a34a">Cảm ơn bạn!</span>';
            document.getElementById('fbDesc').value = '';
            setTimeout(() => { document.getElementById('feedbackPanel').style.display = 'none'; msg.textContent = ''; }, 2000);
            } else {
            msg.innerHTML = '<span style="color:#ba1a1a">' + (data.message || 'Lỗi') + '</span>';
            }
            } catch { msg.innerHTML = '<span style="color:#ba1a1a">Lỗi kết nối</span>'; }
            }

            // Account dropdown toggle
            document.addEventListener('click', function (e) {
            const toggle = e.target.closest('#accountToggle');
            const dropdown = document.getElementById('accountDropdown');
            if (!dropdown) return;
            if (toggle) {
            e.preventDefault();
            e.stopPropagation();
            dropdown.classList.toggle('show');
            } else if (!e.target.closest('.header-dropdown-menu')) {
            dropdown.classList.remove('show');
            }
            });

            // Region switcher dropdown
            document.addEventListener('click', function (e) {
            var toggle = e.target.closest('#regionToggle');
            var dropdown = document.getElementById('regionDropdown');
            if (!dropdown) return;
            if (toggle) {
            e.preventDefault();
            e.stopPropagation();
            dropdown.classList.toggle('show');
            // Đóng account dropdown nếu đang mở
            var accDd = document.getElementById('accountDropdown');
            if (accDd) accDd.classList.remove('show');
            } else if (!e.target.closest('.region-dropdown')) {
            dropdown.classList.remove('show');
            }
            });

            // Đổi ảnh đại diện từ dropdown menu
            var ddChangeBtn = document.getElementById('ddChangeAvatar');
            var ddFileInput = document.getElementById('ddAvatarInput');
            if (ddChangeBtn && ddFileInput) {
            ddChangeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            ddFileInput.click();
            });
            ddFileInput.addEventListener('change', async function () {
            const file = this.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) { Swal.fire('Ảnh quá lớn (tối đa 5MB)'); return; }
            const formData = new FormData();
            formData.append('avatarFile', file);
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenEl) formData.append('__RequestVerificationToken', tokenEl.value);
            try {
            const res = await fetch('/Account/UploadAvatar', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
            Swal.fire(data.message);
            location.reload();
            } else {
            Swal.fire(data.message || 'Lỗi upload');
            }
            } catch { Swal.fire('Lỗi kết nối'); }
            });
            }
        </script>
        <!-- Dark/Light Mode Toggle Script -->
        <script>
            (function () {
            var saved = localStorage.getItem('wisdomTheme') || 'light';
            if (saved === 'dark') applyDark();
            else applyLight();

            function applyDark() {
            document.documentElement.setAttribute('data-mode', 'dark');
            var icon = document.getElementById('themeIcon');
            if (icon) { icon.className = 'fa fa-moon'; }
            }
            function applyLight() {
            document.documentElement.removeAttribute('data-mode');
            var icon = document.getElementById('themeIcon');
            if (icon) { icon.className = 'fa fa-sun'; }
            }
            window.toggleDarkMode = function () {
            var isDark = document.documentElement.getAttribute('data-mode') === 'dark';
            if (isDark) { applyLight(); localStorage.setItem('wisdomTheme', 'light'); }
            else { applyDark(); localStorage.setItem('wisdomTheme', 'dark'); }
            };
            })();
        </script>
        <script>
            (function () {
            var inp = document.getElementById('navSearchInput'), box = document.getElementById('navSuggest');
            if (!inp || !box) return;
            function esc(x) { return (x || '').replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
            var t;

            function bindRowEvents() {
            box.querySelectorAll('.sg-del').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            var id = btn.getAttribute('data-id');
            fetch('/Home/DeleteSearchHistory?id=' + encodeURIComponent(id), { method: 'POST' }).then(function () {
            var row = btn.closest('.sg-kw-row');
            if (row) row.remove();
            if (!box.querySelector('.sg-kw-row')) loadEmptyState();
            });
            });
            });
            }

            function renderEmptyState(data) {
            var html = '<div class="sg-group"><div class="sg-group-head"><span>Lịch sử tìm kiếm</span></div>';
            if (!data.history || !data.history.length) {
            html += '<div class="sg-empty">Chưa có lịch sử tìm kiếm.</div>';
            } else {
            html += '<div class="sg-list sg-scroll">' + data.history.map(function (h) {
            return '<div class="sg-kw-row"><a class="sg-kw" href="/tim-kiem?q=' + encodeURIComponent(h.keyword) + '"><i class="fa fa-clock"></i>' + esc(h.keyword) + '</a><button type="button" class="sg-del" data-id="' + h.id + '" title="Xóa từ khóa này" aria-label="Xóa từ khóa này">&times;</button></div>';
            }).join('') + '</div>';
            }
            html += '</div>';
            if (data.popular && data.popular.length) {
            html += '<div class="sg-group"><div class="sg-group-head"><span>Từ khóa được tìm kiếm nhiều</span></div><div class="sg-chips">' +
            data.popular.map(function (k) { return '<a class="sg-chip" href="/tim-kiem?q=' + encodeURIComponent(k) + '">' + esc(k) + '</a>'; }).join('') + '</div></div>';
            }
            box.innerHTML = html;
            box.style.display = 'block';
            bindRowEvents();
            }

            function renderSuggestState(data) {
            var hasAny = (data.keywords && data.keywords.length) || (data.categories && data.categories.length) || (data.articles && data.articles.length);
            if (!hasAny) { box.innerHTML = '<div class="sg-empty">Không tìm thấy kết quả phù hợp.</div>'; box.style.display = 'block'; return; }
            var html = '';
            if (data.keywords && data.keywords.length) {
            html += '<div class="sg-group"><div class="sg-group-head"><span>Từ khóa gợi ý</span></div><div class="sg-chips">' +
            data.keywords.map(function (k) { return '<a class="sg-chip" href="/tim-kiem?q=' + encodeURIComponent(k) + '">' + esc(k) + '</a>'; }).join('') + '</div></div>';
            }
            if (data.categories && data.categories.length) {
            html += '<div class="sg-group"><div class="sg-group-head"><span>Danh mục</span></div><div class="sg-list">' +
            data.categories.map(function (c) { return '<a class="sg-cat-item" href="/danh-muc/' + esc(c.slug) + '"><span class="sg-cat-icon">' + esc(c.icon || '📁') + '</span>' + esc(c.name) + '</a>'; }).join('') + '</div></div>';
            }
            if (data.articles && data.articles.length) {
            html += '<div class="sg-group"><div class="sg-group-head"><span>Bài viết</span></div><div class="sg-list sg-scroll">' +
            data.articles.map(function (a) {
            var img = a.thumbnail ? '<img src="' + esc(a.thumbnail) + '" alt="" />' : '<div class="ph"></div>';
            return '<a class="sg-item" href="/bai-viet/' + esc(a.slug) + '">' + img + '<div><div class="sg-t">' + esc(a.title) + '</div><div class="sg-c">' + esc(a.categoryName) + '</div></div></a>';
            }).join('') + '</div></div>';
            }
            box.innerHTML = html;
            box.style.display = 'block';
            }

            function loadEmptyState() {
            fetch('/Home/SearchPanel').then(function (r) { return r.json(); }).then(renderEmptyState).catch(function () { box.style.display = 'none'; });
            }

            function loadSuggestState(q) {
            fetch('/Home/SearchSuggest?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(renderSuggestState)
            .catch(function () { box.style.display = 'none'; });
            }

            inp.addEventListener('focus', function () {
            var q = inp.value.trim();
            if (q.length < 1) loadEmptyState(); else loadSuggestState(q);
            });

            inp.addEventListener('input', function () {
            clearTimeout(t);
            var q = inp.value.trim();
            if (q.length < 1) { loadEmptyState(); return; }
            t = setTimeout(function () { loadSuggestState(q); }, 200);
            });

            document.addEventListener('click', function (e) { if (!box.contains(e.target) && e.target !== inp) box.style.display = 'none'; });
            })();
        </script>
        <script>
            window.confirmSwal = function (msg, title) { return Swal.fire({ title: title || 'Xác nhận?', text: msg, icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', cancelButtonColor: '#6c757d', confirmButtonText: 'Đồng ý', cancelButtonText: 'Huỷ' }).then(function (r) { return r.isConfirmed; }); };
            window.swalToast = function (icon, msg) { if (window.Swal) Swal.fire({ toast: true, position: 'top-end', icon: icon, title: msg, showConfirmButton: false, timer: 3000, timerProgressBar: true }); };
        </script>
        @if (Context.Session.GetInt32("UserId") != null)
        {
            <script>
            const userNotifConnection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/notification")
                .withAutomaticReconnect()
                .build();

            userNotifConnection.on("ReceiveNotification", function(notif) {
                showUserNotifDot();
                loadUserNotifications();

                const toast = document.createElement('div');
                toast.innerHTML = `
                    <div style="position:fixed;bottom:20px;right:20px;
                        background:#fff;border-left:4px solid ${notif.iconColor || '#159aa3'};
                        border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,.15);
                        padding:12px 16px;z-index:99999;max-width:320px;
                        animation:slideIn .3s ease;">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <i class="fa fa-${notif.icon || 'bell'}"
                                style="color:${notif.iconColor || '#159aa3'};"></i>
                            <strong style="font-size:13px;">${notif.title}</strong>
                        </div>
                        <div style="font-size:12px;color:#6c757d;margin-top:4px;">
                            ${notif.content}
                        </div>
                    </div>`;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 4000);
            });

            userNotifConnection.start().catch(err => console.error(err));

            function showUserNotifDot() {
                var d = document.getElementById('user-notif-dot'); if (d) d.style.display = 'block';
                var b = document.getElementById('burger-notif-dot'); if (b) b.style.display = 'inline-block';
            }

            // Mở/đóng panel Thông báo (gọi từ mục ☰ > Thông báo)
            function openNotifPanel() {
                var p = document.getElementById('notifPanel'); if (!p) return;
                if (p.style.display === 'flex') { closeNotifPanel(); return; }
                p.style.display = 'flex';
                var bd = document.getElementById('notifBackdrop'); if (bd) bd.style.display = 'block';
                if (typeof loadUserNotifications === 'function') loadUserNotifications();
                document.querySelectorAll('details.bm-nav-burger[open]').forEach(function (d) { d.removeAttribute('open'); });
            }
            function closeNotifPanel() {
                var p = document.getElementById('notifPanel'); if (p) p.style.display = 'none';
                var bd = document.getElementById('notifBackdrop'); if (bd) bd.style.display = 'none';
            }
            window.openNotifPanel = openNotifPanel;
            window.closeNotifPanel = closeNotifPanel;

            function hideUserNotifDot() {
                var d = document.getElementById('user-notif-dot'); if (d) d.style.display = 'none';
                var b = document.getElementById('burger-notif-dot'); if (b) b.style.display = 'none';
            }

            async function checkUserUnread() {
                try {
                    const res = await fetch('/Account/GetUserUnreadCount');
                    const data = await res.json();
                    if (data.count > 0) showUserNotifDot();
                    else hideUserNotifDot();
                } catch(e) {}
            }

            let allUserNotifs = [];
            const NOTIF_DEFAULT_SHOW = 3;
            let notifShowAll = false;

            async function loadUserNotifications() {
                try {
                    const res = await fetch('/Account/GetUserNotifications');
                    allUserNotifs = await res.json();
                    renderUserNotifs();
                } catch(e) {}
            }

            function renderUserNotifs() {
                const container = document.getElementById('user-notif-list');
                if (!container) return;

                const displayList = notifShowAll 
                    ? allUserNotifs 
                    : allUserNotifs.slice(0, NOTIF_DEFAULT_SHOW);

                if (allUserNotifs.length === 0) {
                    container.innerHTML = `
                        <div style="padding:28px;text-align:center;color:#94a3b8;font-size:13px;">
                            <i class="fa fa-bell-slash" 
                                style="font-size:28px;margin-bottom:10px;display:block;"></i>
                            Không có thông báo nào
                        </div>`;
                    return;
                }

                let html = displayList.map(n => `
                    <div id="notif-item-${n.id}"
                        style="border-bottom:1px solid #f0f2f5;">

                        <div style="padding:10px 16px;display:flex;
                            align-items:center;gap:8px;
                            background:${n.isRead ? '#fff' : '#f0fafa'};"
                            id="notif-header-${n.id}">

                        <input type="checkbox" 
                            id="notif-check-${n.id}"
                            value="${n.id}"
                            onchange="onNotifCheckChange()"
                            onclick="event.stopPropagation()"
                            style="width:14px;height:14px;cursor:pointer;flex-shrink:0;accent-color:#159aa3;" />

                        <div onclick="toggleNotifItem(${n.id})"
                            style="width:30px;height:30px;border-radius:50%;flex-shrink:0;
                            background:${n.iconColor}20;display:flex;align-items:center;
                            justify-content:center;cursor:pointer;">
                            <i class="fa fa-${n.icon}" 
                                style="color:${n.iconColor};font-size:12px;"></i>
                        </div>

                        <div onclick="toggleNotifItem(${n.id})"
                            style="flex:1;min-width:0;cursor:pointer;">
                            <div id="notif-title-${n.id}"
                                style="font-weight:${n.isRead ? '500' : '700'};
                                font-size:13px;color:#1e293b;
                                white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                ${n.title}
                            </div>
                            <div style="font-size:11px;color:#94a3b8;margin-top:1px;">
                                ${n.createdAt}
                            </div>
                        </div>

                        <div id="notif-dot-${n.id}"
                            style="display:${n.isRead ? 'none' : 'block'};
                            width:8px;height:8px;background:#dc2626;
                            border-radius:50%;flex-shrink:0;">
                        </div>

                        <i id="notif-arrow-${n.id}"
                            onclick="toggleNotifItem(${n.id})"
                            class="fa fa-chevron-down"
                            style="font-size:10px;color:#94a3b8;
                            transition:transform .2s;flex-shrink:0;cursor:pointer;">
                        </i>

                        <button onclick="deleteSingleNotif(${n.id})"
                            title="Xóa thông báo này"
                            style="background:none;border:none;color:#cbd5e1;
                            cursor:pointer;padding:2px 4px;flex-shrink:0;
                            font-size:12px;transition:color .2s;"
                            onmouseover="this.style.color='#dc2626'"
                            onmouseout="this.style.color='#cbd5e1'">
                            <i class="fa fa-xmark"></i>
                        </button>
                    </div>

                    <div id="notif-body-${n.id}"
                        style="display:none;padding:8px 16px 12px 68px;
                        background:#f8fafc;border-top:1px solid #f0f2f5;">
                        <p style="font-size:13px;color:#374151;
                            margin:0 0 6px;line-height:1.6;">
                            ${n.content}
                        </p>
                        ${n.violationContent ? `
                            <div style="padding:7px 10px;background:#fef3c7;
                                border-left:3px solid #f59e0b;border-radius:4px;
                                font-size:12px;color:#92400e;margin-top:6px;">
                                <i class="fa fa-triangle-exclamation" 
                                    style="margin-right:4px;"></i>
                                <strong>Nội dung vi phạm:</strong> ${n.violationContent}
                            </div>` : ''}
                        ${n.violationReason ? `
                            <div style="padding:7px 10px;background:#fee2e2;
                                border-left:3px solid #dc2626;border-radius:4px;
                                font-size:12px;color:#991b1b;margin-top:6px;">
                                <i class="fa fa-ban" style="margin-right:4px;"></i>
                                <strong>Lý do từ chối:</strong> ${n.violationReason}
                            </div>` : ''}
                    </div>
                </div>
            `).join('');

                if (allUserNotifs.length > NOTIF_DEFAULT_SHOW) {
                    const remaining = allUserNotifs.length - NOTIF_DEFAULT_SHOW;
                    html += notifShowAll
                        ? `<div onclick="toggleShowAllNotifs()"
                            style="padding:10px;text-align:center;cursor:pointer;
                            font-size:12px;color:#94a3b8;background:#f8fafc;
                            border-top:1px solid #f0f2f5;">
                            <i class="fa fa-chevron-up"></i> Thu gọn
                           </div>`
                        : `<div onclick="toggleShowAllNotifs()"
                            style="padding:10px;text-align:center;cursor:pointer;
                            font-size:12px;color:#159aa3;font-weight:600;
                            background:#f8fafc;border-top:1px solid #f0f2f5;">
                            <i class="fa fa-chevron-down"></i> Xem thêm ${remaining} thông báo
                           </div>`;
                }

                container.innerHTML = html;
            }

            function toggleShowAllNotifs() {
                notifShowAll = !notifShowAll;
                renderUserNotifs();
            }

            async function deleteSingleNotif(id) {
                const item = document.getElementById(`notif-item-${id}`);
                if (!item) return;

                item.style.transition = 'opacity .2s, max-height .3s';
                item.style.opacity = '0';
                item.style.overflow = 'hidden';

                setTimeout(async () => {
                    await fetch('/Account/DeleteUserNotification/' + id, { method: 'POST' });
                    allUserNotifs = allUserNotifs.filter(n => n.id !== id);
                    renderUserNotifs();
                    checkUserUnread();
                }, 200);
            }

            async function deleteSelectedNotifs() {
                const checked = [...document.querySelectorAll('[id^="notif-check-"]:checked')]
                    .map(cb => parseInt(cb.value));

                if (checked.length === 0) return;

                if (!confirm(`Xóa ${checked.length} thông báo đã chọn?`)) return;

                await fetch('/Account/DeleteUserNotifications', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(checked)
                });

                allUserNotifs = allUserNotifs.filter(n => !checked.includes(n.id));
                renderUserNotifs();
                updateDeleteSelectedBtn();
                checkUserUnread();
            }

            async function deleteAllRead() {
                const readCount = allUserNotifs.filter(n => n.isRead).length;
                if (readCount === 0) {
                    alert('Không có thông báo đã đọc nào để xóa.');
                    return;
                }

                if (!confirm(`Xóa ${readCount} thông báo đã đọc?`)) return;

                await fetch('/Account/DeleteAllReadNotifications', { method: 'POST' });
                allUserNotifs = allUserNotifs.filter(n => !n.isRead);
                renderUserNotifs();
                checkUserUnread();
            }

            function onNotifCheckChange() {
                updateDeleteSelectedBtn();
            }

            function updateDeleteSelectedBtn() {
                const checked = document.querySelectorAll('[id^="notif-check-"]:checked').length;
                const btn = document.getElementById('btn-delete-selected');
                const countEl = document.getElementById('notif-selected-count');

                if (btn) btn.style.display = checked > 0 ? 'inline-block' : 'none';
                if (countEl) countEl.textContent = checked > 0 ? `Đang chọn: ${checked}` : '';
            }

            const notifOpenState = {};

            async function toggleNotifItem(id) {
                const body = document.getElementById(`notif-body-${id}`);
                const arrow = document.getElementById(`notif-arrow-${id}`);
                const dot = document.getElementById(`notif-dot-${id}`);
                const title = document.getElementById(`notif-title-${id}`);
                const header = body?.previousElementSibling;

                const isOpen = notifOpenState[id] || false;

                if (!isOpen) {
                    body.style.display = 'block';
                    arrow.style.transform = 'rotate(180deg)';
                    notifOpenState[id] = true;

                    if (dot && dot.style.display !== 'none') {
                        await fetch('/Account/MarkUserNotificationRead/' + id, { method: 'POST' });
                        dot.style.display = 'none';
                        if (title) title.style.fontWeight = '500';
                        if (header) header.style.background = '#fff';
                        checkUserUnread();
                    }
                } else {
                    body.style.display = 'none';
                    arrow.style.transform = 'rotate(0deg)';
                    notifOpenState[id] = false;
                }
            }

            async function markAllRead() {
                await fetch('/Account/MarkAllUserNotificationsRead', { method: 'POST' });
                hideUserNotifDot();
                document.querySelectorAll('[id^="notif-dot-"]').forEach(dot => {
                    dot.style.display = 'none';
                });
                document.querySelectorAll('[id^="notif-title-"]').forEach(title => {
                    title.style.fontWeight = '500';
                });
                document.querySelectorAll('[id^="notif-body-"]').forEach(body => {
                    if (body.previousElementSibling)
                        body.previousElementSibling.style.background = '#fff';
                });
            }

            function toggleUserNotifDropdown() {
                const d = document.getElementById('user-notif-dropdown');
                const isOpen = d.style.display !== 'none';
                d.style.display = isOpen ? 'none' : 'block';
                if (!isOpen) loadUserNotifications();
            }

            document.addEventListener('click', function(e) {
                const dropdown = document.getElementById('user-notif-dropdown');
                const bell = e.target.closest('[onclick="toggleUserNotifDropdown()"]');
                if (!bell && dropdown && !dropdown.contains(e.target))
                    dropdown.style.display = 'none';
            });

            const style = document.createElement('style');
            style.textContent = '@@keyframes slideIn { from { transform: translateX(100px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }';
            document.head.appendChild(style);

            checkUserUnread();
            setInterval(checkUserUnread, 60000);
            </script>
        }
    </body>
</html>
