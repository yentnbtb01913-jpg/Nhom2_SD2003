  async acceptFriend(requesterId) {
    const res = await fetch('/api/friends/accept/' + requesterId, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      const el = document.getElementById('freq-' + requesterId);
      if (el) el.innerHTML = '<div style="padding:10px;color:#16a34a;font-size:13px;width:100%;"><i class="fa fa-check-circle"></i> Đã chấp nhận!</div>';
      this.loadFriendReqCount();
      this.loadOnlineBar();
    }
