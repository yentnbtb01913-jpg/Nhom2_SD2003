    <!-- JS: lazy-load bài mới nhất cho mega menu khi hover -->
    <script>
        (function () {
            function esc(s){var d=document.createElement('div');d.textContent=s||'';return d.innerHTML;}
            document.querySelectorAll('.wi-nav-item').forEach(function (li) {
                li.addEventListener('mouseenter', function () {
                    var box = li.querySelector('.wi-mega-right');
                    if (!box || box.dataset.loaded === '1' || box.dataset.loading === '1') return;
                    box.dataset.loading = '1';
                    fetch('/danh-muc/' + encodeURIComponent(box.dataset.slug) + '/mega', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            box.dataset.loading = '0'; box.dataset.loaded = '1';
                            if (!d.ok || !d.items || d.items.length === 0) { box.innerHTML = '<div class="wi-mega-empty">Chưa có bài viết.</div>'; return; }
                            var it = d.items;
                            var cards = it.slice(0, 3).map(function (a) {
                                return '<a class="wi-mega-card" href="' + a.url + '"><div class="wi-mega-card-thumb"><img src="' + a.thumb + '" loading="lazy" alt=""></div><div class="wi-mega-card-title">' + esc(a.title) + '</div></a>';
                            }).join('');
                            var titles = it.slice(3, 8).map(function (a) {
                                return '<li><a href="' + a.url + '">' + esc(a.title) + '</a></li>';
                            }).join('');
                            box.innerHTML = '<div class="wi-mega-cards">' + cards + '</div>' + (titles ? '<ul class="wi-mega-titles">' + titles + '</ul>' : '');
                        })
                        .catch(function () { box.dataset.loading = '0'; box.innerHTML = '<div class="wi-mega-empty">Không tải được.</div>'; });
                });
            });
        })();
    </script>
