@using WisdomITNews.Services
@using Microsoft.EntityFrameworkCore
@inject WisdomITNews.Data.AppDbContext _layoutDb
@{
    var megaCategories = await _layoutDb.Categories
        .Where(c => c.IsVisible)
        .OrderBy(c => c.SortOrder)
        .ToListAsync();

    var hotTags = await _layoutDb.Tags
        .OrderBy(t => t.Name)
        .Take(10)
        .ToListAsync();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")Wisdom IT News</title>
    <!-- ===== SEO / Mạng xã hội (meta OG + Twitter) ===== -->
    <meta name="description" content="Wisdom IT News — tin tức công nghệ, AI và lập trình cập nhật nhanh, kèm video, podcast và tính năng AI." />
    <meta name="keywords" content="tin công nghệ, AI, lập trình, bảo mật, tin tức 24h, WisdomITNews" />
    <meta property="og:site_name" content="Wisdom IT News" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Wisdom IT News")" />
    <meta property="og:description" content="Tin tức công nghệ, AI và lập trình cập nhật nhanh mỗi ngày." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- ===== JSON-LD (dữ liệu có cấu trúc cho công cụ tìm kiếm) ===== -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebSite",
        "name": "Wisdom IT News",
        "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
        "potentialAction": {
            "@@type": "SearchAction",
            "target": "@($"{Context.Request.Scheme}://{Context.Request.Host}")/tim-kiem?q={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "NewsMediaOrganization",
        "name": "Wisdom IT News",
        "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")"
    }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,600;1,700&family=Inter:wght@400;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="icon" type="image/png" href="/Logo%20Kh%C3%B4ng%20ch%E1%BB%AF.png" />
    <!-- Bootstrap 5 (chỉ dùng grid row/col cho khung layout tổng) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=20260527e" />
    <link rel="stylesheet" href="~/css/baomoi-skin.css?v=20260710b" />
    <!-- Lớp giao diện MỚI (thanhnien-style) — nạp SAU cùng để bổ sung, không đè -->
    <link rel="stylesheet" href="~/css/wisdom-site.css?v=20260727n" />
    <style>
            /* ===== Account Dropdown (in sticky header) ===== */
            .header-account-dropdown {
                position: relative;
                flex-shrink: 0;
            }

            .header-account-toggle {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--ai-color, #476083);
                border: none;
                border-radius: 0px;
                padding: 9px 16px;
                cursor: pointer;
                color: #fff;
                font-family: inherit;
                font-size: 13px;
                font-weight: 600;
                transition: opacity .2s;
                white-space: nowrap;
            }

                .header-account-toggle:hover {
                    opacity: .9;
                }

                .header-account-toggle .toggle-avatar {
                    width: 22px;
                    height: 22px;
                    border-radius: 50%;
                    background: rgba(255,255,255,.25);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                    font-size: 10px;
                    font-weight: 700;
                }

                    .header-account-toggle .toggle-avatar img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        border-radius: 50%;
                    }
            /* Dropdown panel */
            .header-dropdown-menu {
                position: absolute;
                top: calc(100% + 8px);
                right: 0;
                background: #fff;
                border-radius: 0px;
                box-shadow: 0 4px 20px rgba(0,0,0,.12);
                border: 1px solid #c4c6cf;
                min-width: 240px;
                padding: 6px 0;
                z-index: 9999;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: opacity .2s,transform .2s,visibility .2s;
            }

                .header-dropdown-menu.show {
                    opacity: 1;
                    visibility: visible;
                    transform: translateY(0);
                }
            /* User info */
            .dd-user-info {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 14px 16px;
            }

            .dd-avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: linear-gradient(135deg,#000613,#476083);
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                font-size: 18px;
                font-weight: 700;
                color: #fff;
                flex-shrink: 0;
            }

                .dd-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    border-radius: 50%;
                }

            .dd-user-info strong {
                display: block;
                font-size: 14px;
                color: #0a2540;
            }

            .dd-role {
                display: inline-block;
                font-size: 10px;
                font-weight: 700;
                color: #476083;
                background: rgba(71,96,131,.1);
                padding: 2px 8px;
                border-radius: 0px;
                text-transform: uppercase;
                margin-top: 2px;
            }

            .dd-divider {
                height: 1px;
                background: #e0e4e8;
                margin: 4px 14px;
            }

            .dd-item {
                display: flex !important;
                align-items: center;
                gap: 10px;
                padding: 10px 16px;
                font-size: 13px;
                color: #0a2540 !important;
                transition: background .15s;
                cursor: pointer;
                text-decoration: none !important;
            }

                .dd-item:hover {
                    background: #f0eded;
                    color: #001f3f !important;
                }

                .dd-item i {
                    width: 18px;
                    text-align: center;
                    font-size: 14px;
                    color: #74777f;
                }

                .dd-item:hover i {
                    color: #001f3f;
                }

            .dd-item-danger {
                color: #ba1a1a !important;
            }

                .dd-item-danger i {
                    color: #ba1a1a !important;
                }

                .dd-item-danger:hover {
                    background: rgba(186,26,26,.06) !important;
                }
            /* Topbar simple user pill (no dropdown) */
            .topbar-user-pill {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 2px 8px;
                border-radius: 0px;
                background: rgba(255,255,255,.1);
                font-size: 12px;
                color: rgba(255,255,255,.9);
            }

                .topbar-user-pill img {
                    width: 18px;
                    height: 18px;
                    border-radius: 50%;
                    object-fit: cover;
                }
            /* ===== Region Switcher ===== */
            .region-switcher {
                position: relative;
                flex-shrink: 0;
            }

            .region-toggle {
                display: flex;
                align-items: center;
                gap: 6px;
                background: rgba(255,255,255,.12);
                border: 1px solid rgba(255,255,255,.2);
                border-radius: 20px;
                padding: 5px 14px;
                cursor: pointer;
                color: rgba(255,255,255,.95);
                font-family: inherit;
                font-size: 12px;
                font-weight: 600;
                transition: all .2s;
                white-space: nowrap;
            }

                .region-toggle:hover {
                    background: rgba(255,255,255,.2);
                    border-color: rgba(255,255,255,.35);
                }

                .region-toggle i:first-child {
                    color: #afc8f0;
                    font-size: 13px;
                }

            .region-dropdown {
                position: absolute;
                top: calc(100% + 6px);
                left: 0;
                background: #fff;
                border-radius: 0px;
                box-shadow: 0 4px 20px rgba(0,0,0,.12);
                border: 1px solid #c4c6cf;
                min-width: 180px;
                padding: 6px 0;
                z-index: 9999;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-6px);
                transition: opacity .2s, transform .2s, visibility .2s;
            }

                .region-dropdown.show {
                    opacity: 1;
                    visibility: visible;
                    transform: translateY(0);
                }

            .region-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 16px;
                font-size: 13px;
                color: #0a2540 !important;
                text-decoration: none !important;
                transition: background .15s;
                cursor: pointer;
            }

                .region-item:hover {
                    background: #f0eded;
                    color: #001f3f !important;
                }

                .region-item.active {
                    background: rgba(0,31,63,.06);
                    color: #001f3f !important;
                    font-weight: 600;
                }

                    .region-item.active::after {
                        content: '\2713';
                        margin-left: auto;
                        color: #001f3f;
                        font-weight: 700;
                    }

                .region-item i {
                    width: 16px;
                    text-align: center;
                    font-size: 12px;
                    color: #6c757d;
                }

                .region-item:hover i,
                .region-item.active i {
                    color: #001f3f;
                }

            /* ===== Responsive: header mobile (logo + thời tiết + nút tài khoản trên 1 hàng) =====
               site.css có @@media(max-width:580px){.header-main .container{flex-wrap:wrap;}} khiến nút
               tài khoản rớt xuống dòng dưới và đè lên phần khác khi không đủ chỗ. Ép lại nowrap + thu
               nhỏ các phần tử để luôn vừa 1 hàng, không đổi gì trên desktop. */
            @@media (max-width: 768px) {
                .header-main .container {
                    flex-wrap: nowrap;
                    gap: 8px;
                }
                .header-account-toggle {
                    padding: 6px 10px;
                    gap: 6px;
                }
                .header-account-toggle .toggle-avatar {
                    width: 32px;
                    height: 32px;
                }
                .header-account-toggle .toggle-username {
                    display: none;
                }
                .header-dropdown-menu {
                    right: 0;
                    left: auto;
                    max-width: calc(100vw - 24px);
                }
            }
            @@media (max-width: 480px) {
                .header-weather-wrap {
                    display: none;
                }
                .logo-text span {
                    display: none;
                }
                .logo-text h1 {
                    font-size: 17px;
                }
                .logo-icon {
                    width: 34px;
                    height: 34px;
                    font-size: 16px;
                }
                .header-dropdown-menu {
                    width: calc(100vw - 24px);
                    min-width: 0;
                    max-height: 80vh;
                    overflow-y: auto;
                }
            }
    </style>
    @await RenderSectionAsync("Head", required: false)
    <style>
            .nav-suggest {
                position: absolute;
                top: calc(100% + 4px);
                left: 0;
                right: 0;
                background: #fff;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                box-shadow: 0 10px 28px rgba(0,0,0,.15);
                z-index: 2000;
                max-height: 400px;
                overflow-y: auto;
            }

                .nav-suggest .sg-item {
                    display: flex;
                    gap: 10px;
                    padding: 9px 12px;
                    text-decoration: none;
                    color: #1a1a1a;
                    border-bottom: 1px solid #f2f4f6;
                    align-items: center;
                }

                    .nav-suggest .sg-item:last-child {
                        border-bottom: 0;
                    }

                    .nav-suggest .sg-item:hover {
                        background: #f3fafb;
                    }

                    .nav-suggest .sg-item img, .nav-suggest .sg-item .ph {
                        width: 54px;
                        height: 38px;
                        object-fit: cover;
                        border-radius: 5px;
                        flex: 0 0 auto;
                        background: #eef1f3;
                    }

                .nav-suggest .sg-t {
                    font-size: 13px;
                    font-weight: 600;
                    line-height: 1.35;
                    display: -webkit-box;
                    -webkit-line-clamp: 2;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                }

                .nav-suggest .sg-c {
                    font-size: 11px;
                    color: #0e7d85;
                    font-weight: 600;
                    margin-top: 2px;
                }
            /* ===== MEGA MENU ===== */
            .mega-menu-wrapper {
                position: relative;
            }

            .mega-trigger {
                display: flex !important;
                align-items: center;
                gap: 5px;
                cursor: pointer;
            }

                .mega-trigger .fa-chevron-down {
                    font-size: 10px;
                    transition: transform .2s;
                }

            .mega-menu-wrapper:hover .fa-chevron-down {
                transform: rotate(180deg);
            }

            .mega-menu {
                display: none;
                position: absolute;
                top: 100%;
                left: 50%;
                transform: translateX(-50%);
                background: var(--bg-white,#fff);
                border: 1px solid var(--border,#e0e4e8);
                border-top: 2px solid var(--primary,#0e7d85);
                box-shadow: 0 8px 24px rgba(0,0,0,.12);
                width: 480px;
                z-index: 10000;
                padding: 16px;
            }

            .mega-menu-wrapper:hover .mega-menu {
                display: block !important;
            }

            .bm-nav-list .mega-menu-wrapper:hover .mega-menu {
                display: block !important;
            }

            .mega-categories {
                display: grid;
                grid-template-columns: repeat(2,1fr);
                gap: 4px;
            }

            .mega-cat-item {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 10px;
                text-decoration: none !important;
                color: var(--text-body,#333);
                font-size: 13px;
                font-weight: 500;
                border-radius: 4px;
                transition: background .15s,color .15s;
            }

                .mega-cat-item:hover {
                    background: var(--bg-gray,#f5f5f5);
                    color: var(--primary,#0e7d85);
                }

            .mega-cat-icon {
                font-size: 16px;
                width: 20px;
                text-align: center;
            }

            .mega-tags-row {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 6px;
                margin-top: 12px;
                padding-top: 12px;
                border-top: 1px solid var(--border,#e0e4e8);
            }

            .mega-tags-label {
                font-size: 11px;
                font-weight: 700;
                color: var(--text-muted,#888);
                text-transform: uppercase;
            }

            .mega-tag {
                font-size: 12px;
                padding: 3px 8px;
                border: 1px solid var(--border,#e0e4e8);
                border-radius: 20px;
                text-decoration: none !important;
                color: var(--text-muted,#888);
                transition: all .15s;
            }

                .mega-tag:hover {
                    border-color: var(--primary,#0e7d85);
                    color: var(--primary,#0e7d85);
                }
            @@media(max-width:768px) {
                .mega-menu {
                    width: 100vw;
                    left: 0;
                    transform: none;
                }

                .mega-categories {
                    grid-template-columns: 1fr;
                }
            }
            /* ===== END MEGA MENU ===== */
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
@{
    var currentTheme = "default"; // Re-skin Báo Mới: ép theme sáng đồng nhất (tắt neon/dark theo danh mục). Bỏ dòng này để bật lại theme động.
}
<body data-theme="@currentTheme">
    <!-- TOPBAR -->
    @{
        var currentRegion = Context.Session.GetString("CurrentRegion") ?? "dong-nai";
        var regionNames = new Dictionary<string, string>
        {
            ["dong-nai"] = "Đồng Nai",
            ["ha-noi"] = "Hà Nội",
            ["ho-chi-minh"] = "TP. HCM",
            ["da-nang"] = "Đà Nẵng",
            ["hai-phong"] = "Hải Phòng",
            ["can-tho"] = "Cần Thơ"
        };
        var currentRegionName = regionNames.GetValueOrDefault(currentRegion, "Đồng Nai");
        var userId = Context.Session.GetInt32("UserId");
        var userName = Context.Session.GetString("UserName");
        var userAvatar = Context.Session.GetString("UserAvatar");
    }
    <!-- ================= TOP BANNER AD (leaderboard, placeholder) ================= -->
    <div class="container" style="max-width:1200px;margin:10px auto 0;padding:0 16px;">
        <div class="wi-ad-slot wi-ad-top" data-ad-label="Quảng cáo · Top Banner 728×90">
            @await Component.InvokeAsync("AdSlot", new { position = "header" })
        </div>
    </div>

    <!-- ==================== HEADER START ==================== -->
    <header class="wi-site-header">
        <!-- ----- HEADER · TẦNG 1: thanh tiện ích (topbar) ----- -->
        <div class="wi-topbar">
            <div class="container" style="max-width:1600px;">
                <div class="wi-topbar-inner">
                    <div class="wi-topbar-left">
                        <span class="wi-topbar-date"><i class="fa-regular fa-calendar"></i> @DateTime.Now.ToString("dd/MM/yyyy")</span>
                        <span class="wi-tb-sep"></span>
                        <div class="dropdown wi-region-dd">
                            <a class="wi-region" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                                <i class="fa fa-location-dot"></i> @currentRegionName <i class="fa fa-chevron-down"></i>
                            </a>
                            <ul class="dropdown-menu">
                                @foreach (var r in regionNames)
                                {
                                    <li><a class="dropdown-item @(r.Key == currentRegion ? "active" : "")" href="/@r.Key">@r.Value</a></li>
                                }
                            </ul>
                        </div>
                        <span class="wi-tb-sep"></span>
                        <div class="wi-topbar-weather">@await Component.InvokeAsync("Weather")</div>
                        <span class="wi-tb-sep"></span>
                        <a href="/lien-he" class="wi-topbar-link"><i class="fa fa-phone"></i>Liên hệ</a>
                    </div>
                    <div class="wi-topbar-right">
                        @if (userId.HasValue)
                        {
                            <a href="javascript:void(0)" onclick="openNotifPanel(); return false;" class="wi-topbar-link" title="Thông báo" style="position:relative;">
                                <i class="fa fa-bell"></i>
                                <span id="topbar-notif-dot" style="display:none;position:absolute;top:-2px;right:-4px;width:8px;height:8px;background:#dc2626;border-radius:50%;"></span>
                            </a>
                            <span class="wi-tb-sep"></span>
                        }
                        <span class="wi-follow-label">Theo dõi trên</span>
                        @* SOCIAL PLACEHOLDER: thay <i> bằng <img src="/img/xxx.png"> để dùng ảnh riêng *@
                        <a href="#" class="wi-social" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#" class="wi-social" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="wi-social" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                        <a href="#" class="wi-social" aria-label="Zalo"><i class="fa fa-comment-dots"></i></a>
                        <span class="wi-tb-sep"></span>
                        <a href="javascript:void(0)" onclick="toggleDarkMode()" class="wi-topbar-link" title="Chế độ tối"><i class="fa fa-moon"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <!-- ----- HEADER · TẦNG 2: ☰ + tìm kiếm | LOGO GIỮA | nút icon (placeholder) ----- -->
        <div class="wi-header-main">
            <div class="container" style="max-width:1600px;">
                <div class="row align-items-center wi-hm-row g-0">
                    <!-- CỘT TRÁI: hamburger + ô tìm kiếm -->
                    <div class="col wi-hm-col-left">
                        <button type="button" class="wi-ham" aria-label="Danh mục" onclick="document.getElementById('wiNav')?.classList.toggle('wi-nav-open');">
                            <span></span><span></span><span></span>
                        </button>
                        <form action="/tim-kiem" method="get" class="wi-hm-search" autocomplete="off" style="position:relative;">
                            <input type="text" id="navSearchInput" name="q" placeholder="Tìm kiếm..." value="@ViewData["SearchQuery"]" />
                            <button type="submit" aria-label="Tìm kiếm"><i class="fa fa-search"></i></button>
                            <div id="navSuggest" class="nav-suggest" style="display:none;"></div>
                        </form>
                    </div>
                    <!-- CỘT GIỮA: LOGO -->
                    <div class="col-auto wi-hm-col-center">
                        <a href="/" class="wi-brand wi-brand-center">
                            <img src="/Logo%20c%C3%B3%20ch%E1%BB%AF.png" alt="Wisdom IT News" class="wi-brand-logo-full" />
                        </a>
                    </div>
                    <!-- CỘT PHẢI: nút icon dạng placeholder (thay <i> trong .wi-iconbtn-img bằng <img>) -->
                    <div class="col wi-hm-col-right">
                        <a href="/lien-he-quang-cao" class="wi-iconbtn">
                            <span class="wi-iconbtn-label">Quảng cáo</span>
                            <span class="wi-iconbtn-img wi-ph-ad"><i class="fa fa-bullhorn"></i></span>
                        </a>
                    <div class="wi-hm-right">
                @if (userId.HasValue)
                {
                    <!-- DROPDOWN trong header sticky -->
                    <div class="header-account-dropdown">
                        <button class="header-account-toggle" id="accountToggle" style="position:relative;">
                            <span id="user-notif-dot" style="display:none;position:absolute;top:0;left:26px;width:9px;height:9px;background:#dc2626;border-radius:50%;border:2px solid #fff;z-index:3;"></span>
                            <div class="toggle-avatar">
                                @if (!string.IsNullOrEmpty(userAvatar))
                                {
                                    <img src="@userAvatar" alt="@userName" />
                                }
                                else
                                {
                                    <span>@(string.IsNullOrWhiteSpace(userName) ? "?" : userName.Substring(0, 1).ToUpper())</span>
                                }
                            </div>
                            <span class="toggle-username">@userName</span>
                            <i class="fa fa-chevron-down" style="font-size:10px;opacity:.7;"></i>
                        </button>
                        <div class="header-dropdown-menu" id="accountDropdown">
                            <div class="dd-user-info">
                                <div class="dd-avatar">
                                    @if (!string.IsNullOrEmpty(userAvatar))
                                    {
                                        <img src="@userAvatar" alt="@userName" />
                                    }
                                    else
                                    {
