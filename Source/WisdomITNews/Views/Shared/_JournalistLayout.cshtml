@{
    var jName = Context.Session.GetString("JournalistName") ?? "Nhà Báo";
    var jAvatar = Context.Session.GetString("JournalistAvatar") ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] — Journalist Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter',sans-serif;
                background: #f8f9fb;
                color: #0a2540;
                display: flex;
                min-height: 100vh;
            }
            /* ===== SIDEBAR ===== */
            .j-sidebar {
                width: 240px;
                background: linear-gradient(180deg,#0a2540 0%,#16213e 100%);
                color: #fff;
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0;
                left: 0;
                height: 100vh;
                overflow-y: auto;
                z-index: 100;
            }

            .j-sidebar-brand {
                padding: 24px 20px;
                display: flex;
                align-items: center;
                gap: 12px;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

                .j-sidebar-brand .icon {
                    width: 40px;
                    height: 40px;
                    background: linear-gradient(135deg,#001f3f,#476083);
                    border-radius: 0px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 18px;
                    font-weight: 700;
                }

                .j-sidebar-brand .text {
                    font-size: 15px;
                    font-weight: 700;
                    letter-spacing: -.3px;
                }

                .j-sidebar-brand .sub {
                    font-size: 10px;
                    opacity: .5;
                    text-transform: uppercase;
                    letter-spacing: .5px;
                }
            /* User info in sidebar */
            .j-sidebar-user {
                padding: 20px;
                display: flex;
                align-items: center;
                gap: 12px;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

                .j-sidebar-user .avatar {
                    width: 42px;
                    height: 42px;
                    border-radius: 50%;
                    background: linear-gradient(135deg,#001f3f,#ef4444);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 18px;
                    font-weight: 700;
                    overflow: hidden;
                    flex-shrink: 0;
                }

                    .j-sidebar-user .avatar img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                    }

                .j-sidebar-user .info {
                    overflow: hidden;
                }

                .j-sidebar-user .name {
                    font-size: 14px;
                    font-weight: 600;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .j-sidebar-user .role {
                    font-size: 10px;
                    opacity: .5;
                    text-transform: uppercase;
                    letter-spacing: .5px;
                }

            .j-nav {
                flex: 1;
                padding: 12px 0;
            }

                .j-nav .section-label {
                    font-size: 10px;
                    text-transform: uppercase;
                    letter-spacing: 1.2px;
                    color: rgba(255,255,255,.3);
                    padding: 16px 20px 6px;
                    font-weight: 600;
                }

                .j-nav a {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 11px 20px;
                    color: rgba(255,255,255,.65);
                    font-size: 14px;
                    text-decoration: none;
                    transition: all .2s;
                    border-left: 3px solid transparent;
                    font-weight: 500;
                }

                    .j-nav a:hover, .j-nav a.active {
                        color: #fff;
                        background: rgba(255,255,255,.06);
                        border-left-color: #001f3f;
                    }

                    .j-nav a.active {
                        font-weight: 600;
                    }

                    .j-nav a i {
                        width: 18px;
                        text-align: center;
                        font-size: 15px;
                    }

                    .j-nav a .badge {
                        margin-left: auto;
                        background: #001f3f;
                        color: #0a2540;
                        font-size: 10px;
                        font-weight: 700;
                        padding: 2px 8px;
                        border-radius: 0px;
                    }

            .j-nav-divider {
                height: 1px;
                background: rgba(255,255,255,.06);
                margin: 8px 20px;
            }

            .j-sidebar-footer {
                padding: 16px 20px;
                border-top: 1px solid rgba(255,255,255,.08);
                font-size: 11px;
                color: rgba(255,255,255,.3);
            }
            /* ===== MAIN CONTENT ===== */
            .j-main {
                margin-left: 240px;
                flex: 1;
                min-height: 100vh;
                min-width: 0;
            }
            /* ===== Mobile off-canvas sidebar (≤992px) ===== */
            .j-hamburger {
                display: none;
                position: fixed;
                top: 14px;
                left: 14px;
                z-index: 1100;
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background: #0a2540;
                color: #fff;
                border: none;
                font-size: 17px;
                cursor: pointer;
                align-items: center;
                justify-content: center;
                box-shadow: 0 2px 10px rgba(0,0,0,.25);
            }
            .j-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.45);
                z-index: 199;
            }

            .j-topbar {
                background: #fff;
                padding: 16px 28px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid #e5e7eb;
                position: sticky;
                top: 0;
                z-index: 50;
            }

                .j-topbar h1 {
                    font-size: 20px;
                    font-weight: 700;
                    color: #0a2540;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

            .j-topbar-actions {
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .j-topbar-actions a, .j-topbar-actions button {
                    padding: 9px 18px;
                    border-radius: 0px;
                    font-size: 13px;
                    font-weight: 600;
                    text-decoration: none;
                    border: none;
                    cursor: pointer;
                    font-family: inherit;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    transition: all .2s;
                }

            .j-btn-primary {
                background: #001f3f;
                color: #fff;
            }

                .j-btn-primary:hover {
                    background: #d97706;
                    color: #fff;
                }

            .j-btn-secondary {
                background: #f3f4f6;
                color: #374151;
                border: 1px solid #e5e7eb;
            }

                .j-btn-secondary:hover {
                    background: #e5e7eb;
                }

            .j-btn-danger {
                background: #fee2e2;
                color: #dc2626;
            }

                .j-btn-danger:hover {
                    background: #fecaca;
                }

            .j-content {
                padding: 28px;
            }
            /* ===== CARDS & UTILITIES ===== */
            .j-card {
                background: #fff;
                border-radius: 0px;
                padding: 24px;
                box-shadow: 0 1px 3px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.04);
                border: 1px solid #f0f0f0;
            }

            .j-card-title {
                font-size: 16px;
                font-weight: 700;
                color: #0a2540;
                margin-bottom: 16px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .j-card-title i {
                    color: #001f3f;
                }
            /* Alert */
            .j-alert {
                padding: 12px 16px;
                border-radius: 0px;
                font-size: 13px;
                margin-bottom: 16px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .j-alert-success {
                background: #dcfce7;
                color: #16a34a;
                border: 1px solid #bbf7d0;
            }

            .j-alert-error {
                background: #fee2e2;
                color: #dc2626;
                border: 1px solid #fecaca;
            }

            @@media (max-width:992px) {
                .j-hamburger { display: flex; }
                .j-sidebar {
                    width: 250px;
                    transform: translateX(-100%);
                    transition: transform .25s ease;
                    z-index: 200;
                }
                .j-sidebar.open { transform: translateX(0); }
                .j-backdrop.show { display: block; }
                .j-main {
                    margin-left: 0;
                }
                .j-topbar {
                    padding-left: 64px;
                }
            }
    </style>
    @await RenderSectionAsync("Head", required: false)
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <button type="button" class="j-hamburger" onclick="toggleJSidebar()" aria-label="Mở/đóng menu"><i class="fa fa-bars"></i></button>
    <div class="j-backdrop" id="jBackdrop" onclick="closeJSidebar()"></div>
    <aside class="j-sidebar" id="jSidebar">
        <div class="j-sidebar-brand">
            <div class="icon"><i class="fa fa-pen-nib"></i></div>
            <div>
                <div class="text">Journalist Panel</div>
                <div class="sub">Wisdom IT News</div>
            </div>
        </div>
        <div class="j-sidebar-user">
            <div class="avatar">
                @if (!string.IsNullOrEmpty(jAvatar))
                {
                    <img src="@jAvatar" alt="@jName" />
                }
                else
                {
                    <span>@(string.IsNullOrWhiteSpace(jName) ? "?" : jName.Substring(0, 1).ToUpper())</span>
                }
            </div>
            <div class="info">
                <div class="name">@jName</div>
                <div class="role">Nhà báo</div>
            </div>
        </div>
        <nav class="j-nav">
            <div class="section-label">Tổng quan</div>
            <a href="/Journalist/Dashboard" class="@(currentAction == "Dashboard" ? "active" : "")">
                <i class="fa fa-chart-line"></i> <span>Dashboard</span>
            </a>
            <div class="section-label">Bài viết</div>
            <a href="/Journalist/Create" class="@(currentAction == "Create" ? "active" : "")">
                <i class="fa fa-feather-pointed"></i> <span>Viết bài mới</span>
            </a>
            <a href="/journalist/Videos" class="@(currentAction == "Videos" || currentAction == "CreateVideo" ? "active" : "")">
                <i class="fa fa-video"></i> <span>Video</span>
            </a>
            <a href="/journalist/Podcasts" class="@(currentAction == "Podcasts" ? "active" : "")">
                <i class="fa fa-podcast"></i> <span>Audio / Podcast</span>
            </a>
            <a href="/journalist/Ads" class="@(currentAction == "Ads" || currentAction == "CreateAd" ? "active" : "")">
                <i class="fa fa-rectangle-ad"></i> <span>Quảng cáo của tôi</span>
            </a>
            <a href="/journalist/RenewAds" class="@(currentAction == "RenewAds" || currentAction == "AdChat" ? "active" : "")">
                <i class="fa fa-clock-rotate-left"></i> <span>Gia hạn quảng cáo</span> @await Component.InvokeAsync("AdRenewalBadge", new { side = "journalist" })
            </a>
            <a href="/journalist/TeamChat" class="@(currentAction == "TeamChat" ? "active" : "")">
                <i class="fa fa-comments"></i> <span>Chat nội bộ</span>
            </a>
            <div class="j-nav-divider"></div>
            <div class="section-label">Tài khoản</div>
            <a href="/Journalist/Profile" class="@(currentAction == "Profile" ? "active" : "")">
                <i class="fa fa-user-circle"></i> <span>Hồ sơ cá nhân</span>
            </a>
            <a href="/Journalist/Inbox" class="@(currentAction == "Inbox" ? "active" : "")" style="position:relative;">
                <i class="fa fa-inbox"></i> <span>Hộp Thư</span>
                <span id="journalist-inbox-badge"
                    style="display:none;background:#dc2626;color:#fff;
                    border-radius:10px;padding:1px 6px;
                    font-size:11px;margin-left:4px;">
                </span>
            </a>
            <div class="j-nav-divider"></div>
            <a href="/" target="_blank">
                <i class="fa fa-globe"></i> <span>Xem website</span>
            </a>
            <a href="/Journalist/Logout" style="color:rgba(255,100,100,.8);">
                <i class="fa fa-right-from-bracket"></i> <span>Đăng xuất</span>
            </a>
        </nav>
        <div class="j-sidebar-footer">
            &copy; @DateTime.Now.Year Wisdom IT News
        </div>
    </aside>
    <div class="j-main">
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
<script>
  window.confirmSwal=function(msg,title){return Swal.fire({title:title||'Xác nhận?',text:msg,icon:'warning',showCancelButton:true,confirmButtonColor:'#d33',cancelButtonColor:'#6c757d',confirmButtonText:'Đồng ý',cancelButtonText:'Huỷ'}).then(function(r){return r.isConfirmed;});};
  window.swalToast=function(icon,msg){if(window.Swal)Swal.fire({toast:true,position:'top-end',icon:icon,title:msg,showConfirmButton:false,timer:3000,timerProgressBar:true});};

  // ===== Sidebar off-canvas (mobile ≤992px) =====
  function toggleJSidebar(){
    document.getElementById('jSidebar').classList.toggle('open');
    document.getElementById('jBackdrop').classList.toggle('show');
  }
  function closeJSidebar(){
    document.getElementById('jSidebar').classList.remove('open');
    document.getElementById('jBackdrop').classList.remove('show');
  }
  document.querySelectorAll('.j-sidebar .j-nav a').forEach(function(a){
    a.addEventListener('click', closeJSidebar);
  });

  async function checkJournalistInbox() {
    try {
        const res = await fetch('/Journalist/GetUnreadCount');
        const data = await res.json();
        const badge = document.getElementById('journalist-inbox-badge');
        if (badge) {
            badge.style.display = data.count > 0 ? 'inline' : 'none';
            badge.textContent = data.count;
        }
    } catch(e) {}
  }
  checkJournalistInbox();
  setInterval(checkJournalistInbox, 60000);
</script>
@{
    var __ok = (TempData["Ok"] ?? TempData["NewsletterSuccess"])?.ToString();
    var __er = (TempData["Err"] ?? TempData["NewsletterError"])?.ToString();
}
@if (!string.IsNullOrEmpty(__ok))
{
    <script>swalToast('success', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(__ok)));</script>
}
@if (!string.IsNullOrEmpty(__er))
{
    <script>swalToast('error', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(__er)));</script>
}
</body>
</html>