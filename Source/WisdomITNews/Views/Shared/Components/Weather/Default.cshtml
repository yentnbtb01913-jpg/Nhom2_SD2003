@using WisdomITNews.Models
@model WeatherViewModel
@if (Model != null)
{
    <div class="weather-widget" title="@Model.Description">
        <img src="https://openweathermap.org/img/wn/@(Model.IconCode)@@2x.png"
             alt="@Model.Description"
             loading="lazy" width="40" height="40" />
        <div class="weather-info">
            <span class="weather-temp">@Model.Temp.ToString("0")°C</span>
            <span class="weather-city">@Model.City</span>
            <span class="weather-desc">@Model.Description</span>
        </div>
    </div>
}
