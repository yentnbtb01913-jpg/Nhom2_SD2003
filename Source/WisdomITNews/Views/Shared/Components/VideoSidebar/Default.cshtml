@model List<WisdomITNews.Models.Video>
@if (Model.Any())
{
    <div class="bm-widget vid-sticky">
        <div class="bm-widget-head"><i class="fa fa-video" style="color:#e63946;"></i> Video</div>
        <div style="padding:9px 10px;">
            <input type="text" id="vidSearch" placeholder="🔍 Tìm video..." oninput="filterVids(this.value)"
                   style="width:100%;padding:8px 11px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;" />
        </div>
        <div id="vidList" class="vid-list-scroll">
            @foreach (var v in Model)
            {
                <a href="/Video/Watch/@v.Id" class="vid-item vid-hover" data-t="@v.Title.ToLower()"
                   data-type="@v.VideoType" data-yt="@v.YouTubeId" data-vurl="@v.VideoUrl"
                   style="display:flex;gap:10px;padding:9px 10px;text-decoration:none;border-top:1px solid #f0f2f5;">
                    <div class="vid-thumb" style="position:relative;flex-shrink:0;width:92px;height:58px;border-radius:6px;overflow:hidden;background:#000;">
                        <img src="@v.Thumbnail" alt="@v.Title" loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
                        <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:17px;text-shadow:0 1px 4px rgba(0,0,0,.7);pointer-events:none;"><i class="fa fa-circle-play"></i></span>
                    </div>
                    <div style="min-width:0;flex:1;">
                        <div style="font-size:13px;font-weight:600;color:#1f2937;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">@v.Title</div>
                        <div style="font-size:11px;color:#94a3b8;margin-top:3px;"><i class="fa fa-eye"></i> @v.Views</div>
                    </div>
                </a>
            }
            <div id="vidNone" style="display:none;padding:18px;text-align:center;color:#94a3b8;font-size:13px;">Không tìm thấy video phù hợp.</div>
        </div>
    </div>
    <script>
        function filterVids(q){
            q = (q || '').trim().toLowerCase();
            var items = document.querySelectorAll('#vidList .vid-item'), shown = 0;
            items.forEach(function(el){
                var m = el.getAttribute('data-t').indexOf(q) >= 0;
                el.style.display = m ? 'flex' : 'none';
                if (m) shown++;
            });
            document.getElementById('vidNone').style.display = shown ? 'none' : 'block';
        }
        if (window.attachVidHover) window.attachVidHover(document.getElementById('vidList'));
    </script>
}
