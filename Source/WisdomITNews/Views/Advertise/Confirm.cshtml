@using WisdomITNews.Models
@model Advertisement
@{
    ViewData["Title"] = "Thanh toán thành công";
}
<div style="max-width:640px;margin:24px auto;padding:0 16px;">
    <div style="text-align:center;margin-bottom:16px;">
        <div style="font-size:48px;color:#16a34a;"><i class="fa fa-circle-check"></i></div>
        <h1 style="font-size:24px;font-weight:800;">Thanh toán thành công — đơn #@Model.Id</h1>
        <p style="color:#64748b;">Đơn đã được <b>ghi nhận thanh toán</b> và đang <b>chờ ban biên tập duyệt nội dung</b>. Quảng cáo sẽ tự lên sóng sau khi được duyệt.</p>
    </div>

    @if (TempData["AdEmail"] != null)
    {
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;padding:12px 16px;border-radius:10px;margin-bottom:16px;text-align:center;">
            <i class="fa fa-envelope-circle-check"></i> @TempData["AdEmail"]
        </div>
    }

    <div style="background:#fff;border-radius:12px;padding:20px;box-shadow:0 2px 12px rgba(0,0,0,.07);margin-bottom:16px;">
        <h3 style="margin:0 0 12px;font-size:16px;">Chi tiết đơn</h3>
        <div style="display:flex;justify-content:space-between;padding:6px 0;"><span style="color:#64748b;">Vị trí:</span><b>@(Model.AdSlot?.Name) (@Model.Position)</b></div>
        <div style="display:flex;justify-content:space-between;padding:6px 0;"><span style="color:#64748b;">Tiêu đề:</span><b>@Model.Title</b></div>
        <div style="display:flex;justify-content:space-between;padding:6px 0;"><span style="color:#64748b;">Số ngày:</span><b>@Model.Days ngày</b></div>
        <div style="display:flex;justify-content:space-between;padding:6px 0;"><span style="color:#64748b;">Thời gian:</span><b>@Model.StartDate?.ToString("dd/MM/yyyy") → @Model.EndDate?.ToString("dd/MM/yyyy")</b></div>
        <div style="display:flex;justify-content:space-between;padding:6px 0;"><span style="color:#64748b;">Thanh toán:</span><b style="color:#16a34a;">Đã thanh toán</b></div>
        <div style="display:flex;justify-content:space-between;padding:6px 0;"><span style="color:#64748b;">Trạng thái:</span><b style="color:#ca8a04;">Chờ duyệt nội dung</b></div>
        <div style="display:flex;justify-content:space-between;padding:10px 0 0;border-top:1px solid #eef1f4;margin-top:8px;"><span style="color:#64748b;font-weight:600;">Tổng tiền:</span><b style="color:#dc2626;font-size:20px;">@Model.Amount.ToString("#,##0") đ</b></div>
    </div>

    <div style="text-align:center;margin-top:18px;">
        <a href="@(ViewBag.MyOrdersUrl ?? "/Advertise/MyOrders")" style="display:inline-block;background:#0e7d85;color:#fff;padding:11px 24px;border-radius:8px;font-weight:700;text-decoration:none;">Xem đơn của tôi</a>
    </div>
</div>
