@model WisdomITNews.Models.HomeViewModel
@using WisdomITNews.Services
@{
    ViewData["Title"] = "Trang Chủ"; Layout = "_Layout";
}

<!-- TICKER -->
<div class="ticker-wrap">
    <div class="container">
        <span class="ticker-label">⚡ Nóng</span>
        <div class="ticker-track">
            <div class="ticker-content">
                @foreach (var a in Model.LatestArticles.Where(a => a.IsBreaking).Take(5).ToList().Concat(Model.LatestArticles.Where(a => a.IsBreaking).Take(5).ToList()))
                {
                    <a href="/bai-viet/@a.Slug" style="color:#fff;text-decoration:none;">@a.Title</a>
                }
                @if (!Model.LatestArticles.Any(a => a.IsBreaking))
                {
                    @foreach (var a in Model.LatestArticles.Take(3).ToList().Concat(Model.LatestArticles.Take(3).ToList()))
                    {
                        <a href="/bai-viet/@a.Slug" style="color:#fff;text-decoration:none;">@a.Title</a>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- HERO + AI + SIDEBAR -->
<div class="page-wrapper">
    <main>
        @if (Model.FeaturedArticles.Count >= 2)
        {
            <section class="hero">
                <article class="hero-main" onclick="location.href='/bai-viet/@Model.FeaturedArticles[0].Slug'">
                    <img src="@Model.FeaturedArticles[0].Thumbnail" alt="@Model.FeaturedArticles[0].Title" />
                    <div class="hero-overlay">
                        <span class="badge">@Model.FeaturedArticles[0].Category?.Icon @Model.FeaturedArticles[0].Category?.Name</span>
                        <h2 class="hero-title">@Model.FeaturedArticles[0].Title</h2>
                        <div class="hero-meta">
                            <span><i class="fa fa-clock"></i> @SlugHelper.FormatDate(Model.FeaturedArticles[0].PublishedAt)</span>
                            <span><i class="fa fa-eye"></i> @SlugHelper.FormatViews(Model.FeaturedArticles[0].Views)</span>
                        </div>
                    </div>
                </article>
                @for (int i = 1; i < Math.Min(3, Model.FeaturedArticles.Count); i++)
                {
                    var a = Model.FeaturedArticles[i];
                    <article class="hero-sub" onclick="location.href='/bai-viet/@a.Slug'">
                        <img src="@a.Thumbnail" alt="@a.Title" />
                        <div class="hero-overlay">
                            <span class="badge">@a.Category?.Icon @a.Category?.Name</span>
                            <h3 class="hero-title sm">@a.Title</h3>
                            <div class="hero-meta"><span><i class="fa fa-clock"></i> @SlugHelper.FormatDate(a.PublishedAt)</span></div>
                        </div>
                    </article>
                }
            </section>
        }

        @if (Model.AIArticles.Any())
        {
            <section class="ai-section">
                <div class="ai-section-header">
                    <div class="ai-icon">🤖</div>
                    <div><h2>Góc AI & Học máy</h2><p>Cập nhật mới nhất từ thế giới Trí tuệ Nhân tạo</p></div>
                </div>
                <div class="ai-cards">
                    @foreach (var a in Model.AIArticles)
                    {
                        <article class="ai-card" onclick="location.href='/bai-viet/@a.Slug'">
                            <div class="ai-pill"><i class="fa fa-robot"></i> AI</div>
                            <h3 class="ai-card-title">@a.Title</h3>
                            <div class="ai-card-meta"><i class="fa fa-clock"></i> @SlugHelper.FormatDate(a.PublishedAt) · @SlugHelper.FormatViews(a.Views) xem</div>
                        </article>
                    }
                </div>
            </section>
        }
    </main>

    <aside class="sidebar">
        <div class="sidebar-widget">
            <div class="widget-header hot"><i class="fa fa-fire"></i> Xem nhiều nhất</div>
            <div class="widget-body">
                @for (int i = 0; i < Model.PopularArticles.Count; i++)
                {
                    var a = Model.PopularArticles[i];
                    <div class="hot-item" onclick="location.href='/bai-viet/@a.Slug'">
                        <span class="hot-num @(i < 3 ? "top" : "rest")">@(i + 1)</span>
                        <span class="hot-item-title">@a.Title</span>
                    </div>
                }
            </div>
        </div>
        <div class="sidebar-widget">
            <div class="widget-header"><i class="fa fa-tags"></i> Chủ đề phổ biến</div>
            <div class="widget-body">
                <div class="tags-cloud">
                    @foreach (var t in Model.Tags)
                    {
                        <a href="/tim-kiem?q=@Uri.EscapeDataString(t.Name)" class="tag">@t.Name</a>
                    }
                </div>
            </div>
        </div>
    </aside>
</div>

<!-- TIN MỚI NHẤT — FULL WIDTH, NGOÀI PAGE-WRAPPER -->
<div class="container">
    <div class="section-box latest-full">
        <div class="section-title">
            <h2>Tin mới nhất</h2>
        </div>
        <div class="latest-grid">
            @foreach (var a in Model.LatestArticles)
            {
                @await Html.PartialAsync("_ArticleCard", a)
            }
        </div>
        <div class="latest-more">
            <a href="/danh-muc" class="btn-see-all">Xem tất cả bài viết <i class="fa fa-arrow-right"></i></a>
        </div>
    </div>
</div>