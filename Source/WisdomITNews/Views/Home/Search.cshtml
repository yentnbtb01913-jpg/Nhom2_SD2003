@model WisdomITNews.Models.SearchViewModel
@using WisdomITNews.Services
@{ ViewData["Title"] = "Tìm kiếm: " + Model.Keyword; Layout = "_Layout"; }

<div class="page-wrapper">
<main>
  <div style="background:#fff;border-radius:0px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);margin-bottom:20px;">
    <form action="/tim-kiem" method="get" style="display:flex;gap:10px;">
      <input type="text" name="q" value="@Model.Keyword" placeholder="Tìm kiếm bài viết..." autofocus
             style="flex:1;padding:11px 16px;border:2px solid #e0e4e8;border-radius:0px;font-size:15px;outline:none;font-family:inherit;"/>
      <button type="submit" style="background:#ba1a1a;color:#fff;border:none;padding:11px 20px;border-radius:0px;font-size:14px;font-weight:600;cursor:pointer;">
        <i class="fa fa-search"></i> Tìm
      </button>
    </form>
    @if (!string.IsNullOrEmpty(Model.Keyword))
    {
      <p style="font-size:13px;color:#6c757d;margin-top:10px;">Tìm thấy <strong>@Model.TotalCount</strong> kết quả cho "<strong>@Model.Keyword</strong>"</p>
    }
  </div>

  @if (Model.Results.Any())
  {
    <div class="article-list">
      @foreach (var a in Model.Results)
      {
        @await Html.PartialAsync("_ArticleCard", a)
      }
    </div>
  }
  else if (!string.IsNullOrEmpty(Model.Keyword))
  {
    <div style="text-align:center;padding:60px 20px;color:#6c757d;">
      <div style="font-size:48px;margin-bottom:16px;">🔍</div>
      <h2 style="font-family:'Playfair Display',serif;margin-bottom:8px;">Không tìm thấy kết quả</h2>
      <p>Thử tìm với từ khóa khác nha!</p>
    </div>
  }
</main>
<aside class="sidebar"></aside>
</div>
