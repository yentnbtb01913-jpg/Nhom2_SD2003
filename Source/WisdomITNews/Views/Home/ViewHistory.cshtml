@using WisdomITNews.Models
@using WisdomITNews.Services
@model IEnumerable<ViewHistoryItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Lịch sử đã xem";
}

@section Head {
    <meta name="description" content="Danh sách 20 bài viết bạn đã xem gần đây trên Wisdom IT News." />
}

<div class="page-wrapper" style="grid-template-columns:1fr;">
<main>
<section style="background:var(--bg-white);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow-sm);margin-top:20px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
        <h1 style="font-family:'Playfair Display',serif;font-size:24px;display:flex;align-items:center;gap:10px;">
            <i class="fa fa-clock-rotate-left" style="color:var(--accent);"></i> Lịch sử đã xem
        </h1>
        <span style="background:var(--bg-gray);color:var(--text-muted);padding:2px 10px;border-radius:20px;font-size:13px;">@Model.Count() bài</span>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:60px 20px;color:var(--text-muted);">
            <div style="font-size:48px;margin-bottom:14px;">📭</div>
            <p style="font-size:15px;">Chưa có lịch sử nào. Hãy bắt đầu khám phá các bài viết!</p>
            <a href="/" style="display:inline-block;margin-top:16px;background:var(--accent);color:#fff;padding:10px 22px;border-radius:0px;font-weight:600;text-decoration:none;">Về trang chủ</a>
        </div>
    }
    else
    {
        <ul class="history-list">
            @foreach (var item in Model)
            {
                <li class="history-item">
                    <a href="/bai-viet/@item.Article.Slug" class="history-link">
                        <div class="history-thumb">
                            @if (!string.IsNullOrEmpty(item.Article.Thumbnail))
                            {
                                <img src="@item.Article.Thumbnail" alt="@item.Article.Title" loading="lazy" />
                            }
                            else
                            {
                                <span class="history-thumb-placeholder">📰</span>
                            }
                        </div>
                        <div class="history-body">
                            <span class="history-cat">@item.Article.Category?.Icon @item.Article.Category?.Name</span>
                            <h3 class="history-title">@item.Article.Title</h3>
                            <div class="history-meta">
                                <span><i class="fa fa-clock"></i> Xem @SlugHelper.FormatDate(item.History.ViewedAt)</span>
                                <span><i class="fa fa-eye"></i> @SlugHelper.FormatViews(item.Article.Views)</span>
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }
</section>
</main>
</div>
