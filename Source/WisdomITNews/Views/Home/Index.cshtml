@model WisdomITNews.Models.HomeViewModel
@using WisdomITNews.Models
@using WisdomITNews.Services
@*
    TRANG CHỦ — bố cục đầy đủ theo Báo Thanh Niên:
    Focus (tin lớn + tag Tiêu điểm + lưới 4 cột) | sidebar (Tin mới/Đọc nhiều)
    → dải 3 quảng cáo → HAI LUỒNG CỘT (block chính + widget sidebar sticky)
    → Multimedia (nền xanh) → "Đừng bỏ lỡ" (đánh số 1..9).
    Khung: Bootstrap row/col. Style: wwwroot/css/wisdom-site.css. Dữ liệu thật.
*@
@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_Layout";

    Func<Article, string> U = a => "/bai-viet/" + a.Slug;
    Func<Article, string> T = a => string.IsNullOrWhiteSpace(a.Thumbnail) ? "/images/placeholder.jpg" : a.Thumbnail;

    var feat = Model.FeaturedArticles.Concat(Model.LatestArticles)
        .GroupBy(x => x.Id).Select(g => g.First()).ToList();
    var big = feat.FirstOrDefault();
    var related = feat.Skip(1).Take(3).ToList();
    var subGrid = feat.Skip(4).Take(8).ToList();

    // Tách riêng khối AI để đặt xuống CUỐI cột trái (lấp vùng trống dưới cùng)
    var aiBlock = Model.CategoryBlocks.FirstOrDefault(b =>
        (b.Category.Slug ?? "").Contains("ai")
        || (b.Category.Name ?? "").ToLower().Contains("ai")
        || (b.Category.Name ?? "").ToLower().Contains("machine"));
    var restBlocks = Model.CategoryBlocks.Where(b => b != aiBlock).ToList();

    // Chia khối còn lại thành 2 luồng: cột chính (chẵn) và sidebar (lẻ)
    var mainBlocks = restBlocks.Where((b, i) => i % 2 == 0).ToList();
    var sideBlocks = restBlocks.Where((b, i) => i % 2 == 1).ToList();
    if (aiBlock != null) { mainBlocks.Add(aiBlock); }   // AI xuống cuối cột trái

    // Danh mục con theo danh mục cha (cho sub-tab)
    var childLookup = Model.Categories.Where(c => c.ParentCategoryId != null)
        .GroupBy(c => c.ParentCategoryId!.Value)
        .ToDictionary(g => g.Key, g => g.ToList());

    // "Đừng bỏ lỡ" — 9 tin
    var dontMiss = Model.PopularArticles.Concat(Model.LatestArticles)
        .GroupBy(x => x.Id).Select(g => g.First()).Take(9).ToList();
}

<div class="wi-home container" style="max-width:1200px;">

    <!-- ==================== KHU NỔI BẬT + SIDEBAR ==================== -->
    <div class="row">
        <div class="col-lg-8">
            @if (big != null)
            {
                <article class="wi-lead">
                    <div class="row g-0">
                        <div class="col-md-7">
                            <a href="@U(big)" class="wi-thumb"><img src="@T(big)" alt="@big.Title" fetchpriority="high" /></a>
                        </div>
                        <div class="col-md-5 wi-lead-body">
                            @if (big.Category != null) { <a href="/danh-muc/@big.Category.Slug" class="wi-cat-label">@big.Category.Name</a> }
                            <a href="@U(big)"><h2 class="wi-lc-title">@big.Title</h2></a>
                            <p class="wi-sapo">@big.Summary</p>
                        </div>
                    </div>
                </article>
            }

            @if (related.Any())
            {
                <div class="row wi-lead-related">
                    @foreach (var a in related)
                    {
                        <div class="col-md-4">
                            <div class="wi-rel-item">
                                <a href="@U(a)"><h3 class="wi-lc-title">@a.Title</h3></a>
                                <p class="wi-sapo">@a.Summary</p>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Hàng "Tiêu điểm" (tag chips) -->
            @if (Model.Tags.Any())
            {
                <div class="wi-focus-tags">
                    <span class="wi-tt-label"><i class="fa fa-arrow-trend-up"></i> Tiêu điểm</span>
                    @foreach (var t in Model.Tags.Take(6))
                    {
                        <a href="/tim-kiem?q=@t.Name" class="wi-tag-chip">@t.Name</a>
                    }
                </div>
            }

            @if (subGrid.Any())
            {
                <div class="row wi-lead-grid">
                    @foreach (var a in subGrid)
                    {
                        <div class="col-6 col-md-3 wi-grid-item">
                            <a href="@U(a)" class="wi-thumb"><img src="@T(a)" alt="@a.Title" loading="lazy" /></a>
                            <a href="@U(a)"><h3 class="wi-lc-title">@a.Title</h3></a>
                        </div>
                    }
                </div>
            }
        </div>

        <aside class="col-lg-4">
            <div class="wi-sidebox">
                <div class="wi-sidebox-tabs">
                    <div class="wi-sidebox-tab active" data-tab="new">Tin mới</div>
                    <div class="wi-sidebox-tab" data-tab="read">Đọc nhiều</div>
                </div>
                <div class="wi-sidebox-body" data-body="new">
                    @foreach (var a in Model.LatestArticles.Take(8))
                    { <a href="@U(a)" class="wi-side-item">@a.Title</a> }
                </div>
                <div class="wi-sidebox-body hidden" data-body="read">
                    @foreach (var a in Model.PopularArticles.Take(8))
                    { <a href="@U(a)" class="wi-side-item">@a.Title</a> }
                </div>
            </div>
            <div class="wi-ad-slot wi-ad-sidebar" data-ad-label="Quảng cáo · Sidebar 300×250">@await Component.InvokeAsync("AdSlot", new { position = "home_focus_rect" })</div>
        </aside>
    </div>

    <!-- ==================== DẢI 3 Ô QUẢNG CÁO ==================== -->
    <div class="row wi-ad-row">
        <div class="col-md-4"><div class="wi-ad-slot wi-ad-inline" data-ad-label="QC 300×250">@await Component.InvokeAsync("AdSlot", new { position = "home_rect_1" })</div></div>
        <div class="col-md-4"><div class="wi-ad-slot wi-ad-inline" data-ad-label="QC 300×250">@await Component.InvokeAsync("AdSlot", new { position = "home_rect_2" })</div></div>
        <div class="col-md-4"><div class="wi-ad-slot wi-ad-inline" data-ad-label="QC 300×250">@await Component.InvokeAsync("AdSlot", new { position = "home_rect_3" })</div></div>
    </div>

    <!-- ==================== HAI LUỒNG CỘT: block chính + widget sidebar ==================== -->
    <div class="row">
        <!-- CỘT CHÍNH -->
        <div class="col-lg-8">
            @{ int mIdx = 0; }
            @foreach (var blk in mainBlocks)
            {
                var lead = blk.Articles.FirstOrDefault();
                var list = blk.Articles.Skip(1).Take(4).ToList();
                var kids = childLookup.TryGetValue(blk.Category.Id, out var kk) ? kk : null;
                <section class="wi-mblock">
                    <div class="wi-mblock-head">
                        <a href="/danh-muc/@blk.Category.Slug" class="wi-mblock-title">@blk.Category.Name</a>
                        @if (kids != null && kids.Count > 0)
                        {
                            <div class="wi-mblock-subtabs">
                                @foreach (var k in kids.Take(3))
                                { <a href="/danh-muc/@k.Slug">@k.Name</a> }
                            </div>
                        }
                    </div>
                    <div class="row">
                        <div class="col-lg-6 wi-cat-lead">
                            @if (lead != null)
                            {
                                <a href="@U(lead)" class="wi-thumb"><img src="@T(lead)" alt="@lead.Title" loading="lazy" /></a>
                                @if (lead.Category != null) { <span class="wi-cat-label">@lead.Category.Name</span> }
                                <a href="@U(lead)"><h3 class="wi-lc-title">@lead.Title</h3></a>
                                <p class="wi-sapo">@lead.Summary</p>
                            }
                        </div>
                        <div class="col-lg-6">
                            @foreach (var a in list)
                            {
                                <div class="wi-cat-list-item">
                                    <div class="wi-cat-list-thumb">
                                        <a href="@U(a)" class="wi-thumb"><img src="@T(a)" alt="@a.Title" loading="lazy" /></a>
                                    </div>
                                    <div class="wi-cat-list-body">
                                        @if (a.Category != null) { <span class="wi-cat-label">@a.Category.Name</span> }
                                        <a href="@U(a)"><h4 class="wi-lc-title">@a.Title</h4></a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
                mIdx++;
                if (mIdx == 2)
                {
                    <div class="wi-ad-slot wi-ad-inline" data-ad-label="Quảng cáo · Inline 970×90">@await Component.InvokeAsync("AdSlot", new { position = "home_mid_banner" })</div>
                }
            }
        </div>

        <!-- CỘT SIDEBAR (widget + quảng cáo sticky) -->
        <aside class="col-lg-4">
            @{ int sIdx = 0; }
            @foreach (var blk in sideBlocks)
            {
                var wlead = blk.Articles.FirstOrDefault();
                var wlist = blk.Articles.Skip(1).Take(3).ToList();
                <section class="wi-widget">
                    <div class="wi-cat-head">
                        <a href="/danh-muc/@blk.Category.Slug" class="wi-cat-title">@blk.Category.Name</a>
                    </div>
                    <div class="wi-widget-lead">
                        @if (wlead != null)
                        {
                            <a href="@U(wlead)" class="wi-thumb"><img src="@T(wlead)" alt="@wlead.Title" loading="lazy" /></a>
                            <a href="@U(wlead)"><h3 class="wi-lc-title">@wlead.Title</h3></a>
                        }
                    </div>
                    @foreach (var a in wlist)
                    {
                        <div class="wi-cat-list-item">
                            <div class="wi-cat-list-thumb">
                                <a href="@U(a)" class="wi-thumb"><img src="@T(a)" alt="@a.Title" loading="lazy" /></a>
                            </div>
                            <div class="wi-cat-list-body">
                                <a href="@U(a)"><h4 class="wi-lc-title">@a.Title</h4></a>
                            </div>
                        </div>
                    }
                </section>
                sIdx++;
                if (sIdx == 1)
                {
                    <div class="wi-ad-slot wi-ad-sidebar wi-ad-sticky" style="min-height:600px;" data-ad-label="Quảng cáo · Sidebar 300×600">@await Component.InvokeAsync("AdSlot", new { position = "home_side600" })</div>
                }
            }
        </aside>
    </div>

    <!-- ==================== QUẢNG CÁO · BILLBOARD GIỮA TRANG (mã: home_billboard) ==================== -->
    <div class="wi-ad-slot wi-ad-billboard" data-ad-label="Quảng cáo · Billboard 970×250" style="min-height:250px;margin:22px 0;">
        @await Component.InvokeAsync("AdSlot", new { position = "home_billboard" })
    </div>

    <!-- ==================== MULTIMEDIA (nền xanh) ==================== -->
    @if (Model.LatestVideos.Any())
    {
        var vlead = Model.LatestVideos.First();
        var vrest = Model.LatestVideos.Skip(1).Take(6).ToList();
        Func<Video, string> VT = v => string.IsNullOrWhiteSpace(v.YouTubeId)
            ? "/images/placeholder.jpg" : $"https://img.youtube.com/vi/{v.YouTubeId}/hqdefault.jpg";
        <section class="wi-multi">
            <div class="wi-cat-head d-flex justify-content-between align-items-center">
                <a href="/video" class="wi-cat-title">Multimedia</a>
                <div class="wi-multi-menu"><a href="/video">Video</a><a href="/video">Podcast</a></div>
            </div>
            <div class="row">
                <div class="col-lg-5 wi-multi-lead">
                    <a href="/video" class="wi-thumb"><span class="wi-play-badge"><i class="fa fa-play"></i></span><img src="@VT(vlead)" alt="@vlead.Title" loading="lazy" /></a>
                    <a href="/video"><h3 class="wi-lc-title"><i class="fa fa-play wi-ntype"></i>@vlead.Title</h3></a>
                </div>
                <div class="col-lg-7">
                    <div class="row">
                        @foreach (var v in vrest)
                        {
                            <div class="col-6 col-md-4 wi-multi-item">
                                <a href="/video" class="wi-thumb"><span class="wi-play-badge"><i class="fa fa-play"></i></span><img src="@VT(v)" alt="@v.Title" loading="lazy" /></a>
                                <a href="/video"><h4 class="wi-lc-title"><i class="fa fa-play wi-ntype"></i>@v.Title</h4></a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- ==================== DÒNG TIN MỚI NHẤT (nạp sẵn 35 bài, hết mới hiện "Tải thêm bài") ==================== -->
    <section class="wi-mblock" style="margin-top:8px;">
        <div id="feedHead" class="wi-mblock-head" style="@(Model.FeedArticles.Any() ? "" : "display:none;")"><span class="wi-mblock-title">Dòng tin mới nhất</span></div>
        <div id="feedMore">
            @if (Model.FeedArticles.Any())
            {
                @await Html.PartialAsync("_FeedMore", Model.FeedArticles)
            }
        </div>
        <div id="feedLoader" style="display:none;text-align:center;padding:16px;color:var(--wi-text-soft);"><i class="fa fa-spinner fa-spin"></i> Đang tải…</div>
        <div style="text-align:center;margin:14px 0 6px;">
            <button type="button" id="feedMoreBtn" data-skip="@Model.FeedArticles.Count" class="wi-loadmore-btn"><i class="fa fa-plus" style="font-size:12px;"></i> Tải thêm bài</button>
        </div>
    </section>

    <!-- ==================== QUẢNG CÁO · BANNER TRƯỚC "ĐỪNG BỎ LỠ" (mã: home_bottom) ==================== -->
    <div class="wi-ad-slot wi-ad-inline" data-ad-label="Quảng cáo · Banner 970×90" style="min-height:90px;margin:8px 0 18px;">
        @await Component.InvokeAsync("AdSlot", new { position = "home_bottom" })
    </div>

    <!-- ==================== ĐỪNG BỎ LỠ (đánh số 1..9 — NGAY TRÊN FOOTER) ==================== -->
    @if (dontMiss.Any())
    {
        <section class="wi-dontmiss">
            <div class="wi-cat-head"><span class="wi-cat-title">Đừng bỏ lỡ</span></div>
            <div class="row">
                @{ int n = 0; }
                @foreach (var a in dontMiss)
                {
                    n++;
                    <div class="col-md-4">
                        <div class="wi-dm-item">
                            <span class="wi-dm-num">@n</span>
                            <a href="@U(a)"><h3 class="wi-lc-title">@a.Title</h3></a>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.wi-sidebox-tab').forEach(function (t) {
            t.addEventListener('click', function () {
                var box = t.closest('.wi-sidebox');
                box.querySelectorAll('.wi-sidebox-tab').forEach(function (x) { x.classList.remove('active'); });
                t.classList.add('active');
                box.querySelectorAll('.wi-sidebox-body').forEach(function (b) {
                    b.classList.toggle('hidden', b.getAttribute('data-body') !== t.getAttribute('data-tab'));
                });
            });
        });

        // "Dòng tin mới nhất" — CHỈ tải khi bấm nút, không tự cuộn, KHÔNG báo hết tin.
        (function () {
            var btn = document.getElementById('feedMoreBtn');
            var box = document.getElementById('feedMore');
            var head = document.getElementById('feedHead');
            var loader = document.getElementById('feedLoader');
            if (!btn || !box) return;
            var loading = false;
            btn.addEventListener('click', function () {
                if (loading) return;
                loading = true;
                var skip = parseInt(btn.getAttribute('data-skip') || '0', 10) || 0;
                loader.style.display = 'block';
                fetch('/Home/LoadMore?skip=' + skip, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        loader.style.display = 'none'; loading = false;
                        var t = (html || '').trim();
                        if (!t) { btn.style.display = 'none'; return; }          // hết bài -> ẩn nút, không báo gì
                        var tmp = document.createElement('div'); tmp.innerHTML = t;
                        var articleCount = tmp.querySelectorAll('.bm-list-item:not(.feed-vid)').length || 6;
                        if (articleCount === 0) { btn.style.display = 'none'; return; }
                        if (head) head.style.display = '';                       // hiện tiêu đề khi đã có tin
                        while (tmp.firstChild) box.appendChild(tmp.firstChild);
                        if (typeof attachVidHover === 'function') { try { attachVidHover(box); } catch (e) { } }
                        btn.setAttribute('data-skip', skip + articleCount);
                    })
                    .catch(function () { loader.style.display = 'none'; loading = false; });
            });
        })();
    </script>
}
