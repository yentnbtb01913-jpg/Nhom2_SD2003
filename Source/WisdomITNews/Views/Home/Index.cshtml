@model WisdomITNews.Models.HomeViewModel
@using WisdomITNews.Services
@*
    Trang chủ — re-skin theo phong cách Báo Mới (2 cột: nội dung chính + "Nóng 24H").
    Dùng nguyên HomeViewModel cũ (Featured / Latest / AI / Popular / Categories / Tags).
    Style trong wwwroot/css/baomoi-skin.css. Không đụng controller/route/model.
*@
@{
    ViewData["Title"] = "Trang Chủ";
    Layout = "_Layout";

    var shown = new HashSet<int>();

    // Tin chủ đạo (ưu tiên Featured, fallback Latest)
    var top = Model.FeaturedArticles.FirstOrDefault() ?? Model.LatestArticles.FirstOrDefault();
    if (top != null) shown.Add(top.Id);

    // Hàng 3 card nổi bật (loại trùng tin chủ đạo)
    var highlights = Model.FeaturedArticles.Concat(Model.LatestArticles)
        .Where(a => !shown.Contains(a.Id))
        .GroupBy(a => a.Id).Select(g => g.First())
        .Take(3).ToList();
    foreach (var a in highlights) shown.Add(a.Id);

    // Danh sách "Tin mới nhất" (loại các tin đã hiển thị)
    var latest = Model.LatestArticles
        .Where(a => !shown.Contains(a.Id))
        .GroupBy(a => a.Id).Select(g => g.First())
        .Take(6).ToList();
    foreach (var a in latest) shown.Add(a.Id);

    // Số bài đã hiển thị (để infinite scroll bỏ qua, tránh trùng)
    foreach (var a in Model.AIArticles) shown.Add(a.Id);
    int shownCount = shown.Count;
}

<!-- TICKER (Breaking News) -->
<div class="ticker-wrap">
    <div class="container">
        <span class="ticker-label">⚡ Nóng</span>
        <div class="ticker-track">
            <div class="ticker-content">
                @foreach (var a in Model.LatestArticles.Where(a => a.IsBreaking).Take(5).ToList().Concat(Model.LatestArticles.Where(a => a.IsBreaking).Take(5).ToList()))
                {
                    <a href="/bai-viet/@a.Slug" style="color:#fff;text-decoration:none;">@a.Title</a>
                }
                @if (!Model.LatestArticles.Any(a => a.IsBreaking))
                {
                    @foreach (var a in Model.LatestArticles.Take(3).ToList().Concat(Model.LatestArticles.Take(3).ToList()))
                    {
                        <a href="/bai-viet/@a.Slug" style="color:#fff;text-decoration:none;">@a.Title</a>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Dải quảng cáo "Trang Chủ" (home_left/home_right) — hiện ở 2 gutter trái/phải khi màn hình đủ rộng,
     sticky trong vùng nội dung, tự ẩn trên tablet/mobile, không hiện khung rỗng nếu không có QC. -->
<div class="home-rail-wrap">
    <aside class="home-rail home-rail-left">
        @await Component.InvokeAsync("AdSlot", new { position = "home_left" })
    </aside>

    <div class="bm-home container">
    <div class="bm-grid">

        <!-- ===================== CỘT CHÍNH ===================== -->
        <main class="bm-main">

            <!-- Tin chủ đạo: tiêu đề trái + ảnh phải -->
            @if (top != null)
            {
                <article class="bm-top-story" onclick="location.href='/bai-viet/@top.Slug'">
                    <div class="bm-ts-text">
                        <div class="bm-meta"><span class="bm-cat">@top.Category?.Icon @top.Category?.Name</span></div>
                        <h2><a href="/bai-viet/@top.Slug">@top.Title</a></h2>
                        <div class="bm-meta">
                            <span><i class="fa fa-clock"></i> @SlugHelper.FormatDate(top.PublishedAt)</span>
                            <span class="sep">·</span>
                            <span><i class="fa fa-eye"></i> @SlugHelper.FormatViews(top.Views)</span>
                        </div>
                        <p class="bm-desc">@top.Summary</p>
                    </div>
                    <div class="bm-ts-thumb">
                        @if (!string.IsNullOrWhiteSpace(top.Thumbnail))
                        {
                            <img src="@top.Thumbnail" alt="@top.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="bm-noimg"></div>
                        }
                    </div>
                </article>
            }

            <!-- Hàng 3 card -->
            @if (highlights.Any())
            {
                <div class="bm-cards3">
                    @foreach (var a in highlights)
                    {
                        <article class="bm-card" onclick="location.href='/bai-viet/@a.Slug'">
                            <div class="bm-thumb" style="position:relative;">
                                @if (!string.IsNullOrWhiteSpace(a.Thumbnail))
                                {
                                    <img src="@a.Thumbnail" alt="@a.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="bm-noimg"></div>
                                }
                            </div>
                            <h4><a href="/bai-viet/@a.Slug">@a.Title</a></h4>
                            <div class="bm-meta">
                                <span class="bm-cat">@a.Category?.Name</span>
                                <span class="sep">·</span>
                                <span>@SlugHelper.FormatDate(a.PublishedAt)</span>
                            </div>
                        </article>
                    }
                </div>
            }

            <!-- Dải chip chủ đề -->
            @if (Model.Categories.Any())
            {
                <div class="bm-chips">
                    @foreach (var c in Model.Categories.Take(6))
                    {
                        <a class="bm-chip" href="/danh-muc/@c.Slug"># @c.Name</a>
                    }
                </div>
            }

            <!-- Tin mới nhất (danh sách ảnh-trái) -->
            @if (latest.Any())
            {
                <section class="bm-section">
                    <div class="bm-section-head">
                        <h3>Tin mới nhất</h3>
                        <a class="bm-more" href="/danh-muc">Xem tất cả ›</a>
                    </div>
                    @foreach (var a in latest)
                    {
                        <div class="bm-list-item" onclick="location.href='/bai-viet/@a.Slug'">
                            <div class="bm-thumb" style="position:relative;">
                                @if (!string.IsNullOrWhiteSpace(a.Thumbnail))
                                {
                                    <img src="@a.Thumbnail" alt="@a.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="bm-noimg"></div>
                                }
                            </div>
                            <div class="bm-it-body">
                                <div class="bm-meta"><span class="bm-cat">@a.Category?.Icon @a.Category?.Name</span></div>
                                <h4><a href="/bai-viet/@a.Slug">@a.Title</a></h4>
                                <p class="bm-desc">@a.Summary</p>
                                <div class="bm-meta">
                                    <span><i class="fa fa-clock"></i> @SlugHelper.FormatDate(a.PublishedAt)</span>
                                    <span class="sep">·</span>
                                    <span><i class="fa fa-eye"></i> @SlugHelper.FormatViews(a.Views)</span>
                                </div>
                            </div>
                        </div>
                    }
                </section>
            }

            <!-- Góc AI & Công nghệ (giữ chất báo IT) -->
            @if (Model.AIArticles.Any())
            {
                <section class="bm-section bm-ai">
                    <div class="bm-section-head">
                        <h3><span class="hash">#</span>GÓC AI &amp; CÔNG NGHỆ</h3>
                        <a class="bm-more" href="/danh-muc/ai-machine-learning">Xem tất cả ›</a>
                    </div>
                    <div class="bm-cards3">
                        @foreach (var a in Model.AIArticles)
                        {
                            <article class="bm-card" onclick="location.href='/bai-viet/@a.Slug'">
                                <div class="bm-thumb" style="position:relative;">
                                    @if (!string.IsNullOrWhiteSpace(a.Thumbnail))
                                    {
                                        <img src="@a.Thumbnail" alt="@a.Title" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="bm-noimg"></div>
                                    }
                                </div>
                                <h4><a href="/bai-viet/@a.Slug">@a.Title</a></h4>
                                <div class="bm-meta">
                                    <span>@SlugHelper.FormatDate(a.PublishedAt)</span>
                                    <span class="sep">·</span>
                                    <span>@SlugHelper.FormatViews(a.Views) xem</span>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
            <!-- Infinite scroll: tự nạp thêm bài sau Góc AI (có video xen kẽ) -->
            <div id="feedMore"></div>
            <div id="feedLoader" style="display:none;text-align:center;padding:18px;color:#94a3b8;font-size:14px;"><i class="fa fa-spinner fa-spin"></i> Đang tải thêm bài...</div>
            <div id="feedEnd" style="display:none;text-align:center;padding:18px;color:#cbd5e1;font-size:13px;">— Bạn đã xem hết tin —</div>
            <div id="feedSentinel" data-skip="@shownCount" style="height:1px;"></div>
        </main>

        <!-- ===================== SIDEBAR ===================== -->
        <aside class="bm-aside">

            <!-- Nóng 24H = Xem nhiều nhất -->
            @if (Model.PopularArticles.Any())
            {
                <div class="bm-widget">
                    <div class="bm-widget-head">Nóng 24H</div>
                    @{ var rank = 0; }
                    @foreach (var a in Model.PopularArticles)
                    {
                        rank++;
                        <div class="bm-rank-item @(rank <= 3 ? "top" : "")" onclick="location.href='/bai-viet/@a.Slug'">
                            <div class="bm-rank-num">@rank</div>
                            <h4><a href="/bai-viet/@a.Slug">@a.Title</a></h4>
                        </div>
                    }
                </div>
            }

            <!-- Chủ đề (danh mục) -->
            @if (Model.Categories.Any())
            {
                <div class="bm-widget">
                    <div class="bm-widget-head">Chủ đề</div>
                    <div class="bm-cats">
                        @foreach (var c in Model.Categories)
                        {
                            <a href="/danh-muc/@c.Slug">@c.Icon @c.Name</a>
                        }
                    </div>
                </div>
            }

            <!-- Tag phổ biến -->
            @if (Model.Tags.Any())
            {
                <div class="bm-widget">
                    <div class="bm-widget-head">Chủ đề phổ biến</div>
                    <div class="bm-tagcloud">
                        @foreach (var t in Model.Tags)
                        {
                            <a href="/tim-kiem?q=@Uri.EscapeDataString(t.Name)">@t.Name</a>
                        }
                    </div>
                </div>
            }
            <!-- Cột Video (tìm kiếm + cuộn) — dính đáy màn hình -->
            @await Component.InvokeAsync("VideoSidebar")

        </aside>

    </div>
    </div>

    <aside class="home-rail home-rail-right">
        @await Component.InvokeAsync("AdSlot", new { position = "home_right" })
    </aside>
</div>

@section Scripts {
<style>
    .feed-vid { position: relative; }
    .feed-vid .feed-vid-badge {
        position: absolute; top: 6px; left: 6px; z-index: 2;
        background: #e63946; color: #fff; font-size: 10px; font-weight: 800;
        padding: 2px 8px; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,.3);
    }
    .vid-hover .bm-thumb, .vid-hover .vid-thumb { overflow: hidden; }
    .vid-hover:hover { cursor: pointer; }
    .vid-hover .vid-thumb img { transition: transform .3s ease; }
    .vid-hover:hover .vid-thumb img { transform: scale(1.05); }
</style>
<script>
(function () {
    // ---- Hover preview: phát video thật (tắt tiếng) khi di chuột vào ----
    function attachVidHover(root) {
        (root || document).querySelectorAll('.vid-hover:not([data-hooked])').forEach(function (el) {
            el.setAttribute('data-hooked', '1');
            var thumb = el.querySelector('.vid-thumb') || el.querySelector('.bm-thumb');
            if (!thumb) return;
            var yt = el.getAttribute('data-yt') || '';
            var type = el.getAttribute('data-type') || '';
            var vurl = el.getAttribute('data-vurl') || '';
            var orig = thumb.innerHTML, timer = null;
            el.addEventListener('mouseenter', function () {
                timer = setTimeout(function () {
                    if (type === 'upload' && vurl) {
                        thumb.innerHTML = '<video src="' + vurl + '" autoplay muted loop playsinline style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;"></video>';
                    } else if (yt) {
                        thumb.innerHTML = '<iframe src="https://www.youtube.com/embed/' + yt + '?autoplay=1&mute=1&controls=0&loop=1&playlist=' + yt + '&modestbranding=1&rel=0&playsinline=1" allow="autoplay" frameborder="0" style="width:100%;height:100%;border:0;position:absolute;inset:0;"></iframe>';
                    }
                }, 320);
            });
            el.addEventListener('mouseleave', function () {
                if (timer) { clearTimeout(timer); timer = null; }
                thumb.innerHTML = orig;
            });
        });
    }
    window.attachVidHover = attachVidHover;
    attachVidHover(document);

    // ---- Infinite scroll: tự nạp thêm bài sau Góc AI ----
    var sentinel = document.getElementById('feedSentinel');
    var box = document.getElementById('feedMore');
    var loader = document.getElementById('feedLoader');
    var endMsg = document.getElementById('feedEnd');
    if (sentinel && box) {
        var skip = parseInt(sentinel.getAttribute('data-skip') || '0', 10) || 0;
        var loading = false, done = false;

        var MAX_MORE = 18; // giới hạn số bài nạp thêm để còn thấy footer
        function loadMore() {
            if (loading || done) return;
            if (skip >= MAX_MORE) { done = true; if (endMsg) endMsg.style.display = 'block'; return; }
            loading = true;
            loader.style.display = 'block';
            fetch('/Home/LoadMore?skip=' + skip, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    var t = (html || '').trim();
                    if (!t) { done = true; loader.style.display = 'none'; endMsg.style.display = 'block'; return; }
                    var tmp = document.createElement('div');
                    tmp.innerHTML = t;
                    // đếm số bài viết thật (không tính thẻ video) để tăng skip đúng
                    var articleCount = tmp.querySelectorAll('.bm-list-item:not(.feed-vid)').length;
                    while (tmp.firstChild) box.appendChild(tmp.firstChild);
                    attachVidHover(box);
                    skip += articleCount;
                    loader.style.display = 'none';
                    loading = false;
                    if (articleCount === 0) { done = true; endMsg.style.display = 'block'; }
                })
                .catch(function () { loader.style.display = 'none'; loading = false; });
        }

        if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
                if (entries[0].isIntersecting) loadMore();
            }, { rootMargin: '400px' });
            io.observe(sentinel);
        } else {
            window.addEventListener('scroll', function () {
                if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 500) loadMore();
            });
        }
    }
})();
</script>
}
