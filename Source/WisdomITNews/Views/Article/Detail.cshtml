@model WisdomITNews.Models.ArticleViewModel
@using WisdomITNews.Services
@{
    ViewData["Title"] = Model.Article.Title;
    Layout = "_Layout";
    var article = Model.Article;
    var authorName = article.Author?.FullName ?? "Admin";
    var authorInitial = string.IsNullOrWhiteSpace(authorName) ? "A" : authorName.Substring(0, 1).ToUpper();
    var allComments = Model.Comments ?? new List<WisdomITNews.Models.Comment>();
    var rootComments = allComments.Where(c => c.ParentCommentId == null || c.ParentCommentId == 0).OrderBy(c => c.CreatedAt).ToList();
    var sessionUserId = Context.Session.GetInt32("UserId");
    var sessionUserName = Context.Session.GetString("UserName") ?? "";
}
@section Head {
    @{
        var _canon = $"{Context.Request.Scheme}://{Context.Request.Host}/bai-viet/{article.Slug}";
        var _img = string.IsNullOrWhiteSpace(article.Thumbnail) ? null
            : (article.Thumbnail.StartsWith("http") ? article.Thumbnail : $"{Context.Request.Scheme}://{Context.Request.Host}{article.Thumbnail}");
        var _author = article.AuthorUser?.FullName ?? article.Author?.FullName ?? "Wisdom IT News";
        var _ld = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "NewsArticle",
            ["headline"] = article.Title,
            ["description"] = article.Summary,
            ["image"] = _img,
            ["datePublished"] = article.PublishedAt?.ToString("yyyy-MM-ddTHH:mm:sszzz"),
            ["dateModified"] = article.UpdatedAt.ToString("yyyy-MM-ddTHH:mm:sszzz"),
            ["mainEntityOfPage"] = _canon,
            ["author"] = new Dictionary<string, object> { ["@type"] = "Person", ["name"] = _author },
            ["publisher"] = new Dictionary<string, object> { ["@type"] = "Organization", ["name"] = "Wisdom IT News" }
        }, new System.Text.Json.JsonSerializerOptions
        {
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
        });
    }
    <meta name="description" content="@article.Summary" />
    <link rel="canonical" href="@_canon" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="@article.Title" />
    <meta property="og:description" content="@article.Summary" />
    <meta property="og:url" content="@_canon" />
    <meta property="og:site_name" content="Wisdom IT News" />
    @if (!string.IsNullOrEmpty(_img)) { <meta property="og:image" content="@_img" /> }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@article.Title" />
    <meta name="twitter:description" content="@article.Summary" />
    @if (!string.IsNullOrEmpty(_img)) { <meta name="twitter:image" content="@_img" /> }
    <script type="application/ld+json">@Html.Raw(_ld)</script>
}
<div id="readProgress" class="read-progress"></div>
<div class="breadcrumb">
    <div class="container">
        <ul class="breadcrumb-list">
            <li><a href="/"><i class="fa fa-home"></i> Trang chủ</a></li>
            @if (article.Category != null)
            {
                <li><a href="/danh-muc/@article.Category.Slug">@article.Category.Icon @article.Category.Name</a></li>
            }
            <li>@article.Title</li>
        </ul>
    </div>
</div>
<div class="page-wrapper">
    <main>
        <div class="article-header">
            @if (article.Category != null)
            {
                <span class="badge" style="background:@(article.Category.Color ?? "#ba1a1a");margin-bottom:12px;">
                    @article.Category.Icon @article.Category.Name
                </span>
            }
            <h1 class="article-title">@article.Title</h1>
            <p class="article-sapo" style="color:var(--text-dark);">@article.Summary</p>
            <div class="article-meta">
                <div class="meta-author">
                    <div class="author-avatar">@authorInitial</div>
                    <div>
                        <div class="author-name">@authorName</div>
                        <div class="author-role">@(article.Author?.Role ?? "Editor")</div>
                    </div>
                </div>
                <div class="meta-stats">
                    <span><i class="fa fa-calendar"></i> @SlugHelper.FormatDate(article.PublishedAt)</span>
                    <span><i class="fa fa-eye"></i> @SlugHelper.FormatViews(article.Views) lượt xem</span>
                    <span><i class="fa fa-comments"></i> @allComments.Count bình luận</span>
                </div>
            </div>

            @{ var _ap = ViewBag.AuthorProfile as WisdomITNews.Models.JournalistProfile; }
            @if (article.IsExternal && !string.IsNullOrWhiteSpace(article.SourceUrl))
            {
                string _host = ""; try { _host = new Uri(article.SourceUrl).Host; } catch { }
                <div style="display:flex;align-items:center;gap:14px;background:#f3fafb;border:1px solid #e6f4f5;border-radius:12px;padding:14px 16px;margin:16px 0;">
                    <img src="@(string.IsNullOrEmpty(_host) ? "" : $"https://www.google.com/s2/favicons?domain={_host}&sz=64")" alt="@article.SourceName" style="width:48px;height:48px;border-radius:50%;object-fit:cover;background:#fff;border:1px solid #e5e7eb;" onerror="this.style.visibility='hidden'" />
                    <div style="flex:1;min-width:0;">
                        <div style="font-weight:700;font-size:15px;color:#0e7d85;">@article.SourceName</div>
                        <div style="font-size:12.5px;color:#6b7280;">Bài tổng hợp · Nguồn ngoài</div>
                    </div>
                    <a href="@article.SourceUrl" target="_blank" rel="noopener noreferrer" style="background:#0e7d85;color:#fff;padding:8px 14px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;white-space:nowrap;"><i class="fa fa-up-right-from-square"></i> Đọc bài gốc</a>
                </div>
            }
            else if (article.AuthorUser != null)
            {
                <div style="display:flex;align-items:center;gap:14px;background:#f3fafb;border:1px solid #e6f4f5;border-radius:12px;padding:14px 16px;margin:16px 0;">
                    <img src="@(string.IsNullOrEmpty(article.AuthorUser.AvatarUrl) ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(article.AuthorUser.FullName)}&background=0e7d85&color=fff" : article.AuthorUser.AvatarUrl)" alt="@article.AuthorUser.FullName" style="width:52px;height:52px;border-radius:50%;object-fit:cover;" />
                    <div style="flex:1;min-width:0;">
                        <div style="font-weight:700;font-size:15px;color:#0e7d85;">@(string.IsNullOrWhiteSpace(_ap?.PenName) ? article.AuthorUser.FullName : _ap.PenName)</div>
                        <div style="font-size:12.5px;color:#6b7280;">@(_ap?.JobTitle ?? "Nhà báo")@(string.IsNullOrWhiteSpace(_ap?.Organization) ? "" : " · " + _ap.Organization)</div>
                    </div>
                    <div style="display:flex;gap:12px;font-size:18px;">
                        @if (!string.IsNullOrWhiteSpace(_ap?.Facebook)) { <a href="@_ap.Facebook" target="_blank" style="color:#1877f2;"><i class="fa-brands fa-facebook"></i></a> }
                        @if (!string.IsNullOrWhiteSpace(_ap?.LinkedIn)) { <a href="@_ap.LinkedIn" target="_blank" style="color:#0a66c2;"><i class="fa-brands fa-linkedin"></i></a> }
                        @if (!string.IsNullOrWhiteSpace(_ap?.Twitter)) { <a href="@_ap.Twitter" target="_blank" style="color:#111;"><i class="fa-brands fa-x-twitter"></i></a> }
                    </div>
                </div>
            }

            <!-- AI Tools Bar -->
            <div style="display:flex;align-items:center;gap:10px;margin-top:16px;padding-top:16px;border-top:1px solid var(--border);flex-wrap:wrap;">
                <span style="font-size:12px;font-weight:700;color:var(--ai-color);text-transform:uppercase;letter-spacing:.5px;display:flex;align-items:center;gap:6px;">
                    <i class="fa fa-robot"></i> AI Tools
                </span>
                <button onclick="toggleSummary()" style="background:var(--ai-color);color:#fff;border:none;padding:8px 16px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all .2s;">
                    <i class="fa fa-magic-wand-sparkles"></i> Tóm tắt bằng AI
                </button>
                <button onclick="shareArticle()" style="background:var(--bg-gray);color:var(--text-dark);border:1px solid var(--border);padding:8px 16px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all .2s;">
                    <i class="fa fa-share-nodes"></i> Chia sẻ
                </button>
                @if (ViewBag.CanSave == true)
                {
                    var _saved = ViewBag.IsSaved == true;
                    <button id="btnSave" onclick="toggleSave(@article.Id, this)" style="background:@(_saved ? "#0e7d85" : "var(--bg-gray)");color:@(_saved ? "#fff" : "var(--text-dark)");border:1px solid var(--border);padding:8px 16px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;">
                        <i class="fa fa-bookmark"></i> <span>@(_saved ? "Đã lưu" : "Lưu")</span>
                    </button>
                }
            </div>
        </div>

        @if (article.IsExternal && !string.IsNullOrWhiteSpace(article.SourceUrl))
        {
            <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:14px 16px;margin:18px 0;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <span style="font-size:13.5px;color:#1e3a8a;"><i class="fa fa-newspaper"></i> Bài tổng hợp — Nguồn: <strong>@article.SourceName</strong></span>
                <a href="@article.SourceUrl" target="_blank" rel="noopener noreferrer" style="margin-left:auto;background:#0e7d85;color:#fff;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;"><i class="fa fa-up-right-from-square"></i> Đọc bài gốc</a>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(article.AiSummary))
        {
            <div class="tldr-box" style="background:#e6f4f5;border-left:4px solid #0e7d85;border-radius:10px;padding:16px 18px;margin:18px 0;">
                <div style="font-weight:700;color:#0e7d85;font-size:13px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;"><i class="fa fa-bolt"></i> Tóm tắt nhanh</div>
                <div style="font-size:14.5px;line-height:1.7;color:#1f2937;white-space:pre-line;">@article.AiSummary</div>
            </div>
        }
        <div id="summaryBox" class="ai-summary-box" style="display:none;">
            <div class="ai-summary-header">
                <i class="fa fa-robot"></i>
                <h3>Tóm tắt bởi AI</h3>
                <button class="close-btn" onclick="closeSummary()"><i class="fa fa-times"></i></button>
            </div>
            <div id="summaryContent" class="ai-summary-content">
                <div class="loading-dots"><span></span><span></span><span></span></div>
            </div>
            <div class="ai-summary-footer">
                <span id="tokenInfo"></span>
                <span>Powered by AI</span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(article.Thumbnail))
        {
            <div class="article-thumbnail">
                <img src="@article.Thumbnail" alt="@(article.ThumbnailAlt ?? article.Title)" />
            </div>
        }
        <div class="article-body">
            @if (article.IsPremiumOnly)
            {
                <div style="display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,#0e7d85,#0ea5a0);color:#fff;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:800;margin-bottom:12px;"><i class="fa fa-crown"></i> PREMIUM</div>
            }
            @{ var _podcast = ViewBag.Podcast as WisdomITNews.Models.Podcast; }
            @if (_podcast != null)
            {
                <div class="article-audio" style="background:#f0fdfa;border:1px solid #99e1cb;border-radius:8px;padding:12px 16px;margin:0 0 18px;">
                    <div style="font-weight:700;color:#0e7d85;margin-bottom:8px;"><i class="fa fa-headphones"></i> Nghe bài viết @(_podcast.IsAiGenerated ? "(giọng đọc AI)" : "")</div>
                    <audio controls preload="none" src="@_podcast.FilePath" style="width:100%;"></audio>
                </div>
            }
            @{ var _premiumLocked = (bool)(ViewBag.IsPremiumLocked ?? false); }
            @if (_premiumLocked)
            {
                <div class="article-content" style="position:relative;">
                    <div style="max-height:220px;overflow:hidden;-webkit-mask-image:linear-gradient(#000 55%,transparent);mask-image:linear-gradient(#000 55%,transparent);">
                        <p>@WisdomITNews.Services.PremiumAccess.Preview(article.Content)</p>
                    </div>
                    <div style="text-align:center;border:1px solid #d7ece9;background:#f0fdfa;border-radius:12px;padding:26px 20px;margin-top:8px;">
                        <div style="font-size:40px;color:#0e7d85;margin-bottom:8px;"><i class="fa fa-lock"></i></div>
                        <h3 style="margin:0 0 6px;color:#0f172a;">Nội dung dành cho thành viên Premium</h3>
                        <p style="color:#64748b;margin:0 0 16px;">Nâng cấp gói Premium để đọc trọn vẹn bài viết này và toàn bộ nội dung cao cấp khác.</p>
                        <a href="/Subscription/Pricing" style="display:inline-block;background:#0e7d85;color:#fff;text-decoration:none;padding:12px 26px;border-radius:8px;font-weight:700;"><i class="fa fa-crown"></i> Nâng cấp Premium để đọc tiếp</a>
                    </div>
                </div>
            }
            else
            {
                <div class="article-content">
                    @Html.Raw(article.Content)
                    @await Component.InvokeAsync("AdSlot", new { position = "in_article" })
                </div>
            }
            @if (Model.Tags.Any())
            {
                <div class="article-tags">
                    @foreach (var tag in Model.Tags)
                    {
                        <a href="/tim-kiem?q=@Uri.EscapeDataString(tag.Name)" class="tag-link">#@tag.Name</a>
                    }
                </div>
            }
        </div>
        <div class="share-bar" data-share-url="@Context.Request.Scheme://@Context.Request.Host/bai-viet/@article.Slug">
            <span class="share-bar-label"><i class="fa fa-share-nodes"></i> Chia sẻ:</span>
            <a href="https://www.facebook.com/sharer.php?u=@Uri.EscapeDataString($"{Context.Request.Scheme}://{Context.Request.Host}/bai-viet/{article.Slug}")"
               target="_blank" class="share-btn share-fb"><i class="fa-brands fa-facebook-f"></i> Facebook</a>
            <button class="share-btn share-copy js-share-copy"><i class="fa fa-link"></i> Sao chép</button>
            <span class="share-toast"></span>
        </div>
        <div class="author-box">
            <div class="author-box-avatar">@authorInitial</div>
            <div class="author-box-info">
                <div class="role"><i class="fa fa-pen-nib"></i> Tác giả</div>
                <h3 style="font-family:'Playfair Display',serif;font-size:18px;">@authorName</h3>
                <p style="font-size:13px;color:var(--text-muted);margin-top:6px;">@(article.Author?.Role ?? "Editor") tại Wisdom IT News</p>
            </div>
        </div>
        <!-- Comments Section -->
        <div class="comments-section">
            <h2 class="comments-title">
                <i class="fa fa-comments"></i> Bình luận
                <span class="comment-count">@allComments.Count</span>
            </h2>
            <div class="comment-form">
                @if (sessionUserId.HasValue)
                {
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding:10px;background:var(--bg-gray);border-radius:0px;">
                        <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#0a2540,#476083);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;">
                            @(string.IsNullOrWhiteSpace(sessionUserName) ? "?" : sessionUserName.Substring(0, 1).ToUpper())
                        </div>
                        <span style="font-weight:600;font-size:14px;">Bình luận với tên: <strong>@sessionUserName</strong></span>
                    </div>
                    <input type="hidden" id="cName" value="@sessionUserName" />
                    <input type="hidden" id="cEmail" value="" />
                }
                else
                {
                    <div class="comment-form-row">
                        <input type="text" id="cName" placeholder="Họ và tên *" maxlength="80" />
                        <input type="email" id="cEmail" placeholder="Email (tuỳ chọn)" maxlength="120" />
                    </div>
                }
                <textarea id="cText" placeholder="Viết bình luận của bạn..." maxlength="1000"></textarea>
                <button class="btn-comment" onclick="submitComment(@article.Id)">
                    <i class="fa fa-paper-plane"></i> Gửi bình luận
                </button>
            </div>
            <div id="commentList" class="comment-tree">
                @if (!rootComments.Any())
                {
                    <p style="text-align:center;color:var(--text-muted);padding:24px 0;font-size:14px;">
                        Chưa có bình luận nào. Hãy là người đầu tiên!
                    </p>
                }
                @foreach (var comment in rootComments)
                {
                    @await Html.PartialAsync("_CommentNode", comment, new ViewDataDictionary(ViewData) {
                { "AllComments", allComments },
                { "Depth", 0 }
            })
                }
            </div>
        </div>

        <!-- Bài cùng thể loại — tự load khi cuộn -->
        @if (article.CategoryId != null)
        {
            <section class="bm-section" id="relatedFeed" style="margin-top:26px;">
                <div class="bm-section-head"><h3 style="font-size:18px;font-weight:800;"><span class="hash" style="color:#e63946;">#</span> BÀI CÙNG THỂ LOẠI</h3></div>
                <div id="relatedMore"></div>
                <div id="relatedLoader" style="display:none;text-align:center;padding:16px;color:#94a3b8;font-size:14px;"><i class="fa fa-spinner fa-spin"></i> Đang tải bài cùng thể loại...</div>
                <div id="relatedEnd" style="display:none;text-align:center;padding:16px;color:#cbd5e1;font-size:13px;">— Đã hết bài cùng thể loại —</div>
                <div id="relatedSentinel" data-cat="@article.CategoryId" data-exclude="@article.Id" data-skip="0" style="height:1px;"></div>
            </section>
        }

        <!-- Bài báo bạn có thể thích (toàn bộ) — hiện sau khi hết bài cùng thể loại -->
        <section class="bm-section" id="suggestedFeed" style="margin-top:26px;display:none;">
            <div class="bm-section-head"><h3 style="font-size:18px;font-weight:800;"><span class="hash" style="color:#0e7d85;">#</span> BÀI BÁO BẠN CÓ THỂ THÍCH</h3></div>
            <div id="suggestedMore"></div>
            <div id="suggestedLoader" style="display:none;text-align:center;padding:16px;color:#94a3b8;font-size:14px;"><i class="fa fa-spinner fa-spin"></i> Đang tải thêm bài...</div>
            <div id="suggestedEnd" style="display:none;text-align:center;padding:16px;color:#cbd5e1;font-size:13px;">— Đã hiển thị hết bài viết —</div>
            <div id="suggestedSentinel" data-exclude="@article.Id" data-skip="0" style="height:1px;"></div>
        </section>
    </main>
    <aside class="sidebar">
        @await Component.InvokeAsync("AdSlot", new { position = "sidebar" })
        @if (Model.RelatedArticles.Any())
        {
            <div class="sidebar-widget">
                <div class="widget-header"><i class="fa fa-link"></i> Bài viết liên quan</div>
                <div class="widget-body">
                    @foreach (var r in Model.RelatedArticles)
                    {
                        <div class="related-item" onclick="location.href='/bai-viet/@r.Slug'">
                            <div class="related-thumb">
                                <img src="@(string.IsNullOrWhiteSpace(r.Thumbnail) ? "/images/placeholder.jpg" : r.Thumbnail)" alt="@r.Title" loading="lazy" />
                            </div>
                            <div>
                                <div class="related-title">@r.Title</div>
                                <div class="related-meta"><i class="fa fa-eye"></i> @SlugHelper.FormatViews(r.Views)</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        <div class="sidebar-widget">
            <div class="widget-header hot"><i class="fa fa-fire"></i> Xem nhiều nhất</div>
            <div class="widget-body">
                @for (int i = 0; i < Model.PopularArticles.Count; i++)
                {
                    var p = Model.PopularArticles[i];
                    <div class="hot-item" onclick="location.href='/bai-viet/@p.Slug'">
                        <span class="hot-num @(i < 3 ? "top" : "rest")">@(i + 1)</span>
                        <span class="hot-item-title">@p.Title</span>
                    </div>
                }
            </div>
        </div>

        @* Cột Video — cố định (sticky) dưới "Xem nhiều nhất" *@
        @await Component.InvokeAsync("VideoSidebar")
    </aside>
</div>

<!-- AI Chatbot Popup -->
<button class="chatbot-toggle" onclick="toggleChatbot()" title="Trợ lý AI">
    <i class="fa fa-robot" id="chatbotIcon"></i>
</button>
<div class="chatbot-panel" id="chatbotPanel">
    <div class="chatbot-header">
        <span><i class="fa fa-robot"></i> Wisdom AI Bot</span>
        <button class="chatbot-close" onclick="toggleChatbot()">&times;</button>
    </div>
    <div class="chatbot-messages" id="chatbotMessages">
        <div class="chatbot-msg bot">Xin chào! Tôi là trợ lý AI của WisdomITNews. Hỏi tôi bất cứ điều gì về công nghệ, lập trình hoặc AI nhé!</div>
    </div>
    <form class="chatbot-form" onsubmit="sendBotMsg(event)">
        <input type="text" id="chatbotInput" placeholder="Nhập câu hỏi..." autocomplete="off">
        <button type="submit" id="chatbotSendBtn"><i class="fa fa-paper-plane"></i></button>
    </form>
</div>

@section Scripts {
    <script>
        var ARTICLE_ID = @article.Id;
        var summaryLoaded = false;

        // ===== Tự load "bài cùng thể loại" -> hết thì "bài bạn có thể thích" (toàn bộ) =====
        (function () {
            // --- Gợi ý (toàn bộ bài, trừ bài hiện tại) ---
            var sSen = document.getElementById('suggestedSentinel');
            var sBox = document.getElementById('suggestedMore');
            var sSec = document.getElementById('suggestedFeed');
            var sLoader = document.getElementById('suggestedLoader');
            var sEnd = document.getElementById('suggestedEnd');
            var sExclude = sSen ? sSen.getAttribute('data-exclude') : '0';
            var sSkip = 0, sLoading = false, sDone = false, sStarted = false;

            function loadSuggested() {
                if (sLoading || sDone) return;
                sLoading = true; if (sLoader) sLoader.style.display = 'block';
                fetch('/Article/LoadSuggested?excludeId=' + sExclude + '&skip=' + sSkip)
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        var t = (html || '').trim();
                        if (!t) { sDone = true; if (sLoader) sLoader.style.display = 'none'; if (sEnd) sEnd.style.display = 'block'; return; }
                        var tmp = document.createElement('div'); tmp.innerHTML = t;
                        var n = tmp.querySelectorAll('.bm-list-item').length;
                        while (tmp.firstChild) sBox.appendChild(tmp.firstChild);
                        sSkip += n; sLoading = false; if (sLoader) sLoader.style.display = 'none';
                        if (n === 0) { sDone = true; if (sEnd) sEnd.style.display = 'block'; }
                    })
                    .catch(function () { sLoading = false; if (sLoader) sLoader.style.display = 'none'; });
            }
            function startSuggested() {
                if (sStarted || !sSen || !sBox) return; sStarted = true;
                if (sSec) sSec.style.display = '';
                if ('IntersectionObserver' in window) {
                    var io2 = new IntersectionObserver(function (e) { if (e[0].isIntersecting) loadSuggested(); }, { rootMargin: '400px' });
                    io2.observe(sSen);
                } else {
                    window.addEventListener('scroll', function () { if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 400) loadSuggested(); });
                }
                loadSuggested();
            }

            // --- Cùng thể loại ---
            var sentinel = document.getElementById('relatedSentinel');
            var box = document.getElementById('relatedMore');
            if (!sentinel || !box) { startSuggested(); return; }   // không có mục cùng thể loại -> gợi ý luôn
            var cat = sentinel.getAttribute('data-cat');
            var exclude = sentinel.getAttribute('data-exclude');
            var skip = parseInt(sentinel.getAttribute('data-skip') || '0', 10) || 0;
            var loading = false, done = false;
            var loader = document.getElementById('relatedLoader');
            var endMsg = document.getElementById('relatedEnd');

            function loadRelated() {
                if (loading || done) return;
                loading = true; if (loader) loader.style.display = 'block';
                fetch('/Article/LoadRelated?categoryId=' + cat + '&excludeId=' + exclude + '&skip=' + skip)
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        var t = (html || '').trim();
                        if (!t) { done = true; if (loader) loader.style.display = 'none'; if (endMsg) endMsg.style.display = 'block'; startSuggested(); return; }
                        var tmp = document.createElement('div'); tmp.innerHTML = t;
                        var n = tmp.querySelectorAll('.bm-list-item').length;
                        while (tmp.firstChild) box.appendChild(tmp.firstChild);
                        skip += n; loading = false; if (loader) loader.style.display = 'none';
                        if (n === 0) { done = true; if (endMsg) endMsg.style.display = 'block'; startSuggested(); }
                    })
                    .catch(function () { loading = false; if (loader) loader.style.display = 'none'; });
            }

            if ('IntersectionObserver' in window) {
                var io = new IntersectionObserver(function (e) { if (e[0].isIntersecting) loadRelated(); }, { rootMargin: '400px' });
                io.observe(sentinel);
            } else {
                window.addEventListener('scroll', function () {
                    if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 500) loadRelated();
                });
            }
        })();

        function toggleSummary() {
            var box = document.getElementById('summaryBox');
            if (box.style.display !== 'none') { closeSummary(); return; }
            box.style.display = 'block';
            box.scrollIntoView({ behavior: 'smooth' });
            if (summaryLoaded) return;
            document.getElementById('summaryContent').innerHTML = '<p style="text-align:center;padding:20px;">AI đang đọc bài báo...</p>';
            fetch('/api/summarize', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ articleId: ARTICLE_ID }) })
                .then(function (r) { return r.json(); }).then(function (d) {
                    if (d.success) {
                        document.getElementById('summaryContent').innerHTML = d.summary;
                        document.getElementById('tokenInfo').textContent = d.cached ? 'Từ cache' : 'Tokens: ' + d.tokens;
                        summaryLoaded = true;
                    } else {
                        document.getElementById('summaryContent').innerHTML = '<p style="color:#ba1a1a">Lỗi khi tóm tắt.</p>';
                    }
                }).catch(function () { document.getElementById('summaryContent').innerHTML = '<p style="color:#ba1a1a">Lỗi kết nối.</p>'; });
        }

        function closeSummary() {
            document.getElementById('summaryBox').style.display = 'none';
        }

        async function toggleSave(id, btn){
            const r = await fetch('/Account/ToggleSave/'+id,{method:'POST'});
            const d = await r.json();
            if(!d.success){ Swal.fire(d.message||'Bạn cần đăng nhập'); return; }
            const span = btn.querySelector('span');
            if(d.saved){ btn.style.background='#0e7d85'; btn.style.color='#fff'; span.textContent='Đã lưu'; }
            else { btn.style.background='var(--bg-gray)'; btn.style.color='var(--text-dark)'; span.textContent='Lưu'; }
        }

        function shareArticle() {
            if (navigator.share) navigator.share({ title: document.title, url: location.href });
            else { navigator.clipboard.writeText(location.href); Swal.fire('Đã sao chép link!'); }
        }

        function submitComment(articleId) {
            var nameEl = document.getElementById('cName');
            var name = nameEl.value.trim();
            var text = document.getElementById('cText').value.trim();
            if (!name || !text) { Swal.fire('Vui lòng điền tên và nội dung!'); return; }
            var emailEl = document.getElementById('cEmail');
            var email = emailEl ? emailEl.value : '';
            fetch('/api/comment', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ articleId: articleId, name: name, email: email, content: text }) })
                .then(function (r) { return r.json(); }).then(function (data) {
                    // AI đã từ chối — không render, báo lỗi
                    if (data.status === 'rejected') {
                        Swal.fire(data.message || 'Bình luận của bạn vi phạm quy định cộng đồng.');
                        return;
                    }
                    if (data.success) {
                        var initial = name[0].toUpperCase();
                        var html = '<div class="comment-node" style="padding-top:12px;"><div class="comment-row"><div class="comment-avatar">' + initial + '</div><div class="comment-body"><div class="comment-meta"><strong>' + name + '</strong> <span class="comment-time">Vừa xong</span></div><p class="comment-text">' + text + '</p></div></div></div>';
                        document.getElementById('commentList').insertAdjacentHTML('afterbegin', html);
                        document.getElementById('cText').value = '';
                        if (nameEl.type !== 'hidden') nameEl.value = '';
                        if (emailEl && emailEl.type !== 'hidden') emailEl.value = '';
                        Swal.fire(data.message);
                    }
                });
        }

        window.addEventListener('scroll', function () {
            var h = document.documentElement.scrollHeight - window.innerHeight;
            document.getElementById('readProgress').style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
        });

        document.addEventListener('DOMContentLoaded', function () {
            var copyBtn = document.querySelector('.js-share-copy');
            if (copyBtn) {
                copyBtn.addEventListener('click', function () {
                    var url = this.closest('.share-bar').dataset.shareUrl || location.href;
                    navigator.clipboard.writeText(url).then(function () {
                        var toast = document.querySelector('.share-toast');
                        if (toast) { toast.textContent = 'Đã sao chép link!'; setTimeout(function () { toast.textContent = ''; }, 2500); }
                    });
                });
            }

            document.addEventListener('click', function (e) {
                var likeBtn = e.target.closest('.js-like-btn');
                var dislikeBtn = e.target.closest('.js-dislike-btn');
                var btn = likeBtn || dislikeBtn;
                if (!btn) return;
                var commentId = btn.dataset.commentId;
                var type = likeBtn ? 'like' : 'dislike';
                fetch('/article/' + type + '-comment/' + commentId, { method: 'POST' })
                    .then(function (r) { return r.json(); }).then(function (data) {
                        if (data.success) {
                            var node = document.querySelector('.comment-node[data-comment-id="' + commentId + '"]');
                            if (node) {
                                var lc = node.querySelector('.like-count');
                                var dc = node.querySelector('.dislike-count');
                                if (lc) lc.textContent = data.likeCount;
                                if (dc) dc.textContent = data.dislikeCount;
                            }
                        } else { Swal.fire(data.message || 'Bạn đã bình chọn rồi!'); }
                    }).catch(function () { Swal.fire('Lỗi kết nối.'); });
            });

            document.addEventListener('click', function (e) {
                var replyBtn = e.target.closest('.js-reply-btn');
                if (replyBtn) {
                    var commentId = replyBtn.dataset.commentId;
                    var node = document.querySelector('.comment-node[data-comment-id="' + commentId + '"]');
                    var form = node ? node.querySelector(':scope > .comment-row .reply-form') : null;
                    if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
                }
                var cancelBtn = e.target.closest('.js-reply-cancel');
                if (cancelBtn) {
                    var f = cancelBtn.closest('.reply-form');
                    if (f) f.style.display = 'none';
                }
            });

            document.addEventListener('submit', function (e) {
                var form = e.target.closest('.reply-form');
                if (!form) return;
                e.preventDefault();
                var parentId = parseInt(form.dataset.parentId);
                var nameInput = form.querySelector('.reply-name');
                var name = nameInput ? nameInput.value.trim() : '';
                var emailInput = form.querySelector('.reply-email');
                var email = emailInput ? emailInput.value.trim() : '';
                var content = form.querySelector('.reply-text').value.trim();
                if (!name || !content) { Swal.fire('Vui lòng điền tên và nội dung!'); return; }
                fetch('/article/reply-comment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ articleId: ARTICLE_ID, parentCommentId: parentId, name: name, email: email, content: content })
                }).then(function (r) { return r.json(); }).then(function (data) {
                    if (data.success) { Swal.fire(data.message); form.reset(); form.style.display = 'none'; }
                    else { Swal.fire(data.message || 'Lỗi gửi trả lời'); }
                }).catch(function () { Swal.fire('Lỗi kết nối.'); });
            });
        });

        async function deleteComment(commentId) {
            if (!await confirmSwal('Bạn có chắc muốn xoá bình luận này?')) return;
            const res = await fetch(`/article/delete-comment/${commentId}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) location.reload();
            else Swal.fire(data.message || 'Lỗi');
        }

        // ===== AI CHATBOT =====
        function toggleChatbot() {
            var panel = document.getElementById('chatbotPanel');
            var icon = document.getElementById('chatbotIcon');
            panel.classList.toggle('open');
            icon.className = panel.classList.contains('open') ? 'fa fa-xmark' : 'fa fa-robot';
        }

        async function sendBotMsg(e) {
            e.preventDefault();
            var input = document.getElementById('chatbotInput');
            var msg = input.value.trim();
            if (!msg) return;

            var box = document.getElementById('chatbotMessages');
            var btn = document.getElementById('chatbotSendBtn');

            box.innerHTML += '<div class="chatbot-msg user">' + msg + '</div>';
            input.value = '';
            btn.disabled = true;
            box.innerHTML += '<div class="chatbot-msg typing" id="typingMsg">Đang suy nghĩ...</div>';
            box.scrollTop = box.scrollHeight;

            try {
                var res = await fetch('/article/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: msg })
                });
                var data = await res.json();
                var typing = document.getElementById('typingMsg');
                if (typing) typing.remove();
                box.innerHTML += '<div class="chatbot-msg bot">' + data.reply + '</div>';
            } catch {
                var typing = document.getElementById('typingMsg');
                if (typing) typing.remove();
                box.innerHTML += '<div class="chatbot-msg bot" style="color:#dc2626;">Lỗi kết nối, thử lại sau.</div>';
            }

            btn.disabled = false;
            box.scrollTop = box.scrollHeight;
            input.focus();
        }

        // Lightbox: phóng to ảnh trong nội dung bài viết
        (function(){
            if (typeof GLightbox === 'undefined') return;
            document.querySelectorAll('.article-content img').forEach(function(img){
                if (img.closest('a')) return;
                var a = document.createElement('a');
                a.href = img.getAttribute('src');
                a.className = 'glightbox';
                a.setAttribute('data-gallery', 'article');
                img.parentNode.insertBefore(a, img);
                a.appendChild(img);
                img.style.cursor = 'zoom-in';
            });
            GLightbox({ selector: '.article-content a.glightbox' });
        })();
    </script>
}