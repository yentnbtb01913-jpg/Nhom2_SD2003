@using WisdomITNews.Models
@model List<StaffActivityLog>
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Lịch sử làm việc";
    var q = (string)(ViewBag.Q ?? "");
    var af = (string)(ViewBag.ActionFilter ?? "");
    (string, string)[] acts = new[] {
        ("", "Tất cả hành động"), ("edit_profile", "Sửa hồ sơ"), ("change_status", "Đổi trạng thái"),
        ("add_article", "Đăng bài"), ("import_rss", "Nhập RSS"), ("post_notification", "Thông báo")
    };
}
@functions {
    static readonly Dictionary<string, string> ActLabel = new() { ["edit_profile"] = "Sửa hồ sơ", ["change_status"] = "Đổi trạng thái", ["add_article"] = "Đăng bài", ["import_rss"] = "Nhập RSS", ["post_notification"] = "Thông báo" };
    static readonly Dictionary<string, string> ActIcon = new() { ["edit_profile"] = "fa-user-pen", ["change_status"] = "fa-user-clock", ["add_article"] = "fa-newspaper", ["import_rss"] = "fa-satellite-dish", ["post_notification"] = "fa-bell" };
    static readonly Dictionary<string, string> ActColor = new() { ["edit_profile"] = "#159aa3", ["change_status"] = "#ca8a04", ["add_article"] = "#2563eb", ["import_rss"] = "#7c3aed", ["post_notification"] = "#dc2626" };
    string AL(string a) => ActLabel.TryGetValue(a ?? "", out var v) ? v : (a ?? "");
    string AIc(string a) => ActIcon.TryGetValue(a ?? "", out var v) ? v : "fa-circle-info";
    string AC(string a) => ActColor.TryGetValue(a ?? "", out var v) ? v : "#6b7280";
}

<div style="margin-bottom:14px;">
    <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-clock-rotate-left" style="color:#159aa3;"></i> Lịch sử làm việc</h1>
    <p style="color:#6c757d;font-size:13px;margin-top:4px;">Nhật ký thao tác của admin & nhân viên. Bạn chỉ có thể <b>xem</b> (không sửa/xóa).</p>
</div>

<form method="get" action="/nhan-vien/ActivityLog" style="background:#fff;padding:14px;margin-bottom:16px;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);display:flex;gap:10px;flex-wrap:wrap;">
    <input type="text" name="q" value="@q" placeholder="🔍 Tìm theo nội dung / người thực hiện..." style="flex:1;min-width:220px;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;" />
    <select name="actionType" style="padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;">
        @foreach (var (val, label) in acts)
        {
            <option value="@val" selected="@(af == val)">@label</option>
        }
    </select>
    <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:9px 18px;border-radius:6px;font-weight:600;cursor:pointer;"><i class="fa fa-filter"></i> Lọc</button>
    <a href="/nhan-vien/ActivityLog" style="background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;padding:9px 16px;border-radius:6px;font-weight:600;text-decoration:none;font-size:13px;">Xóa lọc</a>
</form>

<div style="background:#fff;border-radius:8px;padding:18px;box-shadow:0 2px 10px rgba(0,0,0,.06);">
    @if (!Model.Any())
    {
        <p style="text-align:center;color:#94a3b8;padding:24px;">Chưa có hoạt động nào được ghi lại.</p>
    }
    else
    {
        foreach (var l in Model)
        {
            <div style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid #f0f2f5;align-items:flex-start;">
                <div style="width:38px;height:38px;border-radius:50%;background:#f3f4f6;color:@AC(l.Action);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fa @AIc(l.Action)"></i></div>
                <div style="flex:1;min-width:0;">
                    <div style="font-size:13px;">
                        <b>@l.ActorName</b>
                        <span style="font-size:11px;color:#94a3b8;">(@(l.ActorRole == "superadmin" ? "Super Admin" : "Nhân viên"))</span>
                        <span style="margin-left:6px;padding:1px 8px;border-radius:20px;font-size:11px;font-weight:700;background:#f3f4f6;color:@AC(l.Action);">@AL(l.Action)</span>
                    </div>
                    <div style="color:#374151;font-size:13px;margin:3px 0;">@l.Detail</div>
                    <div style="color:#94a3b8;font-size:12px;"><i class="fa fa-clock"></i> @l.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div>
                </div>
            </div>
        }
    }
</div>
