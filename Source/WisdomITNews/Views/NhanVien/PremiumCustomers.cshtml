@using WisdomITNews.Models
@using WisdomITNews.Services
@model List<CustomerListItem>
@{
    ViewData["Title"] = "Quản lý khách hàng"; Layout = "_ManagerLayout";
    string role = ViewBag.Role as string ?? "";
    string status = ViewBag.Status as string ?? "";
    int? planId = ViewBag.PlanId as int?;
    string q = ViewBag.Q as string ?? "";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    var plans = ViewBag.Plans as List<SubscriptionPlan> ?? new();
    bool expiring = ViewBag.Expiring == true;
    string basePath = "/nhan-vien/PremiumCustomers";
    string PageUrl(int p) => $"{basePath}?role={role}&status={status}&planId={planId}&q={Uri.EscapeDataString(q)}&expiring={expiring}&page={p}";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
  <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-user-tie" style="color:#159aa3;"></i> Quản lý khách hàng</h1>
</div>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }
@if (TempData["Err"] != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Err"]</div> }

<!-- Thống kê -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:16px;">
  @{
    (string lbl,object val,string clr,string ic)[] cards = new (string,object,string,string)[] {
      ("Tổng khách hàng", ViewBag.TotalCount ?? 0, "#159aa3", "fa-users"),
      ("Đang dùng Trial", ViewBag.TrialCount ?? 0, "#f59e0b", "fa-hourglass-half"),
      ("Đang dùng Premium", ViewBag.PremiumCount ?? 0, "#16a34a", "fa-crown"),
      ("Premium sắp hết hạn", ViewBag.ExpiringCount ?? 0, "#dc2626", "fa-triangle-exclamation"),
    };
  }
  @foreach (var c in cards)
  {
    <div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);padding:14px 16px;">
      <div style="font-size:12px;color:#94a3b8;font-weight:600;"><i class="fa @c.ic" style="color:@c.clr;"></i> @c.lbl</div>
      <div style="font-size:24px;font-weight:800;color:@c.clr;margin-top:4px;">@c.val</div>
    </div>
  }
</div>

<!-- Bộ lọc -->
<form method="get" action="@basePath" style="background:#fff;padding:14px;margin-bottom:16px;border-radius:6px;box-shadow:0 2px 10px rgba(0,0,0,.06);display:flex;gap:10px;flex-wrap:wrap;">
  <input type="text" name="q" value="@q" placeholder="🔍 Tìm tên / email / SĐT..." style="flex:1;min-width:220px;padding:10px 14px;border:1px solid #d1d5db;font-size:14px;border-radius:6px;" />
  <select name="role" style="padding:10px 14px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;">
    <option value="">Tất cả role</option>
    <option value="Premium" selected="@(role=="Premium" ? "selected" : null)">Premium</option>
    <option value="Trial" selected="@(role=="Trial" ? "selected" : null)">Dùng thử</option>
  </select>
  <select name="status" style="padding:10px 14px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;">
    <option value="">Tất cả trạng thái</option>
    <option value="Active" selected="@(status=="Active" ? "selected" : null)">Đang hoạt động</option>
    <option value="Trial" selected="@(status=="Trial" ? "selected" : null)">Dùng thử</option>
    <option value="Expired" selected="@(status=="Expired" ? "selected" : null)">Hết hạn</option>
    <option value="Cancelled" selected="@(status=="Cancelled" ? "selected" : null)">Đã hủy</option>
  </select>
  <select name="planId" style="padding:10px 14px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;">
    <option value="">Tất cả gói</option>
    @foreach (var p in plans)
    {
      <option value="@p.Id" selected="@(planId==p.Id ? "selected" : null)">@p.Name</option>
    }
  </select>
  <label style="display:flex;align-items:center;gap:6px;padding:0 10px;font-size:13px;color:#475569;cursor:pointer;white-space:nowrap;">
    <input type="checkbox" name="expiring" value="true" @(expiring ? "checked" : "") style="width:16px;height:16px;" /> Sắp hết hạn
  </label>
  <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:10px 18px;border-radius:6px;font-weight:600;cursor:pointer;">Lọc</button>
  <a href="@basePath" style="background:#f0f2f5;color:#475569;padding:10px 16px;border-radius:6px;font-weight:600;font-size:14px;text-decoration:none;">Xóa lọc</a>
</form>

<!-- Bảng -->
<div style="background:#fff;border-radius:6px;box-shadow:0 2px 10px rgba(0,0,0,.06);overflow-x:auto;">
  <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
    <thead>
      <tr style="background:#f5f6f8;border-bottom:2px solid #e0e4e8;color:#6c757d;text-align:left;">
        <th style="padding:12px 14px;">Khách hàng</th>
        <th style="padding:12px 14px;">SĐT</th>
        <th style="padding:12px 14px;">Role</th>
        <th style="padding:12px 14px;">Gói</th>
        <th style="padding:12px 14px;">Trạng thái gói</th>
        <th style="padding:12px 14px;">Tài khoản</th>
        <th style="padding:12px 14px;">Ngày ĐK</th>
        <th style="padding:12px 14px;">Hết hạn</th>
        <th style="padding:12px 14px;"></th>
      </tr>
    </thead>
    <tbody>
      @if (!Model.Any())
      {
        <tr><td colspan="9" style="padding:26px;text-align:center;color:#94a3b8;">Không có khách hàng nào phù hợp.</td></tr>
      }
      @foreach (var c in Model)
      {
        var sclr = CustomerHelper.StatusColor(c.SubStatus);
        <tr style="border-bottom:1px solid #f0f2f5;">
          <td style="padding:12px 14px;">
            <div style="display:flex;align-items:center;gap:10px;">
              @if (!string.IsNullOrWhiteSpace(c.AvatarUrl))
              { <img src="@c.AvatarUrl" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" /> }
              else
              { <div style="width:36px;height:36px;border-radius:50%;background:#159aa3;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;">@(string.IsNullOrEmpty(c.FullName) ? "?" : c.FullName.Substring(0,1).ToUpper())</div> }
              <div>
                <div style="font-weight:600;">@c.FullName</div>
                <div style="font-size:12px;color:#94a3b8;">@c.Email</div>
              </div>
            </div>
          </td>
          <td style="padding:12px 14px;color:#475569;">@(string.IsNullOrWhiteSpace(c.Phone) ? "—" : c.Phone)</td>
          <td style="padding:12px 14px;">
            @if (c.Role == CustomerRole.Premium)
            { <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;background:#dcfce7;color:#16a34a;"><i class="fa fa-crown"></i> Premium</span> }
            else
            { <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;background:#fef3c7;color:#b45309;"><i class="fa fa-hourglass-half"></i> Dùng thử</span> }
          </td>
          <td style="padding:12px 14px;">@c.PlanName</td>
          <td style="padding:12px 14px;"><span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;color:#fff;background:@sclr;">@CustomerHelper.StatusLabel(c.SubStatus)</span></td>
          <td style="padding:12px 14px;">
            @if (c.AccountActive)
            { <span style="color:#16a34a;font-weight:600;"><i class="fa fa-circle-check"></i> Hoạt động</span> }
            else
            { <span style="color:#dc2626;font-weight:600;"><i class="fa fa-lock"></i> Bị khóa</span> }
          </td>
          <td style="padding:12px 14px;color:#6c757d;">@c.StartDate.ToString("dd/MM/yyyy")</td>
          <td style="padding:12px 14px;color:#6c757d;">@c.EndDate.ToString("dd/MM/yyyy")</td>
          <td style="padding:12px 14px;">
            <a href="/nhan-vien/CustomerProfile/@c.UserId" style="background:#159aa3;color:#fff;padding:6px 12px;border-radius:6px;font-size:12px;font-weight:600;text-decoration:none;"><i class="fa fa-eye"></i> Chi tiết</a>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

@if (totalPages > 1)
{
  <div style="display:flex;justify-content:center;gap:6px;margin-top:18px;">
    @if (page > 1)
    { <a href="@PageUrl(page-1)" style="padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;text-decoration:none;color:#475569;">‹ Trước</a> }
    @for (int p = Math.Max(1, page-2); p <= Math.Min(totalPages, page+2); p++)
    {
      <a href="@PageUrl(p)" style="padding:8px 13px;border:1px solid @(p==page ? "#159aa3" : "#d1d5db");border-radius:6px;text-decoration:none;font-weight:@(p==page ? "700" : "400");background:@(p==page ? "#159aa3" : "#fff");color:@(p==page ? "#fff" : "#475569");">@p</a>
    }
    @if (page < totalPages)
    { <a href="@PageUrl(page+1)" style="padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;text-decoration:none;color:#475569;">Sau ›</a> }
  </div>
}
