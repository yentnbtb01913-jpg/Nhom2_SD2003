@using WisdomITNews.Models
@{
    Layout = "_ManagerLayout";
    var ad = ViewBag.Ad as Advertisement;
    var msgs = ViewBag.Messages as List<AdRenewalMessage> ?? new();
    ViewData["Title"] = "Chat gia hạn";
}
<div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
    <a href="/nhan-vien/RenewalAds" style="color:#6c757d;text-decoration:none;"><i class="fa fa-arrow-left"></i></a>
    <h1 style="font-size:20px;font-weight:800;"><i class="fa fa-comments" style="color:#159aa3;"></i> Gia hạn: @ad?.Title</h1>
</div>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:12px;">@TempData["Ok"]</div> }
@if (TempData["Err"] != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:12px;">@TempData["Err"]</div> }

<div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start;">
  <div style="background:#fff;border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.06);display:flex;flex-direction:column;height:62vh;">
    <div id="msgBox" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;">
        @foreach (var m in msgs)
        {
            var mine = m.SenderRole != "journalist";
            <div style="display:flex;justify-content:@(mine ? "flex-end" : "flex-start");">
                <div style="max-width:74%;">
                    <div style="font-size:11px;color:#94a3b8;margin-bottom:2px;@(mine ? "text-align:right;" : "")">@m.SenderName · @m.CreatedAt.ToString("HH:mm dd/MM")</div>
                    <div style="background:@(mine ? "#159aa3" : "#eef2f5");color:@(mine ? "#fff" : "#1f2937");padding:9px 13px;border-radius:12px;font-size:14px;white-space:pre-wrap;word-break:break-word;">@m.Content</div>
                </div>
            </div>
        }
    </div>
    <div style="border-top:1px solid #eef2f5;padding:12px;display:flex;gap:8px;">
        <input id="msgInput" type="text" placeholder="Nhập tin nhắn..." maxlength="2000" style="flex:1;padding:11px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;" />
        <button id="sendBtn" style="background:#159aa3;color:#fff;border:none;padding:0 20px;border-radius:8px;font-weight:700;cursor:pointer;"><i class="fa fa-paper-plane"></i></button>
    </div>
  </div>

  <div style="background:#fff;border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.06);padding:18px;">
    <h3 style="font-size:15px;font-weight:700;margin-bottom:6px;color:#0e7d85;"><i class="fa fa-calendar-check"></i> Gia hạn quảng cáo</h3>
    <p style="font-size:12px;color:#94a3b8;margin-bottom:12px;">Hết hạn: @ad?.EndDate?.ToString("dd/MM/yyyy"). Đặt ngày mới để chạy lại ngay.</p>
    <form method="post" action="/nhan-vien/ExtendAdRenewal">
        <input type="hidden" name="id" value="@ad?.Id" />
        <label style="display:block;font-weight:600;font-size:13px;margin-bottom:6px;">Gia hạn đến ngày</label>
        <input type="date" name="endDate" required style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;margin-bottom:12px;" />
        <button type="submit" style="width:100%;background:#16a34a;color:#fff;border:none;padding:10px;border-radius:6px;font-weight:700;cursor:pointer;"><i class="fa fa-check"></i> Gia hạn &amp; bật lại</button>
    </form>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    const adId = @ad!.Id;
    const box = document.getElementById('msgBox');
    const input = document.getElementById('msgInput');
    const btn = document.getElementById('sendBtn');
    function esc(t){ const d=document.createElement('div'); d.textContent=t; return d.innerHTML; }
    function scrollDown(){ box.scrollTop = box.scrollHeight; }
    function append(m){
        const mine = m.role !== 'journalist';
        const row = document.createElement('div');
        row.style.display='flex'; row.style.justifyContent = mine ? 'flex-end':'flex-start';
        row.innerHTML = '<div style="max-width:74%;">'
          + '<div style="font-size:11px;color:#94a3b8;margin-bottom:2px;'+(mine?'text-align:right;':'')+'">'+esc(m.senderName)+' · '+esc(m.createdAt)+'</div>'
          + '<div style="background:'+(mine?'#159aa3':'#eef2f5')+';color:'+(mine?'#fff':'#1f2937')+';padding:9px 13px;border-radius:12px;font-size:14px;white-space:pre-wrap;word-break:break-word;">'+esc(m.content)+'</div>'
          + '</div>';
        box.appendChild(row); scrollDown();
    }
    const conn = new signalR.HubConnectionBuilder().withUrl("/adChatHub").withAutomaticReconnect().build();
    conn.on("ReceiveAdMessage", m => { if (m.adId === adId) append(m); });
    conn.start().then(() => conn.invoke("JoinAd", adId)).catch(e => console.error(e));
    function send(){
        const t = input.value.trim(); if (!t) return;
        conn.invoke("SendMessage", adId, t).catch(e => console.error(e));
        input.value=''; input.focus();
    }
    btn.addEventListener('click', send);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); send(); } });
    scrollDown();
</script>
