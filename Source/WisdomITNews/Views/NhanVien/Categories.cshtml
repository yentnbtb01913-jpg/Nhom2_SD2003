@model List<WisdomITNews.Models.Category>
@{ ViewData["Title"] = "Danh mục"; Layout = "_ManagerLayout"; }

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
  <h1 style="font-size:22px;font-weight:700;">📁 Danh mục</h1>
</div>

<div style="background:#fff;border-radius:0px;box-shadow:0 2px 8px rgba(0,0,0,.07);overflow:hidden;">
  <table style="width:100%;border-collapse:collapse;font-size:13px;">
    <thead>
      <tr style="background:#f5f6f8;border-bottom:2px solid #e0e4e8;">
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Icon</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Tên danh mục</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Slug</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Màu sắc</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Thứ tự</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Hiển thị</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var c in Model)
      {
        <tr style="border-bottom:1px solid #f0f2f5;">
          <td style="padding:12px 16px;font-size:20px;">@c.Icon</td>
          <td style="padding:12px 16px;font-weight:600;">@c.Name</td>
          <td style="padding:12px 16px;"><code style="background:#f0f2f5;padding:2px 8px;border-radius:4px;font-size:12px;">@c.Slug</code></td>
          <td style="padding:12px 16px;">
            <div style="display:flex;align-items:center;gap:8px;">
              <div style="width:20px;height:20px;border-radius:4px;background:@c.Color;"></div>
              <span style="font-size:12px;color:#6c757d;">@c.Color</span>
            </div>
          </td>
          <td style="padding:12px 16px;color:#6c757d;">@c.SortOrder</td>
          <td style="padding:12px 16px;">
            <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:@(c.IsVisible?"#dcfce7":"#f0f2f5");color:@(c.IsVisible?"#16a34a":"#6c757d");">
              @(c.IsVisible ? "✅ Hiển thị" : "🙈 Ẩn")
            </span>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

<div style="background:#fef9c3;border:1px solid #fde68a;border-radius:0px;padding:12px 16px;margin-top:16px;font-size:13px;color:#92400e;">
  <i class="fa fa-info-circle"></i> Để thêm/sửa danh mục, vui lòng chỉnh sửa trực tiếp trong database hoặc qua Migration.
</div>
