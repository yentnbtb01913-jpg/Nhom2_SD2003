@model WisdomITNews.Models.Advertisement
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Thêm quảng cáo";
    var isEdit = Model.Id > 0;
    string lbl = "display:block;font-weight:600;font-size:13px;margin-bottom:6px;color:#374151;";
    string inp = "width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;";
    string hint = "font-size:11px;color:#94a3b8;margin-top:4px;";
    string D(DateTime? d) => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : "";
}
<div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
    <a href="/nhan-vien/Advertisements" style="color:#6c757d;text-decoration:none;"><i class="fa fa-arrow-left"></i></a>
    <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-rectangle-ad" style="color:#159aa3;"></i> Thêm quảng cáo</h1>
</div>
@if (ViewBag.Error != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@ViewBag.Error</div> }

<form method="post" action="/nhan-vien/CreateAd" enctype="multipart/form-data" style="background:#fff;border-radius:8px;padding:22px;box-shadow:0 2px 10px rgba(0,0,0,.06);max-width:680px;">
    <div style="margin-bottom:16px;"><label style="@lbl">Tiêu đề *</label><input style="@inp" name="Title" value="@Model.Title" required maxlength="150" /></div>
    <div style="margin-bottom:16px;"><label style="@lbl">Link đích (khi click) *</label><input style="@inp" name="TargetUrl" value="@Model.TargetUrl" placeholder="https://... hoặc /danh-muc/..." required /></div>
    <div style="margin-bottom:16px;">
        <label style="@lbl">Ảnh banner</label>
        @if (!string.IsNullOrEmpty(Model.ImageUrl)) { <img src="@Model.ImageUrl" style="max-width:100%;max-height:90px;border-radius:6px;margin-bottom:8px;display:block;" /> }
        <input style="@inp" type="file" name="imageFile" accept="image/*" />
        <div style="@hint">Tải ảnh lên, HOẶC dán link ảnh bên dưới. Gợi ý kích thước: Header 728x90, Sidebar 300x250, Trang Chủ (trái/phải) 160x600.</div>
        <input style="@inp;margin-top:6px;" name="ImageUrl" value="@Model.ImageUrl" placeholder="https://link-anh.png (tuỳ chọn)" />

        <div id="homeRailHint" style="display:none;margin-top:10px;padding:10px 12px;background:#eef2ff;border:1px solid #c7d2fe;border-radius:6px;">
            <div style="display:flex;gap:12px;align-items:center;">
                <div style="flex-shrink:0;width:34px;height:128px;border:2px dashed #6366f1;border-radius:4px;background:#fff;display:flex;align-items:center;justify-content:center;">
                    <span style="writing-mode:vertical-rl;font-size:10px;color:#6366f1;font-weight:700;letter-spacing:1px;">160×600</span>
                </div>
                <div style="font-size:12px;color:#3730a3;line-height:1.6;">
                    <strong>Kích thước khuyến nghị: 160 × 600 px</strong> (hoặc 300 × 600 px) — ảnh dọc dạng banner đứng (skyscraper).<br />
                    Ảnh càng cao càng lấp đầy khung; khung sẽ tự kéo dài xuống theo chiều dọc và giữ chiều cao tối thiểu dù ảnh thấp.
                </div>
            </div>
        </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;">
        <div><label style="@lbl">Vị trí</label>
            <select style="@inp" name="Position" id="adPosition" onchange="toggleHomeRailHint()">
                <option value="header" selected="@(Model.Position=="header")">Header (đầu trang)</option>
                <option value="sidebar" selected="@(Model.Position=="sidebar" || !isEdit)">Sidebar (cột bên)</option>
                <option value="in_article" selected="@(Model.Position=="in_article")">Trong bài viết</option>
                <option value="home_left" selected="@(Model.Position=="home_left")">Trang Chủ (trái)</option>
                <option value="home_right" selected="@(Model.Position=="home_right")">Trang Chủ (phải)</option>
            </select>
        </div>
        <div><label style="@lbl">Trạng thái</label>
            <select style="@inp" name="IsActive">
                <option value="true" selected="@(Model.IsActive || !isEdit)">Bật (đang chạy)</option>
                <option value="false" selected="@(isEdit && !Model.IsActive)">Tắt</option>
            </select>
        </div>
        <div><label style="@lbl">Chạy từ ngày</label><input style="@inp" type="date" name="StartDate" value="@D(Model.StartDate)" /></div>
        <div><label style="@lbl">Đến ngày</label><input style="@inp" type="date" name="EndDate" value="@D(Model.EndDate)" /></div>
    </div>
    <p style="@hint;margin-bottom:14px;">Để trống ngày = chạy không giới hạn thời gian.</p>
    <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:11px 24px;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;"><i class="fa fa-check"></i> Thêm quảng cáo</button>
    <a href="/nhan-vien/Advertisements" style="margin-left:8px;color:#6c757d;text-decoration:none;font-size:14px;">Hủy</a>
</form>
<script>
    function toggleHomeRailHint() {
        var v = document.getElementById('adPosition').value;
        document.getElementById('homeRailHint').style.display = (v === 'home_left' || v === 'home_right') ? 'block' : 'none';
    }
    toggleHomeRailHint();
</script>
