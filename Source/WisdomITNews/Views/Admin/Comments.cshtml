@model List<WisdomITNews.Models.Comment>
@using WisdomITNews.Services
@{ ViewData["Title"] = "Quản lý bình luận"; Layout = "_AdminLayout"; }

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
  <h1 style="font-size:22px;font-weight:700;">💬 Bình luận</h1>
</div>

<!-- FILTER -->
<div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
  @foreach (var s in new[] {
      ("pending",  "⏳ Chờ duyệt"),
      ("approved", "✅ Đã duyệt"),
      ("rejected", "🤖 AI không cho qua"),
      ("spam",     "🚫 Spam"),
      ("all",      "Tất cả") })
  {
    <a href="/admin/Comments?status=@s.Item1"
       style="padding:7px 16px;border-radius:20px;font-size:13px;font-weight:600;text-decoration:none;background:@(ViewBag.Status==s.Item1?"#0a2540":"#f0f2f5");color:@(ViewBag.Status==s.Item1?"#fff":"#3d3d3d");">
      @s.Item2
    </a>
  }
</div>

<div style="background:#fff;border-radius:0px;box-shadow:0 2px 8px rgba(0,0,0,.07);overflow:hidden;">
  @if (!Model.Any())
  {
    <div style="text-align:center;padding:40px;color:#6c757d;">Không có bình luận nào.</div>
  }
  @foreach (var c in Model)
  {
    <div style="padding:16px 20px;border-bottom:1px solid #f0f2f5;display:flex;gap:14px;align-items:flex-start;">
      <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#0a2540,#476083);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0;">
        @c.AuthorName[0].ToString().ToUpper()
      </div>
      <div style="flex:1;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;">
          <div>
            <span style="font-weight:700;font-size:14px;">@c.AuthorName</span>
            @if (!string.IsNullOrEmpty(c.AuthorEmail)) { <span style="font-size:12px;color:#6c757d;margin-left:8px;">@c.AuthorEmail</span> }
            <span style="font-size:12px;color:#6c757d;margin-left:8px;"><i class="fa fa-clock"></i> @SlugHelper.FormatDate(c.CreatedAt)</span>
          </div>
          @{
              string badgeBg, badgeColor, badgeText;
              switch (c.Status)
              {
                  case "approved":
                      badgeBg = "#dcfce7"; badgeColor = "#16a34a"; badgeText = "✅ Đã duyệt"; break;
                  case "pending":
                      badgeBg = "#fef9c3"; badgeColor = "#ca8a04"; badgeText = "⏳ Chờ duyệt"; break;
                  case "rejected":
                      badgeBg = "#fde2f3"; badgeColor = "#9333ea"; badgeText = "🤖 AI không cho qua"; break;
                  default:
                      badgeBg = "#fee2e2"; badgeColor = "#ba1a1a"; badgeText = "🚫 Spam"; break;
              }
          }
          <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:@badgeBg;color:@badgeColor;">
            @badgeText
          </span>
        </div>
        @if (c.Article != null)
        {
          <div style="font-size:12px;color:#476083;margin-bottom:6px;"><i class="fa fa-newspaper"></i> @c.Article.Title</div>
        }
        <p style="font-size:14px;line-height:1.6;color:#3d3d3d;">@c.Content</p>
        @if (c.Status == "rejected")
        {
          <div style="margin-top:8px;padding:8px 12px;background:#fdf4ff;border-left:3px solid #9333ea;border-radius:4px;font-size:12px;color:#6b21a8;">
            <i class="fa fa-robot"></i>
            <strong>AI không cho qua:</strong>
            bình luận này bị Gemini AI đánh giá vi phạm quy định cộng đồng (điểm > 70). Bạn có thể bấm <b>Duyệt</b> để override nếu cho rằng AI sai.
          </div>
        }
        <div style="display:flex;gap:8px;margin-top:10px;">
          @if (c.Status != "approved")
          {
            <button onclick="approveComment(@c.Id, this)" style="background:#dcfce7;color:#16a34a;border:none;padding:5px 12px;border-radius:5px;font-size:12px;font-weight:600;cursor:pointer;"><i class="fa fa-check"></i> Duyệt</button>
          }
          <button onclick="deleteComment(@c.Id, this)" style="background:#fee2e2;color:#ba1a1a;border:none;padding:5px 12px;border-radius:5px;font-size:12px;font-weight:600;cursor:pointer;"><i class="fa fa-trash"></i> Xóa</button>
        </div>
      </div>
    </div>
  }
</div>

@section Scripts {
<script>
async function approveComment(id, btn) {
  const res  = await fetch('/admin/ApproveComment/' + id, { method: 'POST' });
  const data = await res.json();
  if (data.success) {
    const row = btn.closest('div[style*="border-bottom"]');
    const badge = row.querySelector('span[style*="border-radius:20px"]');
    badge.innerHTML = '✅ Đã duyệt';
    badge.style.background = '#dcfce7';
    badge.style.color = '#16a34a';
    // Bỏ note "AI không cho qua" nếu admin override
    const aiNote = row.querySelector('div[style*="#9333ea"]');
    if (aiNote) aiNote.remove();
    btn.remove();
  }
}
async function deleteComment(id, btn) {
  if (!confirm('Xóa bình luận này?')) return;
  const res  = await fetch('/admin/DeleteComment/' + id, { method: 'POST' });
  const data = await res.json();
  if (data.success) btn.closest('div[style*="border-bottom"]').remove();
}
</script>
}
