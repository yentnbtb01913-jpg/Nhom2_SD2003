@model List<WisdomITNews.Models.ChatGroup>
@{
    Layout = "_AdminLayout"; ViewData["Title"] = "Quan ly Chat";
    var msgCounts = ViewBag.MessageCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div style="margin-bottom:20px;">
    <h1 style="font-size:22px;font-weight:700;">Quan ly nhom Chat</h1>
</div>

<div style="background:#fff;border-radius:0px;box-shadow:0 2px 8px rgba(0,0,0,.07);overflow:hidden;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead>
            <tr style="background:#f5f6f8;border-bottom:2px solid #e0e4e8;">
                <th style="padding:12px 16px;text-align:left;font-weight:600;color:#6c757d;">ID</th>
                <th style="padding:12px 16px;text-align:left;font-weight:600;color:#6c757d;">Ten nhom</th>
                <th style="padding:12px 16px;text-align:center;font-weight:600;color:#6c757d;">Loai</th>
                <th style="padding:12px 16px;text-align:center;font-weight:600;color:#6c757d;">Thanh vien</th>
                <th style="padding:12px 16px;text-align:center;font-weight:600;color:#6c757d;">Tin nhan</th>
                <th style="padding:12px 16px;text-align:center;font-weight:600;color:#6c757d;">Ngay tao</th>
                <th style="padding:12px 16px;text-align:center;font-weight:600;color:#6c757d;">Hanh dong</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model)
            {
                <tr style="border-bottom:1px solid #f0f2f5;">
                    <td style="padding:12px 16px;">@g.Id</td>
                    <td style="padding:12px 16px;">@(string.IsNullOrEmpty(g.Name) ? "(DM)" : g.Name)</td>
                    <td style="padding:12px 16px;text-align:center;">@(g.IsDirectMessage ? "Tin nhan rieng" : "Nhom")</td>
                    <td style="padding:12px 16px;text-align:center;">@g.Members.Count</td>
                    <td style="padding:12px 16px;text-align:center;">@(msgCounts.ContainsKey(g.Id) ? msgCounts[g.Id] : 0)</td>
                    <td style="padding:12px 16px;text-align:center;">@g.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td style="padding:12px 16px;text-align:center;">
                        <a href="/Admin/ChatGroupDetail?id=@g.Id" style="color:#2563eb;text-decoration:none;font-weight:600;margin-right:10px;">Xem</a>
                        <button onclick="deleteChatGroup(@g.Id)" style="color:#ba1a1a;border:none;background:none;cursor:pointer;font-weight:600;">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:40px;color:#6c757d;">Chua co nhom chat nao.</div>
    }
</div>

<script>
    async function deleteChatGroup(id) {
        if (!confirm('Xoa nhom chat nay va tat ca tin nhan?')) return;
        const res = await fetch(`/Admin/DeleteChatGroup?id=${id}`, { method: 'POST' });
        const data = await res.json();
        if (data.success) location.reload();
        else alert(data.message || 'Loi');
    }
</script>