@using WisdomITNews.Models
@model List<UserSubscription>
@{
    ViewData["Title"] = "Đăng ký Premium"; Layout = "_AdminLayout";
    var names = ViewBag.UserNames as Dictionary<int,string> ?? new();
    var emails = ViewBag.UserEmails as Dictionary<int,string> ?? new();
    string status = ViewBag.Status as string ?? "";
    string q = ViewBag.Q as string ?? "";
    string StatusText(SubscriptionStatus st) => st switch { SubscriptionStatus.Trial=>"Dùng thử", SubscriptionStatus.Active=>"Hoạt động", SubscriptionStatus.Expired=>"Hết hạn", _=>"Đã hủy" };
    (string bg,string fg) StatusClr(SubscriptionStatus st) => st switch {
        SubscriptionStatus.Trial=>("#e0f2fe","#0369a1"), SubscriptionStatus.Active=>("#dcfce7","#16a34a"),
        SubscriptionStatus.Expired=>("#f0f2f5","#6c757d"), _=>("#fee2e2","#991b1b") };
}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
  <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-users-gear" style="color:#159aa3;"></i> Đăng ký Premium</h1>
  <a href="/admin/Transactions" style="background:#0e7d85;color:#fff;padding:9px 16px;border-radius:6px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-receipt"></i> Giao dịch</a>
</div>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }
@if (TempData["Err"] != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Err"]</div> }

<form method="get" action="/admin/Subscriptions" style="background:#fff;padding:14px;margin-bottom:16px;border-radius:6px;box-shadow:0 2px 10px rgba(0,0,0,.06);display:flex;gap:10px;flex-wrap:wrap;">
  <input type="text" name="q" value="@q" placeholder="🔍 Tìm theo tên / email người dùng..." style="flex:1;min-width:220px;padding:10px 14px;border:1px solid #d1d5db;font-size:14px;border-radius:6px;" />
  <select name="status" style="padding:10px 14px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;">
    <option value="">Tất cả trạng thái</option>
    <option value="Trial" selected="@(status=="Trial" ? "selected" : null)">Dùng thử</option>
    <option value="Active" selected="@(status=="Active" ? "selected" : null)">Hoạt động</option>
    <option value="Expired" selected="@(status=="Expired" ? "selected" : null)">Hết hạn</option>
    <option value="Cancelled" selected="@(status=="Cancelled" ? "selected" : null)">Đã hủy</option>
  </select>
  <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:10px 18px;border-radius:6px;font-weight:600;cursor:pointer;">Lọc</button>
</form>

<div style="background:#fff;border-radius:6px;box-shadow:0 2px 10px rgba(0,0,0,.06);overflow-x:auto;">
  <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
    <thead>
      <tr style="background:#f5f6f8;border-bottom:2px solid #e0e4e8;color:#6c757d;text-align:left;">
        <th style="padding:12px 14px;">Người dùng</th>
        <th style="padding:12px 14px;">Gói</th>
        <th style="padding:12px 14px;">Trạng thái</th>
        <th style="padding:12px 14px;">Bắt đầu</th>
        <th style="padding:12px 14px;">Kết thúc</th>
        <th style="padding:12px 14px;">Xác nhận</th>
        <th style="padding:12px 14px;"></th>
      </tr>
    </thead>
    <tbody>
      @foreach (var sub in Model)
      {
        var clr = StatusClr(sub.Status);
        <tr style="border-bottom:1px solid #f0f2f5;">
          <td style="padding:12px 14px;">
            <div style="font-weight:600;">@(names.ContainsKey(sub.UserId) ? names[sub.UserId] : ("User #" + sub.UserId))</div>
            <div style="font-size:12px;color:#94a3b8;">@(emails.ContainsKey(sub.UserId) ? emails[sub.UserId] : "")</div>
          </td>
          <td style="padding:12px 14px;">@(sub.Plan?.Name ?? "—")</td>
          <td style="padding:12px 14px;"><span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;background:@clr.bg;color:@clr.fg;">@StatusText(sub.Status)</span></td>
          <td style="padding:12px 14px;color:#6c757d;">@sub.StartDate.ToString("dd/MM/yyyy")</td>
          <td style="padding:12px 14px;color:#6c757d;">@sub.EndDate.ToString("dd/MM/yyyy")</td>
          <td style="padding:12px 14px;">@(sub.ConfirmedAt != null ? "✔" : "—")</td>
          <td style="padding:12px 14px;"><a href="/admin/SubscriptionDetail/@sub.Id" style="background:#159aa3;color:#fff;padding:6px 12px;border-radius:5px;font-size:12px;text-decoration:none;">Chi tiết</a></td>
        </tr>
      }
      @if (!Model.Any())
      { <tr><td colspan="7" style="padding:24px;text-align:center;color:#94a3b8;">Chưa có đăng ký nào.</td></tr> }
    </tbody>
  </table>
</div>
