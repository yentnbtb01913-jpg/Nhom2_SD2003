@using WisdomITNews.Models
@model UserSubscription
@{
    ViewData["Title"] = "Chi tiết đăng ký"; Layout = "_AdminLayout";
    var user = ViewBag.User as User;
    var txs = ViewBag.Txs as List<Transaction> ?? new();
    string StatusText(SubscriptionStatus st) => st switch { SubscriptionStatus.Trial=>"Dùng thử", SubscriptionStatus.Active=>"Hoạt động", SubscriptionStatus.Expired=>"Hết hạn", _=>"Đã hủy" };
    string TxText(TransactionStatus st) => st switch { TransactionStatus.Pending=>"Chờ", TransactionStatus.Success=>"Thành công", TransactionStatus.Failed=>"Thất bại", _=>"Đã hủy" };
    string lbl="display:block;font-weight:600;font-size:13px;margin-bottom:6px;color:#374151;";
    string inp="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;";
}
<div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
  <a href="/admin/Subscriptions" style="color:#6c757d;text-decoration:none;"><i class="fa fa-arrow-left"></i></a>
  <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-id-card" style="color:#159aa3;"></i> Chi tiết đăng ký #@Model.Id</h1>
</div>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }
@if (TempData["Err"] != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Err"]</div> }

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
  <div style="background:#fff;border-radius:8px;padding:20px;box-shadow:0 2px 10px rgba(0,0,0,.06);">
    <h3 style="font-size:15px;font-weight:700;margin-bottom:14px;">Thông tin</h3>
    <div style="font-size:14px;line-height:2;">
      <div><span style="color:#6c757d;">Người dùng:</span> <strong>@(user?.FullName ?? ("User #" + Model.UserId))</strong></div>
      <div><span style="color:#6c757d;">Email:</span> @(user?.Email ?? "—")</div>
      <div><span style="color:#6c757d;">Gói:</span> <strong>@(Model.Plan?.Name ?? "—")</strong></div>
      <div><span style="color:#6c757d;">Trạng thái:</span> <strong>@StatusText(Model.Status)</strong></div>
      <div><span style="color:#6c757d;">Bắt đầu:</span> @Model.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
      <div><span style="color:#6c757d;">Kết thúc:</span> <strong>@Model.EndDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
      <div><span style="color:#6c757d;">Xác nhận:</span> @(Model.ConfirmedAt?.ToString("dd/MM/yyyy HH:mm") ?? "chưa")</div>
      @if (!string.IsNullOrWhiteSpace(Model.Notes))
      { <div style="margin-top:8px;padding:8px 10px;background:#f8fafc;border-radius:6px;font-size:12px;color:#475569;"><i class="fa fa-note-sticky"></i> @Model.Notes</div> }
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:16px;">
    <div style="background:#fff;border-radius:8px;padding:20px;box-shadow:0 2px 10px rgba(0,0,0,.06);">
      <h3 style="font-size:15px;font-weight:700;margin-bottom:14px;"><i class="fa fa-calendar-plus" style="color:#16a34a;"></i> Gia hạn thủ công</h3>
      <form method="post" action="/admin/ExtendSubscription/@Model.Id" style="display:flex;gap:10px;align-items:end;">
        <div style="flex:1;">
          <label style="@lbl">Số ngày cộng thêm</label>
          <input style="@inp" type="number" name="days" min="1" value="30" required />
        </div>
        <button type="submit" style="background:#16a34a;color:#fff;border:none;padding:9px 16px;border-radius:6px;font-weight:600;cursor:pointer;">Gia hạn</button>
      </form>
    </div>
    <div style="background:#fff;border-radius:8px;padding:20px;box-shadow:0 2px 10px rgba(0,0,0,.06);">
      <h3 style="font-size:15px;font-weight:700;margin-bottom:14px;"><i class="fa fa-ban" style="color:#dc2626;"></i> Hủy gói</h3>
      <form method="post" action="/admin/CancelSubscriptionAdmin/@Model.Id" onsubmit="return confirm('Xác nhận hủy gói này?');">
        <label style="@lbl">Lý do (ghi vào Notes)</label>
        <input style="@inp" name="note" placeholder="VD: người dùng yêu cầu hoàn tiền" />
        <button type="submit" style="margin-top:10px;background:#dc2626;color:#fff;border:none;padding:9px 16px;border-radius:6px;font-weight:600;cursor:pointer;">Hủy gói</button>
      </form>
    </div>
  </div>
</div>

<div style="background:#fff;border-radius:8px;padding:20px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-top:16px;">
  <h3 style="font-size:15px;font-weight:700;margin-bottom:14px;">Giao dịch liên quan</h3>
  <table style="width:100%;border-collapse:collapse;font-size:13px;">
    <thead><tr style="background:#f5f6f8;color:#6c757d;text-align:left;">
      <th style="padding:10px 12px;">#</th><th style="padding:10px 12px;">Số tiền</th><th style="padding:10px 12px;">Phương thức</th><th style="padding:10px 12px;">Trạng thái</th><th style="padding:10px 12px;">Ngày</th>
    </tr></thead>
    <tbody>
      @foreach (var t in txs)
      {
        <tr style="border-bottom:1px solid #f0f2f5;">
          <td style="padding:10px 12px;">@t.Id</td>
          <td style="padding:10px 12px;font-weight:600;">@string.Format("{0:#,##0}", t.Amount) đ</td>
          <td style="padding:10px 12px;">@t.PaymentMethodLabel</td>
          <td style="padding:10px 12px;">@TxText(t.Status)</td>
          <td style="padding:10px 12px;color:#6c757d;">@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
        </tr>
      }
      @if (!txs.Any())
      { <tr><td colspan="5" style="padding:16px;text-align:center;color:#94a3b8;">Không có giao dịch.</td></tr> }
    </tbody>
  </table>
</div>
