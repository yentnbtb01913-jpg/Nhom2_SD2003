@model WisdomITNews.Models.ArticleFormViewModel
@{ ViewData["Title"] = "Viết bài mới"; Layout = "_AdminLayout"; }

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
  <h1 style="font-size:22px;font-weight:700;">✍️ Viết bài mới</h1>
  <a href="/admin/Articles" style="background:#f0f2f5;color:#3d3d3d;padding:9px 16px;border-radius:0px;font-size:14px;text-decoration:none;"><i class="fa fa-arrow-left"></i> Quay lại</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
  <div style="background:#fee2e2;color:#ba1a1a;border:1px solid #fecaca;border-radius:0px;padding:12px 16px;margin-bottom:16px;"><i class="fa fa-triangle-exclamation"></i> @Model.Error</div>
}

<form method="post" action="/admin/CreateArticle" enctype="multipart/form-data">
  @Html.AntiForgeryToken()
  <div style="display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start;">

    <!-- LEFT -->
    <div style="display:flex;flex-direction:column;gap:16px;">
      <div style="background:#fff;border-radius:0px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);">
        <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Tiêu đề *</label>
        <input type="text" name="Article.Title" value="@Model.Article.Title" placeholder="Nhập tiêu đề bài viết..." required
               style="width:100%;padding:10px 14px;border:1px solid #e0e4e8;border-radius:0px;font-size:15px;outline:none;font-family:inherit;"/>

        <label style="font-size:13px;font-weight:600;display:block;margin-top:14px;margin-bottom:6px;">Mô tả ngắn *</label>
        <textarea name="Article.Summary" rows="3" placeholder="Tóm tắt ngắn gọn nội dung bài viết..." required
                  style="width:100%;padding:10px 14px;border:1px solid #e0e4e8;border-radius:0px;font-size:14px;outline:none;font-family:inherit;resize:vertical;">@Model.Article.Summary</textarea>

        <label style="font-size:13px;font-weight:600;display:block;margin-top:14px;margin-bottom:6px;">Nội dung * <span style="font-size:11px;color:#6c757d;font-weight:400;">(hỗ trợ HTML)</span></label>
        <textarea name="Article.Content" id="content" rows="16" placeholder="Nội dung bài viết..." required
                  style="width:100%;padding:10px 14px;border:1px solid #e0e4e8;border-radius:0px;font-size:14px;outline:none;font-family:'Courier New',monospace;resize:vertical;">@Html.Raw(Model.Article.Content)</textarea>
      </div>

      <div style="background:#fff;border-radius:0px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);">
        <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">📷 Upload ảnh thumbnail <span style="font-size:11px;color:#6c757d;font-weight:400;">(jpg/png/webp, ≤5MB)</span></label>
        <input type="file" name="thumbnailFile" accept=".jpg,.jpeg,.png,.webp" id="thumbFile"
               style="width:100%;padding:8px;border:1px solid #e0e4e8;border-radius:0px;font-size:13px;background:#fafbfc;"/>

        <label style="font-size:13px;font-weight:600;display:block;margin-top:14px;margin-bottom:6px;">…hoặc dán URL Thumbnail</label>
        <input type="text" name="Article.Thumbnail" value="@Model.Article.Thumbnail" placeholder="https://images.unsplash.com/..."
               style="width:100%;padding:10px 14px;border:1px solid #e0e4e8;border-radius:0px;font-size:14px;outline:none;font-family:inherit;" id="thumbInput" oninput="previewThumb(this.value)"/>
        <div id="thumbPreview" style="margin-top:10px;display:@(string.IsNullOrEmpty(Model.Article.Thumbnail)?"none":"block");">
          <img src="@Model.Article.Thumbnail" alt="" style="width:100%;max-height:180px;object-fit:cover;border-radius:0px;" id="thumbImg"/>
        </div>

        <label style="font-size:13px;font-weight:600;display:block;margin-top:14px;margin-bottom:6px;">Tags <span style="font-size:11px;color:#6c757d;font-weight:400;">(phân cách bằng dấu phẩy)</span></label>
        <input type="text" name="Tags" value="@Model.Tags" placeholder="AI, Python, Machine Learning..."
               style="width:100%;padding:10px 14px;border:1px solid #e0e4e8;border-radius:0px;font-size:14px;outline:none;font-family:inherit;"/>
      </div>
    </div>

    <!-- RIGHT -->
    <div style="display:flex;flex-direction:column;gap:16px;">
      <div style="background:#fff;border-radius:0px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);">
        <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Trạng thái</label>
        <select name="Article.Status" style="width:100%;padding:10px 14px;border:1px solid #e0e4e8;border-radius:0px;font-size:14px;outline:none;background:#fff;">
          <option value="draft" selected="@(Model.Article.Status == "draft")">📝 Bản nháp</option>
          <option value="published" selected="@(Model.Article.Status == "published")">✅ Xuất bản</option>
          <option value="archived" selected="@(Model.Article.Status == "archived")">📦 Lưu trữ</option>
        </select>

        <label style="font-size:13px;font-weight:600;display:block;margin-top:14px;margin-bottom:6px;">Danh mục</label>
        <select name="Article.CategoryId" required title="Vui lòng chọn danh mục cho bài viết" style="width:100%;padding:10px 14px;border:1px solid #e0e4e8;border-radius:0px;font-size:14px;outline:none;background:#fff;">
          <option value="">— Chọn danh mục —</option>
          @foreach (var c in Model.Categories)
          {
            <option value="@c.Id" selected="@(Model.Article.CategoryId == c.Id)">@c.Icon @c.Name</option>
          }
        </select>
                <label style="font-size:13px;font-weight:600;display:block;margin-top:14px;margin-bottom:6px;"><i class="fa fa-map-marker-alt" style="color:#ba1a1a;"></i> Vùng tin tức</label>
                <select name="Article.Region" style="width:100%;padding:10px 14px;border:1px solid #e0e4e8;border-radius:0px;font-size:14px;outline:none;background:#fff;">
                    <option value="">— Tất cả (không chọn vùng) —</option>
                    <option value="dong-nai" selected="@(Model.Article.Region == "dong-nai")">📍 Đồng Nai</option>
                    <option value="ha-noi" selected="@(Model.Article.Region == "ha-noi")">📍 Hà Nội</option>
                    <option value="ho-chi-minh" selected="@(Model.Article.Region == "ho-chi-minh")">📍 TP. Hồ Chí Minh</option>
                    <option value="da-nang" selected="@(Model.Article.Region == "da-nang")">📍 Đà Nẵng</option>
                    <option value="hai-phong" selected="@(Model.Article.Region == "hai-phong")">📍 Hải Phòng</option>
                    <option value="can-tho" selected="@(Model.Article.Region == "can-tho")">📍 Cần Thơ</option>
                </select>
        <div style="display:flex;flex-direction:column;gap:8px;margin-top:14px;">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;">
            <input type="checkbox" name="Article.IsFeatured" value="true" @(Model.Article.IsFeatured?"checked":"") style="width:16px;height:16px;"/> ⭐ Bài nổi bật
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;">
            <input type="checkbox" name="Article.IsBreaking" value="true" @(Model.Article.IsBreaking?"checked":"") style="width:16px;height:16px;"/> 🔴 Breaking news
          </label>
                    <label style="font-size:13px;font-weight:600;display:block;margin-top:14px;margin-bottom:6px;"><i class="fa fa-clock" style="color:#476083;"></i> Thời gian đăng bài</label>
                    <input type="datetime-local" name="Article.PublishedAt"
                           style="width:100%;padding:10px 14px;border:1px solid #e0e4e8;border-radius:0px;font-size:14px;outline:none;font-family:inherit;background:#fff;" />
                    <p style="font-size:11px;color:#9ca3af;margin-top:4px;">Để trống = thời điểm duyệt bài</p>
        </div>

        <button type="submit" style="width:100%;margin-top:16px;padding:12px;background:#ba1a1a;color:#fff;border:none;border-radius:0px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;">
          <i class="fa fa-paper-plane"></i> Đăng bài
        </button>
      </div>

      <div style="background:#f0eeff;border-radius:0px;padding:16px;border:1px solid #d4d0f5;">
        <div style="font-weight:700;color:#476083;margin-bottom:10px;"><i class="fa fa-robot"></i> AI Moderation</div>
        <p style="font-size:12px;color:#555;line-height:1.5;">Khi đăng bài, AI sẽ tự động kiểm tra nội dung. Bài bị cờ score &gt; 70 sẽ chuyển sang trạng thái <strong>Rejected</strong>; score 40-70 sẽ thành <strong>PendingReview</strong>.</p>
      </div>
    </div>
  </div>
</form>

@section Scripts {
<script>
function previewThumb(url) {
  const box = document.getElementById('thumbPreview');
  const img = document.getElementById('thumbImg');
  if (url && url.trim()) { img.src = url; box.style.display = 'block'; }
  else { box.style.display = 'none'; }
}
// Preview file upload
const fileInput = document.getElementById('thumbFile');
if (fileInput) {
  fileInput.addEventListener('change', function () {
    const file = this.files && this.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      const box = document.getElementById('thumbPreview');
      const img = document.getElementById('thumbImg');
      img.src = e.target.result;
      box.style.display = 'block';
    };
    reader.readAsDataURL(file);
  });
}
</script>
}
