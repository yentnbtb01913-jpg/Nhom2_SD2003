@model WisdomITNews.Models.ChatGroup
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết nhóm: " + Model.Name;
    var members = ViewBag.Members as List<dynamic> ?? new List<dynamic>();
    var messages = ViewBag.Messages as List<WisdomITNews.Models.ChatMessage> ?? new List<WisdomITNews.Models.ChatMessage>();
}

<div style="margin-bottom:20px;">
    <a href="/Admin/ChatManagement" style="color:#2563eb;text-decoration:none;">&larr; Quay lại danh sách</a>
    <h1 style="font-size:22px;font-weight:700;margin-top:10px;">@Model.Name</h1>
    <p style="color:#6c757d;font-size:13px;">
        Loại: @(Model.IsDirectMessage ? "Tin nhắn riêng" : "Nhóm") |
        Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") |
        Thành viên: @members.Count |
        Tin nhắn: @messages.Count
    </p>
</div>

<!-- THÀNH VIÊN -->
<div style="background:#fff;border-radius:0px;box-shadow:0 2px 8px rgba(0,0,0,.07);padding:20px;margin-bottom:20px;">
    <h2 style="font-size:16px;font-weight:700;margin-bottom:12px;">Thành viên (@members.Count)</h2>
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead>
            <tr style="background:#f5f6f8;border-bottom:2px solid #e0e4e8;">
                <th style="padding:10px 14px;text-align:left;">Tên</th>
                <th style="padding:10px 14px;text-align:center;">Loại</th>
                <th style="padding:10px 14px;text-align:center;">Vai trò</th>
                <th style="padding:10px 14px;text-align:center;">Ngày tham gia</th>
                <th style="padding:10px 14px;text-align:center;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in members)
            {
                <tr style="border-bottom:1px solid #f0f2f5;" id="member-@m.Id">
                    <td style="padding:10px 14px;">
                        @if (m.Avatar != null)
                        {
                            <img src="@m.Avatar" style="width:28px;height:28px;border-radius:50%;margin-right:8px;vertical-align:middle;" />
                        }
                        @m.Name
                    </td>
                    <td style="padding:10px 14px;text-align:center;">
                        <span style="background:@(m.MemberType == "admin" ? "#fef3c7" : "#dbeafe");color:@(m.MemberType == "admin" ? "#92400e" : "#1e40af");padding:2px 8px;border-radius:4px;font-size:11px;">
                            @(m.MemberType == "admin" ? "Admin" : "User")
                        </span>
                    </td>
                    <td style="padding:10px 14px;text-align:center;">@m.Role</td>
                    <td style="padding:10px 14px;text-align:center;">@m.JoinedAt.ToString("dd/MM/yyyy")</td>
                    <td style="padding:10px 14px;text-align:center;">
                        <button onclick="kickMember(@m.Id, '@m.Name')" style="color:#ba1a1a;border:none;background:none;cursor:pointer;font-weight:600;font-size:12px;">Kick</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- TIN NHẮN -->
<div style="background:#fff;border-radius:0px;box-shadow:0 2px 8px rgba(0,0,0,.07);padding:20px;">
    <h2 style="font-size:16px;font-weight:700;margin-bottom:12px;">Tin nhắn (@messages.Count)</h2>
    <div style="max-height:600px;overflow-y:auto;" id="message-list">
        @if (!messages.Any())
        {
            <p style="text-align:center;color:#6c757d;padding:20px;">Chưa có tin nhắn nào.</p>
        }
        @foreach (var msg in messages)
        {
            <div style="display:flex;align-items:flex-start;padding:10px 0;border-bottom:1px solid #f0f2f5;" id="msg-@msg.Id">
                <div style="flex:1;">
                    <div style="margin-bottom:4px;">
                        <strong style="color:@(msg.SenderType == "admin" ? "#92400e" : "#1e40af");font-size:13px;">@msg.SenderName</strong>
                        <span style="color:#adb5bd;font-size:11px;margin-left:8px;">@msg.SentAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        @if (msg.IsPinned)
                        {
                            <span style="background:#fef3c7;color:#92400e;padding:1px 6px;border-radius:3px;font-size:10px;margin-left:6px;">📌 Ghim</span>
                        }
                    </div>
                    @if (msg.MessageType == "image")
                    {
                        <div>
                            <img src="@msg.FileUrl" style="max-width:300px;max-height:200px;border-radius:0px;" />
                        </div>
                    }
                    else if (msg.MessageType == "file")
                    {
                        <div>
                            <a href="@msg.FileUrl" target="_blank" style="color:#2563eb;">📎 @msg.FileName</a>
                        </div>
                    }
                    else
                    {
                        <p style="margin:0;font-size:13px;color:#333;">@msg.Content</p>
                    }
                </div>
                <button onclick="deleteMessage(@msg.Id)" style="color:#ba1a1a;border:none;background:none;cursor:pointer;font-size:12px;font-weight:600;margin-left:12px;white-space:nowrap;">Xóa</button>
            </div>
        }
    </div>
</div>

<script>
    async function deleteMessage(id) {
        if (!confirm('Xóa tin nhắn này?')) return;
        const res = await fetch(`/Admin/AdminDeleteMessage?id=${id}`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            document.getElementById('msg-' + id).remove();
        } else {
            alert(data.message || 'Lỗi');
        }
    }

    async function kickMember(id, name) {
        if (!confirm(`Kick "${name}" khỏi nhóm?`)) return;
        const res = await fetch(`/Admin/KickMember?id=${id}`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            document.getElementById('member-' + id).remove();
        } else {
            alert(data.message || 'Lỗi');
        }
    }
</script>