@using WisdomITNews.Models
@model List<Podcast>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Audio / Podcast";
}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-podcast" style="color:#159aa3;"></i> Quản lý Audio / Podcast</h1>
</div>
@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }
@if (TempData["Err"] != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Err"]</div> }

<div style="background:#fff;border-radius:8px;padding:18px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:16px;">
    <h3 style="font-size:15px;font-weight:800;margin-bottom:12px;color:#0e7d85;"><i class="fa fa-upload"></i> Tải lên audio</h3>
    <form method="post" action="/admin/UploadPodcast" enctype="multipart/form-data" style="display:grid;grid-template-columns:2fr 2fr auto;gap:10px;align-items:end;">
        <div><label style="font-size:12px;color:#6c757d;font-weight:600;">Tiêu đề</label><input name="title" placeholder="Để trống sẽ lấy tên file" style="width:100%;padding:9px 11px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;" /></div>
        <div><label style="font-size:12px;color:#6c757d;font-weight:600;">File audio (.mp3/.wav, ≤50MB)</label><input type="file" name="audioFile" accept=".mp3,.wav,audio/*" required style="width:100%;padding:7px 11px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;" /></div>
        <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:9px 18px;border-radius:6px;font-weight:600;cursor:pointer;white-space:nowrap;"><i class="fa fa-upload"></i> Tải lên</button>
        <div style="grid-column:1 / -1;">
            <label style="font-size:12px;color:#6c757d;font-weight:600;">Bài viết liên kết (tùy chọn)</label>
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                <button type="button" onclick="artOpen()" style="background:#0e7d85;color:#fff;border:none;padding:9px 14px;border-radius:6px;font-size:13px;cursor:pointer;white-space:nowrap;"><i class="fa fa-newspaper"></i> Chọn bài viết</button>
                <span id="artSelected" style="font-size:13px;color:#374151;align-items:center;gap:6px;display:none;">
                    <i class="fa fa-check-circle" style="color:#16a34a;"></i>
                    <span id="artSelTitle" style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;"></span>
                    <button type="button" onclick="artClear()" title="Bỏ chọn" style="background:#fee2e2;color:#991b1b;border:none;border-radius:50%;width:20px;height:20px;cursor:pointer;line-height:1;">&times;</button>
                </span>
            </div>
            <input type="hidden" name="articleId" id="articleId" />
        </div>
    </form>
    <input type="hidden" id="pfx" value="/admin" />
</div>

<div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead><tr style="background:#f5f6f8;color:#6c757d;text-align:left;">
            <th style="padding:10px;">Tiêu đề</th><th style="padding:10px;">Bài viết</th><th style="padding:10px;">Loại</th>
            <th style="padding:10px;">Thời lượng</th><th style="padding:10px;">Dung lượng</th><th style="padding:10px;">Nghe</th><th style="padding:10px;">Ngày</th><th style="padding:10px;"></th>
        </tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr id="pod-@p.Id" style="border-bottom:1px solid #f0f2f5;">
                    <td style="padding:10px;font-weight:600;">@p.Title</td>
                    <td style="padding:10px;color:#6c757d;">@(p.Article != null ? p.Article.Title : "—")</td>
                    <td style="padding:10px;">@if (p.IsAiGenerated) {<span style="background:#f0eeff;color:#6c63ff;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">AI (Piper)</span>} else {<span style="background:#e6f4f5;color:#0e7d85;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">Upload</span>}</td>
                    <td style="padding:10px;color:#6c757d;">@(p.DurationSeconds > 0 ? $"{p.DurationSeconds/60}:{p.DurationSeconds%60:D2}" : "—")</td>
                    <td style="padding:10px;color:#6c757d;">@((p.FileSizeBytes/1024.0/1024.0).ToString("0.0")) MB</td>
                    <td style="padding:10px;"><audio controls preload="none" src="@p.FilePath" style="height:32px;max-width:200px;"></audio></td>
                    <td style="padding:10px;color:#6c757d;font-size:12px;">@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td style="padding:10px;"><button onclick="delPod(@p.Id)" title="Xóa" style="background:#fee2e2;color:#991b1b;border:none;padding:5px 10px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-trash"></i></button></td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="8" style="padding:24px;text-align:center;color:#94a3b8;">Chưa có audio nào.</td></tr> }
        </tbody>
    </table>
</div>

<!-- Modal chọn bài viết (thuần, không dùng thư viện ngoài) -->
<div id="artModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;align-items:flex-start;justify-content:center;padding:40px 16px;">
    <div style="background:#fff;border-radius:10px;max-width:720px;width:100%;max-height:82vh;display:flex;flex-direction:column;box-shadow:0 10px 40px rgba(0,0,0,.3);">
        <div style="padding:14px 18px;border-bottom:1px solid #eef2f7;display:flex;justify-content:space-between;align-items:center;">
            <b style="font-size:16px;color:#0e7d85;"><i class="fa fa-newspaper"></i> Chọn bài viết liên kết</b>
            <button type="button" onclick="artClose()" style="background:none;border:none;font-size:22px;cursor:pointer;color:#94a3b8;line-height:1;">&times;</button>
        </div>
        <div style="padding:14px 18px 8px;">
            <input id="artSearch" type="text" placeholder="🔍 Tìm theo tên bài viết..." oninput="artDebounce()" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box;" />
        </div>
        <div id="artList" style="flex:1;overflow-y:auto;padding:4px 18px 10px;"></div>
        <div style="padding:12px 18px;border-top:1px solid #eef2f7;text-align:center;">
            <button type="button" id="artMore" onclick="artLoadMore()" style="display:none;background:#f0f2f5;color:#374151;border:1px solid #e5e7eb;padding:8px 22px;border-radius:6px;cursor:pointer;font-size:13px;font-weight:600;">Tải thêm</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function delPod(id){
        if(!await confirmSwal('Xóa audio này?')) return;
        var pfx = document.getElementById('pfx').value;
        var r = await fetch(pfx + '/DeletePodcast/' + id, { method:'POST' });
        var d = await r.json();
        if(d.success){ document.getElementById('pod-'+id)?.remove(); swalToast('success','Đã xóa'); }
        else Swal.fire('Không xóa được');
    }

    // ===== Modal chọn bài viết =====
    var artPage = 1, artQ = '', artTimer = null, artLoaded = false;
    function artOpen(){
        document.getElementById('artModal').style.display = 'flex';
        if(!artLoaded){ artPage = 1; artQ = ''; document.getElementById('artSearch').value = ''; artLoad(true); }
    }
    function artClose(){ document.getElementById('artModal').style.display = 'none'; }
    function artDebounce(){
        clearTimeout(artTimer);
        artTimer = setTimeout(function(){ artQ = document.getElementById('artSearch').value.trim(); artPage = 1; artLoad(true); }, 300);
    }
    function artLoadMore(){ artPage++; artLoad(false); }
    function artEsc(s){ return (s||'').replace(/[&<>"']/g, function(m){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]; }); }
    async function artLoad(reset){
        var pfx = document.getElementById('pfx').value;
        var url = pfx + '/SearchArticlesForPicker?q=' + encodeURIComponent(artQ) + '&page=' + artPage + '&pageSize=8';
        var list = document.getElementById('artList');
        if(reset) list.innerHTML = '<div style="padding:20px;text-align:center;color:#94a3b8;">Đang tải...</div>';
        try {
            var r = await fetch(url); var d = await r.json();
            if(reset) list.innerHTML = '';
            if((!d.items || d.items.length === 0) && reset){
                list.innerHTML = '<div style="padding:20px;text-align:center;color:#94a3b8;">Không tìm thấy bài viết.</div>';
            }
            (d.items || []).forEach(function(a){
                var thumb = a.thumbnail
                    ? '<img src="' + a.thumbnail + '" style="width:66px;height:46px;object-fit:cover;border-radius:5px;flex-shrink:0;">'
                    : '<div style="width:66px;height:46px;background:#e5e7eb;border-radius:5px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#9ca3af;"><i class="fa fa-image"></i></div>';
                var el = document.createElement('div');
                el.style.cssText = 'display:flex;gap:12px;padding:9px 6px;border-bottom:1px solid #f0f2f5;cursor:pointer;align-items:center;border-radius:6px;';
                el.onmouseover = function(){ el.style.background = '#f0fdfa'; };
                el.onmouseout = function(){ el.style.background = ''; };
                el.onclick = function(){ artPick(a.id, a.title); };
                el.innerHTML = thumb +
                    '<div style="min-width:0;flex:1;">' +
                    '<div style="font-weight:600;font-size:13.5px;color:#111827;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + artEsc(a.title) + '</div>' +
                    '<div style="font-size:11.5px;color:#6c757d;margin-top:2px;"><i class="fa fa-location-dot"></i> ' + artEsc(a.region) + ' &nbsp;·&nbsp; <i class="fa fa-eye"></i> ' + a.views + ' lượt xem</div>' +
                    '</div>';
                list.appendChild(el);
            });
            document.getElementById('artMore').style.display = d.hasMore ? 'inline-block' : 'none';
            artLoaded = true;
        } catch(e){ if(reset) list.innerHTML = '<div style="padding:20px;text-align:center;color:#dc2626;">Lỗi tải danh sách.</div>'; }
    }
    function artPick(id, title){
        document.getElementById('articleId').value = id;
        document.getElementById('artSelTitle').textContent = title;
        document.getElementById('artSelected').style.display = 'inline-flex';
        artClose();
    }
    function artClear(){
        document.getElementById('articleId').value = '';
        document.getElementById('artSelected').style.display = 'none';
    }
</script>
}
