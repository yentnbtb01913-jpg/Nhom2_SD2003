@using WisdomITNews.Models
@model List<NewsletterSubscriber>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Newsletter";
    var smtpOk = (bool)(ViewBag.SmtpConfigured ?? false);
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <h1 style="font-size:22px;font-weight:700;">📧 Newsletter</h1>
    <span style="font-size:13px;color:#6c757d;">Tổng subscribers: <strong>@Model.Count</strong></span>
</div>

@if (TempData["NewsletterSuccess"] != null)
{
    <div style="background:#dcfce7;color:#166534;padding:12px 16px;margin-bottom:16px;border-left:4px solid #16a34a;font-size:14px;">
        @TempData["NewsletterSuccess"]
    </div>
}
@if (TempData["NewsletterError"] != null)
{
    <div style="background:#fee2e2;color:#991b1b;padding:12px 16px;margin-bottom:16px;border-left:4px solid #dc2626;font-size:14px;">
        @TempData["NewsletterError"]
    </div>
}

@if (!smtpOk)
{
    <div style="background:#fff7ed;color:#9a3412;padding:12px 16px;margin-bottom:20px;border-left:4px solid #f97316;font-size:13px;">
        ⚠️ SMTP chưa được cấu hình. Mở <code>appsettings.json</code> → section <code>Smtp</code> và điền Host/Port/Username/Password trước khi gửi.
        Với Gmail: bật 2-Step Verification rồi tạo App Password 16 ký tự.
    </div>
}

<!-- Soạn newsletter -->
<div style="background:#fff;padding:20px;margin-bottom:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);">
    <h2 style="font-size:16px;font-weight:600;margin-bottom:14px;">Soạn & gửi newsletter cho tất cả subscriber active</h2>
    <form method="post" action="/admin/SendNewsletter">
        @Html.AntiForgeryToken()
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">Tiêu đề email</label>
        <input type="text" name="subject" required
               placeholder="Vd: Bản tin tuần này — Tin nóng công nghệ"
               style="width:100%;padding:9px 12px;border:1px solid #d1d5db;font-size:14px;margin-bottom:12px;" />

        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">Nội dung HTML</label>
        <textarea name="htmlBody" rows="10" required
                  placeholder="&lt;h2&gt;Tin nổi bật tuần này&lt;/h2&gt;&lt;p&gt;...&lt;/p&gt;"
                  style="width:100%;padding:10px 12px;border:1px solid #d1d5db;font-size:13px;font-family:Consolas,Monaco,monospace;"></textarea>

        <button type="submit" onclick="return confirm('Gửi email tới @Model.Count(m => m.Status == "active") subscriber active?');"
                style="margin-top:12px;padding:10px 22px;background:#e63946;color:#fff;border:none;font-size:14px;font-weight:600;cursor:pointer;">
            🚀 Gửi cho tất cả subscriber
        </button>
    </form>
</div>

<!-- Test SMTP -->
<div style="background:#fff;padding:20px;margin-bottom:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);">
    <h2 style="font-size:16px;font-weight:600;margin-bottom:14px;">Test cấu hình SMTP</h2>
    <form method="post" action="/admin/SendTestEmail" style="display:flex;gap:10px;align-items:center;">
        @Html.AntiForgeryToken()
        <input type="email" name="testEmail" required placeholder="email-test@example.com"
               style="flex:1;padding:9px 12px;border:1px solid #d1d5db;font-size:14px;" />
        <button type="submit"
                style="padding:9px 18px;background:#0a2540;color:#fff;border:none;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;">
            Gửi email test
        </button>
    </form>
</div>

<!-- Bộ lọc trạng thái -->
@{ var nlFilter = (string)(ViewBag.Filter ?? "all"); }
<div style="display:flex;gap:8px;margin-bottom:12px;">
    <a href="/admin/Newsletter?filter=all" style="padding:7px 16px;font-size:13px;text-decoration:none;border-radius:6px;@(nlFilter=="all" ? "background:#0e7d85;color:#fff;" : "background:#f0f2f5;color:#374151;")">Tất cả</a>
    <a href="/admin/Newsletter?filter=active" style="padding:7px 16px;font-size:13px;text-decoration:none;border-radius:6px;@(nlFilter=="active" ? "background:#16a34a;color:#fff;" : "background:#f0f2f5;color:#374151;")">Đang nhận (active)</a>
    <a href="/admin/Newsletter?filter=inactive" style="padding:7px 16px;font-size:13px;text-decoration:none;border-radius:6px;@(nlFilter=="inactive" ? "background:#dc2626;color:#fff;" : "background:#f0f2f5;color:#374151;")">Đã huỷ (inactive)</a>
</div>

<!-- Danh sách subscribers -->
<div style="background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.07);overflow-x:auto;">
    <div style="padding:14px 18px;border-bottom:1px solid #e5e7eb;font-weight:600;">Danh sách subscriber (@Model.Count)</div>
    @if (!Model.Any())
    {
        <div style="padding:30px;text-align:center;color:#6c757d;">Chưa có subscriber nào.</div>
    }
    else
    {
        <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
            <thead style="background:#f8fafc;color:#6c757d;text-align:left;">
                <tr>
                    <th style="padding:10px;">Email</th>
                    <th style="padding:10px;">Họ tên</th>
                    <th style="padding:10px;">Số điện thoại</th>
                    <th style="padding:10px;">Nguồn đăng ký</th>
                    <th style="padding:10px;">Trạng thái</th>
                    <th style="padding:10px;">Ngày đăng ký</th>
                    <th style="padding:10px;text-align:right;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr id="sub-@s.Id" style="border-bottom:1px solid #f0f2f5;">
                        <td style="padding:10px;">@s.Email</td>
                        <td style="padding:10px;">@(string.IsNullOrWhiteSpace(s.FullName) ? "—" : s.FullName)</td>
                        <td style="padding:10px;">@(string.IsNullOrWhiteSpace(s.Phone) ? "—" : s.Phone)</td>
                        <td style="padding:10px;color:#6c757d;">@(string.IsNullOrWhiteSpace(s.Source) ? "—" : s.Source)</td>
                        <td style="padding:10px;">
                            <span style="padding:2px 10px;border-radius:20px;background:@(s.Status == "active" ? "#dcfce7" : "#fee2e2");color:@(s.Status == "active" ? "#166534" : "#991b1b");font-weight:600;font-size:11px;">@(s.Status == "active" ? "Đang nhận" : "Đã huỷ")</span>
                        </td>
                        <td style="padding:10px;color:#6c757d;font-size:12px;">@s.SubscribedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="padding:10px;text-align:right;white-space:nowrap;">
                            <button type="button" onclick="toggleEdit(@s.Id)" style="padding:5px 12px;background:#e6f4f5;color:#0e7d85;border:none;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-pen"></i> Sửa</button>
                            <button type="button" onclick="deleteSubscriber(@s.Id)" style="padding:5px 12px;background:#fee2e2;color:#991b1b;border:none;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-trash"></i> Xoá</button>
                        </td>
                    </tr>
                    <tr id="edit-@s.Id" style="display:none;background:#f8fafc;border-bottom:1px solid #f0f2f5;">
                        <td colspan="7" style="padding:14px;">
                            <form method="post" action="/admin/EditSubscriber/@s.Id" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
                                @Html.AntiForgeryToken()
                                <div><label style="display:block;font-size:11px;color:#6c757d;">Email</label><input name="email" value="@s.Email" type="email" required style="padding:7px 10px;border:1px solid #d1d5db;border-radius:5px;" /></div>
                                <div><label style="display:block;font-size:11px;color:#6c757d;">Họ tên</label><input name="fullName" value="@s.FullName" style="padding:7px 10px;border:1px solid #d1d5db;border-radius:5px;" /></div>
                                <div><label style="display:block;font-size:11px;color:#6c757d;">SĐT</label><input name="phone" value="@s.Phone" style="padding:7px 10px;border:1px solid #d1d5db;border-radius:5px;width:130px;" /></div>
                                <div><label style="display:block;font-size:11px;color:#6c757d;">Nguồn</label><input name="source" value="@s.Source" style="padding:7px 10px;border:1px solid #d1d5db;border-radius:5px;width:140px;" /></div>
                                <div><label style="display:block;font-size:11px;color:#6c757d;">Trạng thái</label>
                                    <select name="status" style="padding:7px 10px;border:1px solid #d1d5db;border-radius:5px;">
                                        <option value="active" selected="@(s.Status == "active")">Đang nhận</option>
                                        <option value="inactive" selected="@(s.Status != "active")">Đã huỷ</option>
                                    </select>
                                </div>
                                <button type="submit" style="padding:8px 16px;background:#0e7d85;color:#fff;border:none;border-radius:5px;font-weight:600;cursor:pointer;"><i class="fa fa-save"></i> Lưu</button>
                                <button type="button" onclick="toggleEdit(@s.Id)" style="padding:8px 14px;background:#f0f2f5;color:#374151;border:none;border-radius:5px;cursor:pointer;">Huỷ</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        function toggleEdit(id){
            var r = document.getElementById('edit-' + id);
            r.style.display = (r.style.display === 'none' || !r.style.display) ? 'table-row' : 'none';
        }
        async function deleteSubscriber(id) {
            if (!await confirmSwal('Xoá subscriber này?')) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const fd = new FormData();
            fd.append('__RequestVerificationToken', token);
            const r = await fetch('/admin/DeleteSubscriber/' + id, { method: 'POST', body: fd });
            const data = await r.json();
            if (data.success) { document.getElementById('sub-' + id).remove(); document.getElementById('edit-' + id).remove(); }
            else Swal.fire(data.message || 'Xoá thất bại');
        }
    </script>
}
