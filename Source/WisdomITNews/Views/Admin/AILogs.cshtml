@model List<WisdomITNews.Models.AILog>
@using WisdomITNews.Services
@{ ViewData["Title"] = "AI Logs"; Layout = "_AdminLayout"; }

<div style="margin-bottom:20px;">
  <h1 style="font-size:22px;font-weight:700;">🤖 AI Logs</h1>
  <p style="font-size:13px;color:#6c757d;margin-top:4px;">Lịch sử các lần gọi Gemini AI</p>
</div>

@if (TempData["AILogSuccess"] != null)
{
  <div style="background:#dcfce7;color:#166534;padding:10px 14px;margin-bottom:14px;border-left:4px solid #16a34a;font-size:13px;">
    @TempData["AILogSuccess"]
  </div>
}
@if (TempData["AILogError"] != null)
{
  <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;margin-bottom:14px;border-left:4px solid #dc2626;font-size:13px;">
    @TempData["AILogError"]
  </div>
}

<form method="get" action="/Admin/AILogs" style="display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap;">
    <label style="font-size:13px;font-weight:600;">Từ ngày:</label>
    <input type="date" name="from" id="filterFrom" value="@ViewBag.FromDate" style="padding:6px 10px;border:1px solid #ddd;border-radius:0px;" />
    <label style="font-size:13px;font-weight:600;">Đến ngày:</label>
    <input type="date" name="to" id="filterTo" value="@ViewBag.ToDate" style="padding:6px 10px;border:1px solid #ddd;border-radius:0px;" />
    <button type="submit" style="padding:6px 16px;background:#476083;color:#fff;border:none;border-radius:0px;font-weight:600;cursor:pointer;">Lọc</button>
    <a href="/Admin/AILogs" style="padding:6px 12px;font-size:13px;color:#6c757d;">Xóa lọc</a>
</form>

<!-- Hàng nút xóa hàng loạt -->
<div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;">
  <form method="post" action="/Admin/DeleteAILogs" onsubmit="return confirmDeleteRange();" style="display:inline;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="from" id="delFrom" value="@ViewBag.FromDate" />
    <input type="hidden" name="to"   id="delTo"   value="@ViewBag.ToDate" />
    <button type="submit" style="padding:7px 14px;background:#fff7ed;color:#9a3412;border:1px solid #fdba74;font-size:12px;font-weight:600;cursor:pointer;">
      🗑️ Xóa log theo khoảng lọc
    </button>
  </form>
  <form method="post" action="/Admin/DeleteAILogs" onsubmit="return confirm('XÓA TẤT CẢ log AI? Không thể khôi phục.');" style="display:inline;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="all" value="true" />
    <button type="submit" style="padding:7px 14px;background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;font-size:12px;font-weight:600;cursor:pointer;">
      💥 Xóa TẤT CẢ log
    </button>
  </form>
</div>

<div style="background:#fff;border-radius:0px;box-shadow:0 2px 8px rgba(0,0,0,.07);overflow:hidden;">
  <table style="width:100%;border-collapse:collapse;font-size:13px;">
    <thead>
      <tr style="background:#f5f6f8;border-bottom:2px solid #e0e4e8;">
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Thời gian</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Bài viết</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Hành động</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Model</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Tokens</th>
        <th style="text-align:left;padding:12px 16px;font-weight:600;color:#6c757d;">Kết quả</th>
        <th style="text-align:right;padding:12px 16px;font-weight:600;color:#6c757d;">Hành động</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var l in Model)
      {
        <tr id="log-@l.Id" style="border-bottom:1px solid #f0f2f5;">
          <td style="padding:12px 16px;color:#6c757d;white-space:nowrap;">@l.CreatedAt.ToString("dd/MM HH:mm")</td>
          <td style="padding:12px 16px;max-width:200px;">
            <div style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;font-size:12px;">
              @(l.Article?.Title ?? "—")
            </div>
          </td>
          <td style="padding:12px 16px;">
            <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:@(l.Action=="summarize"?"#f0eeff":"#fef9c3");color:@(l.Action=="summarize"?"#476083":"#ca8a04");">
              @(l.Action == "summarize" ? "🤖 Tóm tắt" : l.Action == "suggest_title" ? "✍️ Gợi ý tiêu đề" : l.Action)
            </span>
          </td>
          <td style="padding:12px 16px;font-size:12px;color:#6c757d;">@l.ModelUsed</td>
          <td style="padding:12px 16px;color:#6c757d;">@l.TokensUsed</td>
          <td style="padding:12px 16px;">
            <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:@(l.IsSuccess?"#dcfce7":"#fee2e2");color:@(l.IsSuccess?"#16a34a":"#ba1a1a");">
              @(l.IsSuccess ? "✅ Thành công" : "❌ Thất bại")
            </span>
          </td>
          <td style="padding:12px 16px;text-align:right;">
            <button onclick="deleteAILog(@l.Id)" style="padding:5px 12px;background:#fee2e2;color:#991b1b;border:none;font-size:12px;cursor:pointer;">Xóa</button>
          </td>
        </tr>
      }
    </tbody>
  </table>
  @if (!Model.Any())
  {
    <div style="text-align:center;padding:40px;color:#6c757d;">Chưa có log nào.</div>
  }
</div>

@section Scripts {
<script>
    function confirmDeleteRange() {
        var f = document.getElementById('filterFrom').value;
        var t = document.getElementById('filterTo').value;
        document.getElementById('delFrom').value = f;
        document.getElementById('delTo').value = t;
        if (!f && !t) {
            alert('Hãy chọn "Từ ngày" và/hoặc "Đến ngày" trước khi xóa theo khoảng.');
            return false;
        }
        return confirm('Xóa tất cả log AI trong khoảng đã lọc?');
    }
    async function deleteAILog(id) {
        if (!confirm('Xóa log AI này?')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const fd = new FormData();
        fd.append('id', id);
        fd.append('__RequestVerificationToken', token);
        const r = await fetch('/Admin/DeleteAILog', { method: 'POST', body: fd });
        const data = await r.json();
        if (data.success) {
            const row = document.getElementById('log-' + id);
            if (row) row.remove();
        } else {
            alert(data.message || 'Xóa thất bại');
        }
    }
</script>
}
