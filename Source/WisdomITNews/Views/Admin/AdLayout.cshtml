@using WisdomITNews.Models
@model List<AdLayoutZoneVm>
@{
    ViewData["Title"] = "Bố cục & xoay vòng quảng cáo";
    Layout = "_AdminLayout";
    var payload = Model.Select(z => new
    {
        position = z.Position,
        name = z.Name,
        size = z.Size,
        rotationSeconds = z.RotationSeconds,
        ads = z.Ads.Select(a => new
        {
            id = a.Id,
            title = a.Title,
            imageUrl = a.ImageUrl,
            status = a.Status,
            isActive = a.IsActive,
            paymentStatus = a.PaymentStatus
        })
    });
    var json = System.Text.Json.JsonSerializer.Serialize(payload);
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:12px;">
    <div>
        <h2 style="margin:0;font-size:22px;font-weight:800;">Bố cục &amp; xoay vòng quảng cáo</h2>
        <p style="margin:4px 0 0;color:#64748b;font-size:14px;">Mỗi khu hiển thị quảng cáo đang gắn, xem trước xoay vòng, sắp thứ tự chạy và chỉnh chu kỳ nhảy. Bấm <b>Lưu</b> để áp dụng ngay.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <button id="btnCancel" style="background:#e2e8f0;color:#334155;border:none;padding:10px 20px;border-radius:8px;font-weight:700;cursor:pointer;"><i class="fa fa-rotate-left"></i> Hủy</button>
        <button id="btnSave" style="background:#0e7d85;color:#fff;border:none;padding:10px 22px;border-radius:8px;font-weight:700;cursor:pointer;"><i class="fa fa-floppy-disk"></i> Lưu &amp; chạy ngay</button>
    </div>
</div>

@if (!Model.Any())
{
    <div style="background:#fff;border-radius:10px;padding:40px;text-align:center;color:#64748b;">Chưa có khu quảng cáo (slot) nào. Tạo slot ở mục <b>Slot QC</b> trước.</div>
}

<div id="editors" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;"></div>

<style>
    .ed-card { background:#fff;border:1px solid #e5eaf0;border-radius:12px;padding:14px 16px;box-shadow:0 1px 6px rgba(0,0,0,.04);display:flex;flex-direction:column; }
    .pv-box { position:relative;background:#f1f5f9;border:2px dashed #c3ccd6;border-radius:8px;height:150px;overflow:hidden;margin-bottom:10px; }
    .pv-slide { position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .5s;font-size:12px;text-align:center;padding:6px; }
    .pv-slide.on { opacity:1; }
    .pv-empty { display:flex;align-items:center;justify-content:center;height:100%;color:#94a3b8;font-size:12px;text-align:center; }
    .pv-num { position:absolute;top:6px;left:6px;background:rgba(14,125,133,.92);color:#fff;font-size:11px;font-weight:800;padding:1px 8px;border-radius:20px;z-index:2; }
    .ed-row { display:flex;align-items:center;gap:8px;padding:7px 9px;border:1px solid #eef1f4;border-radius:8px;margin-bottom:6px;background:#fafbfc; }
    .ed-row.playing { background:#ecfdf5;border-color:#a7f3d0; }
    .ed-num { width:22px;height:22px;flex:none;border-radius:50%;background:#0e7d85;color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center; }
    .ed-row .thumb { width:38px;height:26px;border-radius:4px;object-fit:cover;background:#e2e8f0;flex:none; }
    .ed-btn { border:none;background:#e2e8f0;color:#334155;border-radius:6px;width:26px;height:26px;cursor:pointer;font-size:12px; }
    .ed-btn:disabled { opacity:.35;cursor:default; }
    .badge { font-size:10px;font-weight:700;padding:2px 7px;border-radius:5px;color:#fff; }
    .btn-next { background:#0e7d85;color:#fff;border:none;padding:6px 12px;border-radius:7px;font-weight:700;cursor:pointer;font-size:12px; }
    .btn-next:disabled { opacity:.4;cursor:default; }
</style>

<script>
    var ZONES = @Html.Raw(json);
    var CUR = {}, timers = {};

    function statusBadge(a){
        if (a.status === 'rejected') return '<span class="badge" style="background:#dc2626;">Từ chối</span>';
        if (a.status === 'pending')  return '<span class="badge" style="background:#ca8a04;">Chờ duyệt</span>';
        if (!a.isActive)             return '<span class="badge" style="background:#6b7280;">Đang dừng</span>';
        return '<span class="badge" style="background:#16a34a;">Đang chạy</span>';
    }
    function zoneOf(pos){ return ZONES.find(function(z){ return z.position===pos; }); }

    function showSlide(pos, idx){
        var zone = zoneOf(pos); if (!zone || !zone.ads.length) return;
        var box = document.getElementById('pv_' + pos); if(!box) return;
        box.querySelectorAll('.pv-slide').forEach(function(s,i){ s.classList.toggle('on', i===idx); });
        CUR[pos] = idx;
        var num = document.getElementById('num_' + pos); if (num) num.textContent = (idx+1) + '/' + zone.ads.length;
        document.querySelectorAll('.ed-row[data-pos="' + pos + '"]').forEach(function(r,i){ r.classList.toggle('playing', i===idx); });
    }
    function nextSlide(pos){ var z=zoneOf(pos); if(!z||z.ads.length<2)return; showSlide(pos, ((CUR[pos]||0)+1)%z.ads.length); resetTimer(pos); }
    function resetTimer(pos){
        if (timers[pos]) clearInterval(timers[pos]);
        var z = zoneOf(pos); if (!z || z.ads.length < 2) return;
        timers[pos] = setInterval(function(){ showSlide(pos, ((CUR[pos]||0)+1)%z.ads.length); }, Math.max(1, z.rotationSeconds)*1000);
    }

    function renderEditors(){
        var wrap = document.getElementById('editors');
        wrap.innerHTML = '';
        ZONES.forEach(function(zone, zi){
            // preview slides
            var slides = zone.ads.length
                ? '<div class="pv-num" id="num_' + zone.position + '"></div>' + zone.ads.map(function(a,i){
                    return '<div class="pv-slide' + (i===0?' on':'') + '" style="background:' + (a.imageUrl?'#000':'#f1f5f9') + ';">' +
                        (a.imageUrl ? '<img src="' + a.imageUrl + '" style="width:100%;height:100%;object-fit:cover;">' : '<div style="color:#475569;">' + a.title + '</div>') + '</div>';
                  }).join('')
                : '<div class="pv-empty">' + zone.name + '<br>(chưa có quảng cáo)</div>';

            var rows = zone.ads.length ? zone.ads.map(function(a,i){
                return '<div class="ed-row" data-pos="' + zone.position + '">' +
                    '<span class="ed-num">' + (i+1) + '</span>' +
                    (a.imageUrl ? '<img class="thumb" src="' + a.imageUrl + '">' : '<span class="thumb"></span>') +
                    '<div style="flex:1;min-width:0;"><div style="font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + a.title + '</div>' + statusBadge(a) + '</div>' +
                    '<button class="ed-btn" onclick="move(' + zi + ',' + i + ',-1)" ' + (i===0?'disabled':'') + '>▲</button>' +
                    '<button class="ed-btn" onclick="move(' + zi + ',' + i + ',1)" ' + (i===zone.ads.length-1?'disabled':'') + '>▼</button>' +
                    '</div>';
            }).join('') : '<div style="color:#94a3b8;font-size:13px;padding:6px 0;">Chưa có quảng cáo nào cho khu này.</div>';

            var card = document.createElement('div');
            card.className = 'ed-card';
            card.innerHTML =
                '<div style="display:flex;justify-content:space-between;align-items:center;">' +
                    '<b style="font-size:15px;">' + zone.name + '</b>' +
                    '<span style="font-size:11px;color:#94a3b8;">' + zone.size + '</span>' +
                '</div>' +
                '<div style="font-size:12px;color:#94a3b8;margin:2px 0 10px;">mã khu: ' + zone.position + '</div>' +
                '<div class="pv-box" id="pv_' + zone.position + '">' + slides + '</div>' +
                '<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap;">' +
                    '<span style="font-size:13px;color:#475569;">Chu kỳ:</span>' +
                    '<input type="number" min="1" value="' + zone.rotationSeconds + '" onchange="setSec(' + zi + ',this.value)" style="width:60px;padding:5px 8px;border:1px solid #d7dde3;border-radius:6px;"><span style="font-size:13px;color:#475569;">giây</span>' +
                    '<button class="btn-next" onclick="nextSlide(\'' + zone.position + '\')" ' + (zone.ads.length<2?'disabled':'') + '>Tiếp ▶</button>' +
                '</div>' +
                rows;
            wrap.appendChild(card);
        });
        ZONES.forEach(function(z){ if (z.ads.length) showSlide(z.position, CUR[z.position]||0); });
    }

    function move(zi, i, dir){
        var ads = ZONES[zi].ads, j = i + dir;
        if (j < 0 || j >= ads.length) return;
        var t = ads[i]; ads[i] = ads[j]; ads[j] = t;
        CUR[ZONES[zi].position] = 0;
        renderEditors(); resetTimer(ZONES[zi].position);
    }
    function setSec(zi, v){ ZONES[zi].rotationSeconds = Math.max(1, parseInt(v)||5); resetTimer(ZONES[zi].position); }

    document.getElementById('btnSave').addEventListener('click', function(){
        var dto = { zones: ZONES.map(function(z){ return { position: z.position, rotationSeconds: z.rotationSeconds, adIds: z.ads.map(function(a){ return a.id; }) }; }) };
        fetch('/admin/SaveAdLayout', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(dto) })
            .then(function(r){ return r.json(); })
            .then(function(res){ if (window.swalToast) swalToast(res.success?'success':'error', res.success?'Đã lưu bố cục — có hiệu lực ngay!':(res.message||'Lỗi')); else alert(res.success?'Đã lưu!':(res.message||'Lỗi')); })
            .catch(function(){ alert('Không kết nối được máy chủ.'); });
    });
    document.getElementById('btnCancel').addEventListener('click', function(){ location.reload(); });

    renderEditors();
    ZONES.forEach(function(z){ resetTimer(z.position); });
</script>
