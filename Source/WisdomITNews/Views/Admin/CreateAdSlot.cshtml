@using WisdomITNews.Models
@model AdSlot
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tạo slot quảng cáo";
}

<div style="max-width:640px;">
    <h1 style="font-size:22px;font-weight:800;margin-bottom:18px;"><i class="fa fa-plus-circle" style="color:#2563eb;"></i> Tạo slot quảng cáo</h1>

    @if (ViewBag.Error != null)
    { <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@ViewBag.Error</div> }

    <form method="post" action="/admin/CreateAdSlot" style="background:#fff;border-radius:10px;padding:22px;box-shadow:0 2px 10px rgba(0,0,0,.06);">
        @Html.AntiForgeryToken()
        <partial name="_AdSlotFields" model="Model" />
        <div style="display:flex;gap:10px;margin-top:18px;">
            <button type="submit" style="background:#2563eb;color:#fff;border:none;padding:11px 22px;border-radius:8px;font-weight:700;cursor:pointer;">Tạo slot</button>
            <a href="/admin/AdSlots" style="padding:11px 22px;border-radius:8px;background:#f1f5f9;color:#334155;text-decoration:none;font-weight:600;">Hủy</a>
        </div>
    </form>
</div>
