@{
    ViewData["Title"] = "Test Email"; Layout = "_AdminLayout";
    bool configured = (bool)(ViewBag.Configured ?? false);
    string result = ViewBag.Result as string ?? "";
    string msg = ViewBag.Msg as string ?? "";
    string to = ViewBag.To as string ?? "";
}
<h1 style="font-size:22px;font-weight:800;margin-bottom:16px;"><i class="fa fa-envelope" style="color:#159aa3;"></i> Chẩn đoán gửi Email (SMTP)</h1>

<div style="background:@(configured ? "#dcfce7" : "#fee2e2");color:@(configured ? "#166534" : "#991b1b");padding:10px 14px;border-radius:6px;margin-bottom:16px;">
  Cấu hình SMTP: <strong>@(configured ? "ĐÃ đọc được (Host/User/Password đủ)" : "CHƯA cấu hình — thiếu Host/Username/Password trong appsettings.json")</strong>
</div>

@if (result == "ok")
{ <div style="background:#dcfce7;color:#166534;padding:12px 16px;border-radius:6px;margin-bottom:16px;"><i class="fa fa-circle-check"></i> @msg</div> }
else if (result == "err")
{ <div style="background:#fee2e2;color:#991b1b;padding:12px 16px;border-radius:6px;margin-bottom:16px;word-break:break-word;"><i class="fa fa-circle-xmark"></i> @msg</div> }

<form method="post" action="/admin/TestEmail" style="background:#fff;border-radius:8px;padding:22px;box-shadow:0 2px 10px rgba(0,0,0,.06);max-width:560px;">
  <label style="display:block;font-weight:600;font-size:13px;margin-bottom:6px;">Gửi email test tới:</label>
  <input name="toEmail" value="@to" type="email" required placeholder="email-cua-ban@gmail.com"
         style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box;margin-bottom:14px;" />
  <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:11px 22px;border-radius:6px;font-weight:700;cursor:pointer;"><i class="fa fa-paper-plane"></i> Gửi thử</button>
</form>

<p style="margin-top:14px;color:#6c757d;font-size:13px;max-width:560px;">
  Nếu báo lỗi, hãy copy nguyên dòng "LỖI SMTP: ..." gửi cho người hỗ trợ — dòng đó cho biết chính xác Gmail từ chối vì lý do gì.
</p>
