@using WisdomITNews.Models
@using WisdomITNews.Services
@model CustomerDetailVM
@{
    ViewData["Title"] = "Chi tiết khách hàng"; Layout = "_AdminLayout";
    var u = Model.User;
    var cur = Model.Current;
    string backUrl = "/admin/PremiumCustomers";
    string actionBase = "/admin";
    var plans = ViewBag.Plans as List<SubscriptionPlan> ?? new();
    string toggleMsg = u.IsActive ? "Khóa tài khoản khách hàng này?" : "Mở khóa tài khoản này?";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
  <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-id-card" style="color:#159aa3;"></i> Chi tiết khách hàng</h1>
  <a href="@backUrl" style="background:#f0f2f5;color:#475569;padding:9px 16px;border-radius:6px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-arrow-left"></i> Quay lại</a>
</div>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }
@if (TempData["Err"] != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Err"]</div> }

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">

  <!-- Thông tin cá nhân -->
  <div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);padding:18px;">
    <div style="font-size:13px;font-weight:800;color:#159aa3;text-transform:uppercase;margin-bottom:14px;"><i class="fa fa-user"></i> Thông tin cá nhân</div>
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
      @if (!string.IsNullOrWhiteSpace(u.AvatarUrl))
      { <img src="@u.AvatarUrl" style="width:64px;height:64px;border-radius:50%;object-fit:cover;" /> }
      else
      { <div style="width:64px;height:64px;border-radius:50%;background:#159aa3;color:#fff;display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:700;">@(string.IsNullOrEmpty(u.FullName) ? "?" : u.FullName.Substring(0,1).ToUpper())</div> }
      <div>
        <div style="font-size:18px;font-weight:800;">@u.FullName</div>
        <div style="color:#94a3b8;font-size:13px;">@@@u.Username</div>
      </div>
    </div>
    <table style="width:100%;font-size:14px;">
      <tr><td style="padding:6px 0;color:#94a3b8;width:130px;">Email</td><td style="padding:6px 0;font-weight:600;">@u.Email</td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Số điện thoại</td><td style="padding:6px 0;font-weight:600;">@(string.IsNullOrWhiteSpace(u.Phone) ? "—" : u.Phone)</td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Ngày tạo TK</td><td style="padding:6px 0;">@u.CreatedAt.ToString("dd/MM/yyyy")</td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Tài khoản</td><td style="padding:6px 0;">
        @if (u.IsActive)
        { <span style="color:#16a34a;font-weight:700;"><i class="fa fa-circle-check"></i> Đang hoạt động</span> }
        else
        { <span style="color:#dc2626;font-weight:700;"><i class="fa fa-lock"></i> Bị khóa</span> }
      </td></tr>
    </table>
  </div>

  <!-- Thông tin dịch vụ -->
  <div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);padding:18px;">
    <div style="font-size:13px;font-weight:800;color:#159aa3;text-transform:uppercase;margin-bottom:14px;"><i class="fa fa-gem"></i> Thông tin gói</div>
    @if (cur == null || (cur.Status != SubscriptionStatus.Active && cur.Status != SubscriptionStatus.Trial))
    {
      <div style="background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;padding:9px 12px;border-radius:8px;margin-bottom:12px;font-size:13px;font-weight:600;"><i class="fa fa-circle-info"></i> Chưa có gói Premium đang hoạt động.</div>
    }
    <table style="width:100%;font-size:14px;">
      <tr><td style="padding:6px 0;color:#94a3b8;width:140px;">Loại tài khoản</td><td style="padding:6px 0;">
        @if (Model.Role == CustomerRole.Premium)
        { <span style="padding:3px 10px;border-radius:20px;font-size:12px;font-weight:700;background:#dcfce7;color:#16a34a;"><i class="fa fa-crown"></i> Premium</span> }
        else
        { <span style="padding:3px 10px;border-radius:20px;font-size:12px;font-weight:700;background:#fef3c7;color:#b45309;"><i class="fa fa-hourglass-half"></i> Dùng thử</span> }
      </td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Gói hiện tại</td><td style="padding:6px 0;font-weight:700;">@(Model.CurrentPlanName ?? "—")</td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Trạng thái gói</td><td style="padding:6px 0;">
        @if (cur != null)
        { <span style="padding:3px 10px;border-radius:20px;font-size:12px;font-weight:700;color:#fff;background:@CustomerHelper.StatusColor(cur.Status);">@CustomerHelper.StatusLabel(cur.Status)</span> }
        else { <text>—</text> }
      </td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Ngày đăng ký</td><td style="padding:6px 0;">@(cur?.CreatedAt.ToString("dd/MM/yyyy") ?? "—")</td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Ngày bắt đầu</td><td style="padding:6px 0;">@(cur?.StartDate.ToString("dd/MM/yyyy") ?? "—")</td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Ngày hết hạn</td><td style="padding:6px 0;">@(cur?.EndDate.ToString("dd/MM/yyyy") ?? "—")</td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Trạng thái xác nhận</td><td style="padding:6px 0;">
        @if (cur?.ConfirmedAt != null)
        { <span style="color:#16a34a;font-weight:600;"><i class="fa fa-circle-check"></i> Đã xác nhận (@cur.ConfirmedAt.Value.ToString("dd/MM/yyyy"))</span> }
        else if (cur != null)
        { <span style="color:#f59e0b;font-weight:600;"><i class="fa fa-hourglass-half"></i> Chưa xác nhận</span> }
        else { <text>—</text> }
      </td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Còn lại</td><td style="padding:6px 0;">
        @if (cur != null)
        {
          var days = (cur.EndDate - DateTime.Now).Days;
          if (days >= 0) { <span style="font-weight:700;color:@(days<=3 ? "#dc2626" : "#16a34a");">@days ngày</span> }
          else { <span style="color:#94a3b8;">Đã hết hạn</span> }
        }
        else { <text>—</text> }
      </td></tr>
    </table>
  </div>
</div>

<!-- Quản lý trạng thái & gói -->
<div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);padding:14px 18px;margin-bottom:16px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
  <span style="font-weight:800;color:#159aa3;"><i class="fa fa-sliders"></i> Quản lý:</span>

  <form method="post" action="@actionBase/ToggleCustomerAccount" style="display:inline;" onsubmit="return confirm('@toggleMsg');">
    <input type="hidden" name="userId" value="@u.Id" />
    @if (u.IsActive)
    { <button type="submit" style="background:#dc2626;color:#fff;border:none;padding:9px 15px;border-radius:6px;font-weight:600;font-size:13px;cursor:pointer;"><i class="fa fa-lock"></i> Khóa tài khoản</button> }
    else
    { <button type="submit" style="background:#16a34a;color:#fff;border:none;padding:9px 15px;border-radius:6px;font-weight:600;font-size:13px;cursor:pointer;"><i class="fa fa-lock-open"></i> Mở khóa tài khoản</button> }
  </form>

  <button type="button" onclick="document.getElementById('mRegister').style.display='flex'" style="background:#16a34a;color:#fff;border:none;padding:9px 15px;border-radius:6px;font-weight:600;font-size:13px;cursor:pointer;"><i class="fa fa-crown"></i> Đăng ký Premium</button>

  @if (cur != null)
  {
    @if (cur.Status == SubscriptionStatus.Trial)
    { <button type="button" onclick="document.getElementById('mConvert').style.display='flex'" style="background:#7c3aed;color:#fff;border:none;padding:9px 15px;border-radius:6px;font-weight:600;font-size:13px;cursor:pointer;"><i class="fa fa-arrow-up"></i> Chuyển Trial → Premium</button> }
    <button type="button" onclick="document.getElementById('mExtend').style.display='flex'" style="background:#0e7d85;color:#fff;border:none;padding:9px 15px;border-radius:6px;font-weight:600;font-size:13px;cursor:pointer;"><i class="fa fa-calendar-plus"></i> Gia hạn</button>
    <button type="button" onclick="document.getElementById('mUpdate').style.display='flex'" style="background:#159aa3;color:#fff;border:none;padding:9px 15px;border-radius:6px;font-weight:600;font-size:13px;cursor:pointer;"><i class="fa fa-pen"></i> Cập nhật gói</button>
    @if (cur.Status != SubscriptionStatus.Cancelled)
    { <button type="button" onclick="document.getElementById('mCancel').style.display='flex'" style="background:#f59e0b;color:#fff;border:none;padding:9px 15px;border-radius:6px;font-weight:600;font-size:13px;cursor:pointer;"><i class="fa fa-ban"></i> Hủy gói</button> }
  }
</div>

<!-- Modal đăng ký Premium -->
<div id="mRegister" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
  <form method="post" action="@actionBase/RegisterPremium" style="background:#fff;border-radius:10px;padding:22px;width:420px;max-width:92%;">
    <h3 style="font-size:18px;font-weight:800;margin-bottom:14px;"><i class="fa fa-crown" style="color:#16a34a;"></i> Đăng ký Premium</h3>
    <input type="hidden" name="userId" value="@u.Id" />
    <label style="font-size:13px;font-weight:600;color:#475569;">Gói</label>
    <select name="planId" required style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 12px;">
      @foreach (var p in plans) { <option value="@p.Id">@p.Name (@p.Price.ToString("#,##0") đ · @p.DurationDays ngày)</option> }
    </select>
    <label style="font-size:13px;font-weight:600;color:#475569;">Số ngày (0 = theo gói)</label>
    <input type="number" name="days" value="0" min="0" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 16px;" />
    <div style="display:flex;justify-content:flex-end;gap:10px;">
      <button type="button" onclick="document.getElementById('mRegister').style.display='none'" style="background:#f0f2f5;color:#475569;border:none;padding:9px 16px;border-radius:6px;font-weight:600;cursor:pointer;">Hủy</button>
      <button type="submit" style="background:#16a34a;color:#fff;border:none;padding:9px 18px;border-radius:6px;font-weight:600;cursor:pointer;">Đăng ký</button>
    </div>
  </form>
</div>

@if (cur != null)
{
  <!-- Modal gia hạn -->
  <div id="mExtend" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
    <form method="post" action="@actionBase/ExtendPremium" style="background:#fff;border-radius:10px;padding:22px;width:400px;max-width:92%;">
      <h3 style="font-size:18px;font-weight:800;margin-bottom:14px;"><i class="fa fa-calendar-plus" style="color:#0e7d85;"></i> Gia hạn Premium</h3>
      <input type="hidden" name="subId" value="@cur.Id" />
      <label style="font-size:13px;font-weight:600;color:#475569;">Số ngày gia hạn</label>
      <input type="number" name="days" value="30" min="1" required style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 16px;" />
      <div style="display:flex;justify-content:flex-end;gap:10px;">
        <button type="button" onclick="document.getElementById('mExtend').style.display='none'" style="background:#f0f2f5;color:#475569;border:none;padding:9px 16px;border-radius:6px;font-weight:600;cursor:pointer;">Hủy</button>
        <button type="submit" style="background:#0e7d85;color:#fff;border:none;padding:9px 18px;border-radius:6px;font-weight:600;cursor:pointer;">Gia hạn</button>
      </div>
    </form>
  </div>

  @if (cur.Status == SubscriptionStatus.Trial)
  {
    <!-- Modal chuyển Trial -> Premium -->
    <div id="mConvert" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
      <form method="post" action="@actionBase/ConvertTrialToPremium" style="background:#fff;border-radius:10px;padding:22px;width:420px;max-width:92%;">
        <h3 style="font-size:18px;font-weight:800;margin-bottom:14px;"><i class="fa fa-arrow-up" style="color:#7c3aed;"></i> Chuyển Trial → Premium</h3>
        <input type="hidden" name="subId" value="@cur.Id" />
        <label style="font-size:13px;font-weight:600;color:#475569;">Gói Premium</label>
        <select name="planId" required style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 12px;">
          @foreach (var p in plans) { <option value="@p.Id" selected="@(cur.PlanId==p.Id ? "selected" : null)">@p.Name (@p.Price.ToString("#,##0") đ · @p.DurationDays ngày)</option> }
        </select>
        <label style="font-size:13px;font-weight:600;color:#475569;">Số ngày (0 = theo gói)</label>
        <input type="number" name="days" value="0" min="0" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 16px;" />
        <div style="display:flex;justify-content:flex-end;gap:10px;">
          <button type="button" onclick="document.getElementById('mConvert').style.display='none'" style="background:#f0f2f5;color:#475569;border:none;padding:9px 16px;border-radius:6px;font-weight:600;cursor:pointer;">Hủy</button>
          <button type="submit" style="background:#7c3aed;color:#fff;border:none;padding:9px 18px;border-radius:6px;font-weight:600;cursor:pointer;">Chuyển</button>
        </div>
      </form>
    </div>
  }
}

@if (cur != null)
{
  <!-- Modal cập nhật gói -->
  <div id="mUpdate" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
    <form method="post" action="@actionBase/UpdateCustomerPlan" style="background:#fff;border-radius:10px;padding:22px;width:440px;max-width:92%;">
      <h3 style="font-size:18px;font-weight:800;margin-bottom:14px;"><i class="fa fa-pen" style="color:#159aa3;"></i> Cập nhật gói</h3>
      <input type="hidden" name="subId" value="@cur.Id" />
      <label style="font-size:13px;font-weight:600;color:#475569;">Gói</label>
      <select name="planId" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 12px;">
        @foreach (var p in plans)
        {
          <option value="@p.Id" selected="@(cur.PlanId==p.Id ? "selected" : null)">@p.Name (@p.Price.ToString("#,##0") đ)</option>
        }
      </select>
      <label style="font-size:13px;font-weight:600;color:#475569;">Ngày hết hạn</label>
      <input type="date" name="endDate" value="@cur.EndDate.ToString("yyyy-MM-dd")" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 12px;" />
      <label style="font-size:13px;font-weight:600;color:#475569;">Ghi chú (tùy chọn)</label>
      <input type="text" name="note" placeholder="Lý do cập nhật..." style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 16px;" />
      <div style="display:flex;justify-content:flex-end;gap:10px;">
        <button type="button" onclick="document.getElementById('mUpdate').style.display='none'" style="background:#f0f2f5;color:#475569;border:none;padding:9px 16px;border-radius:6px;font-weight:600;cursor:pointer;">Hủy</button>
        <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:9px 18px;border-radius:6px;font-weight:600;cursor:pointer;">Lưu</button>
      </div>
    </form>
  </div>

  <!-- Modal hủy gói -->
  <div id="mCancel" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
    <form method="post" action="@actionBase/CancelCustomerSub" style="background:#fff;border-radius:10px;padding:22px;width:420px;max-width:92%;">
      <h3 style="font-size:18px;font-weight:800;margin-bottom:8px;"><i class="fa fa-ban" style="color:#f59e0b;"></i> Hủy gói</h3>
      <p style="color:#64748b;font-size:13px;margin-bottom:12px;">Gói sẽ chuyển sang trạng thái <b>Đã hủy</b>. Không xử lý hoàn tiền.</p>
      <input type="hidden" name="subId" value="@cur.Id" />
      <label style="font-size:13px;font-weight:600;color:#475569;">Lý do hủy (tùy chọn)</label>
      <input type="text" name="note" placeholder="Nhập lý do..." style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 16px;" />
      <div style="display:flex;justify-content:flex-end;gap:10px;">
        <button type="button" onclick="document.getElementById('mCancel').style.display='none'" style="background:#f0f2f5;color:#475569;border:none;padding:9px 16px;border-radius:6px;font-weight:600;cursor:pointer;">Đóng</button>
        <button type="submit" style="background:#f59e0b;color:#fff;border:none;padding:9px 18px;border-radius:6px;font-weight:600;cursor:pointer;">Xác nhận hủy</button>
      </div>
    </form>
  </div>
}

<!-- Lịch sử gói -->
<div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:16px;overflow-x:auto;">
  <div style="padding:14px 18px;font-weight:800;border-bottom:1px solid #f0f2f5;"><i class="fa fa-clock-rotate-left" style="color:#159aa3;"></i> Lịch sử gói (@Model.History.Count)</div>
  <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
    <thead>
      <tr style="background:#f5f6f8;color:#6c757d;text-align:left;">
        <th style="padding:10px 14px;">Gói</th><th style="padding:10px 14px;">Trạng thái</th>
        <th style="padding:10px 14px;">Bắt đầu</th><th style="padding:10px 14px;">Kết thúc</th>
        <th style="padding:10px 14px;">Xác nhận</th><th style="padding:10px 14px;">Ghi chú</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var s in Model.History)
      {
        <tr style="border-bottom:1px solid #f0f2f5;">
          <td style="padding:10px 14px;font-weight:600;">@(s.Plan?.Name ?? "(gói đã xóa)")</td>
          <td style="padding:10px 14px;"><span style="padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;color:#fff;background:@CustomerHelper.StatusColor(s.Status);">@CustomerHelper.StatusLabel(s.Status)</span></td>
          <td style="padding:10px 14px;color:#6c757d;">@s.StartDate.ToString("dd/MM/yyyy")</td>
          <td style="padding:10px 14px;color:#6c757d;">@s.EndDate.ToString("dd/MM/yyyy")</td>
          <td style="padding:10px 14px;color:#6c757d;">@(s.ConfirmedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
          <td style="padding:10px 14px;color:#94a3b8;white-space:normal;max-width:280px;">@(string.IsNullOrWhiteSpace(s.Notes) ? "—" : s.Notes)</td>
        </tr>
      }
    </tbody>
  </table>
</div>

<!-- Giao dịch -->
<div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:16px;overflow-x:auto;">
  <div style="padding:14px 18px;font-weight:800;border-bottom:1px solid #f0f2f5;"><i class="fa fa-receipt" style="color:#159aa3;"></i> Lịch sử giao dịch Premium (@Model.Transactions.Count)</div>
  @if (!Model.Transactions.Any())
  { <div style="padding:18px;text-align:center;color:#94a3b8;">Chưa có giao dịch.</div> }
  else
  {
    <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
      <thead>
        <tr style="background:#f5f6f8;color:#6c757d;text-align:left;">
          <th style="padding:10px 14px;">Mã GD</th><th style="padding:10px 14px;">Gói</th><th style="padding:10px 14px;">Giá</th>
          <th style="padding:10px 14px;">Phương thức</th><th style="padding:10px 14px;">Trạng thái</th><th style="padding:10px 14px;">Thời gian</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var t in Model.Transactions)
        {
          (string bg,string fg,string tx) tc = t.Status switch {
            TransactionStatus.Success => ("#dcfce7","#16a34a","Thành công"),
            TransactionStatus.Pending => ("#e0f2fe","#0369a1","Chờ xác nhận"),
            TransactionStatus.Failed  => ("#fee2e2","#991b1b","Thất bại"),
            _ => ("#f0f2f5","#6c757d","Đã hủy") };
          <tr style="border-bottom:1px solid #f0f2f5;">
            <td style="padding:10px 14px;font-weight:700;color:#159aa3;">#@t.Id</td>
            <td style="padding:10px 14px;">@(t.Plan?.Name ?? "—")</td>
            <td style="padding:10px 14px;font-weight:700;">@t.Amount.ToString("#,##0") đ</td>
            <td style="padding:10px 14px;color:#6c757d;">@t.PaymentMethodLabel</td>
            <td style="padding:10px 14px;"><span style="padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;background:@tc.bg;color:@tc.fg;">@tc.tx</span></td>
            <td style="padding:10px 14px;color:#6c757d;">@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>

<!-- Nhật ký thao tác (audit) -->
<div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);">
  <div style="padding:14px 18px;font-weight:800;border-bottom:1px solid #f0f2f5;"><i class="fa fa-list-check" style="color:#159aa3;"></i> Nhật ký thao tác (@Model.Logs.Count)</div>
  @if (!Model.Logs.Any())
  { <div style="padding:18px;text-align:center;color:#94a3b8;">Chưa có thao tác nào được ghi.</div> }
  else
  {
    <div style="padding:12px 18px;">
      @foreach (var l in Model.Logs)
      {
        <div style="display:flex;gap:12px;padding:10px 0;border-bottom:1px solid #f5f6f8;">
          <div style="flex-shrink:0;width:34px;height:34px;border-radius:50%;background:#e0f2fe;color:#0369a1;display:flex;align-items:center;justify-content:center;"><i class="fa fa-pen"></i></div>
          <div style="flex:1;min-width:0;">
            <div style="font-weight:600;">@l.Action @(string.IsNullOrWhiteSpace(l.Note) ? "" : "— " + l.Note)</div>
            @if (!string.IsNullOrWhiteSpace(l.OldValue) || !string.IsNullOrWhiteSpace(l.NewValue))
            { <div style="font-size:12px;color:#94a3b8;">@l.OldValue → @l.NewValue</div> }
            <div style="font-size:12px;color:#94a3b8;">@l.ActorName (@l.ActorRole) · @l.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
          </div>
        </div>
      }
    </div>
  }
</div>
