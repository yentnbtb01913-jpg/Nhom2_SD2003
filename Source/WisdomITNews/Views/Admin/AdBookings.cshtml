@using WisdomITNews.Models
@model List<AdBooking>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Đơn đăng ký quảng cáo";
    var slotNames = ViewBag.SlotNames as Dictionary<string, string> ?? new Dictionary<string, string>();
    string PosVi(string p) => slotNames.TryGetValue(p ?? "", out var v) ? v : p;

    // Ánh xạ trạng thái cũ -> chuẩn
    string Canon(string s) => s switch
    {
        "pending" => "PendingConfirmation",
        "confirmed" => "AwaitingPayment",
        "published" => "Live",
        "cancelled" => "Rejected",
        _ => string.IsNullOrEmpty(s) ? "PendingConfirmation" : s
    };
    // 7 bước theo thứ tự + nhãn
    var steps = new (string key, string label)[]
    {
        ("PendingConfirmation","Chờ xác nhận"),
        ("AwaitingPayment","Chờ thanh toán"),
        ("AwaitingContent","Chờ nội dung"),
        ("UnderReview","Đang duyệt"),
        ("Scheduled","Đã lên lịch"),
        ("Live","Đang chạy"),
        ("Completed","Hoàn tất"),
    };
    int StepIndex(string k) { for (int i = 0; i < steps.Length; i++) if (steps[i].key == k) return i; return -1; }
}

<h1 style="font-size:22px;font-weight:800;margin-bottom:6px;"><i class="fa fa-file-invoice-dollar" style="color:#159aa3;"></i> Đơn đăng ký quảng cáo</h1>
<p style="color:#64748b;font-size:14px;margin-bottom:16px;">Xử lý theo quy trình (offline): admin gọi/nhận tiền/nhận banner ngoài đời rồi bấm cập nhật trạng thái. Bấm một bước để chuyển sang bước đó.</p>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }

@if (!Model.Any())
{ <div style="background:#fff;border-radius:10px;padding:40px;text-align:center;color:#64748b;">Chưa có đơn đăng ký nào.</div> }

<div style="display:grid;gap:16px;">
    @foreach (var b in Model)
    {
        var cur = Canon(b.Status);
        var rejected = cur == "Rejected";
        var curIdx = StepIndex(cur);
        <div class="bk-card" id="bk-@b.Id">
            <!-- Header -->
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;border-bottom:1px solid #eef1f4;padding-bottom:12px;margin-bottom:12px;">
                <div>
                    <span style="font-weight:800;font-size:16px;">Đơn #@b.Id</span>
                    <span style="color:#94a3b8;font-size:12px;margin-left:8px;">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    <div style="margin-top:4px;color:#475569;font-size:13px;">
                        <b>@(b.BuyerType == "company" ? b.CompanyName : b.ContactName)</b>
                        · @b.Email · @b.Phone
                    </div>
                </div>
                <div style="text-align:right;font-size:13px;color:#475569;">
                    <div>Vị trí: <b>@PosVi(b.AdPosition)</b> · @b.DurationDays ngày</div>
                    <div>Tạm tính: <b style="color:#dc2626;">@b.Amount.ToString("#,##0")đ</b></div>
                </div>
            </div>

            <!-- Thanh trạng thái 7 bước -->
            @if (rejected)
            {
                <div style="background:#fee2e2;color:#991b1b;font-weight:700;padding:8px 14px;border-radius:8px;display:inline-block;margin-bottom:6px;"><i class="fa fa-ban"></i> Đơn đã bị từ chối</div>
                <button onclick="setSt(@b.Id,'PendingConfirmation')" style="margin-left:8px;background:#e2e8f0;border:none;padding:6px 12px;border-radius:6px;font-size:12px;cursor:pointer;">Khôi phục đơn</button>
            }
            else
            {
                <div class="bk-steps">
                    @for (int i = 0; i < steps.Length; i++)
                    {
                        var done = i < curIdx;
                        var active = i == curIdx;
                        var cls = active ? "on" : (done ? "done" : "");
                        <button class="bk-step @cls" onclick="setSt(@b.Id,'@steps[i].key')" title="Chuyển sang: @steps[i].label">
                            <span class="bk-dot">@(done ? "✓" : (i + 1).ToString())</span>
                            <span class="bk-lbl">@steps[i].label</span>
                        </button>
                    }
                </div>
            }

            <!-- Ghi chú + hành động -->
            <div style="display:grid;grid-template-columns:1fr 220px;gap:14px;margin-top:14px;align-items:start;">
                <div>
                    @if (!string.IsNullOrWhiteSpace(b.Note))
                    {
                        <div style="font-size:12px;color:#475569;background:#f8fafc;border:1px solid #eef1f4;border-radius:6px;padding:6px 10px;margin-bottom:8px;"><b>Ghi chú của khách:</b> @b.Note</div>
                    }
                    <label style="font-size:12px;font-weight:600;color:#475569;">Ghi chú nội bộ (đã nhận tiền, khách gửi banner qua đâu…)</label>
                    <textarea id="note-@b.Id" rows="2" style="width:100%;margin-top:4px;padding:8px 10px;border:1px solid #d7dde3;border-radius:8px;font-size:13px;">@b.AdminNote</textarea>
                    <button onclick="saveNote(@b.Id)" style="margin-top:6px;background:#0e7d85;color:#fff;border:none;padding:6px 14px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;"><i class="fa fa-floppy-disk"></i> Lưu ghi chú</button>
                </div>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    <button onclick="confirmBk(@b.Id)" style="background:#2563eb;color:#fff;border:none;padding:8px;border-radius:6px;font-size:12px;cursor:pointer;font-weight:600;"><i class="fa fa-envelope-circle-check"></i> Xác nhận & gửi mail</button>
                    <button onclick="openPublish(@b.Id, '@Html.Raw(PosVi(b.AdPosition).Replace("'", "\\'"))')" style="background:#16a34a;color:#fff;border:none;padding:8px;border-radius:6px;font-size:12px;cursor:pointer;font-weight:600;"><i class="fa fa-upload"></i> Đưa lên trang</button>
                    @if (!rejected)
                    {
                        <button onclick="rejectBk(@b.Id)" style="background:#fff;color:#991b1b;border:1px solid #fca5a5;padding:8px;border-radius:6px;font-size:12px;cursor:pointer;font-weight:600;"><i class="fa fa-ban"></i> Từ chối</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL ĐƯA LÊN TRANG -->
<div id="pubModal" onclick="if(event.target===this)closePub()" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:4000;padding:24px;overflow:auto;">
    <form method="post" action="/admin/PublishAdBooking" enctype="multipart/form-data" style="background:#fff;border-radius:12px;max-width:460px;margin:auto;overflow:hidden;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="pubId" />
        <div style="background:#16a34a;color:#fff;padding:14px 18px;font-weight:800;display:flex;justify-content:space-between;align-items:center;">
            <span>Đưa quảng cáo lên trang</span>
            <button type="button" onclick="closePub()" style="background:none;border:0;color:#fff;font-size:24px;cursor:pointer;">&times;</button>
        </div>
        <div style="padding:18px;">
            <p style="font-size:13px;color:#475569;margin:0 0 12px;">Vị trí: <b id="pubPos"></b>. Chọn loại quảng cáo khách gửi.</p>

            <div style="display:flex;gap:18px;margin-bottom:14px;">
                <label style="font-weight:600;cursor:pointer;"><input type="radio" name="adType" value="image" checked onchange="pubType('image')"> Ảnh banner</label>
                <label style="font-weight:600;cursor:pointer;"><input type="radio" name="adType" value="html" onchange="pubType('html')"> Mã HTML / JS</label>
            </div>

            <!-- Loại ẢNH -->
            <div id="pubImage">
                <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Ảnh banner *</label>
                <input type="file" name="bannerFile" accept="image/*" style="width:100%;margin-bottom:14px;" />
                <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Link đích khi click</label>
                <input type="url" name="targetUrl" placeholder="https://..." style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;margin-bottom:8px;" />
            </div>

            <!-- Loại HTML/JS -->
            <div id="pubHtml" style="display:none;">
                <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Dán mã HTML/JS khách gửi</label>
                <textarea name="htmlContent" rows="6" placeholder="<div>...</div> <script>...</script>" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-family:monospace;font-size:12px;margin-bottom:10px;"></textarea>
                <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">…hoặc tải lên file .html</label>
                <input type="file" name="htmlFile" accept=".html,.htm,text/html" style="width:100%;margin-bottom:8px;" />
                <div style="font-size:11.5px;color:#94a3b8;margin-bottom:8px;"><i class="fa fa-shield-halved"></i> Mã sẽ chạy trong iframe cách ly (sandbox), không truy cập được dữ liệu site.</div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:8px;">
                <button type="button" onclick="closePub()" style="border:1px solid #d1d5db;background:#fff;padding:9px 16px;border-radius:8px;cursor:pointer;">Hủy</button>
                <button type="submit" style="background:#16a34a;color:#fff;border:none;padding:9px 20px;border-radius:8px;font-weight:700;cursor:pointer;">Đưa lên trang (Live)</button>
            </div>
        </div>
    </form>
</div>

<style>
    .bk-card { background:#fff;border:1px solid #e5eaf0;border-radius:12px;padding:16px 18px;box-shadow:0 1px 6px rgba(0,0,0,.04); }
    .bk-steps { display:flex;gap:6px;flex-wrap:wrap; }
    .bk-step { flex:1;min-width:92px;background:#f3f5f8;border:1px solid #e5eaf0;border-radius:8px;padding:8px 6px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:4px;transition:.15s; }
    .bk-step:hover { border-color:#0e7d85; }
    .bk-dot { width:22px;height:22px;border-radius:50%;background:#cbd5e1;color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center; }
    .bk-lbl { font-size:11px;font-weight:600;color:#64748b;text-align:center;line-height:1.2; }
    .bk-step.done { background:#ecfdf5;border-color:#a7f3d0; }
    .bk-step.done .bk-dot { background:#16a34a; }
    .bk-step.done .bk-lbl { color:#16a34a; }
    .bk-step.on { background:#0e7d85;border-color:#0e7d85; }
    .bk-step.on .bk-dot { background:#fff;color:#0e7d85; }
    .bk-step.on .bk-lbl { color:#fff; }
    @@media(max-width:820px){ .bk-card > div[style*="grid-template-columns:1fr 220px"]{ grid-template-columns:1fr !important; } }
</style>

@section Scripts {
<script>
    async function post(url){ const r = await fetch(url,{method:'POST'}); return await r.json(); }
    async function setSt(id, status){
        const d = await fetch('/admin/SetBookingStatus?id='+id+'&status='+status,{method:'POST'}).then(r=>r.json());
        if(d.success){ swalToast('success','Đã chuyển trạng thái'); setTimeout(()=>location.reload(),500); } else Swal.fire(d.message||'Lỗi');
    }
    async function saveNote(id){
        const note = document.getElementById('note-'+id).value;
        const d = await fetch('/admin/SaveBookingNote?id='+id+'&note='+encodeURIComponent(note),{method:'POST'}).then(r=>r.json());
        if(d.success) swalToast('success','Đã lưu ghi chú'); else Swal.fire('Lỗi');
    }
    async function confirmBk(id){ if(!await confirmSwal('Xác nhận đơn và gửi email cho khách? (chuyển sang Chờ thanh toán)')) return;
        const d = await post('/admin/ConfirmAdBooking/'+id);
        if(d.success){ if(d.emailSent) swalToast('success','Đã xác nhận + gửi email'); else Swal.fire('Đã xác nhận','Email chưa gửi: '+(d.emailMsg||'—'),'warning'); setTimeout(()=>location.reload(),1000); } else Swal.fire('Lỗi'); }
    async function rejectBk(id){ if(!await confirmSwal('Từ chối đơn này?')) return; const d = await post('/admin/CancelAdBooking/'+id); if(d.success){ swalToast('success','Đã từ chối'); setTimeout(()=>location.reload(),600);} else Swal.fire('Lỗi'); }
    function openPublish(id, pos){ document.getElementById('pubId').value=id; document.getElementById('pubPos').textContent=pos; pubType('image'); document.querySelector('input[name=adType][value=image]').checked=true; var m=document.getElementById('pubModal'); m.style.display='flex'; m.style.alignItems='flex-start'; m.style.justifyContent='center'; }
    function closePub(){ document.getElementById('pubModal').style.display='none'; }
    function pubType(t){ document.getElementById('pubImage').style.display = t==='image'?'block':'none'; document.getElementById('pubHtml').style.display = t==='html'?'block':'none'; }
</script>
}
