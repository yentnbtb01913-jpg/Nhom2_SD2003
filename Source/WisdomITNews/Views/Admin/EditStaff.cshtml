@model WisdomITNews.Models.Admin
@{ ViewData["Title"] = "Sửa nhân viên"; Layout = "_AdminLayout"; }

<h1 style="font-size:22px;font-weight:800;margin-bottom:18px;"><i class="fa fa-user-pen" style="color:#159aa3;"></i> Sửa nhân viên: @Model.FullName <span style="font-size:14px;color:#0e7d85;">(NV@Model.Id.ToString("D3"))</span></h1>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }
@if (TempData["Err"] != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Err"]</div> }

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:820px;">
    <div style="background:#fff;border-radius:6px;padding:22px;box-shadow:0 2px 10px rgba(0,0,0,.06);">
        <h2 style="font-size:15px;font-weight:700;margin-bottom:14px;">Thông tin</h2>
        <form method="post" action="/admin/EditStaff/@Model.Id">
            @Html.AntiForgeryToken()
            <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Mã NV</label>
            <input value="NV@(Model.Id.ToString("D3"))" disabled style="width:100%;padding:10px 12px;border:1px solid #e0e4e8;border-radius:6px;margin-bottom:14px;background:#f8fafc;color:#6c757d;" />

            <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Họ và tên</label>
            <input name="fullName" value="@Model.FullName" required style="width:100%;padding:10px 12px;border:1px solid #e0e4e8;border-radius:6px;margin-bottom:14px;" />

            <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Giới tính</label>
            <select name="gender" style="width:100%;padding:10px 12px;border:1px solid #e0e4e8;border-radius:6px;margin-bottom:14px;">
                <option value="Nam" selected="@(Model.Gender == "Nam")">Nam</option>
                <option value="Nữ" selected="@(Model.Gender == "Nữ")">Nữ</option>
                <option value="Khác" selected="@(Model.Gender == "Khác")">Khác</option>
            </select>

            <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Email</label>
            <input name="email" value="@Model.Email" type="email" required style="width:100%;padding:10px 12px;border:1px solid #e0e4e8;border-radius:6px;margin-bottom:14px;" />

            <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Địa chỉ</label>
            <input name="address" value="@Model.Address" style="width:100%;padding:10px 12px;border:1px solid #e0e4e8;border-radius:6px;margin-bottom:14px;" />

            <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Vai trò</label>
            <select name="role" style="width:100%;padding:10px 12px;border:1px solid #e0e4e8;border-radius:6px;margin-bottom:18px;">
                <option value="editor" selected="@(Model.Role == "editor")">Nhân viên (quyền cơ bản)</option>
                <option value="superadmin" selected="@(Model.Role == "superadmin")">Super Admin (toàn quyền)</option>
            </select>
            <button type="submit" style="background:#159aa3;color:#fff;padding:11px 20px;border:none;border-radius:6px;font-weight:700;cursor:pointer;"><i class="fa fa-save"></i> Lưu</button>
        </form>
    </div>
    <div style="background:#fff;border-radius:6px;padding:22px;box-shadow:0 2px 10px rgba(0,0,0,.06);">
        <h2 style="font-size:15px;font-weight:700;margin-bottom:14px;">Mật khẩu &amp; trạng thái</h2>
        <form method="post" action="/admin/ResetStaffPassword/@Model.Id">
            @Html.AntiForgeryToken()
            <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;">Mật khẩu mới</label>
            <input name="newPassword" type="password" required minlength="6" style="width:100%;padding:10px 12px;border:1px solid #e0e4e8;border-radius:6px;margin-bottom:18px;" />
            <button type="submit" style="background:#476083;color:#fff;padding:11px 20px;border:none;border-radius:6px;font-weight:700;cursor:pointer;"><i class="fa fa-key"></i> Đặt lại mật khẩu</button>
        </form>
        <p style="font-size:12.5px;color:#94a3b8;margin-top:16px;">
            Tên đăng nhập: <b>@Model.Username</b><br />
            Tình trạng: <b style="color:@(Model.IsActive ? "#16a34a" : "#dc2626");">@(Model.IsActive ? "Đang hoạt động" : "Đã khoá")</b>
        </p>
        <a href="/admin/Staff" style="font-size:13px;color:#6c757d;text-decoration:none;">← Về danh sách nhân viên</a>
    </div>
</div>
