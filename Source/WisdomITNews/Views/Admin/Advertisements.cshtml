@using WisdomITNews.Models
@model List<Advertisement>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quảng cáo";
    var filter = (string)(ViewBag.Filter ?? "all");
    int pending = (int)(ViewBag.PendingCount ?? 0);
    int imp = (int)(ViewBag.TotalImpressions ?? 0);
    int clk = (int)(ViewBag.TotalClicks ?? 0);
    var slotNames = ViewBag.SlotNames as Dictionary<string, string> ?? new Dictionary<string, string>();
    string PosVi(string p) => slotNames.TryGetValue(p ?? "", out var v) ? v : p;
    var slotList = ViewBag.SlotList as List<AdSlot> ?? new List<AdSlot>();
    var deletedAds = ViewBag.DeletedAds as List<Advertisement> ?? new List<Advertisement>();
    var tabs = new List<(string, string)> { ("all", "Tất cả"), ("active", "Đang chạy"), ("paused", "Tạm dừng"), ("pending", "Chờ duyệt") };
    foreach (var sl in slotList) { tabs.Add((sl.SlotKey, sl.Name)); }
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-rectangle-ad" style="color:#159aa3;"></i> Quản lý Quảng cáo</h1>
    <a href="/admin/CreateAd" style="background:#159aa3;color:#fff;padding:9px 16px;border-radius:6px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-plus"></i> Thêm quảng cáo</a>
</div>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:18px;">
    <div style="background:#fff;border-radius:8px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.06);"><div style="font-size:24px;font-weight:800;color:#0a2540;">@imp.ToString("N0")</div><div style="font-size:13px;color:#6c757d;">Tổng lượt hiển thị</div></div>
    <div style="background:#fff;border-radius:8px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.06);"><div style="font-size:24px;font-weight:800;color:#0a2540;">@clk.ToString("N0")</div><div style="font-size:13px;color:#6c757d;">Tổng lượt click</div></div>
    <div style="background:#fff;border-radius:8px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.06);"><div style="font-size:24px;font-weight:800;color:@(pending>0?"#ca8a04":"#0a2540");">@pending</div><div style="font-size:13px;color:#6c757d;">QC chờ duyệt</div></div>
</div>

<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;">
    @foreach (var (key, label) in tabs)
    {
        <a href="/admin/Advertisements?filter=@key" style="padding:7px 14px;border-radius:6px;font-size:13px;text-decoration:none;@(filter==key ? "background:#0e7d85;color:#fff;" : "background:#f0f2f5;color:#374151;")">@label</a>
    }
</div>

<div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
        <thead>
            <tr style="background:#f5f6f8;color:#6c757d;text-align:left;">
                <th style="padding:10px;">Banner</th><th style="padding:10px;">Tiêu đề</th><th style="padding:10px;">Vị trí</th>
                <th style="padding:10px;">Lịch chạy</th><th style="padding:10px;">Hiển thị</th><th style="padding:10px;">Click</th>
                <th style="padding:10px;">CTR</th><th style="padding:10px;">Trạng thái</th><th style="padding:10px;">Thanh toán</th><th style="padding:10px;">Người tạo</th><th style="padding:10px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                var ctr = a.Impressions > 0 ? (a.Clicks * 100.0 / a.Impressions) : 0;
                <tr id="ad-@a.Id" style="border-bottom:1px solid #f0f2f5;">
                    <td style="padding:10px;">@if (!string.IsNullOrEmpty(a.ImageUrl)) {<img src="@a.ImageUrl" style="width:90px;height:auto;max-height:44px;object-fit:contain;border-radius:4px;" />} else {<span style="color:#cbd5e1;">—</span>}</td>
                    <td style="padding:10px;font-weight:600;max-width:200px;overflow:hidden;text-overflow:ellipsis;">@a.Title</td>
                    <td style="padding:10px;"><span style="background:#e6f4f5;color:#0e7d85;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">@PosVi(a.Position)</span></td>
                    <td style="padding:10px;color:#6c757d;font-size:12px;">@(a.StartDate?.ToString("dd/MM/yy") ?? "Ngay") → @(a.EndDate?.ToString("dd/MM/yy") ?? "Không giới hạn")</td>
                    <td style="padding:10px;">@a.Impressions.ToString("N0")</td>
                    <td style="padding:10px;">@a.Clicks.ToString("N0")</td>
                    <td style="padding:10px;color:#374151;">@ctr.ToString("0.0")%</td>
                    <td style="padding:10px;">
                        @if (a.Status == "pending")
                        { <span style="background:#fef9c3;color:#ca8a04;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">Chờ duyệt</span> }
                        else if (a.Status == "rejected")
                        { <span style="background:#fee2e2;color:#991b1b;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">Từ chối</span> }
                        else
                        { <span id="st-@a.Id" style="background:@(a.IsActive?"#dcfce7":"#f0f2f5");color:@(a.IsActive?"#16a34a":"#6c757d");padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">@(a.IsActive ? "Đang chạy" : "Đã tắt")</span> }
                    </td>
                    <td style="padding:10px;">
                        @if (a.AdSlotId != null)
                        {
                            <div style="font-weight:700;color:#dc2626;">@a.Amount.ToString("#,##0")đ</div>
                            @if (a.PaymentStatus == "paid")
                            { <span style="background:#dcfce7;color:#16a34a;padding:1px 8px;border-radius:20px;font-size:11px;font-weight:700;">Đã TT</span> }
                            else
                            { <span style="background:#fef9c3;color:#ca8a04;padding:1px 8px;border-radius:20px;font-size:11px;font-weight:700;">Chưa TT</span> }
                        }
                        else { <span style="color:#cbd5e1;">—</span> }
                    </td>
                    <td style="padding:10px;color:#6c757d;font-size:12px;">@a.CreatedByName</td>
                    <td style="padding:10px;white-space:nowrap;">
                        @if (a.Status == "pending")
                        {
                            <button onclick="approveAd(@a.Id)" title="Duyệt" style="background:#16a34a;color:#fff;border:none;padding:5px 9px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-check"></i></button>
                            <button onclick="rejectAd(@a.Id)" title="Từ chối" style="background:#fef9c3;color:#ca8a04;border:none;padding:5px 9px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-xmark"></i></button>
                        }
                        <a href="/admin/EditAd/@a.Id" title="Sửa" style="background:#159aa3;color:#fff;padding:5px 9px;border-radius:5px;font-size:12px;text-decoration:none;"><i class="fa fa-pen"></i></a>
                        @if (a.Status == "approved")
                        {
                            <button id="tg-@a.Id" onclick="toggleAd(@a.Id)" title="Bật/Dừng hiển thị trên trang" style="background:@(a.IsActive ? "#fef9c3" : "#dcfce7");color:@(a.IsActive ? "#ca8a04" : "#16a34a");border:none;padding:5px 12px;border-radius:5px;font-size:12px;cursor:pointer;font-weight:700;">@(a.IsActive ? "Dừng" : "Chạy")</button>
                        }
                        <button onclick="deleteAd(@a.Id)" title="Xóa (chuyển vào thùng rác)" style="background:#fee2e2;color:#991b1b;border:none;padding:5px 9px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-trash"></i></button>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            { <tr><td colspan="11" style="padding:24px;text-align:center;color:#94a3b8;">Chưa có quảng cáo nào.</td></tr> }
        </tbody>
    </table>
</div>

<!-- ==================== THÙNG RÁC QUẢNG CÁO ==================== -->
<div style="margin-top:30px;background:#fff;border:2px dashed #e5e7eb;border-radius:10px;padding:18px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
        <i class="fa fa-trash-can" style="color:#991b1b;font-size:18px;"></i>
        <h2 style="font-size:17px;font-weight:800;margin:0;">Thùng rác quảng cáo</h2>
        <span style="background:#fee2e2;color:#991b1b;font-size:12px;font-weight:700;padding:2px 9px;border-radius:20px;">@deletedAds.Count</span>
        <span style="color:#94a3b8;font-size:13px;">— quảng cáo đã xóa, có thể khôi phục hoặc xóa vĩnh viễn</span>
    </div>
    @if (!deletedAds.Any())
    {
        <div style="text-align:center;color:#cbd5e1;padding:16px;">Thùng rác trống.</div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
                <thead>
                    <tr style="background:#f5f6f8;color:#6c757d;text-align:left;">
                        <th style="padding:10px;">Banner</th><th style="padding:10px;">Tiêu đề</th><th style="padding:10px;">Vị trí</th><th style="padding:10px;">Đã xóa lúc</th><th style="padding:10px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in deletedAds)
                    {
                        <tr id="del-@a.Id" style="border-bottom:1px solid #f0f2f5;">
                            <td style="padding:10px;">@if (!string.IsNullOrEmpty(a.ImageUrl)) {<img src="@a.ImageUrl" style="width:80px;height:auto;max-height:40px;object-fit:contain;border-radius:4px;opacity:.7;" />} else {<span style="color:#cbd5e1;">—</span>}</td>
                            <td style="padding:10px;font-weight:600;color:#64748b;max-width:220px;overflow:hidden;text-overflow:ellipsis;">@a.Title</td>
                            <td style="padding:10px;"><span style="background:#f0f2f5;color:#64748b;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">@PosVi(a.Position)</span></td>
                            <td style="padding:10px;color:#94a3b8;font-size:12px;">@(a.DeletedAt?.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td style="padding:10px;white-space:nowrap;">
                                <button onclick="restoreAd(@a.Id)" title="Khôi phục" style="background:#dcfce7;color:#16a34a;border:none;padding:5px 12px;border-radius:5px;font-size:12px;cursor:pointer;font-weight:700;"><i class="fa fa-rotate-left"></i> Khôi phục</button>
                                <button onclick="purgeAd(@a.Id)" title="Xóa vĩnh viễn" style="background:#fee2e2;color:#991b1b;border:none;padding:5px 10px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-xmark"></i> Xóa hẳn</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script>
    async function post(url){ const r = await fetch(url, { method:'POST' }); return await r.json(); }
    async function approveAd(id){ if(!await confirmSwal('Duyệt quảng cáo này?')) return; const d = await post('/admin/ApproveAd/'+id); if(d.success){ swalToast('success','Đã duyệt'); setTimeout(()=>location.reload(),500);} else Swal.fire(d.message||'Lỗi'); }
    async function rejectAd(id){ if(!await confirmSwal('Từ chối quảng cáo này?')) return; const d = await post('/admin/RejectAd/'+id); if(d.success){ swalToast('success','Đã từ chối'); setTimeout(()=>location.reload(),500);} else Swal.fire(d.message||'Lỗi'); }
    async function toggleAd(id){ const d = await post('/admin/ToggleAd/'+id); if(d.success){
        const b=document.getElementById('st-'+id); if(b){ b.textContent=d.isActive?'Đang chạy':'Đã tắt'; b.style.background=d.isActive?'#dcfce7':'#f0f2f5'; b.style.color=d.isActive?'#16a34a':'#6c757d'; }
        const t=document.getElementById('tg-'+id); if(t){ t.textContent=d.isActive?'Dừng':'Chạy'; t.style.background=d.isActive?'#fef9c3':'#dcfce7'; t.style.color=d.isActive?'#ca8a04':'#16a34a'; }
        swalToast('success', d.isActive?'Đã bật hiển thị':'Đã dừng hiển thị'); } else Swal.fire('Lỗi'); }
    async function deleteAd(id){ if(!await confirmSwal('Chuyển quảng cáo này vào thùng rác?')) return; const d = await post('/admin/DeleteAd/'+id); if(d.success){ swalToast('success','Đã chuyển vào thùng rác'); setTimeout(()=>location.reload(),500); } else Swal.fire('Lỗi'); }
    async function restoreAd(id){ const d = await post('/admin/RestoreAd/'+id); if(d.success){ swalToast('success','Đã khôi phục'); setTimeout(()=>location.reload(),500); } else Swal.fire('Lỗi'); }
    async function purgeAd(id){ if(!await confirmSwal('Xóa VĨNH VIỄN quảng cáo này? Không thể hoàn tác.')) return; const d = await post('/admin/PurgeAd/'+id); if(d.success){ document.getElementById('del-'+id)?.remove(); swalToast('success','Đã xóa vĩnh viễn'); } else Swal.fire(d.message||'Lỗi'); }
    async function confirmPay(id){ if(!await confirmSwal('Xác nhận đã NHẬN thanh toán đơn này?')) return; const d = await post('/admin/ConfirmAdPayment/'+id); if(d.success){ if(d.emailSent){ swalToast('success','Đã xác nhận + gửi email biên nhận'); } else { Swal.fire('Đã xác nhận thanh toán', 'Nhưng email KHÔNG gửi được: ' + (d.emailMsg||'không rõ'), 'warning'); } setTimeout(()=>location.reload(),1200);} else Swal.fire('Lỗi'); }
</script>
}
