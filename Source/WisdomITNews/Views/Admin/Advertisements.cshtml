@using WisdomITNews.Models
@model List<Advertisement>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quảng cáo";
    var filter = (string)(ViewBag.Filter ?? "all");
    int pending = (int)(ViewBag.PendingCount ?? 0);
    int imp = (int)(ViewBag.TotalImpressions ?? 0);
    int clk = (int)(ViewBag.TotalClicks ?? 0);
    var posLabel = new Dictionary<string, string> { ["header"] = "Header", ["sidebar"] = "Sidebar", ["in_article"] = "Trong bài", ["home_left"] = "Trang Chủ (trái)", ["home_right"] = "Trang Chủ (phải)" };
    string PosVi(string p) => posLabel.TryGetValue(p ?? "", out var v) ? v : p;
    (string, string)[] tabs = new[] { ("all", "Tất cả"), ("active", "Đang chạy"), ("pending", "Chờ duyệt"), ("header", "Header"), ("sidebar", "Sidebar"), ("in_article", "Trong bài"), ("home_left", "Trang Chủ (trái)"), ("home_right", "Trang Chủ (phải)") };
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-rectangle-ad" style="color:#159aa3;"></i> Quản lý Quảng cáo</h1>
    <a href="/admin/CreateAd" style="background:#159aa3;color:#fff;padding:9px 16px;border-radius:6px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-plus"></i> Thêm quảng cáo</a>
</div>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:18px;">
    <div style="background:#fff;border-radius:8px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.06);"><div style="font-size:24px;font-weight:800;color:#0a2540;">@imp.ToString("N0")</div><div style="font-size:13px;color:#6c757d;">Tổng lượt hiển thị</div></div>
    <div style="background:#fff;border-radius:8px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.06);"><div style="font-size:24px;font-weight:800;color:#0a2540;">@clk.ToString("N0")</div><div style="font-size:13px;color:#6c757d;">Tổng lượt click</div></div>
    <div style="background:#fff;border-radius:8px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.06);"><div style="font-size:24px;font-weight:800;color:@(pending>0?"#ca8a04":"#0a2540");">@pending</div><div style="font-size:13px;color:#6c757d;">QC chờ duyệt</div></div>
</div>

<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;">
    @foreach (var (key, label) in tabs)
    {
        <a href="/admin/Advertisements?filter=@key" style="padding:7px 14px;border-radius:6px;font-size:13px;text-decoration:none;@(filter==key ? "background:#0e7d85;color:#fff;" : "background:#f0f2f5;color:#374151;")">@label</a>
    }
</div>

<div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
        <thead>
            <tr style="background:#f5f6f8;color:#6c757d;text-align:left;">
                <th style="padding:10px;">Banner</th><th style="padding:10px;">Tiêu đề</th><th style="padding:10px;">Vị trí</th>
                <th style="padding:10px;">Lịch chạy</th><th style="padding:10px;">Hiển thị</th><th style="padding:10px;">Click</th>
                <th style="padding:10px;">CTR</th><th style="padding:10px;">Trạng thái</th><th style="padding:10px;">Người tạo</th><th style="padding:10px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                var ctr = a.Impressions > 0 ? (a.Clicks * 100.0 / a.Impressions) : 0;
                <tr id="ad-@a.Id" style="border-bottom:1px solid #f0f2f5;">
                    <td style="padding:10px;">@if (!string.IsNullOrEmpty(a.ImageUrl)) {<img src="@a.ImageUrl" style="width:90px;height:auto;max-height:44px;object-fit:contain;border-radius:4px;" />} else {<span style="color:#cbd5e1;">—</span>}</td>
                    <td style="padding:10px;font-weight:600;max-width:200px;overflow:hidden;text-overflow:ellipsis;">@a.Title</td>
                    <td style="padding:10px;"><span style="background:#e6f4f5;color:#0e7d85;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">@PosVi(a.Position)</span></td>
                    <td style="padding:10px;color:#6c757d;font-size:12px;">@(a.StartDate?.ToString("dd/MM/yy") ?? "Ngay") → @(a.EndDate?.ToString("dd/MM/yy") ?? "Không giới hạn")</td>
                    <td style="padding:10px;">@a.Impressions.ToString("N0")</td>
                    <td style="padding:10px;">@a.Clicks.ToString("N0")</td>
                    <td style="padding:10px;color:#374151;">@ctr.ToString("0.0")%</td>
                    <td style="padding:10px;">
                        @if (a.Status == "pending")
                        { <span style="background:#fef9c3;color:#ca8a04;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">Chờ duyệt</span> }
                        else if (a.Status == "rejected")
                        { <span style="background:#fee2e2;color:#991b1b;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">Từ chối</span> }
                        else
                        { <span id="st-@a.Id" style="background:@(a.IsActive?"#dcfce7":"#f0f2f5");color:@(a.IsActive?"#16a34a":"#6c757d");padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">@(a.IsActive ? "Đang chạy" : "Đã tắt")</span> }
                    </td>
                    <td style="padding:10px;color:#6c757d;font-size:12px;">@a.CreatedByName</td>
                    <td style="padding:10px;white-space:nowrap;">
                        @if (a.Status == "pending")
                        {
                            <button onclick="approveAd(@a.Id)" title="Duyệt" style="background:#16a34a;color:#fff;border:none;padding:5px 9px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-check"></i></button>
                            <button onclick="rejectAd(@a.Id)" title="Từ chối" style="background:#fef9c3;color:#ca8a04;border:none;padding:5px 9px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-xmark"></i></button>
                        }
                        <a href="/admin/EditAd/@a.Id" title="Sửa" style="background:#159aa3;color:#fff;padding:5px 9px;border-radius:5px;font-size:12px;text-decoration:none;"><i class="fa fa-pen"></i></a>
                        @if (a.Status == "approved")
                        {
                            <button onclick="toggleAd(@a.Id)" title="Bật/tắt" style="background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;padding:5px 9px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-power-off"></i></button>
                        }
                        <button onclick="deleteAd(@a.Id)" title="Xóa" style="background:#fee2e2;color:#991b1b;border:none;padding:5px 9px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-trash"></i></button>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            { <tr><td colspan="10" style="padding:24px;text-align:center;color:#94a3b8;">Chưa có quảng cáo nào.</td></tr> }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    async function post(url){ const r = await fetch(url, { method:'POST' }); return await r.json(); }
    async function approveAd(id){ if(!await confirmSwal('Duyệt quảng cáo này?')) return; const d = await post('/admin/ApproveAd/'+id); if(d.success){ swalToast('success','Đã duyệt'); setTimeout(()=>location.reload(),500);} else Swal.fire(d.message||'Lỗi'); }
    async function rejectAd(id){ if(!await confirmSwal('Từ chối quảng cáo này?')) return; const d = await post('/admin/RejectAd/'+id); if(d.success){ swalToast('success','Đã từ chối'); setTimeout(()=>location.reload(),500);} else Swal.fire(d.message||'Lỗi'); }
    async function toggleAd(id){ const d = await post('/admin/ToggleAd/'+id); if(d.success){ const b=document.getElementById('st-'+id); if(b){ b.textContent=d.isActive?'Đang chạy':'Đã tắt'; b.style.background=d.isActive?'#dcfce7':'#f0f2f5'; b.style.color=d.isActive?'#16a34a':'#6c757d'; } swalToast('success','Đã cập nhật'); } else Swal.fire('Lỗi'); }
    async function deleteAd(id){ if(!await confirmSwal('Xóa quảng cáo này?')) return; const d = await post('/admin/DeleteAd/'+id); if(d.success){ document.getElementById('ad-'+id)?.remove(); swalToast('success','Đã xóa'); } else Swal.fire('Lỗi'); }
</script>
}
