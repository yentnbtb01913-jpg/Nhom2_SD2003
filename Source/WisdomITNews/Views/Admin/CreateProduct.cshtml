@model WisdomITNews.Models.SubscriptionPlan
@{
    ViewData["Title"] = "Thêm gói"; Layout = "_AdminLayout";
    var featureList = ViewBag.FeatureList as List<string> ?? new List<string>();
    string lbl = "display:block;font-weight:600;font-size:13px;margin-bottom:6px;color:#374151;";
    string inp = "width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;";
    string hint = "font-size:11px;color:#94a3b8;margin-top:4px;";
}
<div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
  <a href="/admin/Products" style="color:#6c757d;text-decoration:none;"><i class="fa fa-arrow-left"></i></a>
  <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-box" style="color:#159aa3;"></i> Thêm gói Premium</h1>
</div>

@if (ViewBag.Error != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@ViewBag.Error</div> }

<form method="post" action="/admin/CreateProduct" style="background:#fff;border-radius:8px;padding:22px;box-shadow:0 2px 10px rgba(0,0,0,.06);max-width:680px;">
  <div style="margin-bottom:16px;">
    <label style="@lbl">Tên gói *</label>
    <input style="@inp" name="Name" value="@Model.Name" required maxlength="120" placeholder="VD: Premium" />
  </div>
  <div style="margin-bottom:16px;">
    <label style="@lbl">Mô tả</label>
    <textarea style="@inp" name="Description" rows="2" maxlength="500" placeholder="Mô tả ngắn hiển thị trên bảng giá">@Model.Description</textarea>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:16px;">
    <div>
      <label style="@lbl">Giá (đ) *</label>
      <input style="@inp" type="number" name="Price" value="@Model.Price" min="0" step="1000" required />
    </div>
    <div>
      <label style="@lbl">Thời hạn (ngày) *</label>
      <input style="@inp" type="number" name="DurationDays" value="@(Model.DurationDays == 0 ? 30 : Model.DurationDays)" min="1" required />
    </div>
    <div>
      <label style="@lbl">Dùng thử (ngày)</label>
      <input style="@inp" type="number" name="TrialDays" value="@Model.TrialDays" min="0" />
      <div style="@hint">0 = không có dùng thử</div>
    </div>
  </div>

  <div style="margin-bottom:16px;">
    <label style="@lbl">Quyền lợi của gói</label>
    <div id="featBox">
      @foreach (var ft in featureList)
      {
        <div class="feat-row" style="display:flex;gap:8px;margin-bottom:8px;">
          <input name="featureTexts" value="@ft" maxlength="200" style="@inp" placeholder="VD: Đọc toàn bộ bài Premium" />
          <button type="button" onclick="this.parentElement.remove()" style="background:#fee2e2;color:#991b1b;border:none;border-radius:6px;padding:0 12px;cursor:pointer;">×</button>
        </div>
      }
    </div>
    <button type="button" onclick="addFeat()" style="background:#e0f2f1;color:#0e7d85;border:none;border-radius:6px;padding:8px 14px;font-weight:600;cursor:pointer;font-size:13px;"><i class="fa fa-plus"></i> Thêm quyền lợi</button>
  </div>

  <div style="margin-bottom:20px;">
    <label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer;">
      <input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /> Đang bán (hiển thị trên bảng giá)
    </label>
  </div>

  <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:11px 24px;border-radius:6px;font-weight:700;cursor:pointer;"><i class="fa fa-save"></i> Lưu gói</button>
</form>

<script>
function addFeat(){
  var box=document.getElementById('featBox');
  var d=document.createElement('div'); d.className='feat-row'; d.style.cssText='display:flex;gap:8px;margin-bottom:8px;';
  d.innerHTML='<input name="featureTexts" maxlength="200" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;" placeholder="VD: Đọc toàn bộ bài Premium" />'+
    '<button type="button" onclick="this.parentElement.remove()" style="background:#fee2e2;color:#991b1b;border:none;border-radius:6px;padding:0 12px;cursor:pointer;">×</button>';
  box.appendChild(d);
}
if(document.querySelectorAll('.feat-row').length===0) addFeat();
</script>
