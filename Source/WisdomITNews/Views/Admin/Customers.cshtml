@using WisdomITNews.Models
@model List<NewsletterSubscriber>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Khách Hàng";
    var total = Model.Count;
    var active = Model.Count(m => m.Status == "active");
    var inactive = Model.Count(m => m.Status != "active");
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <h1 style="font-size:22px;font-weight:700;">👥 Quản lý Khách Hàng</h1>
</div>

<!-- Thống kê -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px;">
    <div style="background:#fff;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);border-left:4px solid #0e7d85;">
        <div style="font-size:13px;color:#6c757d;margin-bottom:4px;">Tổng số khách hàng</div>
        <div style="font-size:28px;font-weight:700;color:#0e7d85;">@total</div>
    </div>
    <div style="background:#fff;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);border-left:4px solid #16a34a;">
        <div style="font-size:13px;color:#6c757d;margin-bottom:4px;">Đang nhận (Active)</div>
        <div style="font-size:28px;font-weight:700;color:#16a34a;">@active</div>
    </div>
    <div style="background:#fff;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);border-left:4px solid #dc2626;">
        <div style="font-size:13px;color:#6c757d;margin-bottom:4px;">Đã hủy (Inactive)</div>
        <div style="font-size:28px;font-weight:700;color:#dc2626;">@inactive</div>
    </div>
</div>

<!-- Tìm kiếm -->
<div style="background:#fff;padding:16px;margin-bottom:20px;box-shadow:0 2px 8px rgba(0,0,0,.07);">
    <input type="text" id="searchInput" placeholder="🔍 Tìm kiếm theo email..." 
           style="width:100%;padding:10px 14px;border:1px solid #d1d5db;font-size:14px;border-radius:6px;" />
</div>

<!-- Danh sách khách hàng -->
<div style="background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.07);overflow-x:auto;">
    <div style="padding:14px 18px;border-bottom:1px solid #e5e7eb;font-weight:600;">Danh sách khách hàng (@Model.Count)</div>
    @if (!Model.Any())
    {
        <div style="padding:30px;text-align:center;color:#6c757d;">Chưa có khách hàng nào.</div>
    }
    else
    {
        <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
            <thead style="background:#f8fafc;color:#6c757d;text-align:left;">
                <tr>
                    <th style="padding:10px;">STT</th>
                    <th style="padding:10px;">Email</th>
                    <th style="padding:10px;">Trạng thái</th>
                    <th style="padding:10px;">Ngày đăng ký</th>
                    <th style="padding:10px;text-align:right;">Hành động</th>
                </tr>
            </thead>
            <tbody id="customerTable">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <tr data-id="@item.Id" data-email="@item.Email.ToLower()">
                        <td style="padding:10px;">@(i + 1)</td>
                        <td style="padding:10px;">@item.Email</td>
                        <td style="padding:10px;">
                            @if (item.Status == "active")
                            {
                                <span style="background:#dcfce7;color:#166534;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Active</span>
                            }
                            else
                            {
                                <span style="background:#fee2e2;color:#991b1b;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Inactive</span>
                            }
                        </td>
                        <td style="padding:10px;">@item.SubscribedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="padding:10px;text-align:right;">
                            <button onclick="deleteCustomer(@item.Id)" 
                                    style="padding:6px 14px;background:#dc2626;color:#fff;border:none;font-size:12px;font-weight:600;cursor:pointer;border-radius:4px;">
                                Xóa
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<script>
    // Realtime search filter
    document.getElementById('searchInput').addEventListener('input', function(e) {
        const search = e.target.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#customerTable tr');
        
        rows.forEach(row => {
            const email = row.getAttribute('data-email') || '';
            if (email.includes(search)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // Delete customer with SweetAlert2
    async function deleteCustomer(id) {
        const result = await Swal.fire({
            title: 'Xóa khách hàng?',
            text: 'Hành động này không thể hoàn tác!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Huỷ'
        });

        if (result.isConfirmed) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const row = document.querySelector(`tr[data-id="${id}"]`);
            
            try {
                const response = await fetch('/admin/DeleteSubscriber/' + id, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: ''
                });

                const data = await response.json();
                
                if (data.success) {
                    if (row) {
                        row.remove();
                        swalToast('success', 'Đã xóa khách hàng thành công');
                        // Update statistics
                        updateStats();
                    }
                } else {
                    swalToast('error', data.message || 'Xóa thất bại');
                }
            } catch (error) {
                swalToast('error', 'Lỗi kết nối');
            }
        }
    }

    function updateStats() {
        const rows = document.querySelectorAll('#customerTable tr');
        let activeCount = 0;
        
        rows.forEach(row => {
            const statusSpan = row.querySelector('span');
            if (statusSpan && statusSpan.textContent.trim() === 'Active') {
                activeCount++;
            }
        });

        const total = rows.length;
        const inactive = total - activeCount;

        // Update stats in the DOM
        const stats = document.querySelectorAll('.grid > div');
        if (stats.length >= 3) {
            stats[0].querySelector('div:last-child').textContent = total;
            stats[1].querySelector('div:last-child').textContent = activeCount;
            stats[2].querySelector('div:last-child').textContent = inactive;
        }
    }
</script>
