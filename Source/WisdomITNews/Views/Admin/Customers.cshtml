@using WisdomITNews.Models
@model List<NewsletterSubscriber>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Khách Hàng";
    var cats = ViewBag.Categories as List<string> ?? new List<string>();
    var sources = ViewBag.Sources as List<string> ?? new List<string>();
    var q = (string)(ViewBag.Q ?? "");
    var fcat = (string)(ViewBag.Category ?? "");
    var fsrc = (string)(ViewBag.Source ?? "");
    var filter = (string)(ViewBag.Filter ?? "all");
    var total = Model.Count;
    var active = Model.Count(m => m.Status == "active");
    var withCat = Model.Count(m => !string.IsNullOrWhiteSpace(m.InterestedCategory));
}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:8px;">
    <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-users" style="color:#159aa3;"></i> Quản lý Khách Hàng</h1>
    <div style="display:flex;gap:8px;">
        <a href="/admin/SendCustomerEmail" style="background:#0e7d85;color:#fff;padding:9px 16px;border-radius:6px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-paper-plane"></i> Gửi email cho nhóm</a>
        <a href="/admin/CreateCustomer" style="background:#159aa3;color:#fff;padding:9px 16px;border-radius:6px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-plus"></i> Thêm khách</a>
    </div>
</div>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }
@if (TempData["Err"] != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Err"]</div> }

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:16px;">
    <div style="background:#fff;padding:16px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.06);"><div style="font-size:24px;font-weight:800;color:#0e7d85;">@total</div><div style="font-size:13px;color:#6c757d;">Khách hàng (kết quả)</div></div>
    <div style="background:#fff;padding:16px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.06);"><div style="font-size:24px;font-weight:800;color:#16a34a;">@active</div><div style="font-size:13px;color:#6c757d;">Đang nhận (active)</div></div>
    <div style="background:#fff;padding:16px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.06);"><div style="font-size:24px;font-weight:800;color:#2563eb;">@withCat</div><div style="font-size:13px;color:#6c757d;">Đã phân nhóm sở thích</div></div>
</div>

<form method="get" action="/admin/Customers" style="background:#fff;padding:14px;margin-bottom:16px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.06);display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:10px;align-items:end;">
    <div><label style="font-size:12px;color:#6c757d;font-weight:600;">Tìm tên / email / SĐT</label><input type="text" name="q" value="@q" style="width:100%;padding:8px 11px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;" /></div>
    <div><label style="font-size:12px;color:#6c757d;font-weight:600;">Danh mục quan tâm</label>
        <select name="category" style="width:100%;padding:8px 11px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;">
            <option value="">Tất cả</option>
            @foreach (var c in cats) { <option value="@c" selected="@(fcat == c)">@c</option> }
        </select>
    </div>
    <div><label style="font-size:12px;color:#6c757d;font-weight:600;">Nguồn</label>
        <select name="source" style="width:100%;padding:8px 11px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;">
            <option value="">Tất cả</option>
            @foreach (var sc in sources) { <option value="@sc" selected="@(fsrc == sc)">@sc</option> }
        </select>
    </div>
    <div><label style="font-size:12px;color:#6c757d;font-weight:600;">Trạng thái</label>
        <select name="filter" style="width:100%;padding:8px 11px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;">
            <option value="all" selected="@(filter=="all")">Tất cả</option>
            <option value="active" selected="@(filter=="active")">Đang nhận</option>
            <option value="inactive" selected="@(filter=="inactive")">Đã hủy</option>
        </select>
    </div>
    <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:9px 16px;border-radius:6px;font-weight:600;cursor:pointer;"><i class="fa fa-filter"></i></button>
</form>

@Html.AntiForgeryToken()
<div style="background:#fff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.06);overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;">
        <thead><tr style="background:#f5f6f8;color:#6c757d;text-align:left;">
            <th style="padding:10px;">Họ tên</th><th style="padding:10px;">Email</th><th style="padding:10px;">SĐT</th>
            <th style="padding:10px;">Danh mục quan tâm</th><th style="padding:10px;">Nguồn</th><th style="padding:10px;">Trạng thái</th><th style="padding:10px;">Ngày ĐK</th><th style="padding:10px;"></th>
        </tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr id="cus-@m.Id" style="border-bottom:1px solid #f0f2f5;">
                    <td style="padding:10px;font-weight:600;">@(string.IsNullOrWhiteSpace(m.FullName) ? "—" : m.FullName)</td>
                    <td style="padding:10px;color:#374151;">@m.Email</td>
                    <td style="padding:10px;color:#6c757d;">@(string.IsNullOrWhiteSpace(m.Phone) ? "—" : m.Phone)</td>
                    <td style="padding:10px;">@if (!string.IsNullOrWhiteSpace(m.InterestedCategory)) {<span style="background:#e6f4f5;color:#0e7d85;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">@m.InterestedCategory</span>} else {<span style="color:#cbd5e1;">—</span>}</td>
                    <td style="padding:10px;color:#6c757d;">@(string.IsNullOrWhiteSpace(m.Source) ? "—" : m.Source)</td>
                    <td style="padding:10px;"><span style="background:@(m.Status=="active"?"#dcfce7":"#f0f2f5");color:@(m.Status=="active"?"#16a34a":"#6c757d");padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">@(m.Status=="active"?"Đang nhận":"Đã hủy")</span></td>
                    <td style="padding:10px;color:#6c757d;font-size:12px;">@m.SubscribedAt.ToString("dd/MM/yyyy")</td>
                    <td style="padding:10px;white-space:nowrap;">
                        <a href="/admin/CustomerDetail/@m.Id" title="Chi tiết" style="background:#0a2540;color:#fff;padding:5px 10px;border-radius:5px;font-size:12px;text-decoration:none;"><i class="fa fa-eye"></i></a>
                        <a href="/admin/EditCustomer/@m.Id" title="Sửa" style="background:#159aa3;color:#fff;padding:5px 10px;border-radius:5px;font-size:12px;text-decoration:none;"><i class="fa fa-pen"></i></a>
                        <button onclick="delCus(@m.Id)" title="Xóa" style="background:#fee2e2;color:#991b1b;border:none;padding:5px 10px;border-radius:5px;font-size:12px;cursor:pointer;"><i class="fa fa-trash"></i></button>
                    </td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="8" style="padding:24px;text-align:center;color:#94a3b8;">Không có khách hàng phù hợp.</td></tr> }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    async function delCus(id){
        if(!await confirmSwal('Xóa khách hàng này?')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const r = await fetch('/admin/DeleteSubscriber/' + id, { method:'POST', headers: { 'RequestVerificationToken': token } });
        const d = await r.json();
        if(d.success){ document.getElementById('cus-'+id)?.remove(); swalToast('success','Đã xóa'); }
        else Swal.fire(d.message || 'Không xóa được');
    }
</script>
}
