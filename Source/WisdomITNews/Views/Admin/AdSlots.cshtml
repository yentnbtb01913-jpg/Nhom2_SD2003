@using WisdomITNews.Models
@model List<AdSlot>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Slot Quảng cáo";
    var q = (string)(ViewBag.Q ?? "");
    var sampleSlug = ViewBag.SampleArticleSlug as string;
    // Slot thuộc TRANG BÀI CHI TIẾT -> "Xem trên trang" mở 1 bài mẫu; còn lại mở trang chủ
    var articleKeys = new HashSet<string> { "in_article", "sidebar", "article_billboard", "article_rect", "article_side600" };
    string PageUrl(string key) => (articleKeys.Contains(key) && !string.IsNullOrEmpty(sampleSlug)) ? $"/bai-viet/{sampleSlug}" : "/";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
    <h1 style="font-size:24px;font-weight:800;">Slot Quảng cáo</h1>
    <a href="/admin/CreateAdSlot" style="background:#2563eb;color:#fff;padding:10px 18px;border-radius:8px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-plus-circle"></i> Tạo slot mới</a>
</div>

@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }

<form method="get" action="/admin/AdSlots" style="margin-bottom:18px;display:flex;gap:8px;max-width:520px;">
    <input type="text" name="q" value="@q" placeholder="Tìm theo tên / mã vị trí / kích thước..."
           style="flex:1;padding:10px 14px;border:1px solid #d7dde3;border-radius:8px;font-size:14px;outline:none;" />
    <button type="submit" style="background:#0e7d85;color:#fff;border:none;padding:10px 18px;border-radius:8px;font-weight:600;cursor:pointer;"><i class="fa fa-search"></i> Tìm</button>
</form>

@if (!Model.Any())
{
    <div style="background:#fff;border-radius:10px;padding:40px;text-align:center;color:#64748b;box-shadow:0 2px 10px rgba(0,0,0,.05);">Chưa có slot quảng cáo nào.</div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
        @foreach (var s in Model)
        {
            <div style="background:#fff;border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.06);overflow:hidden;display:flex;flex-direction:column;">
                <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid #eef1f4;">
                    <span style="font-size:17px;font-weight:800;color:#0f172a;">@s.Name</span>
                    <span style="background:#2563eb;color:#fff;font-size:11px;font-weight:700;padding:3px 9px;border-radius:6px;">@s.SlotKey</span>
                </div>
                <div style="padding:16px 18px;flex:1;">
                    <p style="color:#475569;font-size:14px;margin:0 0 16px;">@s.Description</p>
                    <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:10px;"><span style="color:#64748b;">Kích thước:</span><span style="font-weight:600;color:#0f172a;">@s.Size</span></div>
                    <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:10px;"><span style="color:#64748b;">Giá/ngày:</span><span style="font-weight:800;color:#dc2626;">@s.PricePerDay.ToString("#,##0") đ</span></div>
                    <div style="display:flex;justify-content:space-between;font-size:14px;align-items:center;"><span style="color:#64748b;">Trạng thái:</span>
                        @if (s.IsActive)
                        { <span style="background:#16a34a;color:#fff;font-size:12px;font-weight:700;padding:3px 10px;border-radius:6px;">Đang hoạt động</span> }
                        else
                        { <span style="background:#94a3b8;color:#fff;font-size:12px;font-weight:700;padding:3px 10px;border-radius:6px;">Tạm ẩn</span> }
                    </div>
                </div>
                <div style="display:flex;gap:8px;padding:0 18px 10px;">
                    <button type="button" onclick="showSlotDemo('@s.SlotKey','@s.Name','@s.Size')" style="flex:1;border:1px solid #0e7d85;color:#0e7d85;background:#fff;padding:9px;border-radius:8px;font-weight:600;font-size:14px;cursor:pointer;"><i class="fa fa-eye"></i> Xem vị trí</button>
                    <a href="@PageUrl(s.SlotKey)" target="_blank" style="flex:1;text-align:center;border:1px solid #64748b;color:#334155;padding:9px;border-radius:8px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-arrow-up-right-from-square"></i> Xem trên trang</a>
                </div>
                <div style="display:flex;gap:8px;padding:0 18px 16px;">
                    <a href="/admin/EditAdSlot/@s.Id" style="flex:1;text-align:center;border:1px solid #2563eb;color:#2563eb;padding:9px;border-radius:8px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-pen"></i> Chỉnh sửa</a>
                    <button type="button" onclick="delSlot(@s.Id)" style="border:1px solid #dc2626;color:#dc2626;background:#fff;padding:9px 14px;border-radius:8px;font-weight:600;cursor:pointer;"><i class="fa fa-trash"></i></button>
                </div>
            </div>
        }
    </div>
}

@Html.AntiForgeryToken()

<!-- ===== MODAL XEM VỊ TRÍ SLOT ===== -->
<div id="slotDemoModal" onclick="if(event.target===this)closeSlotDemo()"
     style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:4000;padding:24px;overflow:auto;">
    <div style="background:#fff;border-radius:14px;max-width:720px;margin:auto;overflow:hidden;">
        <div style="background:#0e7d85;color:#fff;padding:14px 20px;font-weight:800;display:flex;justify-content:space-between;align-items:center;">
            <span id="slotDemoTitle">Vị trí quảng cáo</span>
            <button type="button" onclick="closeSlotDemo()" style="background:none;border:0;color:#fff;font-size:26px;line-height:1;cursor:pointer;">&times;</button>
        </div>
        <div style="padding:20px;">
            <div class="mk-page">
                <div class="mk-slot mk-h" data-keys="header topbanner"><b>BANNER ĐẦU TRANG</b></div>
                <div class="mk-mid">
                    <div class="mk-center">
                        <div class="mk-slot mk-bb" data-keys="home_billboard article_billboard"><b>BILLBOARD</b></div>
                        <div class="mk-line w80"></div><div class="mk-line w60"></div>
                        <div class="mk-slot mk-ia" data-keys="in_article"><b>QC TRONG BÀI</b></div>
                        <div class="mk-slot mk-row3" data-keys="home_rect_1 home_rect_2 home_rect_3"><b>DẢI 3 HỘP 300×250</b></div>
                        <div class="mk-slot mk-mid2" data-keys="home_mid_banner"><b>BANNER GIỮA CỘT</b></div>
                        <div class="mk-line w90"></div><div class="mk-line w70"></div>
                        <div class="mk-slot mk-bot" data-keys="home_bottom"><b>BANNER CUỐI</b></div>
                    </div>
                    <div class="mk-sidecol">
                        <div class="mk-slot mk-rect" data-keys="home_focus_rect sidebar article_rect"><b>HỘP 300×250</b></div>
                        <div class="mk-slot mk-side" data-keys="home_side600 article_side600"><b>DẢI DỌC 300×600</b></div>
                    </div>
                </div>
            </div>
            <p style="text-align:center;color:#6b7280;font-size:13px;margin:14px 0 0;">Vùng tô xanh là nơi slot này hiển thị trên trang.</p>
        </div>
    </div>
</div>
<style>
    #slotDemoModal .mk-page{border:1px solid #e5e7eb;border-radius:10px;background:#fafafa;padding:8px;}
    #slotDemoModal .mk-mid{display:flex;gap:6px;margin-top:6px;}
    #slotDemoModal .mk-center{flex:1;} #slotDemoModal .mk-sidecol{width:96px;flex-shrink:0;} #slotDemoModal .mk-rail{width:26px;flex-shrink:0;min-height:300px;writing-mode:vertical-rl;}
    #slotDemoModal .mk-line{height:9px;background:#e2e8f0;border-radius:4px;margin:7px 0;}
    #slotDemoModal .mk-line.w90{width:90%;} #slotDemoModal .mk-line.w80{width:80%;} #slotDemoModal .mk-line.w70{width:70%;} #slotDemoModal .mk-line.w60{width:60%;}
    #slotDemoModal .mk-slot{display:flex;align-items:center;justify-content:center;background:#cbd5e1;color:#64748b;border-radius:5px;opacity:.4;transition:.2s;text-align:center;}
    #slotDemoModal .mk-slot b{font-size:10px;letter-spacing:.03em;}
    #slotDemoModal .mk-h{height:38px;} #slotDemoModal .mk-bb{height:52px;margin:6px 0;} #slotDemoModal .mk-ia{height:44px;margin:8px 0;}
    #slotDemoModal .mk-row3{height:40px;margin:8px 0;} #slotDemoModal .mk-mid2{height:30px;margin:8px 0;} #slotDemoModal .mk-bot{height:28px;margin-top:8px;}
    #slotDemoModal .mk-rect{height:90px;margin-bottom:8px;} #slotDemoModal .mk-side{height:200px;}
    #slotDemoModal .mk-slot.on{background:#0e7d85;color:#fff;opacity:1;box-shadow:0 0 0 3px rgba(14,125,133,.3);}
</style>
<script>
function showSlotDemo(key, name, size){
    document.querySelectorAll('#slotDemoModal .mk-slot').forEach(function(s){
        var keys=(s.getAttribute('data-keys')||'').split(' ');
        s.classList.toggle('on', keys.indexOf(key)!==-1);
    });
    document.getElementById('slotDemoTitle').textContent = name + (size ? ' · ' + size : '');
    document.getElementById('slotDemoModal').style.display='flex';
    document.getElementById('slotDemoModal').style.alignItems='flex-start';
    document.getElementById('slotDemoModal').style.justifyContent='center';
}
function closeSlotDemo(){ document.getElementById('slotDemoModal').style.display='none'; }
document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeSlotDemo(); });

function delSlot(id){
    if(!confirm('Xóa slot quảng cáo này?')) return;
    fetch('/admin/DeleteAdSlot/'+id,{method:'POST',headers:{'RequestVerificationToken':document.querySelector('input[name="__RequestVerificationToken"]').value}})
      .then(r=>r.json()).then(d=>{ if(d.success) location.reload(); else alert('Không xóa được.'); });
}
</script>
