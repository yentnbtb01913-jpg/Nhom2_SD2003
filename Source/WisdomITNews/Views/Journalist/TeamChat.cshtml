@using WisdomITNews.Models
@{
    Layout = "~/Views/Shared/_JournalistLayout.cshtml";
    ViewData["Title"] = "Chat Ban quản lý";
    var msgs = ViewBag.Messages as List<TeamChatMessage> ?? new();
    string meRole = ViewBag.MeRole as string ?? "";
    int meId = (int)(ViewBag.MeId ?? 0);
    string RoleTag(string r) => r switch { "admin" => "Admin", "nhanvien" => "Nhân viên", "journalist" => "Nhà báo", _ => r };
    string RoleColor(string r) => r switch { "admin" => "#159aa3", "nhanvien" => "#0ea5e9", "journalist" => "#f59e0b", _ => "#64748b" };
}
<div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
    <h1 style="font-size:20px;font-weight:800;"><i class="fa fa-comments" style="color:#159aa3;"></i> Chat Ban quản lý</h1>
    <span style="font-size:12px;color:#94a3b8;">Phòng chung Admin · Nhân viên · Nhà báo</span>
</div>

<div style="background:#fff;border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.06);display:flex;flex-direction:column;height:68vh;max-width:900px;">
    <div id="msgBox" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;">
        @foreach (var m in msgs)
        {
            var mine = m.SenderRole == meRole && m.SenderId == meId;
            <div style="display:flex;justify-content:@(mine ? "flex-end" : "flex-start");">
                <div style="max-width:70%;">
                    <div style="font-size:11px;color:#94a3b8;margin-bottom:2px;@(mine ? "text-align:right;" : "")">
                        <strong style="color:@RoleColor(m.SenderRole);">@m.SenderName</strong>
                        <span style="background:@(RoleColor(m.SenderRole))22;color:@RoleColor(m.SenderRole);padding:0 6px;border-radius:8px;font-size:10px;font-weight:700;">@RoleTag(m.SenderRole)</span>
                        · @m.CreatedAt.ToString("HH:mm dd/MM")
                    </div>
                    <div style="background:@(mine ? "#159aa3" : "#eef2f5");color:@(mine ? "#fff" : "#1f2937");padding:9px 13px;border-radius:12px;font-size:14px;white-space:pre-wrap;word-break:break-word;">@m.Content</div>
                </div>
            </div>
        }
    </div>
    <div style="border-top:1px solid #eef2f5;padding:12px;display:flex;gap:8px;">
        <input id="msgInput" type="text" placeholder="Nhập tin nhắn cho ban quản lý..." maxlength="2000" style="flex:1;padding:11px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;" />
        <button id="sendBtn" style="background:#159aa3;color:#fff;border:none;padding:0 20px;border-radius:8px;font-weight:700;cursor:pointer;"><i class="fa fa-paper-plane"></i></button>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    const meRole = "@meRole", meId = @meId;
    const box = document.getElementById('msgBox');
    const input = document.getElementById('msgInput');
    const btn = document.getElementById('sendBtn');
    function esc(t){ const d=document.createElement('div'); d.textContent=t; return d.innerHTML; }
    function rColor(r){ return r==='admin'?'#159aa3':(r==='nhanvien'?'#0ea5e9':(r==='journalist'?'#f59e0b':'#64748b')); }
    function rTag(r){ return r==='admin'?'Admin':(r==='nhanvien'?'Nhân viên':(r==='journalist'?'Nhà báo':r)); }
    function down(){ box.scrollTop = box.scrollHeight; }
    function append(m){
        const mine = (m.role===meRole && m.senderId===meId);
        const c = rColor(m.role);
        const row = document.createElement('div');
        row.style.display='flex'; row.style.justifyContent = mine ? 'flex-end':'flex-start';
        row.innerHTML = '<div style="max-width:70%;">'
          + '<div style="font-size:11px;color:#94a3b8;margin-bottom:2px;'+(mine?'text-align:right;':'')+'">'
          + '<strong style="color:'+c+';">'+esc(m.senderName)+'</strong> '
          + '<span style="background:'+c+'22;color:'+c+';padding:0 6px;border-radius:8px;font-size:10px;font-weight:700;">'+rTag(m.role)+'</span> · '+esc(m.createdAt)+'</div>'
          + '<div style="background:'+(mine?'#159aa3':'#eef2f5')+';color:'+(mine?'#fff':'#1f2937')+';padding:9px 13px;border-radius:12px;font-size:14px;white-space:pre-wrap;word-break:break-word;">'+esc(m.content)+'</div>'
          + '</div>';
        box.appendChild(row); down();
    }
    const conn = new signalR.HubConnectionBuilder().withUrl("/teamChatHub").withAutomaticReconnect().build();
    conn.on("ReceiveTeamMessage", m => { if (m.convKey === 'team') append(m); });
    conn.start().then(() => conn.invoke("JoinConversation", "team")).catch(e => console.error(e));
    function send(){
        const t = input.value.trim(); if (!t) return;
        conn.invoke("SendMessage", "team", t, null, null).catch(e => console.error(e));
        input.value=''; input.focus();
    }
    btn.addEventListener('click', send);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); send(); } });
    down();
</script>
