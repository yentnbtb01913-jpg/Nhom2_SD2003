@using WisdomITNews.Models
@model JournalistLoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Nhà Báo — Đăng nhập</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter',sans-serif;
                min-height: 100vh;
                display: flex;
                background: #fcf9f8;
            }
            /* Left panel */
            .login-left {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg,#000613 0%,#001020 50%,#001f3f 100%);
                color: #fff;
                padding: 40px;
                position: relative;
                overflow: hidden;
            }

                .login-left::before {
                    content: '';
                    position: absolute;
                    width: 400px;
                    height: 400px;
                    border-radius: 50%;
                    background: radial-gradient(circle,rgba(71,96,131,.2),transparent 70%);
                    top: -100px;
                    right: -100px;
                }

                .login-left::after {
                    content: '';
                    position: absolute;
                    width: 300px;
                    height: 300px;
                    border-radius: 50%;
                    background: radial-gradient(circle,rgba(71,96,131,.12),transparent 70%);
                    bottom: -80px;
                    left: -80px;
                }

            .login-left-content {
                position: relative;
                z-index: 1;
                text-align: center;
                max-width: 400px;
            }

                .login-left-content .icon {
                    width: 80px;
                    height: 80px;
                    background: linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);
                    border-radius: 0px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 36px;
                    margin-bottom: 24px;
                    border: 1px solid rgba(255,255,255,.15);
                }

                .login-left-content h1 {
                    font-family: 'Playfair Display',serif;
                    font-size: 32px;
                    margin-bottom: 12px;
                }

                .login-left-content p {
                    font-size: 15px;
                    opacity: .7;
                    line-height: 1.6;
                }

                .login-left-content .features {
                    margin-top: 32px;
                    display: flex;
                    flex-direction: column;
                    gap: 12px;
                    text-align: left;
                }

                .login-left-content .feat {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    font-size: 14px;
                    opacity: .8;
                }

                    .login-left-content .feat i {
                        width: 32px;
                        height: 32px;
                        background: rgba(255,255,255,.1);
                        border-radius: 0px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 14px;
                        flex-shrink: 0;
                    }
            /* Right panel */
            .login-right {
                width: 480px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
            }

            .login-box {
                width: 100%;
                max-width: 380px;
            }

                .login-box h2 {
                    font-size: 24px;
                    font-weight: 700;
                    margin-bottom: 4px;
                    color: #0a2540;
                }

                .login-box .sub {
                    font-size: 14px;
                    color: #6b7280;
                    margin-bottom: 28px;
                }

            .form-group {
                margin-bottom: 18px;
            }

                .form-group label {
                    font-size: 13px;
                    font-weight: 600;
                    color: #374151;
                    display: block;
                    margin-bottom: 6px;
                }

                .form-group input {
                    width: 100%;
                    padding: 12px 14px;
                    border: 1px solid #c4c6cf;
                    border-radius: 0px;
                    font-size: 14px;
                    font-family: inherit;
                    outline: none;
                    transition: all .2s;
                    background: #fff;
                }

                    .form-group input:focus {
                        border-color: #001f3f;
                        box-shadow: 0 0 0 3px rgba(0,31,63,.08);
                    }

            .login-btn {
                width: 100%;
                padding: 13px;
                background: #001f3f;
                color: #fff;
                border: none;
                border-radius: 0px;
                font-size: 15px;
                font-weight: 700;
                cursor: pointer;
                font-family: inherit;
                transition: all .2s;
            }

                .login-btn:hover {
                    background: #c1121f;
                }

            .error {
                background: #fef2f2;
                color: #ba1a1a;
                border: 1px solid #fecaca;
                border-radius: 0px;
                padding: 10px 14px;
                font-size: 13px;
                margin-bottom: 16px;
            }

            .links {
                text-align: center;
                margin-top: 20px;
                font-size: 13px;
                color: #6b7280;
            }

                .links a {
                    color: #001f3f;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .links a:hover {
                        text-decoration: underline;
                    }

            .back-link {
                text-align: center;
                margin-top: 12px;
            }

                .back-link a {
                    font-size: 13px;
                    color: #9ca3af;
                    text-decoration: none;
                }

                    .back-link a:hover {
                        color: #0a2540;
                    }

            @@media(max-width:900px) {
                .login-left {
                    display: none;
                }

                .login-right {
                    width: 100%;
                }
            }
    </style>
</head>
<body>
    <div class="login-left">
        <div class="login-left-content">
            <div class="icon"><i class="fa fa-pen-nib"></i></div>
            <h1>Journalist Panel</h1>
            <p>Nền tảng viết bài và quản lý nội dung dành cho nhà báo tại Wisdom IT News</p>
            <div class="features">
                <div class="feat"><i class="fa fa-feather-pointed"></i> Trình soạn thảo chuyên nghiệp</div>
                <div class="feat"><i class="fa fa-chart-line"></i> Thống kê chi tiết bài viết</div>
                <div class="feat"><i class="fa fa-shield-check"></i> Kiểm duyệt bài viết tự động bằng AI</div>
                <div class="feat"><i class="fa fa-bolt"></i> Xuất bản nhanh chóng</div>
            </div>
        </div>
    </div>
    <div class="login-right">
        <div class="login-box">
            <h2>Đăng nhập</h2>
            <p class="sub">Truy cập vào tài khoản nhà báo của bạn</p>

            @if (TempData["PendingMsg"] != null)
            {
                <div style="background:#dcfce7;color:#166534;border:1px solid #bbf7d0;border-radius:6px;padding:10px 14px;font-size:13px;margin-bottom:14px;"><i class="fa fa-circle-check"></i> @TempData["PendingMsg"]</div>
            }
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="error"><i class="fa fa-circle-exclamation"></i> @Model.Error</div>
            }

            <form method="post" action="/Journalist/Login" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Tên đăng nhập hoặc email</label>
                    <input type="text" name="UsernameOrEmail" value="@Model.UsernameOrEmail" placeholder="username hoặc email" required />
                </div>
                <div class="form-group">
                    <label>Mật khẩu</label>
                    <input type="password" name="Password" placeholder="••••••••" required />
                </div>
                <button type="submit" class="login-btn"><i class="fa fa-right-to-bracket"></i> Đăng nhập</button>
            </form>

            <div class="links">Chưa có tài khoản? <a href="/Journalist/Register">Đăng ký nhà báo</a></div>
            <div class="back-link"><a href="/"><i class="fa fa-arrow-left"></i> Quay về trang chủ</a></div>
        </div>
    </div>
</body>
</html>