@using WisdomITNews.Models
@model List<Advertisement>
@{
    Layout = "~/Views/Shared/_JournalistLayout.cshtml";
    ViewData["Title"] = "Quảng cáo của tôi";
    var posLabel = new Dictionary<string, string> { ["header"] = "Header", ["sidebar"] = "Sidebar", ["in_article"] = "Trong bài" };
    string PosVi(string p) => posLabel.TryGetValue(p ?? "", out var v) ? v : p;
}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-rectangle-ad" style="color:#159aa3;"></i> Quảng cáo của tôi</h1>
    <a href="/journalist/CreateAd" style="background:#159aa3;color:#fff;padding:9px 16px;border-radius:6px;font-weight:600;font-size:14px;text-decoration:none;"><i class="fa fa-plus"></i> Tạo quảng cáo</a>
</div>
@if (TempData["Ok"] != null)
{ <div style="background:#dcfce7;color:#166534;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@TempData["Ok"]</div> }

<div style="background:#fff;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.06);overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead><tr style="background:#f5f6f8;color:#6c757d;text-align:left;">
            <th style="padding:10px;">Banner</th><th style="padding:10px;">Tiêu đề</th><th style="padding:10px;">Vị trí</th>
            <th style="padding:10px;">Hiển thị</th><th style="padding:10px;">Click</th><th style="padding:10px;">Trạng thái</th>
        </tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr style="border-bottom:1px solid #f0f2f5;">
                    <td style="padding:10px;">@if (!string.IsNullOrEmpty(a.ImageUrl)) {<img src="@a.ImageUrl" style="width:80px;max-height:40px;object-fit:contain;border-radius:4px;" />}</td>
                    <td style="padding:10px;font-weight:600;">@a.Title</td>
                    <td style="padding:10px;">@PosVi(a.Position)</td>
                    <td style="padding:10px;">@a.Impressions.ToString("N0")</td>
                    <td style="padding:10px;">@a.Clicks.ToString("N0")</td>
                    <td style="padding:10px;">
                        @if (a.Status == "pending") { <span style="background:#fef9c3;color:#ca8a04;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">Chờ duyệt</span> }
                        else if (a.Status == "rejected") { <span style="background:#fee2e2;color:#991b1b;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">Bị từ chối</span> }
                        else { <span style="background:#dcfce7;color:#16a34a;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;">@(a.IsActive ? "Đang chạy" : "Đã duyệt (tắt)")</span> }
                    </td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="6" style="padding:24px;text-align:center;color:#94a3b8;">Bạn chưa tạo quảng cáo nào.</td></tr> }
        </tbody>
    </table>
</div>
