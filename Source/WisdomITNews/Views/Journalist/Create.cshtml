@using WisdomITNews.Models
@model ArticleFormViewModel
@{
    Layout = "~/Views/Shared/_JournalistLayout.cshtml"; ViewData["Title"] = "Viết bài mới";
}
<div class="j-topbar">
    <h1><i class="fa fa-feather-pointed" style="color:#001f3f;"></i> Viết bài mới</h1>
    <div class="j-topbar-actions">
        <a href="/Journalist/Dashboard" class="j-btn-secondary"><i class="fa fa-arrow-left"></i> Quay lại</a>
    </div>
</div>
<div class="j-content">
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="j-alert j-alert-error"><i class="fa fa-triangle-exclamation"></i> @Model.Error</div>
    }
    <form method="post" action="/Journalist/Create" enctype="multipart/form-data" id="articleForm">
        @Html.AntiForgeryToken()
        <div style="display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start;">
            <!-- LEFT -->
            <div style="display:flex;flex-direction:column;gap:20px;">
                <div class="j-card">
                    <div style="margin-bottom:16px;">
                        <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">Tiêu đề bài viết *</label>
                        <input type="text" name="Article.Title" value="@Model.Article.Title" placeholder="Nhập tiêu đề hấp dẫn cho bài viết..." required maxlength="200"
                               style="width:100%;padding:14px 16px;border:1px solid #d1d5db;border-radius:0px;font-size:16px;font-weight:600;font-family:inherit;outline:none;transition:all .2s;" onfocus="this.style.borderColor='#001f3f';this.style.boxShadow='0 0 0 3px rgba(245,158,11,.1)'" onblur="this.style.borderColor='#d1d5db';this.style.boxShadow='none'" />
                    </div>
                    <div>
                        <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">Tóm tắt *</label>
                        <textarea name="Article.Summary" rows="3" required maxlength="500" placeholder="Mô tả ngắn gọn nội dung bài viết (sẽ hiển thị trên trang chủ)..."
                                  style="width:100%;padding:12px 16px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;resize:vertical;transition:all .2s;" onfocus="this.style.borderColor='#001f3f'" onblur="this.style.borderColor='#d1d5db'">@Model.Article.Summary</textarea>
                    </div>
                </div>
                <!-- Rich Text Editor -->
                <div class="j-card">
                    <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:8px;">Nội dung bài viết * <span style="font-weight:400;color:#9ca3af;">(Rich Text Editor)</span></label>
                    <textarea name="Article.Content" id="articleContent" style="visibility:hidden;">@Html.Raw(Model.Article.Content)</textarea>
                </div>
            </div>
            <!-- RIGHT SIDEBAR -->
            <div style="display:flex;flex-direction:column;gap:20px;">
                <!-- Publish -->
                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-paper-plane"></i> Xuất bản</h3>
                    <div style="margin-bottom:14px;">
                        <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Hành động</label>
                        <select name="Article.Status" style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;background:#fff;">
                            <option value="PendingReview">Gửi duyệt</option>
                            <option value="draft">Lưu nháp</option>
                        </select>
                    </div>
                    <button type="submit" style="width:100%;padding:13px;background:linear-gradient(135deg,#001f3f,#476083);color:#fff;border:none;border-radius:0px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;transition:all .2s;box-shadow:0 4px 14px rgba(245,158,11,.2);" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='none'">
                        <i class="fa fa-paper-plane"></i> Gửi bài
                    </button>
                    <p style="font-size:11px;color:#9ca3af;text-align:center;margin-top:8px;">Bài viết sẽ được Admin kiểm duyệt</p>
                </div>
                <!-- Category -->
                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-folder"></i> Danh mục</h3>
                    <select name="Article.CategoryId" required style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;background:#fff;">
                        <option value="">— Chọn danh mục —</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id" selected="@(cat.Id == Model.Article.CategoryId)">@cat.Icon @cat.Name</option>
                        }
                    </select>
                </div>

                <!-- Vùng tin tức -->
                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-map-marker-alt"></i> Vùng tin tức</h3>
                    <select name="Article.Region" style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;background:#fff;">
                        <option value="">— Chọn vùng —</option>
                        <option value="dong-nai" selected="@(Model.Article.Region == "dong-nai")">📍 Đồng Nai</option>
                        <option value="ha-noi" selected="@(Model.Article.Region == "ha-noi")">📍 Hà Nội</option>
                        <option value="ho-chi-minh" selected="@(Model.Article.Region == "ho-chi-minh")">📍 TP. Hồ Chí Minh</option>
                        <option value="da-nang" selected="@(Model.Article.Region == "da-nang")">📍 Đà Nẵng</option>
                        <option value="hai-phong" selected="@(Model.Article.Region == "hai-phong")">📍 Hải Phòng</option>
                        <option value="can-tho" selected="@(Model.Article.Region == "can-tho")">📍 Cần Thơ</option>
                    </select>
                    <p style="font-size:11px;color:#9ca3af;margin-top:6px;">Bài viết sẽ hiển thị trong vùng đã chọn</p>
                </div>

                <!-- Tags -->
                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-tags"></i> Tags</h3>
                    <input type="text" name="Tags" value="@Model.Tags" placeholder="AI, Python, React..."
                           style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;" />
                    <p style="font-size:11px;color:#9ca3af;margin-top:6px;">Phân cách bằng dấu phẩy</p>
                </div>
                <!-- Thumbnail -->
                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-image"></i> Ảnh bìa</h3>
                    <div id="thumbDropzone" style="border:2px dashed #d1d5db;border-radius:0px;padding:24px;text-align:center;cursor:pointer;transition:all .2s;background:#fafbfc;" onclick="document.getElementById('thumbFile').click()" ondragover="event.preventDefault();this.style.borderColor='#001f3f';this.style.background='#fffbeb'" ondragleave="this.style.borderColor='#d1d5db';this.style.background='#fafbfc'" ondrop="event.preventDefault();document.getElementById('thumbFile').files=event.dataTransfer.files;previewFile();this.style.borderColor='#d1d5db';this.style.background='#fafbfc'">
                        <i class="fa fa-cloud-arrow-up" style="font-size:28px;color:#d1d5db;margin-bottom:8px;display:block;"></i>
                        <p style="font-size:13px;color:#6b7280;">Kéo thả hoặc click để chọn ảnh</p>
                        <p style="font-size:11px;color:#9ca3af;">JPG, PNG, WEBP (tối đa 5MB)</p>
                    </div>
                    <input type="file" name="thumbnailFile" id="thumbFile" accept=".jpg,.jpeg,.png,.webp" style="display:none;" onchange="previewFile()" />
                    <img id="thumbPreview" style="width:100%;border-radius:0px;margin-top:10px;display:none;max-height:200px;object-fit:cover;" />
                    <div style="margin-top:10px;">
                        <label style="font-size:12px;font-weight:600;color:#374151;display:block;margin-bottom:4px;">Mô tả ảnh (alt)</label>
                        <input type="text" name="Article.ThumbnailAlt" value="@Model.Article.ThumbnailAlt" placeholder="Mô tả ngắn gọn ảnh bìa"
                               style="width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:0px;font-size:13px;font-family:inherit;outline:none;" />
                    </div>
                </div>
                <!-- AI Info -->
                <div style="background:linear-gradient(135deg,#eef2ff,#f5f3ff);border-radius:0px;padding:16px;border:1px solid #ddd6fe;">
                    <div style="font-weight:700;color:#476083;margin-bottom:8px;font-size:14px;"><i class="fa fa-robot"></i> AI Moderation</div>
                    <p style="font-size:12px;color:#6b7280;line-height:1.6;">Bài viết sẽ được AI tự động kiểm tra nội dung trước khi gửi tới Admin duyệt.</p>
                </div>
            </div>
        </div>
    </form>
</div>
@section Head {
    <script src="https://cdn.tiny.cloud/1/6u40dqmt8x9nsfgwy83asegnaf40iitg94ifkmt9fd87m2f8/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
}
@section Scripts {
    <script>
        // TinyMCE init
        tinymce.init({
        selector: '#articleContent',
        height: 500,
        menubar: 'file edit view insert format tools table',
        plugins: 'advlist autolink lists link image charmap preview anchor searchreplace visualblocks code fullscreen insertdatetime media table help wordcount codesample',
        toolbar: 'undo redo | blocks | bold italic underline strikethrough | forecolor backcolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image media codesample | table | removeformat fullscreen code',
        content_style: "body { font-family: 'Inter', sans-serif; font-size: 15px; line-height: 1.7; color: #0a2540; padding: 8px; }",
        branding: false,
        promotion: false,
        skin: 'oxide',
        images_upload_url: '/Journalist/UploadImage',
        images_upload_credentials: true,
        automatic_uploads: true,
        file_picker_types: 'image',
        convert_urls: false,
        relative_urls: false,
        codesample_languages: [
        { text: 'HTML/XML', value: 'markup' },
        { text: 'JavaScript', value: 'javascript' },
        { text: 'CSS', value: 'css' },
        { text: 'PHP', value: 'php' },
        { text: 'Python', value: 'python' },
        { text: 'Java', value: 'java' },
        { text: 'C#', value: 'csharp' },
        { text: 'C++', value: 'cpp' },
        { text: 'SQL', value: 'sql' },
        { text: 'Bash', value: 'bash' },
        { text: 'JSON', value: 'json' }
        ],
        setup: function (editor) {
        editor.on('change', function () {
        editor.save(); // sync to textarea
        });
        }
        });
        // Thumbnail preview
        function previewFile() {
        const input = document.getElementById('thumbFile');
        const preview = document.getElementById('thumbPreview');
        const file = input.files && input.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => { preview.src = e.target.result; preview.style.display = 'block'; };
        reader.readAsDataURL(file);
        }
    </script>
}