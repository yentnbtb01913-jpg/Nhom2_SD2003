@using WisdomITNews.Models
@model JournalistRegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Nhà Báo — Đăng ký</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter',sans-serif;
                min-height: 100vh;
                display: flex;
                background: #fcf9f8;
            }

            .reg-left {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg,#000613 0%,#001020 50%,#001f3f 100%);
                color: #fff;
                padding: 40px;
                position: relative;
                overflow: hidden;
            }

                .reg-left::before {
                    content: '';
                    position: absolute;
                    width: 400px;
                    height: 400px;
                    border-radius: 50%;
                    background: radial-gradient(circle,rgba(71,96,131,.2),transparent 70%);
                    top: -100px;
                    right: -100px;
                }

            .reg-left-content {
                position: relative;
                z-index: 1;
                text-align: center;
                max-width: 400px;
            }

                .reg-left-content .icon {
                    width: 80px;
                    height: 80px;
                    background: linear-gradient(135deg,#c1121f,#e63946,#ba1a1a);
                    border-radius: 0px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 36px;
                    margin-bottom: 24px;
                    border: 1px solid rgba(255,255,255,.15);
                }

                .reg-left-content h1 {
                    font-family: 'Playfair Display',serif;
                    font-size: 32px;
                    margin-bottom: 12px;
                }

                .reg-left-content p {
                    font-size: 15px;
                    opacity: .7;
                    line-height: 1.6;
                }

                .reg-left-content .steps {
                    margin-top: 32px;
                    text-align: left;
                }

                .reg-left-content .step {
                    display: flex;
                    align-items: flex-start;
                    gap: 14px;
                    margin-bottom: 16px;
                }

                .reg-left-content .step-num {
                    width: 28px;
                    height: 28px;
                    background: rgba(71,96,131,.3);
                    border: 1px solid rgba(71,96,131,.5);
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 12px;
                    font-weight: 700;
                    color: #d4e3ff;
                    flex-shrink: 0;
                }

                .reg-left-content .step-text {
                    font-size: 14px;
                    opacity: .8;
                    line-height: 1.5;
                }

                    .reg-left-content .step-text strong {
                        opacity: 1;
                        display: block;
                        margin-bottom: 2px;
                    }

            .reg-right {
                width: 520px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
                overflow-y: auto;
            }

            .reg-box {
                width: 100%;
                max-width: 420px;
            }

                .reg-box h2 {
                    font-size: 24px;
                    font-weight: 700;
                    margin-bottom: 4px;
                    color: #0a2540;
                }

                .reg-box .sub {
                    font-size: 14px;
                    color: #6b7280;
                    margin-bottom: 24px;
                }

            .form-group {
                margin-bottom: 16px;
            }

                .form-group label {
                    font-size: 13px;
                    font-weight: 600;
                    color: #374151;
                    display: block;
                    margin-bottom: 5px;
                }

                .form-group input, .form-group textarea {
                    width: 100%;
                    padding: 11px 14px;
                    border: 1px solid #c4c6cf;
                    border-radius: 0px;
                    font-size: 14px;
                    font-family: inherit;
                    outline: none;
                    transition: all .2s;
                    background: #fff;
                }

                .form-group textarea {
                    resize: vertical;
                    min-height: 60px;
                }

                    .form-group input:focus, .form-group textarea:focus {
                        border-color: #001f3f;
                        box-shadow: 0 0 0 3px rgba(0,31,63,.08);
                    }

            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }

            .form-hint {
                font-size: 11px;
                color: #9ca3af;
                margin-top: 4px;
            }

            .reg-btn {
                width: 100%;
                padding: 13px;
                background: #001f3f;
                color: #fff;
                border: none;
                border-radius: 0px;
                font-size: 15px;
                font-weight: 700;
                cursor: pointer;
                font-family: inherit;
                transition: all .2s;
                margin-top: 4px;
            }

                .reg-btn:hover {
                    background: #c1121f;
                }

            .error {
                background: #fef2f2;
                color: #ba1a1a;
                border: 1px solid #fecaca;
                border-radius: 0px;
                padding: 10px 14px;
                font-size: 13px;
                margin-bottom: 16px;
            }

            .links {
                text-align: center;
                margin-top: 16px;
                font-size: 13px;
                color: #6b7280;
            }

                .links a {
                    color: #001f3f;
                    font-weight: 600;
                    text-decoration: none;
                }

            .back-link {
                text-align: center;
                margin-top: 10px;
            }

                .back-link a {
                    font-size: 13px;
                    color: #9ca3af;
                    text-decoration: none;
                }

            @@media(max-width:900px) {
                .reg-left {
                    display: none;
                }

                .reg-right {
                    width: 100%;
                }
            }
    </style>
</head>
<body>
    <div class="reg-left">
        <div class="reg-left-content">
            <div class="icon"><i class="fa fa-pen-nib"></i></div>
            <h1>Trở thành Nhà Báo</h1>
            <p>Chia sẻ kiến thức công nghệ và lập trình cùng cộng đồng</p>
            <div class="steps">
                <div class="step">
                    <div class="step-num">1</div>
                    <div class="step-text"><strong>Đăng ký tài khoản</strong>Điền thông tin cơ bản để tạo tài khoản nhà báo</div>
                </div>
                <div class="step">
                    <div class="step-num">2</div>
                    <div class="step-text"><strong>Viết bài</strong>Sử dụng trình soạn thảo chuyên nghiệp với rich text editor</div>
                </div>
                <div class="step">
                    <div class="step-num">3</div>
                    <div class="step-text"><strong>Gửi duyệt</strong>Bài viết sẽ được Admin kiểm duyệt trước khi xuất bản</div>
                </div>
            </div>
        </div>
    </div>
    <div class="reg-right">
        <div class="reg-box">
            <h2>Đăng ký nhà báo</h2>
            <p class="sub">Tạo tài khoản để bắt đầu viết bài</p>
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="error"><i class="fa fa-circle-exclamation"></i> @Model.Error</div>
            }
            <form method="post" action="/Journalist/Register" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Họ và tên *</label>
                    <input type="text" name="FullName" value="@Model.FullName" placeholder="Nguyễn Văn A" maxlength="80" required />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Tên đăng nhập *</label>
                        <input type="text" name="Username" value="@Model.Username" placeholder="username" maxlength="40" pattern="[a-zA-Z0-9_.\-]+" required title="Chỉ chữ, số, dấu chấm/gạch dưới" />
                    </div>
                    <div class="form-group">
                        <label>Email *</label>
                        <input type="email" name="Email" value="@Model.Email" placeholder="email@example.com" maxlength="120" required />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Mật khẩu *</label>
                        <input type="password" name="Password" placeholder="Ít nhất 6 ký tự" minlength="6" required />
                    </div>
                    <div class="form-group">
                        <label>Xác nhận mật khẩu *</label>
                        <input type="password" name="ConfirmPassword" placeholder="Nhập lại mật khẩu" minlength="6" required />
                    </div>
                </div>
                <div class="form-group">
                    <label>Giới thiệu bản thân</label>
                    <textarea name="Bio" placeholder="Viết vài dòng giới thiệu về bạn (chuyên môn, kinh nghiệm...)">@Model.Bio</textarea>
                    <div class="form-hint">Không bắt buộc, có thể bổ sung sau</div>
                </div>
                <button type="submit" class="reg-btn"><i class="fa fa-user-plus"></i> Đăng ký tài khoản</button>
            </form>
            <div class="links">Đã có tài khoản? <a href="/Journalist/Login">Đăng nhập</a></div>
            <div class="back-link"><a href="/"><i class="fa fa-arrow-left"></i> Quay về trang chủ</a></div>
        </div>
    </div>
</body>
</html>