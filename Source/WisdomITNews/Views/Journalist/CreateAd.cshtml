@model WisdomITNews.Models.Advertisement
@{
    Layout = "~/Views/Shared/_JournalistLayout.cshtml";
    ViewData["Title"] = "Tạo quảng cáo";
    string lbl = "display:block;font-weight:600;font-size:13px;margin-bottom:6px;color:#374151;";
    string inp = "width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;";
    string hint = "font-size:11px;color:#94a3b8;margin-top:4px;";
    string D(DateTime? d) => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : "";
}
<div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
    <a href="/journalist/Ads" style="color:#6c757d;text-decoration:none;"><i class="fa fa-arrow-left"></i></a>
    <h1 style="font-size:22px;font-weight:800;"><i class="fa fa-rectangle-ad" style="color:#159aa3;"></i> Tạo quảng cáo</h1>
</div>
<div style="background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:12px 16px;margin-bottom:16px;font-size:13px;color:#9a3412;">
    <i class="fa fa-circle-info"></i> Quảng cáo bạn tạo sẽ ở trạng thái <b>Chờ duyệt</b> — Admin duyệt xong mới hiển thị ra ngoài.
</div>
@if (ViewBag.Error != null)
{ <div style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:14px;">@ViewBag.Error</div> }

<form method="post" action="/journalist/CreateAd" style="background:#fff;border-radius:8px;padding:22px;box-shadow:0 2px 10px rgba(0,0,0,.06);max-width:640px;">
    <div style="margin-bottom:16px;"><label style="@lbl">Tiêu đề *</label><input style="@inp" name="Title" value="@Model.Title" required maxlength="150" /></div>
    <div style="margin-bottom:16px;"><label style="@lbl">Link ảnh banner *</label><input style="@inp" name="ImageUrl" value="@Model.ImageUrl" placeholder="https://link-anh-banner.png" required /><div style="@hint">Dán link ảnh banner (Header 728x90, Sidebar 300x250).</div></div>
    <div style="margin-bottom:16px;"><label style="@lbl">Link đích (khi click) *</label><input style="@inp" name="TargetUrl" value="@Model.TargetUrl" placeholder="https://..." required /></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;">
        <div style="grid-column:1 / -1;"><label style="@lbl">Vị trí</label>
            <select style="@inp" name="Position">
                <option value="sidebar" selected>Sidebar (cột bên)</option>
                <option value="header">Header (đầu trang)</option>
                <option value="in_article">Trong bài viết</option>
            </select>
        </div>
        <div><label style="@lbl">Chạy từ ngày</label><input style="@inp" type="date" name="StartDate" value="@D(Model.StartDate)" /></div>
        <div><label style="@lbl">Đến ngày</label><input style="@inp" type="date" name="EndDate" value="@D(Model.EndDate)" /></div>
    </div>
    <button type="submit" style="background:#159aa3;color:#fff;border:none;padding:11px 24px;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;"><i class="fa fa-paper-plane"></i> Gửi (chờ duyệt)</button>
    <a href="/journalist/Ads" style="margin-left:8px;color:#6c757d;text-decoration:none;font-size:14px;">Hủy</a>
</form>
