@using WisdomITNews.Models
@model ArticleFormViewModel
@{
    Layout = "~/Views/Shared/_JournalistLayout.cshtml"; ViewData["Title"] = "Sua bai viet";
}

<div class="j-topbar">
    <h1><i class="fa fa-pen-to-square" style="color:#001f3f;"></i> Sua bai viet</h1>
    <div class="j-topbar-actions">
        <button type="button" onclick="genAudio('/journalist', @Model.Article.Id, this)" class="j-btn-secondary"><i class="fa fa-headphones"></i> Tao audio</button>
        @if (Model.Article.Status == "published")
        {
            <a href="/bai-viet/@Model.Article.Slug" target="_blank" class="j-btn-secondary"><i class="fa fa-eye"></i> Xem bai</a>
        }
        <a href="/Journalist/Dashboard" class="j-btn-secondary"><i class="fa fa-arrow-left"></i> Quay lai</a>
    </div>
</div>

<div class="j-content">
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="j-alert j-alert-error"><i class="fa fa-triangle-exclamation"></i> @Model.Error</div>
    }
    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="j-alert j-alert-success"><i class="fa fa-circle-check"></i> @Model.Success</div>
    }

    <form method="post" action="/Journalist/Edit/@Model.Article.Id" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div style="display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start;">

            <!-- LEFT -->
            <div style="display:flex;flex-direction:column;gap:20px;">
                <div class="j-card">
                    <div style="margin-bottom:16px;">
                        <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">Tieu de *</label>
                        <input type="text" name="Article.Title" value="@Model.Article.Title" required maxlength="200"
                               style="width:100%;padding:14px 16px;border:1px solid #d1d5db;border-radius:0px;font-size:16px;font-weight:600;font-family:inherit;outline:none;transition:all .2s;" onfocus="this.style.borderColor='#001f3f'" onblur="this.style.borderColor='#d1d5db'" />
                    </div>
                    <div>
                        <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">Tom tat *</label>
                        <textarea name="Article.Summary" rows="3" required maxlength="500"
                                  style="width:100%;padding:12px 16px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;resize:vertical;transition:all .2s;" onfocus="this.style.borderColor='#001f3f'" onblur="this.style.borderColor='#d1d5db'">@Model.Article.Summary</textarea>
                    </div>
                </div>

                <div class="j-card">
                    <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:8px;">Noi dung bai viet * <span style="font-weight:400;color:#9ca3af;">(Rich Text Editor)</span></label>
                    <textarea name="Article.Content" id="articleContent" style="visibility:hidden;">@Html.Raw(Model.Article.Content)</textarea>
                </div>
            </div>

            <!-- RIGHT -->
            <div style="display:flex;flex-direction:column;gap:20px;">
                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-floppy-disk"></i> Cap nhat</h3>
                    <div style="margin-bottom:14px;">
                        <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Hanh dong</label>
                        <select name="Article.Status" style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;background:#fff;">
                            <option value="PendingReview" selected="@(Model.Article.Status != "draft")">Gui duyet lai</option>
                            <option value="draft" selected="@(Model.Article.Status == "draft")">Luu nhap</option>
                        </select>
                    </div>
                    <button type="submit" style="width:100%;padding:13px;background:linear-gradient(135deg,#001f3f,#476083);color:#fff;border:none;border-radius:0px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;">
                        <i class="fa fa-save"></i> Luu thay doi
                    </button>
                </div>

                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-folder"></i> Danh muc</h3>
                    <select name="Article.CategoryId" required style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;background:#fff;">
                        <option value="">— Chon danh muc —</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id" selected="@(cat.Id == Model.Article.CategoryId)">@cat.Icon @cat.Name</option>
                        }
                    </select>
                </div>

                <!-- Vùng tin tức -->
                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-map-marker-alt"></i> Vùng tin tức</h3>
                    <select name="Article.Region" style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;background:#fff;">
                        <option value="">— Chọn vùng —</option>
                        <option value="dong-nai" selected="@(Model.Article.Region == "dong-nai")">📍 Đồng Nai</option>
                        <option value="ha-noi" selected="@(Model.Article.Region == "ha-noi")">📍 Hà Nội</option>
                        <option value="ho-chi-minh" selected="@(Model.Article.Region == "ho-chi-minh")">📍 TP. Hồ Chí Minh</option>
                        <option value="da-nang" selected="@(Model.Article.Region == "da-nang")">📍 Đà Nẵng</option>
                        <option value="hai-phong" selected="@(Model.Article.Region == "hai-phong")">📍 Hải Phòng</option>
                        <option value="can-tho" selected="@(Model.Article.Region == "can-tho")">📍 Cần Thơ</option>
                    </select>
                    <p style="font-size:11px;color:#9ca3af;margin-top:6px;">Bài viết sẽ hiển thị trong vùng đã chọn</p>
                </div>
                <!-- Tags-->
                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-tags"></i> Tags</h3>
                    <input type="text" name="Tags" value="@Model.Tags" placeholder="AI, Python, React..."
                           style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:0px;font-size:14px;font-family:inherit;outline:none;" />
                </div>

                <div class="j-card">
                    <h3 class="j-card-title"><i class="fa fa-image"></i> Anh bia</h3>
                    @if (!string.IsNullOrEmpty(Model.Article.Thumbnail))
                    {
                        <img src="@Model.Article.Thumbnail" style="width:100%;border-radius:0px;max-height:180px;object-fit:cover;margin-bottom:10px;" />
                    }
                    <input type="file" name="thumbnailFile" accept=".jpg,.jpeg,.png,.webp"
                           style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:0px;font-size:13px;background:#fafbfc;" />
                    <p style="font-size:11px;color:#9ca3af;margin-top:6px;">Chon file moi de thay the anh bia hien tai</p>
                    <div style="margin-top:10px;">
                        <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px;">Mo ta anh (alt)</label>
                        <input type="text" name="Article.ThumbnailAlt" value="@Model.Article.ThumbnailAlt"
                               style="width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:0px;font-size:13px;font-family:inherit;outline:none;" />
                    </div>
                </div>

                <!-- Info -->
                <div style="background:#f8f9fb;border-radius:0px;padding:14px;font-size:12px;color:#6b7280;border:1px solid #e5e7eb;">
                    <div style="font-weight:600;margin-bottom:8px;color:#374151;">Thong tin</div>
                    <div style="margin-bottom:4px;">Tao luc: @Model.Article.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    <div style="margin-bottom:4px;">Cap nhat: @Model.Article.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    <div>Luot xem: <strong>@Model.Article.Views</strong></div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Head {
    <script src="https://cdn.tiny.cloud/1/6u40dqmt8x9nsfgwy83asegnaf40iitg94ifkmt9fd87m2f8/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
}

@section Scripts {
    <script>
        tinymce.init({
        selector: '#articleContent',
        height: 500,
        menubar: 'file edit view insert format tools table',
        plugins: 'advlist autolink lists link image charmap preview anchor searchreplace visualblocks code fullscreen insertdatetime media table help wordcount codesample',
        toolbar: 'undo redo | blocks | bold italic underline strikethrough | forecolor backcolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image media codesample | table | removeformat fullscreen code',
        content_style: "body { font-family: 'Inter', sans-serif; font-size: 15px; line-height: 1.7; color: #0a2540; padding: 8px; }",
        branding: false,
        promotion: false,
        images_upload_url: '/Journalist/UploadImage',
        images_upload_credentials: true,
        automatic_uploads: true,
        convert_urls: false,
        relative_urls: false,
        codesample_languages: [
        { text: 'HTML/XML', value: 'markup' },
        { text: 'JavaScript', value: 'javascript' },
        { text: 'CSS', value: 'css' },
        { text: 'PHP', value: 'php' },
        { text: 'Python', value: 'python' },
        { text: 'Java', value: 'java' },
        { text: 'C#', value: 'csharp' }
        ],
        setup: function (editor) {
        editor.on('change', function () { editor.save(); });
        }
        });
    </script>
}
<script>
    async function genAudio(prefix, id, btn){
        if (typeof confirmSwal === "function") { if(!await confirmSwal("Tạo audio (giọng đọc AI - Piper) từ bài viết này? Có thể mất một lúc.")) return; }
        var old = btn.innerHTML; btn.disabled = true; btn.innerHTML = "Đang tạo audio...";
        try {
            var r = await fetch(prefix + "/GeneratePodcast?articleId=" + id, { method: "POST" });
            var d = await r.json();
            if (d.success) Swal.fire("Thành công", "Đã tạo audio. Xem ở trang bài viết và mục Quản lý Audio.", "success");
            else Swal.fire("Lỗi", d.message || "Không tạo được audio (kiểm tra Piper đã cài chưa).", "error");
        } catch(e) { Swal.fire("Lỗi kết nối"); }
        btn.disabled = false; btn.innerHTML = old;
    }
</script>